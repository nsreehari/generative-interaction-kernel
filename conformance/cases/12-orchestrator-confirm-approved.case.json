{
  "name": "orchestrator: a decision request resolved by a host drives the follow-up write in one dispatch",
  "description": "Pressing Delete emits a decision request (the reducer itself writes nothing). The scripted resolver returns a `confirmed` follow-up event, which the same node handles to assign card_data.status.",
  "vocabulary": {
    "gik": "0.1",
    "type": "vocabulary",
    "payload": {
      "version": "request-demo/1.0",
      "expression": "jsonata",
      "namespaces": ["card_data"],
      "actions": ["assign", "emit", "invoke", "route", "request"],
      "capabilities": { "actions": { "emits": ["delete", "confirmed"] } }
    }
  },
  "program": {
    "gik": "0.1",
    "type": "program",
    "payload": {
      "vocabulary": "request-demo/1.0",
      "root": {
        "capability": "actions",
        "id": "delBtn",
        "props": { "label": "Delete" },
        "edges": {
          "read": { "state": "card_data.status" },
          "on": {
            "delete": [{
              "do": "request",
              "control": {
                "kind": "decision",
                "responseSchema": { "type": "object", "required": ["approved"], "properties": { "approved": { "type": "boolean" } } }
              },
              "data": { "title": "Delete order?" }
            }],
            "confirmed": [{ "do": "assign", "target": "card_data.status", "args": { "value": "deleted" } }]
          }
        }
      }
    }
  },
  "orchestrator": [
    {
      "on": { "kind": "request", "node": "delBtn" },
      "result": { "events": [{ "node": "delBtn", "name": "confirmed" }] }
    }
  ],
  "steps": [
    {
      "event": { "node": "delBtn", "name": "delete" },
      "expectPatch": {
        "rev": 1,
        "ops": [{ "op": "set", "path": "card_data.status", "value": "deleted" }],
        "completedWithinRun": [{ "kind": "assign", "node": "delBtn", "target": "card_data.status", "value": "deleted" }]
      },
      "expectResolve": [{ "id": "delBtn", "props": { "state": "deleted" } }]
    }
  ]
}
