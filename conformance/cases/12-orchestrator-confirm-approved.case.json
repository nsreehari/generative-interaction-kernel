{
  "name": "orchestrator: a confirm effect approved by HITL drives the follow-up write in one dispatch",
  "description": "Pressing Delete emits a `confirm` effect (the reducer itself writes nothing). The scripted Orchestrator approves it by returning a `confirmed` follow-up event, which the same node handles to assign card_data.status. One dispatch, one rev: the reducer's own ops are empty, yet the effect's follow-up produces the single write.",
  "vocabulary": {
    "gik": "0.1",
    "type": "vocabulary",
    "payload": {
      "version": "confirm-demo/1.0",
      "expression": "jsonata",
      "namespaces": ["card_data"],
      "actions": ["assign", "derive", "invoke", "emit", "route", "confirm"],
      "capabilities": { "actions": { "emits": ["delete", "confirmed"] } }
    }
  },
  "program": {
    "gik": "0.1",
    "type": "program",
    "payload": {
      "vocabulary": "confirm-demo/1.0",
      "root": {
        "capability": "actions",
        "id": "delBtn",
        "props": { "label": "Delete" },
        "edges": {
          "read": { "state": "card_data.status" },
          "on": {
            "delete": [{ "do": "confirm", "args": { "title": "Delete order?" } }],
            "confirmed": [{ "do": "assign", "target": "card_data.status", "args": { "value": "deleted" } }]
          }
        }
      }
    }
  },
  "orchestrator": [
    {
      "on": { "kind": "confirm", "node": "delBtn" },
      "result": { "events": [{ "node": "delBtn", "name": "confirmed" }] }
    }
  ],
  "steps": [
    {
      "event": { "node": "delBtn", "name": "delete" },
      "expectPatch": {
        "rev": 1,
        "ops": [{ "op": "set", "path": "card_data.status", "value": "deleted" }]
      },
      "expectResolve": [{ "id": "delBtn", "props": { "state": "deleted" } }]
    }
  ]
}
