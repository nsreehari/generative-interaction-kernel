{
  "name": "cascade: one event drives two machines through an emit chain in a single dispatch",
  "description": "A press emits `advance`; an outer machine consumes it (idle -> running) and its transition emits `inner`; a second machine consumes `inner` (waiting -> done). All three hops settle inside one dispatch, so one rev carries both machine-state writes in order.",
  "vocabulary": {
    "gik": "0.1",
    "type": "vocabulary",
    "payload": {
      "version": "cascade-demo/1.0",
      "expression": "jsonata",
      "namespaces": ["card_data"],
      "actions": ["assign", "emit", "invoke", "route", "request"],
      "capabilities": { "control": { "emits": ["press"] } }
    }
  },
  "program": {
    "gik": "0.1",
    "type": "program",
    "payload": {
      "vocabulary": "cascade-demo/1.0",
      "root": {
        "capability": "control",
        "id": "c",
        "edges": { "on": { "press": [{ "do": "emit", "event": "advance" }] } }
      },
      "machines": [
        {
          "id": "outer",
          "context": "card_data.outer",
          "initial": "idle",
          "states": {
            "idle": { "on": { "advance": { "target": "running", "actions": [{ "do": "emit", "event": "inner" }] } } },
            "running": { "type": "final" }
          }
        },
        {
          "id": "nested",
          "context": "card_data.nested",
          "initial": "waiting",
          "states": {
            "waiting": { "on": { "inner": "done" } },
            "done": { "type": "final" }
          }
        }
      ]
    }
  },
  "steps": [
    {
      "event": { "node": "c", "name": "press" },
      "expectPatch": {
        "rev": 1,
        "ops": [
          { "op": "set", "path": "card_data.outer.state", "value": "running" },
          { "op": "set", "path": "card_data.nested.state", "value": "done" }
        ],
        "completedWithinRun": [
          { "kind": "emit", "node": "c", "event": { "node": "c", "name": "advance" } },
          { "kind": "emit", "node": "c", "event": { "node": "c", "name": "inner" } }
        ]
      }
    }
  ]
}
