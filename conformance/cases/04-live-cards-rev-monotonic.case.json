{
  "name": "live-cards: revision is monotonic across dispatches",
  "description": "Each dispatch increments rev by exactly one regardless of the action, independent of init().",
  "vocabularyRef": "../../schemas/fixtures/live-cards.vocabulary.json",
  "programRef": "../../schemas/fixtures/example.program.json",
  "steps": [
    {
      "event": { "node": "table-orders", "name": "rowSelect", "payload": { "id": "order-7" } },
      "expectPatch": { "rev": 1, "ops": [{ "op": "set", "path": "card_data.selected", "value": "order-7" }] }
    },
    {
      "event": { "node": "btn-approve", "name": "tap" },
      "expectPatch": { "rev": 2, "ops": [{ "op": "set", "path": "card_data.status", "value": "approved" }] }
    }
  ]
}
