{
  "name": "derive: an expression over $event is stored",
  "description": "A derive action evaluates an expression against the event and writes the result (rev 1).",
  "vocabulary": {
    "gik": "0.1",
    "type": "vocabulary",
    "payload": {
      "version": "derive-demo/1.0",
      "expression": "jsonata",
      "namespaces": ["card_data"],
      "actions": ["assign", "derive", "invoke", "emit", "route", "confirm"],
      "capabilities": { "widget": { "emits": ["compute"] } }
    }
  },
  "program": {
    "gik": "0.1",
    "type": "program",
    "payload": {
      "vocabulary": "derive-demo/1.0",
      "root": {
        "capability": "widget",
        "id": "w",
        "edges": {
          "on": { "compute": [{ "do": "derive", "target": "card_data.doubled", "args": { "expr": "$event.n * 2" } }] }
        }
      }
    }
  },
  "steps": [
    {
      "event": { "node": "w", "name": "compute", "payload": { "n": 21 } },
      "expectPatch": { "rev": 1, "ops": [{ "op": "set", "path": "card_data.doubled", "value": 42 }] }
    }
  ]
}
