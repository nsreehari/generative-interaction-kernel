{
  "name": "assign: an expression over $event is stored",
  "description": "An assign action evaluates its from expression against the event and writes the result (rev 1).",
  "vocabulary": {
    "gik": "0.1",
    "type": "vocabulary",
    "payload": {
      "version": "derive-demo/1.0",
      "expression": "jsonata",
      "namespaces": ["card_data"],
      "actions": ["assign", "emit", "invoke", "route", "request"],
      "capabilities": { "widget": { "emits": ["compute"] } }
    }
  },
  "program": {
    "gik": "0.1",
    "type": "program",
    "payload": {
      "vocabulary": "derive-demo/1.0",
      "root": {
        "capability": "widget",
        "id": "w",
        "edges": {
          "on": { "compute": [{ "do": "assign", "target": "card_data.doubled", "args": { "from": "$event.n * 2" } }] }
        }
      }
    }
  },
  "steps": [
    {
      "event": { "node": "w", "name": "compute", "payload": { "n": 21 } },
      "expectPatch": { "rev": 1, "ops": [{ "op": "set", "path": "card_data.doubled", "value": 42 }], "completedWithinRun": [{ "kind": "assign", "node": "w", "target": "card_data.doubled", "value": 42 }] }
    }
  ]
}
