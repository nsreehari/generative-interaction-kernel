{
  "name": "graceful fallback: an unknown capability resolves without crashing",
  "description": "A node whose capability is not in the manifest resolves as a visible fallback node; a declared sibling does not.",
  "vocabulary": {
    "gik": "0.1",
    "type": "vocabulary",
    "payload": {
      "version": "fallback-demo/1.0",
      "expression": "jsonata",
      "namespaces": [],
      "capabilities": { "board": { "slots": ["children"] } }
    }
  },
  "program": {
    "gik": "0.1",
    "type": "program",
    "payload": {
      "vocabulary": "fallback-demo/1.0",
      "root": {
        "capability": "board",
        "id": "b",
        "edges": { "children": [{ "capability": "mystery-widget", "id": "m", "props": { "label": "?" } }] }
      }
    }
  },
  "expectInitialResolve": [
    { "id": "b", "fallback": false },
    { "id": "m", "fallback": true, "visible": true }
  ]
}
