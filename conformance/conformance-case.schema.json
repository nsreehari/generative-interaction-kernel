{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/gik/0.1/conformance-case.schema.json",
  "title": "GIK behavioral conformance case",
  "description": "A language-neutral kernel test: a program + optional seed state, driven by a sequence of events, with the exact patches and resolved-tree assertions any conforming kernel MUST produce. Vocabulary/program may be inline objects or `*Ref` paths (relative to the case file).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "vocabulary": { "type": "object", "description": "Inline vocabulary (enveloped or bare payload)." },
    "vocabularyRef": { "type": "string", "description": "Path to a vocabulary fixture, relative to the case file." },
    "program": { "type": "object", "description": "Inline program (enveloped or bare payload)." },
    "programRef": { "type": "string", "description": "Path to a program fixture, relative to the case file." },
    "seed": {
      "type": "array",
      "description": "Store ops applied before init(), e.g. fetched/computed state.",
      "items": { "$ref": "#/definitions/op" }
    },
    "orchestrator": {
      "type": "array",
      "description": "Deterministic, scripted Orchestrator responses. Each entry matches a deferred effect (invoke/route/request) and returns canned ops and/or follow-up events, settled inside the same dispatch. No clock, RNG, or IO — the runner uses these to exercise the effect seam reproducibly.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["on", "result"],
        "properties": {
          "on": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["invoke", "route", "request"] },
              "node": { "type": "string", "description": "Match only effects from this node." },
              "tool": { "type": "string", "description": "Match only invoke effects for this tool." }
            }
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ops": { "type": "array", "items": { "$ref": "#/definitions/op" } },
              "events": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["node", "name"],
                  "properties": {
                    "node": { "type": "string" },
                    "name": { "type": "string" },
                    "payload": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "expectInvalid": {
      "type": "boolean",
      "description": "If true, constructing the kernel (validate-before-commit) MUST throw; no steps are run."
    },
    "expectInitialResolve": {
      "type": "array",
      "description": "Assertions on the resolved tree after init(), before any event.",
      "items": { "$ref": "#/definitions/resolveExpectation" }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event"],
        "properties": {
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node", "name"],
            "properties": {
              "node": { "type": "string" },
              "name": { "type": "string" },
              "payload": { "type": "object" }
            }
          },
          "expectPatch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rev", "ops"],
            "properties": {
              "rev": { "type": "integer", "minimum": 0 },
              "ops": { "type": "array", "items": { "$ref": "#/definitions/op" } },
              "completedWithinRun": { "type": "array", "items": { "$ref": "#/definitions/completedWithinRun" } }
            }
          },
          "expectSettledPatch": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rev", "ops"],
            "properties": {
              "rev": { "type": "integer", "minimum": 0 },
              "ops": { "type": "array", "items": { "$ref": "#/definitions/op" } },
              "completedWithinRun": { "type": "array", "items": { "$ref": "#/definitions/completedWithinRun" } }
            }
          },
          "expectResolve": {
            "type": "array",
            "items": { "$ref": "#/definitions/resolveExpectation" }
          }
        }
      }
    }
  },
  "definitions": {
    "completedWithinRun": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "node", "target", "value"],
          "properties": {
            "kind": { "const": "assign" },
            "node": { "type": "string" },
            "target": { "type": "string" },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "node", "event"],
          "properties": {
            "kind": { "const": "emit" },
            "node": { "type": "string" },
            "event": {
              "type": "object",
              "additionalProperties": false,
              "required": ["node", "name"],
              "properties": {
                "node": { "type": "string" },
                "name": { "type": "string" },
                "payload": {},
                "actorId": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": { "enum": ["set", "merge", "remove"] },
        "path": { "type": "string" },
        "value": {}
      }
    },
    "resolveExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "visible": { "type": "boolean" },
        "fallback": { "type": "boolean" },
        "capability": { "type": "string" },
        "props": { "type": "object", "description": "Partial: only listed keys are asserted." }
      }
    }
  }
}
