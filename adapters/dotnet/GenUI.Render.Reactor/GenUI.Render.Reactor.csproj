<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The concrete WinUI/Reactor toolkit binding for the C# render adapter: it sets
    TView = Microsoft.UI.Reactor.Core.Element and adds a host window. This lives OUTSIDE the
    renderer-agnostic offline island (GenUI.Render / GenUI.Kernel are zero-NuGet, net10.0);
    only this project pulls in WinUI + Reactor and only this project needs a Windows TFM.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GenUI.Render.Reactor</RootNamespace>
    <StartupObject>GenUI.Render.Reactor.Host.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.11" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- The shared semantic theme roles (single source of truth for both adapters). Embedded so
       GenUITheme reads the exact same file the React adapter consumes. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\theme\roles.json">
      <LogicalName>GenUI.Render.Reactor.theme.roles.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- The renderer-agnostic core (which itself references the offline kernel). -->
  <ItemGroup>
    <ProjectReference Include="../GenUI.Render/GenUI.Render.csproj" />
  </ItemGroup>

  <!-- The AgentFace MCP transport wrapper (HttpListener over the transport-free McpServer). Lets the
       host expose the agent-authoring tools over HTTP, the .NET peer of the node host's /mcp route. -->
  <ItemGroup>
    <ProjectReference Include="../../../agentface/dotnet/GenUI.AgentFace.Http/GenUI.AgentFace.Http.csproj" />
  </ItemGroup>

  <!-- The HTTP/SSE transport server: binds a running bundle's GenUISession broker to a /gup endpoint
       so remote agents attach to the SAME shared kernel the window renders, over the GUP protocol. -->
  <ItemGroup>
    <ProjectReference Include="../GenUI.Transport.HttpSse/GenUI.Transport.HttpSse.csproj" />
  </ItemGroup>

</Project>
