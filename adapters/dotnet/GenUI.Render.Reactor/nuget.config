<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Scoped to this WinUI/Reactor binding: the renderer-agnostic core and the kernel stay
       zero-NuGet, but this project needs Reactor + Windows App SDK from nuget.org. Clearing
       inherited sources keeps restore reproducible regardless of machine-level config. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
