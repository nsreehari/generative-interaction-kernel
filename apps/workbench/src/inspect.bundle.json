{
  "manifest": {
    "gup": "0.1",
    "type": "manifest",
    "payload": {
      "version": "workbench-chrome/1.0",
      "expression": "jsonata",
      "namespaces": [
        "workbench",
        "inspect"
      ],
      "actions": [
        "assign",
        "derive",
        "emit",
        "invoke",
        "navigate",
        "confirm"
      ],
      "capabilities": {
        "panelGroup": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "select": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "change"
          ]
        },
        "field": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "input"
          ]
        },
        "facetList": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "regionEditor": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "edit"
          ]
        },
        "textarea": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "input"
          ]
        },
        "button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "press"
          ]
        },
        "note": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "stepList": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "tabBar": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "select"
          ]
        },
        "regionTable": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "codeBlock": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "traceList": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  },
  "document": {
    "gup": "0.1",
    "type": "document",
    "payload": {
      "root": {
        "capability": "panelGroup",
        "id": "inspect-root",
        "edges": {
          "on": {
            "snapshot": [
              {
                "do": "assign",
                "target": "inspect.presentationHead",
                "args": {
                  "from": "$event.presentationHead"
                }
              },
              {
                "do": "assign",
                "target": "inspect.regions",
                "args": {
                  "from": "$event.regions"
                }
              },
              {
                "do": "assign",
                "target": "inspect.documentJson",
                "args": {
                  "from": "$event.documentJson"
                }
              },
              {
                "do": "assign",
                "target": "inspect.treeJson",
                "args": {
                  "from": "$event.treeJson"
                }
              },
              {
                "do": "assign",
                "target": "inspect.traces",
                "args": {
                  "from": "$event.traces"
                }
              },
              {
                "do": "assign",
                "target": "inspect.patchLabel",
                "args": {
                  "from": "$event.patchLabel"
                }
              },
              {
                "do": "assign",
                "target": "inspect.exportJson",
                "args": {
                  "from": "$event.exportJson"
                }
              }
            ]
          },
          "children": [
            {
              "capability": "tabBar",
              "id": "inspect-tabs",
              "props": {
                "options": [
                  {
                    "value": "presentation",
                    "label": "Presentation DSL"
                  },
                  {
                    "value": "document",
                    "label": "UI DSL"
                  },
                  {
                    "value": "tree",
                    "label": "Resolved tree"
                  },
                  {
                    "value": "traces",
                    "label": "Traces"
                  },
                  {
                    "value": "export",
                    "label": "Export"
                  }
                ]
              },
              "edges": {
                "read": {
                  "active": "inspect.activeTab"
                },
                "on": {
                  "select": [
                    {
                      "do": "assign",
                      "target": "inspect.activeTab",
                      "args": {
                        "from": "$event.value"
                      }
                    }
                  ]
                }
              }
            },
            {
              "capability": "panelGroup",
              "id": "tab-presentation",
              "edges": {
                "gate": "inspect.activeTab = 'presentation'",
                "children": [
                  {
                    "capability": "regionTable",
                    "id": "inspect-regions",
                    "edges": {
                      "read": {
                        "head": "inspect.presentationHead",
                        "items": "inspect.regions"
                      }
                    }
                  }
                ]
              }
            },
            {
              "capability": "panelGroup",
              "id": "tab-document",
              "edges": {
                "gate": "inspect.activeTab = 'document'",
                "children": [
                  {
                    "capability": "codeBlock",
                    "id": "inspect-document",
                    "edges": {
                      "read": {
                        "code": "inspect.documentJson"
                      }
                    }
                  }
                ]
              }
            },
            {
              "capability": "panelGroup",
              "id": "tab-tree",
              "edges": {
                "gate": "inspect.activeTab = 'tree'",
                "children": [
                  {
                    "capability": "codeBlock",
                    "id": "inspect-tree",
                    "edges": {
                      "read": {
                        "code": "inspect.treeJson"
                      }
                    }
                  }
                ]
              }
            },
            {
              "capability": "panelGroup",
              "id": "tab-traces",
              "edges": {
                "gate": "inspect.activeTab = 'traces'",
                "children": [
                  {
                    "capability": "traceList",
                    "id": "inspect-traces",
                    "edges": {
                      "read": {
                        "label": "inspect.patchLabel",
                        "items": "inspect.traces"
                      }
                    }
                  }
                ]
              }
            },
            {
              "capability": "panelGroup",
              "id": "tab-export",
              "edges": {
                "gate": "inspect.activeTab = 'export'",
                "children": [
                  {
                    "capability": "codeBlock",
                    "id": "inspect-export",
                    "edges": {
                      "read": {
                        "code": "inspect.exportJson"
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    }
  },
  "state": {
    "inspect": {
      "activeTab": "presentation",
      "presentationHead": "",
      "regions": [],
      "documentJson": "",
      "treeJson": "",
      "traces": [],
      "patchLabel": "",
      "exportJson": ""
    }
  }
}
