{
  "gik": "0.1",
  "type": "scenario-blueprint",
  "payload": {
    "id": "portfolio-tracker-dynamic-ticker",
    "targetBlueprintId": "portfolio-tracker",
    "title": "Dynamic ticker injection",
    "pace": { "manualDurationMs": 60000, "autoDurationMs": 1600, "default": "auto" },
    "steps": [
      { "id": "act-01", "title": "Start with AAPL", "kind": "dispatch", "command": "setHoldings", "payload": { "holdings": [{ "ticker": "AAPL", "quantity": 8, "costBasis": 178 }] }, "actorRef": { "namespace": "portfolio", "kind": "actor", "id": "human-investor", "relation": "origin" } },
      { "id": "act-02", "title": "Inject holding:GOOG", "kind": "dispatch", "command": "upsertHolding", "payload": { "holding": { "ticker": "GOOG", "quantity": 4, "costBasis": 165 } }, "actorRef": { "namespace": "portfolio", "kind": "actor", "id": "human-investor", "relation": "origin" }, "focusRefs": [{ "namespace": "portfolio", "kind": "token", "id": "holding:GOOG", "relation": "affected" }] },
      { "id": "act-03", "title": "Remove holding:AAPL", "kind": "dispatch", "command": "removeHolding", "payload": { "ticker": "AAPL" }, "actorRef": { "namespace": "portfolio", "kind": "actor", "id": "human-investor", "relation": "origin" }, "focusRefs": [{ "namespace": "portfolio", "kind": "token", "id": "holding:AAPL", "relation": "affected" }] }
    ]
  }
}
