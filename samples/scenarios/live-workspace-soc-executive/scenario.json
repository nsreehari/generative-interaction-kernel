{
  "gik": "0.1",
  "type": "scenario-blueprint",
  "payload": {
    "id": "live-workspace-soc-executive",
    "targetBlueprintId": "live-workspace-soc",
    "title": "SOC executive walkthrough",
    "applicableContexts": ["war-room"],
    "pace": {
      "manualDurationMs": 120000,
      "autoDurationMs": 2000,
      "default": "auto"
    },
    "steps": [
      {
        "id": "frame-objective",
        "title": "Frame the protected business objective",
        "kind": "dispatch",
        "commands": ["establishIntent", "addConstraint"],
        "focusRefs": [
          { "namespace": "soc", "kind": "record", "id": "intent", "relation": "affected" },
          { "namespace": "soc", "kind": "record", "id": "constraints", "relation": "affected" }
        ],
        "waitAfterMs": 450
      },
      {
        "id": "govern-investigation",
        "title": "Govern the investigation and reject unsafe action",
        "kind": "dispatch",
        "commands": ["suggestExploration", "amendExploration", "replanExploration", "commitPartialFindings", "proposeDc01"],
        "focusRefs": [
          { "namespace": "soc", "kind": "record", "id": "exploration", "relation": "affected" },
          { "namespace": "soc", "kind": "record", "id": "proposal-dc01", "relation": "affected" }
        ],
        "waitAfterMs": 450
      },
      {
        "id": "prepare-response",
        "title": "Resolve the origin and prepare bounded containment",
        "kind": "dispatch",
        "commands": ["completeCorrelation", "proposeHostA", "reviseResponse", "calculateResponse", "recommendContainment"],
        "focusRefs": [
          { "namespace": "soc", "kind": "record", "id": "Host-A", "relation": "affected" },
          { "namespace": "soc", "kind": "record", "id": "rec-1", "relation": "produced" }
        ],
        "waitAfterMs": 450
      },
      { "id": "authorize", "title": "Commander reviews the consequential decision", "kind": "human-gate", "command": "authorizeContainment", "humanBoundary": { "namespace": "soc", "kind": "actor", "id": "human-priya", "relation": "authorized" } },
      { "id": "execute", "title": "Execute the authorized, reversible containment", "kind": "dispatch", "command": "executeContainment", "actorRef": { "namespace": "soc", "kind": "actor", "id": "agent-response", "relation": "origin" }, "waitAfterMs": 450 }
    ]
  }
}