{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "id": "portfolio-tracker",
      "capability": "portfolio:workspace",
      "props": { "title": "Portfolio tracker" },
      "edges": {
        "read": { "presentationContext": "portfolio.presentationContext" },
        "react": [{ "when": "control.presentationContext", "runInitially": true, "run": [{ "do": "emit", "event": "setPresentationContext" }] }],
        "on": {
          "setHoldings": [{ "do": "invoke", "args": { "tool": "setHoldings" } }],
          "upsertHolding": [{ "do": "invoke", "args": { "tool": "upsertHolding" } }],
          "removeHolding": [{ "do": "invoke", "args": { "tool": "removeHolding" } }],
          "refreshPrices": [{ "do": "invoke", "args": { "tool": "refreshPrices" } }],
          "requestIntelligence": [{ "do": "invoke", "args": { "tool": "requestIntelligence" } }],
          "calculateStrategies": [{ "do": "invoke", "args": { "tool": "calculateStrategies" } }],
          "setPresentationContext": [{ "do": "invoke", "args": { "tool": "setPresentationContext" } }]
        },
        "children": [
          { "id": "holdings", "capability": "ui:editable-table", "props": { "label": "holdings" }, "edges": { "readExpr": { "rows": "$each(portfolio.holdings, function($value) { $value })" }, "on": { "save": [{ "do": "invoke", "args": { "tool": "saveHoldings" } }] } } },
          { "id": "market-prices", "capability": "ui:table", "props": { "label": "market-prices" }, "edges": { "readExpr": { "rows": "$each(portfolio.quotes, function($value) { $value })" } } },
          { "id": "positions", "capability": "ui:table", "props": { "label": "positions" }, "edges": { "readExpr": { "rows": "$each(portfolio.positions, function($value) { $value })" } } },
          { "id": "summary", "capability": "portfolio:summary", "props": { "label": "summary" }, "edges": { "read": { "value": "portfolio.summary" } } },
          { "id": "portfolio-intelligence", "capability": "portfolio:narrative", "props": { "label": "portfolio-intelligence" }, "edges": { "read": { "value": "portfolio.intelligence" } } },
          { "id": "conservative-rebalance", "capability": "portfolio:narrative", "props": { "label": "conservative-rebalance" }, "edges": { "read": { "value": "portfolio.strategies.conservative" } } },
          { "id": "growth-rebalance", "capability": "portfolio:narrative", "props": { "label": "growth-rebalance" }, "edges": { "read": { "value": "portfolio.strategies.growth" } } },
          { "id": "rebalance-comparison", "capability": "portfolio:recommendation", "props": { "label": "rebalance-comparison" }, "edges": { "read": { "value": "portfolio.recommendation" }, "on": { "apply": [{ "do": "invoke", "args": { "tool": "applyRecommendation" } }] } } }
        ]
      }
    }
  }
}
