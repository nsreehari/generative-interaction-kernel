{
  "gik": "0.1",
  "type": "manifest",
  "payload": {
    "version": "genui-foundry-agent/1.0",
    "expression": "jsonata",
    "namespaces": ["agent"],
    "actions": ["assign", "invoke"],
    "capabilities": {
      "ui:screen": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:panel": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:col": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:row": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:heading": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:note": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:text": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:alert": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:field": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["input"]
      },
      "ui:select": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["change"]
      },
      "ui:button": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["press"]
      },
      "ui:markdown": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      }
    },
    "externals": {
      "projectionViews": {
        "ui": { "from": "floor" }
      }
    }
  }
}
