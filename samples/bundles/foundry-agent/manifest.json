{
  "gik": "0.1",
  "type": "manifest",
  "payload": {
    "version": "genui-foundry-agent/1.0",
    "expression": "jsonata",
    "namespaces": ["agent"],
    "actions": ["assign", "invoke"],
    "capabilities": {
      "ui:screen": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:panel": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:col": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:row": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:heading": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:note": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:text": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:alert": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:field": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["input"]
      },
      "agent:access-modal": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["accessResolved", "accessCleared"]
      },
      "agent:agent-selector": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["select"]
      },
      "agent:ask-page": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:button": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["press"]
      },
      "ui:markdown": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      }
    },
    "externals": {
      "projectionViews": {
        "ui": { "from": "floor" },
        "agent": { "from": "self" }
      },
      "effectHandlers": ["acceptFoundryAccess", "clearFoundryAccess", "signOut"],
      "services": {
        "assistant": {
          "kind": "foundry-agent",
          "version": "1",
          "operations": ["chat"],
          "config": {
            "endpoint": "https://sz-foundry-proxy.azurewebsites.net",
            "credentialRef": "foundry-agent/access-key"
          },
          "scope": "per-session"
        }
      }
    }
  }
}
