{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "capability": "ui:screen",
      "id": "foundry-agent-root",
      "props": {
        "title": "Foundry Agent",
        "subtitle": "Sign in with your access key, pick an agent, and start a conversation."
      },
      "edges": {
        "children": [
          {
            "capability": "ui:panel",
            "id": "agent-login",
            "props": { "title": "Sign in", "variant": "rail" },
            "edges": {
              "gate": "agent.stage = 'locked'",
              "children": [
                {
                  "capability": "agent:login",
                  "id": "agent-login-view",
                  "edges": {
                    "read": {
                      "key": "agent.key",
                      "agentName": "agent.agentName",
                      "authError": "agent.authError"
                    },
                    "on": {
                      "setKey": [
                        {
                          "do": "assign",
                          "target": "agent.key",
                          "args": { "from": "$event.value" }
                        }
                      ],
                      "setAgent": [
                        {
                          "do": "assign",
                          "target": "agent.agentName",
                          "args": { "from": "$event.value" }
                        }
                      ],
                      "verify": [
                        {
                          "do": "invoke",
                          "args": { "tool": "verifyKey" }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "capability": "ui:panel",
            "id": "agent-demo",
            "props": { "title": "Ask the agent", "variant": "detail" },
            "edges": {
              "gate": "agent.stage = 'unlocked'",
              "children": [
                {
                  "capability": "ui:alert",
                  "id": "agent-connected",
                  "props": { "label": "Connected to", "level": "good" },
                  "edges": {
                    "read": { "value": "agent.agentName" }
                  }
                },
                {
                  "capability": "ui:field",
                  "id": "agent-message-field",
                  "props": {
                    "label": "Message",
                    "placeholder": "Ask the agent something..."
                  },
                  "edges": {
                    "read": { "value": "agent.draft" },
                    "on": {
                      "input": [
                        {
                          "do": "assign",
                          "target": "agent.draft",
                          "args": { "from": "$event.value" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "agent:ask",
                  "id": "agent-ask-btn",
                  "props": { "label": "Ask" },
                  "edges": {
                    "read": { "replyRev": "agent.replyRev" },
                    "on": {
                      "ask": [
                        {
                          "do": "invoke",
                          "args": { "tool": "askAgent" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "ui:alert",
                  "id": "agent-request-error",
                  "props": { "label": "Something went wrong", "level": "error" },
                  "edges": {
                    "gate": "agent.error != ''",
                    "read": { "value": "agent.error" }
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "agent-asked-panel",
                  "props": { "title": "You asked", "variant": "inset" },
                  "edges": {
                    "gate": "agent.lastAsked != ''",
                    "children": [
                      {
                        "capability": "ui:note",
                        "id": "agent-asked-value",
                        "props": { "tone": "muted" },
                        "edges": {
                          "read": { "value": "agent.lastAsked" }
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "agent-reply-panel",
                  "props": { "title": "Reply", "variant": "inset" },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:note",
                        "id": "agent-reply-empty",
                        "props": {
                          "value": "Send a message to see the agent's reply.",
                          "tone": "muted"
                        },
                        "edges": {
                          "gate": "agent.reply = ''"
                        }
                      },
                      {
                        "capability": "ui:markdown",
                        "id": "agent-reply-value",
                        "edges": {
                          "gate": "agent.reply != ''",
                          "read": { "value": "agent.reply" }
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:button",
                  "id": "agent-signout-btn",
                  "props": { "label": "Sign out" },
                  "edges": {
                    "on": {
                      "press": [
                        {
                          "do": "invoke",
                          "args": { "tool": "signOut" }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
