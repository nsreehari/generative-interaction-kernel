{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "capability": "ui:screen",
      "id": "foundry-agent-root",
      "props": {
        "title": "Foundry Agent",
        "subtitle": "Sign in with your access key, pick an agent, and start a conversation."
      },
      "edges": {
        "children": [
          {
            "capability": "ui:panel",
            "id": "agent-login",
            "props": { "title": "Sign in", "variant": "rail" },
            "edges": {
              "gate": "agent.stage = 'locked'",
              "children": [
                {
                  "capability": "ui:note",
                  "id": "agent-login-note",
                  "props": {
                    "value": "Enter your access key, then choose an agent from the list or enter its id.",
                    "tone": "muted"
                  }
                },
                {
                  "capability": "ui:field",
                  "id": "agent-key-field",
                  "props": {
                    "label": "Access key",
                    "placeholder": "Paste your access key",
                    "secret": true
                  },
                  "edges": {
                    "read": { "value": "agent.key" },
                    "on": {
                      "input": [
                        {
                          "do": "assign",
                          "target": "agent.key",
                          "args": { "from": "$event.value" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "ui:button",
                  "id": "agent-list-btn",
                  "props": { "label": "List agents" },
                  "edges": {
                    "on": {
                      "press": [
                        {
                          "do": "invoke",
                          "args": { "tool": "listAgents" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "ui:select",
                  "id": "agent-id-select",
                  "props": { "label": "Agent ID" },
                  "edges": {
                    "gate": "$count(agent.agentOptions) > 0",
                    "read": { "value": "agent.agentId", "options": "agent.agentOptions" },
                    "on": {
                      "change": [
                        {
                          "do": "assign",
                          "target": "agent.agentId",
                          "args": { "from": "$event.value" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "ui:field",
                  "id": "agent-id-field",
                  "props": {
                    "label": "Agent ID",
                    "placeholder": "asst_..."
                  },
                  "edges": {
                    "gate": "$count(agent.agentOptions) = 0",
                    "read": { "value": "agent.agentId" },
                    "on": {
                      "input": [
                        {
                          "do": "assign",
                          "target": "agent.agentId",
                          "args": { "from": "$event.value" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "ui:alert",
                  "id": "agent-auth-error",
                  "props": { "label": "Couldn't sign in", "level": "error" },
                  "edges": {
                    "gate": "agent.authError != ''",
                    "read": { "value": "agent.authError" }
                  }
                },
                {
                  "capability": "ui:button",
                  "id": "agent-unlock-btn",
                  "props": { "label": "Continue", "tone": "primary" },
                  "edges": {
                    "on": {
                      "press": [
                        {
                          "do": "invoke",
                          "args": { "tool": "verifyKey" }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          },
          {
            "capability": "ui:panel",
            "id": "agent-demo",
            "props": { "title": "Ask the agent", "variant": "detail" },
            "edges": {
              "gate": "agent.stage = 'unlocked'",
              "children": [
                {
                  "capability": "ui:alert",
                  "id": "agent-connected",
                  "props": { "label": "Connected to", "level": "good" },
                  "edges": {
                    "read": { "value": "agent.agentName" }
                  }
                },
                {
                  "capability": "ui:field",
                  "id": "agent-message-field",
                  "props": {
                    "label": "Message",
                    "placeholder": "Ask the agent something..."
                  },
                  "edges": {
                    "read": { "value": "agent.draft" },
                    "on": {
                      "input": [
                        {
                          "do": "assign",
                          "target": "agent.draft",
                          "args": { "from": "$event.value" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "ui:button",
                  "id": "agent-ask-btn",
                  "props": { "label": "Ask", "tone": "primary" },
                  "edges": {
                    "on": {
                      "press": [
                        {
                          "do": "invoke",
                          "args": { "tool": "askAgent" }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "ui:alert",
                  "id": "agent-request-error",
                  "props": { "label": "Something went wrong", "level": "error" },
                  "edges": {
                    "gate": "agent.error != ''",
                    "read": { "value": "agent.error" }
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "agent-asked-panel",
                  "props": { "title": "You asked", "variant": "inset" },
                  "edges": {
                    "gate": "agent.lastAsked != ''",
                    "children": [
                      {
                        "capability": "ui:note",
                        "id": "agent-asked-value",
                        "props": { "tone": "muted" },
                        "edges": {
                          "read": { "value": "agent.lastAsked" }
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "agent-reply-panel",
                  "props": { "title": "Reply", "variant": "inset" },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:note",
                        "id": "agent-reply-empty",
                        "props": {
                          "value": "Send a message to see the agent's reply.",
                          "tone": "muted"
                        },
                        "edges": {
                          "gate": "agent.reply = ''"
                        }
                      },
                      {
                        "capability": "ui:markdown",
                        "id": "agent-reply-value",
                        "edges": {
                          "gate": "agent.reply != ''",
                          "read": { "value": "agent.reply" }
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:button",
                  "id": "agent-signout-btn",
                  "props": { "label": "Sign out" },
                  "edges": {
                    "on": {
                      "press": [
                        {
                          "do": "invoke",
                          "args": { "tool": "signOut" }
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
