{
  "gik": "0.1",
  "type": "manifest",
  "payload": {
    "version": "gik-manage-blueprints/1.0",
    "expression": "jsonata",
    "namespaces": ["manageBlueprints"],
    "actions": ["assign", "assignFrom", "derive", "invoke", "route", "confirm", "emit"],
    "capabilities": {
      "ui:screen": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:row": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:col": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:panel": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:text": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:note": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:narrative": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:metric": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:property": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:maplist": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:vocabulary": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:alert": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "manage-blueprints:profile-pipeline-canvas": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["selectNode", "selectEdge"] },
      "manage-blueprints:pipeline-runner": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "manage-blueprints:lowering-recipe-runner": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:list": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select"] },
      "ui:table": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["rowSelect"] },
      "ui:field": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["input"] },
      "ui:form": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["save"] },
      "ui:json-field": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["save"] },
      "ui:select": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["change"] },
      "ui:button": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["press"] },
      "ui:math-challenge": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["confirm", "cancel"] },
      "ui:textarea": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["input"] },
      "ui:tabBar": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select"] },
      "ui:codeBlock": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:embed": { "propsSchema": { "type": "object", "additionalProperties": true } }
    },
    "externals": {
      "projectionViews": {
        "ui": { "from": "floor" },
        "manage-blueprints": { "from": "self" }
      },
      "effectHandlers": [
        "listBlueprints",
        "getBlueprint",
        "selectLayer",
        "selectRecipe",
        "validateProfile",
        "refreshPreview",
        "seedLocalDraft",
        "saveBlueprint",
        "requestDeleteBlueprint",
        "cancelDeleteBlueprint",
        "deleteBlueprint"
      ]
    }
  }
}
