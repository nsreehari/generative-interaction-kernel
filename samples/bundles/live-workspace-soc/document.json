{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "capability": "soc:workspace",
      "id": "soc-workspace",
      "edges": {
        "on": {
          "establishIntent": [
            { "do": "invoke", "args": { "tool": "establishIntent" } }
          ],
          "addConstraint": [
            { "do": "invoke", "args": { "tool": "addConstraint" } }
          ],
          "suggestExploration": [
            { "do": "invoke", "args": { "tool": "suggestExploration" } }
          ],
          "amendExploration": [
            { "do": "invoke", "args": { "tool": "amendExploration" } }
          ],
          "replanExploration": [
            { "do": "invoke", "args": { "tool": "replanExploration" } }
          ],
          "commitPartialFindings": [
            { "do": "invoke", "args": { "tool": "commitPartialFindings" } }
          ],
          "proposeDc01": [
            { "do": "route", "args": { "tool": "evaluateDc01Policy", "to": "isolate:DC-01" } }
          ],
          "completeCorrelation": [
            { "do": "invoke", "args": { "tool": "completeCorrelation" } }
          ],
          "proposeHostA": [
            { "do": "invoke", "args": { "tool": "proposeHostA" } }
          ],
          "reviseResponse": [
            { "do": "invoke", "args": { "tool": "reviseResponse" } }
          ],
          "calculateResponse": [
            { "do": "invoke", "args": { "tool": "calculateResponse" } }
          ],
          "recommendContainment": [
            { "do": "invoke", "args": { "tool": "recommendContainment" } }
          ],
          "authorizeContainment": [
            { "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }
          ],
          "executeContainment": [
            { "do": "invoke", "args": { "tool": "executeContainment" } }
          ],
          "setPresentationContext": [
            { "do": "invoke", "args": { "tool": "setPresentationContext" } }
          ],
          "setAgentMode": [
            { "do": "invoke", "args": { "tool": "setAgentMode" } }
          ]
        },
        "read": {
          "incident": "soc.incident",
          "presentation": "soc.presentation",
          "stage": "soc.stage",
          "actors": "soc.actors",
          "agentProviders": "soc.agentProviders",
          "intent": "soc.intent",
          "constraints": "soc.constraints",
          "dataSources": "soc.dataSources",
          "explorations": "soc.explorations",
          "evidence": "soc.evidence",
          "correlations": "soc.correlations",
          "entities": "soc.entities",
          "hypothesis": "soc.hypothesis",
          "proposal": "soc.proposal",
          "recommendation": "soc.recommendation",
          "authorization": "soc.authorization",
          "journal": "soc.journal"
        },
        "children": [
          {
            "capability": "foundry:access-modal",
            "id": "foundry-access-gate-region",
            "props": { "proxyBaseUrl": "https://sz-foundry-proxy.azurewebsites.net" },
            "edges": {
              "read": { "required": "soc.foundry.required" },
              "on": {
                "accessResolved": [
                  { "do": "invoke", "args": { "tool": "acceptSocFoundryAccess" } }
                ],
                "accessCleared": [
                  { "do": "invoke", "args": { "tool": "clearSocFoundryAccess" } }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
