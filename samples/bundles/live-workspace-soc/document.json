{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "capability": "soc:workspace-shell",
      "id": "soc-workspace-shell",
      "edges": {
        "children": [
          {
            "capability": "soc:header",
            "id": "soc-header",
            "edges": {
              "read": { "incident": "soc.incident" }
            }
          },
          {
            "capability": "ui:embed",
            "id": "demo-runner-region",
            "props": { "app": "demo-runner", "unframed": true },
            "edges": { "gate": "demo.enabled = true" }
          },
          {
            "capability": "foundry:access-modal",
            "id": "foundry-access-gate-region",
            "props": { "proxyBaseUrl": "https://sz-foundry-proxy.azurewebsites.net" },
            "edges": {
              "read": { "required": "soc.foundry.required" },
              "on": {
                "accessResolved": [
                  { "do": "invoke", "args": { "tool": "acceptSocFoundryAccess" } }
                ],
                "accessCleared": [
                  { "do": "invoke", "args": { "tool": "clearSocFoundryAccess" } }
                ]
              }
            }
          },
          {
            "capability": "soc:workspace-body",
            "id": "soc-workspace",
            "edges": {
        "on": {
          "establishIntent": [
            { "do": "invoke", "args": { "tool": "establishIntent" } }
          ],
          "addConstraint": [
            { "do": "invoke", "args": { "tool": "addConstraint" } }
          ],
          "suggestExploration": [
            { "do": "invoke", "args": { "tool": "suggestExploration" } }
          ],
          "amendExploration": [
            { "do": "invoke", "args": { "tool": "amendExploration" } }
          ],
          "replanExploration": [
            { "do": "invoke", "args": { "tool": "replanExploration" } }
          ],
          "commitPartialFindings": [
            { "do": "invoke", "args": { "tool": "commitPartialFindings" } }
          ],
          "proposeDc01": [
            { "do": "route", "args": { "tool": "evaluateDc01Policy", "to": "isolate:DC-01" } }
          ],
          "completeCorrelation": [
            { "do": "invoke", "args": { "tool": "completeCorrelation" } }
          ],
          "proposeHostA": [
            { "do": "invoke", "args": { "tool": "proposeHostA" } }
          ],
          "reviseResponse": [
            { "do": "invoke", "args": { "tool": "reviseResponse" } }
          ],
          "calculateResponse": [
            { "do": "invoke", "args": { "tool": "calculateResponse" } }
          ],
          "recommendContainment": [
            { "do": "invoke", "args": { "tool": "recommendContainment" } }
          ],
          "authorizeContainment": [
            { "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }
          ],
          "executeContainment": [
            { "do": "invoke", "args": { "tool": "executeContainment" } }
          ],
          "setPresentationContext": [
            { "do": "invoke", "args": { "tool": "setPresentationContext" } }
          ],
          "setAgentMode": [
            { "do": "invoke", "args": { "tool": "setAgentMode" } }
          ],
          "reset": [
            { "do": "invoke", "args": { "tool": "resetScenario" } }
          ],
          "selectTimeline": [
            { "do": "assign", "target": "demo.selection", "args": { "from": "$event.selection" } }
          ],
          "clearTimelineSelection": [
            { "do": "assign", "target": "demo.selection", "args": { "value": null } }
          ],
          "selectJournal": [
            { "do": "assign", "target": "soc.ui.selectedJournalId", "args": { "from": "$event.id" } }
          ]
        },
        "react": [
          { "when": "demo.commands.establishIntent", "run": [{ "do": "emit", "event": "establishIntent" }] },
          { "when": "demo.commands.addConstraint", "run": [{ "do": "emit", "event": "addConstraint" }] },
          { "when": "demo.commands.suggestExploration", "run": [{ "do": "emit", "event": "suggestExploration" }] },
          { "when": "demo.commands.amendExploration", "run": [{ "do": "emit", "event": "amendExploration" }] },
          { "when": "demo.commands.replanExploration", "run": [{ "do": "emit", "event": "replanExploration" }] },
          { "when": "demo.commands.commitPartialFindings", "run": [{ "do": "emit", "event": "commitPartialFindings" }] },
          { "when": "demo.commands.proposeDc01", "run": [{ "do": "emit", "event": "proposeDc01" }] },
          { "when": "demo.commands.completeCorrelation", "run": [{ "do": "emit", "event": "completeCorrelation" }] },
          { "when": "demo.commands.proposeHostA", "run": [{ "do": "emit", "event": "proposeHostA" }] },
          { "when": "demo.commands.reviseResponse", "run": [{ "do": "emit", "event": "reviseResponse" }] },
          { "when": "demo.commands.calculateResponse", "run": [{ "do": "emit", "event": "calculateResponse" }] },
          { "when": "demo.commands.recommendContainment", "run": [{ "do": "emit", "event": "recommendContainment" }] },
          { "when": "demo.commands.executeContainment", "run": [{ "do": "emit", "event": "executeContainment" }] },
          { "when": "demo.commands.reset", "run": [{ "do": "emit", "event": "reset" }] }
        ],
        "children": [
          {
            "capability": "soc:substrate-chrome",
            "id": "soc-substrate-chrome",
            "edges": {
              "read": {
                "incident": "soc.incident",
                "presentation": "soc.presentation",
                "consolePlane": "soc.consolePlane"
              },
              "on": {
                "setPresentationContext": [
                  { "do": "invoke", "args": { "tool": "setPresentationContext" } }
                ],
                "setConsolePlane": [
                  { "do": "assign", "target": "soc.consolePlane", "args": { "from": "$event.plane" } }
                ]
              },
              "children": [
                {
                  "capability": "fluent:switch",
                  "id": "soc-inspector-mode",
                  "props": {
                    "offLabel": "Live inspector",
                    "onLabel": "Blueprint inspector",
                    "offValue": "runtime",
                    "onValue": "blueprint",
                    "ariaLabel": "Workspace inspector mode"
                  },
                  "edges": {
                    "read": { "value": "soc.consolePlane" },
                    "on": {
                      "toggle": [
                        { "do": "assign", "target": "soc.consolePlane", "args": { "from": "$event.value" } }
                      ]
                    }
                  }
                },
                {
                  "capability": "soc:blueprint-inspector",
                  "id": "soc-blueprint-inspector",
                  "edges": {
                    "gate": "soc.consolePlane = 'blueprint'",
                    "read": { "presentation": "soc.presentation" }
                  }
                },
                {
                  "capability": "soc:runtime-projection",
                  "id": "soc-runtime-projection",
                  "props": { "frame": "shared" },
                  "edges": {
                    "gate": "soc.consolePlane = 'runtime'",
                    "read": {
                      "presentation": "soc.presentation",
                      "frame": "soc.presentation.frame"
                    },
                    "children": [
                      {
                        "capability": "soc:viewpoint-header",
                        "id": "soc-viewpoint-header",
                        "edges": {
                          "read": { "presentation": "soc.presentation", "journal": "soc.journal", "facet": "soc.presentation.regionFacets.summary" }
                        }
                      },
                      {
                        "capability": "soc:presentation-layout",
                        "id": "soc-presentation-layout",
                        "edges": {
                          "read": {
                            "presentation": "soc.presentation",
                            "actors": "soc.actors",
                            "journal": "soc.journal",
                            "selectedJournalId": "soc.ui.selectedJournalId",
                            "demoEnabled": "demo.enabled",
                            "demoTimeline": "demo.timeline",
                            "demoSelection": "demo.selection"
                          },
                          "children": [
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-intent-surface",
                              "props": { "region": "intent", "title": "Investigation intent", "focusTargets": ["intent"] },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'intent').visible = true",
                                "read": { "facet": "soc.presentation.regionFacets.intent" },
                                "children": [
                                  {
                                    "capability": "soc:intent-region",
                                    "id": "soc-intent-region",
                                    "edges": { "read": { "intent": "soc.intent" } }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-constraints-surface",
                              "props": { "region": "constraints", "title": "Operating constraints", "focusTargets": ["constraints", "DC-01"] },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'constraints').visible = true",
                                "read": { "facet": "soc.presentation.regionFacets.constraints" },
                                "children": [
                                  {
                                    "capability": "soc:constraints-region",
                                    "id": "soc-constraints-region",
                                    "edges": { "read": { "constraints": "soc.constraints" } }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-hypothesis-surface",
                              "props": { "region": "hypothesis", "title": "Working hypothesis", "metricSuffix": "%", "focusTargets": ["hypothesis", "corr-1", "Host-A"] },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'hypothesis').visible = true",
                                "read": { "facet": "soc.presentation.regionFacets.hypothesis", "metricValue": "soc.hypothesis.confidence" },
                                "children": [
                                  {
                                    "capability": "soc:hypothesis-region",
                                    "id": "soc-hypothesis-region",
                                    "edges": { "read": { "hypothesis": "soc.hypothesis" } }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-exploration-surface",
                              "props": { "region": "exploration", "title": "Exploration" },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'exploration').visible = true",
                                "read": { "facet": "soc.presentation.regionFacets.exploration" },
                                "children": [
                                  {
                                    "capability": "soc:exploration-region",
                                    "id": "soc-exploration-region",
                                    "edges": { "read": { "explorations": "soc.explorations" } }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-evidence-surface",
                              "props": { "region": "evidence", "title": "Evidence" },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'evidence').visible = true",
                                "read": { "facet": "soc.presentation.regionFacets.evidence" },
                                "children": [
                                  {
                                    "capability": "soc:evidence-region",
                                    "id": "soc-evidence-region",
                                    "edges": { "read": { "evidence": "soc.evidence" } }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-agent-request-surface",
                              "props": { "region": "agent-request", "title": "Agent request" },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'agent-request').visible = true",
                                "readExpr": { "facet": "$lookup(soc.presentation.regionFacets, 'agent-request')" },
                                "children": [
                                  {
                                    "capability": "soc:agent-request-region",
                                    "id": "soc-agent-request-region",
                                    "edges": {
                                      "read": {
                                        "presentation": "soc.presentation",
                                        "actors": "soc.actors",
                                        "explorations": "soc.explorations",
                                        "proposal": "soc.proposal"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-response-surface",
                              "props": { "region": "response", "title": "Governed response", "focusTargets": ["proposal-dc01", "proposal-host-a", "rec-1", "authorization", "DC-01", "Host-A"] },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'response').visible = true",
                                "read": { "facet": "soc.presentation.regionFacets.response" },
                                "children": [
                                  {
                                    "capability": "soc:response-region",
                                    "id": "soc-response-region",
                                    "edges": { "read": { "proposal": "soc.proposal" } }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-authorization-surface",
                              "props": { "region": "authorization", "title": "Commander authority", "focusTargets": ["authorization", "rec-1", "Host-A"] },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'authorization').visible = true",
                                "read": { "facet": "soc.presentation.regionFacets.authorization" },
                                "children": [
                                  {
                                    "capability": "soc:authorization-region",
                                    "id": "soc-authorization-region",
                                    "edges": {
                                      "read": { "authorization": "soc.authorization" },
                                      "on": {
                                        "authorizeContainment": [
                                          { "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }
                                        ]
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "soc:region-surface",
                              "id": "soc-causal-record-surface",
                              "props": { "region": "causal-record", "title": "Relevant causal record" },
                              "edges": {
                                "gate": "$lookup(soc.presentation.regionFacets, 'causal-record').visible = true",
                                "readExpr": { "facet": "$lookup(soc.presentation.regionFacets, 'causal-record')" },
                                "children": [
                                  {
                                    "capability": "soc:causal-record-region",
                                    "id": "soc-causal-record-region"
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "capability": "soc:journal",
            "id": "soc-journal-region",
            "edges": {
              "read": {
                "incident": "soc.incident",
                "actors": "soc.actors",
                "journal": "soc.journal",
                "journalMode": "soc.ui.journalMode",
                "selectedJournalId": "soc.ui.selectedJournalId",
                "demoEnabled": "demo.enabled",
                "demoTimeline": "demo.timeline",
                "demoSelection": "demo.selection"
              },
              "on": {
                "setJournalMode": [
                  { "do": "assign", "target": "soc.ui.journalMode", "args": { "from": "$event.mode" } }
                ],
                "selectTimeline": [
                  { "do": "assign", "target": "demo.selection", "args": { "from": "$event.selection" } }
                ],
                "clearTimelineSelection": [
                  { "do": "assign", "target": "demo.selection", "args": { "value": null } }
                ],
                "selectJournal": [
                  { "do": "assign", "target": "soc.ui.selectedJournalId", "args": { "from": "$event.id" } }
                ]
              }
            }
          }
        ]
        }
          },
          {
            "capability": "soc:participants",
            "id": "soc-participants-region",
            "edges": {
              "read": {
                "actors": "soc.actors",
                "agentProviders": "soc.agentProviders",
                "authorization": "soc.authorization",
                "journal": "soc.journal",
                "demoSelection": "demo.selection",
                "selectedJournalId": "soc.ui.selectedJournalId",
                "expanded": "soc.ui.participantsExpanded"
              },
              "on": {
                "toggleDrawer": [
                  { "do": "assign", "target": "soc.ui.participantsExpanded", "args": { "from": "$event.expanded" } }
                ],
                "authorizeContainment": [
                  { "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }
                ]
              },
              "children": [
                {
                  "capability": "fluent:switch",
                  "id": "correlation-agent-provider-mode",
                  "props": {
                    "name": "agent-correlation",
                    "offLabel": "Mock",
                    "onLabel": "Live",
                    "offValue": "mock",
                    "onValue": "live",
                    "ariaLabel": "Correlation Agent provider mode"
                  },
                  "edges": {
                    "readExpr": { "value": "$lookup(soc.agentProviders, 'agent-correlation').mode" },
                    "on": { "toggle": [{ "do": "invoke", "args": { "tool": "setAgentMode" } }] }
                  }
                },
                {
                  "capability": "fluent:switch",
                  "id": "response-agent-provider-mode",
                  "props": {
                    "name": "agent-response",
                    "offLabel": "Mock",
                    "onLabel": "Live",
                    "offValue": "mock",
                    "onValue": "live",
                    "ariaLabel": "Response Agent provider mode"
                  },
                  "edges": {
                    "readExpr": { "value": "$lookup(soc.agentProviders, 'agent-response').mode" },
                    "on": { "toggle": [{ "do": "invoke", "args": { "tool": "setAgentMode" } }] }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
