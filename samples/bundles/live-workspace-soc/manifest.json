{
  "gik": "0.1",
  "type": "manifest",
  "payload": {
    "version": "live-workspace-soc/1.0",
    "expression": "jsonata",
    "namespaces": ["soc"],
    "contexts": ["demo"],
    "actions": ["assign", "derive", "emit", "invoke", "route", "confirm"],
    "config": { "proxyBase": "https://sz-foundry-proxy.azurewebsites.net" },
    "capabilities": {
      "foundry:access-modal": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["accessResolved", "accessCleared"]
      },
      "ui:embed": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "fluent:switch": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["toggle"]
      },
      "soc:workspace-shell": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "soc:header": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:participants": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"],
        "emits": ["toggleDrawer", "authorizeContainment"]
      },
      "soc:journal": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["setJournalMode", "selectTimeline", "clearTimelineSelection", "selectJournal"]
      },
      "soc:workspace-body": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"],
        "emits": [
          "establishIntent", "addConstraint", "suggestExploration", "amendExploration",
          "replanExploration", "commitPartialFindings", "proposeDc01", "completeCorrelation",
          "proposeHostA", "reviseResponse", "calculateResponse", "recommendContainment",
          "authorizeContainment", "executeContainment", "setPresentationContext", "setAgentMode", "reset",
          "selectTimeline", "clearTimelineSelection", "selectJournal"
        ]
      },
      "soc:substrate-chrome": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"],
        "emits": ["setPresentationContext", "setConsolePlane"]
      },
      "soc:blueprint-inspector": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:runtime-projection": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "soc:viewpoint-header": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:presentation-layout": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "soc:region-surface": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "soc:intent-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:constraints-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:hypothesis-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:exploration-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:evidence-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:agent-request-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:response-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "soc:authorization-region": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["authorizeContainment"]
      },
      "soc:causal-record-region": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      }
    },
    "externals": {
      "projectionViews": {
        "foundry": { "from": "foundry-agent", "use": ["access-modal"] },
        "fluent": { "from": "fluent", "use": ["switch"] },
        "ui": { "from": "floor", "use": ["embed"] },
        "soc": { "from": "self" }
      },
      "effectHandlers": [
        "establishIntent", "addConstraint", "suggestExploration", "amendExploration",
        "replanExploration", "commitPartialFindings", "evaluateDc01Policy", "completeCorrelation",
        "proposeHostA", "reviseResponse", "calculateResponse", "recommendContainment",
        "authorizeContainment", "setPresentationContext", "setAgentMode",
        "acceptSocFoundryAccess", "clearSocFoundryAccess", "executeContainment", "resetScenario"
      ]
    }
  }
}
