                            {
                              "capability": "ui:list",
                              "id": "agent-steps",
                              "props": {
                                "static": true,
                                "ordered": true,
                                "idKey": "index",
                                "primaryKey": "label",
                                "emptyText": "No steps."
                              },
                              "edges": {
                                "read": {
                                  "items": "workbench.agentPlan",
                                  "selectedId": "workbench.agentStep"
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "session-panel",
                        "props": {
                          "title": "Session"
