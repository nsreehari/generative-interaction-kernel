                              "edges": {
                                "on": {
                                  "press": [
                                    {
                                      "do": "assign",
                                      "target": "workbench.agentStepSeq",
                                      "args": {
                                        "from": "workbench.agentStepSeq + 1"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:note",
                              "id": "agent-label",
                              "edges": {
                                "read": {
                                  "value": "workbench.agentLabel"
