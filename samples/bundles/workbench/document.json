                                      "target": "workbench.agentRunning",
                                      "args": {
                                        "value": true
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:button",
                              "id": "agent-pause",
                              "props": {
                                "label": "⏸ Pause"
