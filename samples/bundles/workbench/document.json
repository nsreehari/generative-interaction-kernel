                                "on": {
                                  "input": [
                                    {
                                      "do": "assign",
                                      "target": "workbench.eventPayload",
                                      "args": {
                                        "from": "$event.value"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:button",
                              "id": "event-fire",
                              "props": {
                                "label": "Emit"
