                              "edges": {
                                "on": {
                                  "press": [
                                    {
                                      "do": "assign",
                                      "target": "workbench.fireSeq",
                                      "args": {
                                        "from": "workbench.fireSeq + 1"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:note",
                              "id": "event-error",
                              "props": {
                                "tone": "error"
                              },
                              "edges": {
                                "read": {
                                  "value": "workbench.eventError"
                                },
                                "gate": "workbench.eventError != ''"
                              }
                            }
                          ]
                        }
                      },
                      {
