                              "edges": {
                                "on": {
                                  "press": [
                                    {
                                      "do": "assign",
                                      "target": "workbench.agentRunning",
                                      "args": {
                                        "value": false
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:button",
                              "id": "agent-step",
                              "props": {
                                "label": "→ Step"
