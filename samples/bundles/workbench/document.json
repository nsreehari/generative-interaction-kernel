                                    {
                                      "do": "assign",
                                      "target": "workbench.eventName",
                                      "args": {
                                        "from": "$event.value"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:textarea",
                              "id": "event-payload",
                              "props": {
                                "label": "Payload (JSON)"
