                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:note",
                              "id": "import-error",
                              "props": {
                                "tone": "error"
                              },
                              "edges": {
                                "read": {
                                  "value": "workbench.importError"
                                },
                                "gate": "workbench.importError != ''"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          },
          {
            "capability": "wb:guestSurface",
            "id": "guest-root",
            "edges": {
              "read": {
                "interaction": "workbench.interaction",
                "subject": "workbench.subject",
                "surface": "workbench.surface",
                "device": "workbench.device",
                "space": "workbench.space",
                "attention": "workbench.attention",
                "expertise": "workbench.expertise",
                "edits": "workbench.edits",
                "fireSeq": "workbench.fireSeq",
                "eventNode": "workbench.eventNode",
                "eventName": "workbench.eventName",
                "eventPayload": "workbench.eventPayload",
                "importSeq": "workbench.importSeq",
                "importText": "workbench.importText",
                "agentRunning": "workbench.agentRunning",
                "agentStep": "workbench.agentStep",
                "agentStepSeq": "workbench.agentStepSeq",
                "agentLabel": "workbench.agentLabel"
              },
              "on": {
                "facetsComputed": [
                  {
                    "do": "assign",
                    "target": "workbench.facets",
                    "args": {
                      "from": "$event.facets"
                    }
                  }
                ],
                "regionsComputed": [
                  {
                    "do": "assign",
                    "target": "workbench.editRegions",
                    "args": {
                      "from": "$event.regions"
                    }
                  }
                ],
                "guestChanged": [
                  {
                    "do": "assign",
                    "target": "workbench.nodeIds",
                    "args": {
                      "from": "$event.nodeIds"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.eventNode",
                    "args": {
                      "value": ""
                    }
                  }
                ],
                "fireResult": [
                  {
                    "do": "assign",
                    "target": "workbench.eventError",
                    "args": {
                      "from": "$event.error"
                    }
                  }
                ],
                "importApply": [
                  {
                    "do": "assign",
                    "target": "workbench.interaction",
                    "args": {
                      "from": "$event.interaction"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.subject",
                    "args": {
                      "from": "$event.subject"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.surface",
                    "args": {
                      "from": "$event.surface"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.device",
                    "args": {
                      "from": "$event.device"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.space",
                    "args": {
                      "from": "$event.space"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.attention",
                    "args": {
                      "from": "$event.attention"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.expertise",
                    "args": {
                      "from": "$event.expertise"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.edits",
                    "args": {
                      "from": "$event.edits"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.importError",
                    "args": {
                      "value": ""
                    }
                  }
                ],
                "importResult": [
                  {
                    "do": "assign",
                    "target": "workbench.importError",
                    "args": {
                      "from": "$event.error"
                    }
                  }
                ],
                "agentAdvance": [
                  {
                    "do": "assign",
                    "target": "workbench.agentStep",
                    "args": {
                      "from": "$event.step"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.agentLabel",
                    "args": {
                      "from": "$event.label"
                    }
                  }
                ],
                "agentDone": [
                  {
                    "do": "assign",
                    "target": "workbench.agentRunning",
                    "args": {
                      "value": false
                    }
                  },
                  {
                    "do": "assign",
                    "target": "workbench.agentLabel",
                    "args": {
                      "value": "Tour complete · press Play to replay"
                    }
                  }
                ],
                "snapshot": [
                  {
                    "do": "assign",
                    "target": "inspect.presentationHead",
                    "args": {
                      "from": "$event.presentationHead"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "inspect.regions",
                    "args": {
                      "from": "$event.regions"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "inspect.documentJson",
                    "args": {
                      "from": "$event.documentJson"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "inspect.treeJson",
                    "args": {
                      "from": "$event.treeJson"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "inspect.traces",
                    "args": {
                      "from": "$event.traces"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "inspect.patchLabel",
                    "args": {
                      "from": "$event.patchLabel"
                    }
                  },
                  {
                    "do": "assign",
                    "target": "inspect.exportJson",
                    "args": {
                      "from": "$event.exportJson"
                    }
                  }
                ]
              }
            }
          },
          {
            "capability": "wb:artifacts",
            "id": "artifacts",
            "edges": {
              "children": [
                {
                  "capability": "wb:panelGroup",
                  "id": "inspect-root",
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:tabBar",
                        "id": "inspect-tabs",
                        "props": {
                          "options": [
                            {
                              "value": "presentation",
                              "label": "Presentation DSL"
                            },
                            {
                              "value": "document",
                              "label": "UI DSL"
                            },
                            {
                              "value": "tree",
                              "label": "Resolved tree"
                            },
                            {
                              "value": "traces",
                              "label": "Traces"
                            },
                            {
                              "value": "export",
                              "label": "Export"
                            }
                          ]
                        },
                        "edges": {
                          "read": {
                            "active": "inspect.activeTab"
                          },
                          "on": {
                            "select": [
                              {
                                "do": "assign",
                                "target": "inspect.activeTab",
                                "args": {
                                  "from": "$event.value"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "wb:panelGroup",
                        "id": "tab-presentation",
                        "edges": {
                          "gate": "inspect.activeTab = 'presentation'",
                          "children": [
                            {
                              "capability": "ui:note",
                              "id": "inspect-regions-head",
                              "props": {
                                "tone": "muted"
                              },
                              "edges": {
                                "read": {
                                  "value": "inspect.presentationHead"
                                }
                              }
                            },
                            {
                              "capability": "ui:table",
                              "id": "inspect-regions",
                              "props": {
                                "static": true,
                                "blankText": "—",
                                "columns": [
                                  {
                                    "key": "name",
                                    "label": "region"
                                  },
                                  {
                                    "key": "role",
                                    "label": "role"
                                  },
                                  {
                                    "key": "priority",
                                    "label": "priority",
                                    "classPrefix": "pri-"
                                  },
                                  {
                                    "key": "disclosure",
                                    "label": "disclosure"
                                  },
                                  {
                                    "key": "presentation",
                                    "label": "presentation"
                                  },
                                  {
                                    "key": "rationale",
                                    "label": "rationale"
                                  }
                                ]
                              },
                              "edges": {
                                "read": {
                                  "rows": "inspect.regions"
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "wb:panelGroup",
                        "id": "tab-document",
                        "edges": {
                          "gate": "inspect.activeTab = 'document'",
                          "children": [
                            {
                              "capability": "ui:codeBlock",
                              "id": "inspect-document",
                              "edges": {
                                "read": {
                                  "code": "inspect.documentJson"
                                }
                              }
