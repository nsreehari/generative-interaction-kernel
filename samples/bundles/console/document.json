{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "capability": "ui:screen",
      "id": "console-root",
      "props": {
        "title": "GenUI Profile Console",
          "subtitle": "Inspect repo samples, validate profile bundles, and save editable local drafts"
      },
      "edges": {
        "children": [
          {
            "capability": "ui:row",
            "id": "console-layout",
            "props": {
              "variant": "split"
            },
            "edges": {
              "children": [
                {
                  "capability": "ui:panel",
                  "id": "list-rail",
                  "props": {
                    "title": "Profiles",
                    "variant": "rail"
                  },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:note",
                        "id": "rail-note",
                        "props": {
                          "tone": "muted",
                          "value": "Repo sample profiles are read-only. Seed a local draft from any selection to save and edit browser-stored JSON bundles."
                        }
                      },
                      {
                        "capability": "ui:note",
                        "id": "catalog-status",
                        "props": {
                          "tone": "info"
                        },
                        "edges": {
                          "gate": "console.catalogStatus != ''",
                          "read": {
                            "value": "console.catalogStatus"
                          }
                        }
                      },
                      {
                        "capability": "ui:button",
                        "id": "create-local-profile",
                        "props": {
                          "label": "Add new local profile",
                          "tone": "primary"
                        },
                        "edges": {
                          "on": {
                            "press": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "seedLocalDraft"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:button",
                        "id": "sync-catalog",
                        "props": {
                          "label": "Refresh catalog"
                        },
                        "edges": {
                          "on": {
                            "press": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "syncCatalog"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:list",
                        "id": "profile-list",
                        "props": {
                          "idKey": "id",
                          "primaryKey": "id",
                          "badgeKey": "kind",
                          "valueKey": "version"
                        },
                        "edges": {
                          "read": {
                            "items": "console.profiles",
                            "selectedId": "console.selectedId"
                          },
                          "on": {
                            "select": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "loadProfile"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "detail",
                  "props": {
                    "title": "Profile",
                    "variant": "detail"
                  },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:panel",
                        "id": "empty-state",
                        "props": {
                          "variant": "tab"
                        },
                        "edges": {
                          "gate": "console.selectedId = ''",
                          "children": [
                            {
                              "capability": "ui:note",
                              "id": "empty-hint",
                              "props": {
                                "tone": "muted",
                                "value": "Select a profile on the left to inspect it, or create a new local profile draft to start editing immediately."
                              }
                            },
                            {
                              "capability": "ui:button",
                              "id": "empty-create-local-profile",
                              "props": {
                                "label": "Add new local profile",
                                "tone": "primary"
                              },
                              "edges": {
                                "on": {
                                  "press": [
                                    {
                                      "do": "invoke",
                                      "args": {
                                        "tool": "seedLocalDraft"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "detail-body",
                        "props": {
                          "variant": "detail-body"
                        },
                        "edges": {
                          "gate": "console.selectedId != ''",
                          "children": [
                            {
                              "capability": "ui:tabBar",
                              "id": "detail-tabs",
                              "props": {
                                "options": [
                                  { "value": "overview", "label": "Overview" },
                                  { "value": "validation", "label": "Validation" },
                                  { "value": "preview", "label": "Preview" },
                                  { "value": "artifacts", "label": "Artifacts" }
                                ]
                              },
                              "edges": {
                                "read": {
                                  "active": "console.tab"
                                },
                                "on": {
                                  "select": [
                                    {
                                      "do": "assign",
                                      "target": "console.tab",
                                      "args": {
                                        "from": "$event.value"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "overview-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'overview'",
                                "children": [
                                  {
                                    "capability": "ui:row",
                                    "id": "profile-summary",
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:metric",
                                          "id": "metric-id",
                                          "props": { "label": "Id" },
                                          "edges": { "read": { "value": "console.profile.id" } }
                                        },
                                        {
                                          "capability": "ui:metric",
                                          "id": "metric-kind",
                                          "props": { "label": "Kind" },
                                          "edges": { "read": { "value": "console.profile.kind" } }
                                        },
                                        {
                                          "capability": "ui:metric",
                                          "id": "metric-version",
                                          "props": { "label": "Version" },
                                          "edges": { "read": { "value": "console.profile.version" } }
                                        },
                                        {
                                          "capability": "ui:metric",
                                          "id": "metric-source-entry",
                                          "props": { "label": "Source" },
                                          "edges": { "read": { "value": "console.profile.source" } }
                                        },
                                        {
                                          "capability": "ui:metric",
                                          "id": "metric-readonly",
                                          "props": { "label": "Read-only" },
                                          "edges": { "read": { "value": "console.profile.readonly" } }
                                        },
                                        {
                                          "capability": "ui:metric",
                                          "id": "metric-layers",
                                          "props": { "label": "Layers" },
                                          "edges": { "read": { "value": "console.profile.layerCount" } }
                                        },
                                        {
                                          "capability": "ui:metric",
                                          "id": "metric-stages",
                                          "props": { "label": "Stages" },
                                          "edges": { "read": { "value": "console.profile.stageCount" } }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "pipeline-panel",
                                    "props": {
                                      "title": "Pipeline",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:row",
                                          "id": "pipeline-metrics",
                                          "edges": {
                                            "children": [
                                              {
                                                "capability": "ui:metric",
                                                "id": "metric-source",
                                                "props": { "label": "Source" },
                                                "edges": { "read": { "value": "console.profile.sourceKind" } }
                                              },
                                              {
                                                "capability": "ui:metric",
                                                "id": "metric-target",
                                                "props": { "label": "Target" },
                                                "edges": { "read": { "value": "console.profile.targetKind" } }
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "layers-panel",
                                    "props": {
                                      "title": "Layers",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:table",
                                          "id": "layers-table",
                                          "props": {
                                            "columns": ["id", "kind", "schema"],
                                            "emptyText": "No layers."
                                          },
                                          "edges": {
                                            "read": {
                                              "rows": "console.profile.layers"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "stages-panel",
                                    "props": {
                                      "title": "Stages",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:table",
                                          "id": "stages-table",
                                          "props": {
                                            "columns": ["id", "from", "to"],
                                            "emptyText": "No stages."
                                          },
                                          "edges": {
                                            "read": {
                                              "rows": "console.profile.stages"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "capabilities-panel",
                                    "props": {
                                      "title": "Runtime capabilities",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:table",
                                          "id": "capabilities-table",
                                          "props": {
                                            "columns": ["capability"],
                                            "emptyText": "No runtime capabilities."
                                          },
                                          "edges": {
                                            "read": {
                                              "rows": "console.profile.capabilities"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "validation-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'validation'",
                                "children": [
                                  {
                                    "capability": "ui:button",
                                    "id": "validate-btn",
                                    "props": {
                                      "label": "Re-run validation"
                                    },
                                    "edges": {
                                      "on": {
                                        "press": [
                                          {
                                            "do": "invoke",
                                            "args": {
                                              "tool": "validateProfile"
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "capability": "ui:metric",
                                    "id": "validation-status",
                                    "props": {
                                      "label": "Status"
                                    },
                                    "edges": {
                                      "read": {
                                        "value": "console.validation.status"
                                      }
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "validation-errors",
                                    "props": {
                                      "title": "Errors",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:codeBlock",
                                          "id": "validation-errors-code",
                                          "edges": {
                                            "read": {
                                              "code": "console.validation.errorsText"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "validation-warnings",
                                    "props": {
                                      "title": "Warnings",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:codeBlock",
                                          "id": "validation-warnings-code",
                                          "edges": {
                                            "read": {
                                              "code": "console.validation.warningsText"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "preview-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'preview'",
                                "children": [
                                  {
                                    "capability": "ui:panel",
                                    "id": "preview-controls",
                                    "props": {
                                      "title": "Preview inputs",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:select",
                                          "id": "preview-interaction",
                                          "props": {
                                            "label": "Interaction",
                                            "options": [
                                              { "value": "investigate", "label": "investigate" },
                                              { "value": "compare", "label": "compare" },
                                              { "value": "review", "label": "review" },
                                              { "value": "approve", "label": "approve" },
                                              { "value": "monitor", "label": "monitor" },
                                              { "value": "explore", "label": "explore" },
                                              { "value": "create", "label": "create" },
                                              { "value": "configure", "label": "configure" },
                                              { "value": "collaborate", "label": "collaborate" },
                                              { "value": "plan", "label": "plan" },
                                              { "value": "learn", "label": "learn" },
                                              { "value": "decide", "label": "decide" }
                                            ]
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.previewInteraction"
                                            },
                                            "on": {
                                              "change": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.previewInteraction",
                                                  "args": {
                                                    "from": "$event.value"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:field",
                                          "id": "preview-subject",
                                          "props": {
                                            "label": "Subject"
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.previewSubject"
                                            },
                                            "on": {
                                              "input": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.previewSubject",
                                                  "args": {
                                                    "from": "$event.value"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:select",
                                          "id": "preview-surface",
                                          "props": {
                                            "label": "Surface",
                                            "options": [
                                              { "value": "desktop", "label": "desktop" },
                                              { "value": "web", "label": "web" },
                                              { "value": "mobile", "label": "mobile" },
                                              { "value": "copilot", "label": "copilot" },
                                              { "value": "teams", "label": "teams" }
                                            ]
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.previewSurface"
                                            },
                                            "on": {
                                              "change": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.previewSurface",
                                                  "args": {
                                                    "from": "$event.value"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:button",
                                          "id": "preview-refresh",
                                          "props": {
                                            "label": "Rebuild preview",
                                            "tone": "primary"
                                          },
                                          "edges": {
                                            "on": {
                                              "press": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "refreshPreview"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:note",
                                    "id": "preview-error",
                                    "props": {
                                      "tone": "info"
                                    },
                                    "edges": {
                                      "gate": "console.previewError != ''",
                                      "read": {
                                        "value": "console.previewError"
                                      }
                                    }
                                  },
                                  {
                                    "capability": "ui:embed",
                                    "id": "preview-mount",
                                    "props": {
                                      "emptyText": "Nothing to preview yet."
                                    },
                                    "edges": {
                                      "read": {
                                        "bundle": "console.previewBundle"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "artifacts-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'artifacts'",
                                "children": [
                                  {
                                    "capability": "ui:panel",
                                    "id": "artifact-editor-panel",
                                    "props": {
                                      "title": "Local storage editor",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:note",
                                          "id": "artifact-editor-status",
                                          "props": {
                                            "tone": "info"
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.editor.status"
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:note",
                                          "id": "artifact-editor-error",
                                          "props": {
                                            "tone": "critical"
                                          },
                                          "edges": {
                                            "gate": "console.editor.error != ''",
                                            "read": {
                                              "value": "console.editor.error"
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:field",
                                          "id": "artifact-editor-id",
                                          "props": {
                                            "label": "Local profile id",
                                            "placeholder": "my-profile-local"
