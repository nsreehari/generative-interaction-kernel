                                            "read": {
                                              "code": "console.artifacts.profileText"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "artifact-recipes-panel",
                                    "props": {
                                      "title": "recipe artifacts",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:codeBlock",
                                          "id": "artifact-recipes-code",
                                          "edges": {
                                            "read": {
                                              "code": "console.artifacts.recipesText"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "artifact-resolved-panel",
                                    "props": {
                                      "title": "resolved chain",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:codeBlock",
                                          "id": "artifact-resolved-code",
                                          "edges": {
                                            "read": {
                                              "code": "console.artifacts.resolvedText"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "artifact-bundle-panel",
                                    "props": {
                                      "title": "stored bundle payload",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:codeBlock",
                                          "id": "artifact-bundle-code",
                                          "edges": {
                                            "read": {
                                              "code": "console.artifacts.bundleText"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
