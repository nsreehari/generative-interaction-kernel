{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "capability": "ui:screen",
      "id": "console-root",
      "props": {
        "title": "Blueprints",
        "subtitle": "Browse, inspect, and preview sample blueprints"
      },
      "edges": {
        "children": [
          {
            "capability": "ui:row",
            "id": "console-layout",
            "props": {
              "variant": "split"
            },
            "edges": {
              "children": [
                {
                  "capability": "ui:panel",
                  "id": "list-rail",
                  "props": {
                    "title": "Catalog",
                    "variant": "rail"
                  },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:note",
                        "id": "catalog-status",
                        "props": {
                          "tone": "info"
                        },
                        "edges": {
                          "gate": "console.catalogStatus != ''",
                          "read": {
                            "value": "console.catalogStatus"
                          }
                        }
                      },
                      {
                        "capability": "ui:button",
                        "id": "sync-catalog",
                        "props": {
                          "label": "Refresh catalog"
                        },
                        "edges": {
                          "on": {
                            "press": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "syncCatalog"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:list",
                        "id": "profile-list",
                        "props": {
                          "idKey": "id",
                          "primaryKey": "id",
                          "badgeKey": "access",
                          "valueKey": "version"
                        },
                        "edges": {
                          "read": {
                            "items": "console.profiles",
                            "selectedId": "console.selectedId"
                          },
                          "on": {
                            "select": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "loadProfile"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "detail",
                  "props": {
                    "title": "Selected Blueprint",
                    "variant": "detail"
                  },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:panel",
                        "id": "empty-state",
                        "props": {
                          "variant": "tab"
                        },
                        "edges": {
                          "gate": "console.selectedId = ''",
                          "children": [
                            {
                              "capability": "ui:note",
                              "id": "empty-hint",
                              "props": {
                                "tone": "muted",
                                "value": "Select a blueprint on the left to inspect its tiers and preview."
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "detail-body",
                        "props": {
                          "variant": "detail-body"
                        },
                        "edges": {
                          "gate": "console.selectedId != ''",
                          "children": [
                            {
                              "capability": "ui:tabBar",
                              "id": "detail-tabs",
                              "props": {
                                "options": [
                                  { "value": "overview", "label": "Overview" },
                                  { "value": "layers", "label": "Tiers" },
                                  { "value": "preview", "label": "Preview" }
                                ]
                              },
                              "edges": {
                                "read": {
                                  "active": "console.tab"
                                },
                                "on": {
                                  "select": [
                                    {
                                      "do": "assign",
                                      "target": "console.tab",
                                      "args": {
                                        "from": "$event.value"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "overview-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'overview'",
                                "children": [
                                  {
                                    "capability": "ui:panel",
                                    "id": "profile-orientation-panel",
                                    "props": {
                                      "title": "What this blueprint is",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:narrative",
                                          "id": "profile-orientation-summary",
                                          "props": {
                                            "emptyMessage": "Select a blueprint to see how it lowers a goal into a UI."
                                          },
                                          "edges": {
                                            "read": {
                                              "text": "console.profile.summary"
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:property",
                                          "id": "profile-orientation-legend",
                                          "props": { "label": "Pipeline" },
                                          "edges": { "read": { "value": "console.profile.legend" } }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "profile-summary-panel",
                                    "props": {
                                      "title": "Basic info",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:row",
                                          "id": "profile-summary",
                                          "edges": {
                                            "children": [
                                              {
                                                "capability": "ui:property",
                                                "id": "metric-profile-id",
                                                "props": { "label": "Blueprint id" },
                                                "edges": { "read": { "value": "console.profile.id" } }
                                              },
                                              {
                                                "capability": "ui:property",
                                                "id": "metric-kind",
                                                "props": { "label": "Kind" },
                                                "edges": { "read": { "value": "console.profile.kind" } }
                                              },
                                              {
                                                "capability": "ui:property",
                                                "id": "metric-version",
                                                "props": { "label": "Version" },
                                                "edges": { "read": { "value": "console.profile.version" } }
                                              },
                                              {
                                                "capability": "ui:metric",
                                                "id": "metric-layers",
                                                "props": { "label": "Tiers" },
                                                "edges": { "read": { "value": "console.profile.layerCount" } }
                                              },
                                              {
                                                "capability": "ui:metric",
                                                "id": "metric-recipes",
                                                "props": { "label": "Lowering recipes" },
                                                "edges": { "read": { "value": "console.profile.recipeCount" } }
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "pipeline-panel",
                                    "props": {
                                      "title": "Pipeline",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "console:profile-pipeline-canvas",
                                          "id": "profile-pipeline",
                                          "edges": {
                                            "read": {
                                              "stateKey": "console.profile.id",
                                              "nodes": "console.pipeline.nodes",
                                              "selectedNodeId": "console.selectedLayerId",
                                              "selectedEdgeId": "console.selectedRecipeId"
                                            },
                                            "on": {
                                              "selectNode": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.tab",
                                                  "args": {
                                                    "from": "$event.tab"
                                                  }
                                                },
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "selectLayer"
                                                  }
                                                }
                                              ],
                                              "selectEdge": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.tab",
                                                  "args": {
                                                    "from": "$event.tab"
                                                  }
                                                },
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "selectRecipe"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "layers-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'layers'",
                                "children": [
                                  {
                                    "capability": "ui:col",
                                    "id": "layers-layout",
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:panel",
                                          "id": "layers-list-panel",
                                          "props": {
                                            "title": "Tiers",
                                            "variant": "inset"
                                          },
                                          "edges": {
                                            "children": [
                                              {
                                                "capability": "ui:list",
                                                "id": "layers-list",
                                                "props": {
                                                  "idKey": "id",
                                                  "primaryKey": "id",
                                                  "secondaryKey": "roleLabel",
                                                  "valueKey": "schema"
                                                },
                                                "edges": {
                                                  "read": {
                                                    "items": "console.layers",
                                                    "selectedId": "console.selectedLayerId"
                                                  },
                                                  "on": {
                                                    "select": [
                                                      {
                                                        "do": "invoke",
                                                        "args": {
                                                          "tool": "selectLayer"
                                                        }
                                                      }
                                                    ]
                                                  }
                                                }
                                              }
                                            ]
                                          }
                                        },
                                        {
                                          "capability": "ui:col",
                                          "id": "layer-detail-col",
                                          "edges": {
                                            "children": [
                                              {
                                                "capability": "ui:panel",
                                                "id": "layer-detail-panel",
                                                "props": {
                                                  "title": "Selected tier",
                                                  "variant": "inset"
                                                },
                                                "edges": {
                                                  "children": [
                                                    {
                                                      "capability": "ui:row",
                                                      "id": "layer-detail-metrics",
                                                      "edges": {
                                                        "children": [
                                                          {
                                                            "capability": "ui:property",
                                                            "id": "layer-detail-kind",
                                                            "props": { "label": "Tier" },
                                                            "edges": { "read": { "value": "console.layerDetail.kind" } }
                                                          },
                                                          {
                                                            "capability": "ui:property",
                                                            "id": "layer-detail-stage",
                                                            "props": { "label": "Pipeline stage" },
                                                            "edges": { "read": { "value": "console.layerDetail.stageLabel" } }
                                                          }
                                                        ]
                                                      }
                                                    },
                                                    {
                                                      "capability": "ui:narrative",
                                                      "id": "layer-detail-role",
                                                      "props": {
                                                        "emptyMessage": "Select a tier to see what it represents."
                                                      },
                                                      "edges": {
                                                        "read": {
                                                          "text": "console.layerDetail.role"
                                                        }
                                                      }
                                                    }
                                                  ]
                                                }
                                              },
                                              {
                                                "capability": "ui:panel",
                                                "id": "layer-vocabulary-panel",
                                                "props": {
                                                  "title": "Vocabulary it speaks",
                                                  "variant": "inset"
                                                },
                                                "edges": {
                                                  "gate": "console.layerDetail.kind != ''",
                                                  "children": [
                                                    {
                                                      "capability": "ui:note",
                                                      "id": "layer-vocabulary-caption",
                                                      "props": { "value": "The closed set of terms this tier works with — every branch above is phrased in these words.", "tone": "muted" }
                                                    },
                                                    {
                                                      "capability": "ui:vocabulary",
                                                      "id": "layer-vocabulary",
                                                      "props": {
                                                        "emptyText": "This tier has no derived vocabulary."
                                                      },
                                                      "edges": {
                                                        "read": {
                                                          "groups": "console.layerDetail.vocabulary.groups"
                                                        }
                                                      }
                                                    }
                                                  ]
                                                }
                                              },
                                              {
                                                "capability": "ui:panel",
                                                "id": "layer-outgoing-recipe-header",
                                                "props": {
                                                  "title": "Lowers into the next tier",
                                                  "variant": "inset"
                                                },
                                                "edges": {
                                                  "gate": "console.layerDetail.outgoingRecipe.id != ''",
                                                  "children": [
                                                    {
                                                      "capability": "ui:row",
                                                      "id": "layer-outgoing-recipe-header-metrics",
                                                      "edges": {
                                                        "children": [
                                                          {
                                                            "capability": "ui:property",
                                                            "id": "layer-outgoing-recipe-kind",
                                                            "props": { "label": "Transformation" },
                                                            "edges": { "read": { "value": "console.layerDetail.outgoingRecipe.kindLabel" } }
                                                          },
                                                          {
                                                            "capability": "ui:property",
                                                            "id": "layer-outgoing-recipe-tagline",
                                                            "props": { "label": "In plain terms" },
                                                            "edges": { "read": { "value": "console.layerDetail.outgoingRecipe.tagline" } }
                                                          }
                                                        ]
                                                      }
                                                    },
                                                    {
                                                      "capability": "ui:narrative",
                                                      "id": "layer-outgoing-recipe-summary",
                                                      "props": {
                                                        "emptyMessage": "No lowering-recipe summary available."
                                                      },
                                                      "edges": {
                                                        "read": {
                                                          "text": "console.layerDetail.outgoingRecipe.purpose"
                                                        }
                                                      }
                                                    },
                                                    {
                                                      "capability": "ui:property",
                                                      "id": "layer-outgoing-recipe-container",
                                                      "props": { "label": "Everything sits inside" },
                                                      "edges": {
                                                        "gate": "console.layerDetail.outgoingRecipe.containerCapability != ''",
                                                        "read": { "value": "console.layerDetail.outgoingRecipe.containerCapability" }
                                                      }
                                                    },
                                                    {
                                                      "capability": "ui:note",
                                                      "id": "layer-outgoing-recipe-region-caption",
                                                      "props": { "value": "How each region inside the result is handled by this lowering:", "tone": "muted" }
                                                    },
                                                    {
                                                      "capability": "ui:maplist",
                                                      "id": "layer-outgoing-recipe-region-map",
                                                      "props": {
                                                        "emptyText": "No per-region rules authored."
                                                      },
                                                      "edges": {
                                                        "read": {
                                                          "fromLabel": "console.layerDetail.outgoingRecipe.regionRuleFromLabel",
                                                          "toLabel": "console.layerDetail.outgoingRecipe.regionRuleToLabel",
                                                          "rows": "console.layerDetail.outgoingRecipe.regionRuleMappings"
                                                        }
                                                      }
                                                    }
                                                  ]
                                                }
                                              },
                                              {
                                                "capability": "ui:panel",
                                                "id": "layer-compute-panel",
                                                "props": {
                                                  "title": "Watch it lower — run this tier",
                                                  "variant": "inset"
                                                },
                                                "edges": {
                                                  "gate": "console.layerDetail.outgoingRecipe.id != ''",
                                                  "children": [
                                                    {
                                                      "capability": "ui:note",
                                                      "id": "layer-compute-caption",
                                                      "props": { "value": "Pick an interaction goal and see exactly what this tier produces when the live blueprint lowers it into the next stage.", "tone": "muted" }
                                                    },
                                                    {
                                                      "capability": "console:lowering-recipe-runner",
                                                      "id": "layer-compute-runner",
                                                      "edges": {
                                                        "read": {
                                                          "bundleText": "console.artifacts.bundleText",
                                                          "layerId": "console.selectedLayerId",
                                                          "seeds": "console.layerDetail.seeds",
                                                          "subject": "console.sourceInput.subject",
                                                          "surface": "console.previewContext.surface"
                                                        }
                                                      }
                                                    }
                                                  ]
                                                }
                                              },
                                              {
                                                "capability": "ui:panel",
                                                "id": "terminal-runtime-components-panel",
                                                "props": {
                                                  "title": "How each region is handled",
                                                  "variant": "inset"
                                                },
                                                "edges": {
                                                  "gate": "console.layerDetail.outgoingRecipe.id = '' and console.layerDetail.incomingRecipe.id != ''",
                                                  "children": [
                                                    {
                                                      "capability": "ui:property",
                                                      "id": "terminal-runtime-container-capability",
                                                      "props": { "label": "Everything sits inside" },
                                                      "edges": {
                                                        "gate": "console.layerDetail.incomingRecipe.containerCapability != ''",
                                                        "read": { "value": "console.layerDetail.incomingRecipe.containerCapability" }
                                                      }
                                                    },
                                                    {
                                                      "capability": "ui:note",
                                                      "id": "terminal-runtime-map-caption",
                                                      "props": { "value": "This is a terminal tier. Each region that reaches it is bound by these rules:", "tone": "muted" }
                                                    },
                                                    {
                                                      "capability": "ui:maplist",
                                                      "id": "terminal-runtime-components-map",
                                                      "props": {
                                                        "emptyText": "No incoming rules derived."
                                                      },
                                                      "edges": {
                                                        "read": {
                                                          "fromLabel": "console.layerDetail.incomingRecipe.regionRuleFromLabel",
                                                          "toLabel": "console.layerDetail.incomingRecipe.regionRuleToLabel",
                                                          "rows": "console.layerDetail.incomingRecipe.regionRuleMappings"
                                                        }
                                                      }
                                                    }
                                                  ]
                                                }
                                              }
                                            ]
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "preview-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'preview'",
                                "children": [
                                  {
                                    "capability": "ui:panel",
                                    "id": "preview-panel",
                                    "props": {
                                      "title": "Preview",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:form",
                                          "id": "source-input-form",
                                          "props": {
                                            "title": "Tier inputs",
                                            "saveLabel": "Apply & refresh",
                                            "discardLabel": "Reset"
                                          },
                                          "edges": {
                                            "read": {
                                              "fields": "console.sourceInputForm",
                                              "value": "console.sourceInput"
                                            },
                                            "on": {
                                              "save": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.sourceInput",
                                                  "args": {
                                                    "from": "$event.values"
                                                  }
                                                },
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "refreshPreview"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:form",
                                          "id": "preview-ctx-form",
                                          "props": {
                                            "title": "Context params",
                                            "saveLabel": "Apply & refresh",
                                            "discardLabel": "Reset"
                                          },
                                          "edges": {
                                            "read": {
                                              "fields": "console.previewContextForm",
                                              "value": "console.previewContext"
                                            },
                                            "on": {
                                              "save": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.previewContext",
                                                  "args": {
                                                    "from": "$event.values"
                                                  }
                                                },
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "refreshPreview"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:panel",
                                          "id": "preview-waterfall-panel",
                                          "props": {
                                            "title": "Watch it lower — stage by stage",
                                            "variant": "inset"
                                          },
                                          "edges": {
                                            "children": [
                                              {
                                                "capability": "console:pipeline-runner",
                                                "id": "preview-pipeline-runner",
                                                "edges": {
                                                  "read": {
                                                    "bundleText": "console.artifacts.bundleText",
                                                    "seed": "console.sourceInput",
                                                    "ctx": "console.previewContext"
                                                  }
                                                }
                                              }
                                            ]
                                          }
                                        },
                                        {
                                          "capability": "ui:note",
                                          "id": "preview-error",
                                          "props": {
                                            "tone": "info"
                                          },
                                          "edges": {
                                            "gate": "console.previewError != ''",
                                            "read": {
                                              "value": "console.previewError"
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:embed",
                                          "id": "preview-mount",
                                          "props": {
                                            "emptyText": "Nothing to preview yet."
                                          },
                                          "edges": {
                                            "read": {
                                              "bundle": "console.previewBundle"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "detail-footer",
                              "props": {
                                "variant": "footer"
                              },
                              "edges": {
                                "children": [
                                  {
                                    "capability": "ui:row",
                                    "id": "detail-footer-row",
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:alert",
                                          "id": "validation-status",
                                          "props": {
                                            "label": "Validation"
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.validation.summary",
                                              "level": "console.validation.level"
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:button",
                                          "id": "validate-btn",
                                          "props": {
                                            "label": "Re-run validation"
                                          },
                                          "edges": {
                                            "on": {
                                              "press": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "validateProfile"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}
