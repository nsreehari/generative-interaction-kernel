                                          "edges": {
                                            "read": {
                                              "value": "console.editor.id"
                                            },
                                            "on": {
                                              "input": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.editor.id",
                                                  "args": {
                                                    "from": "$event.value"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:button",
                                          "id": "artifact-seed-draft",
                                          "props": {
                                            "label": "Add new local profile from selection"
                                          },
                                          "edges": {
                                            "on": {
                                              "press": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "seedLocalDraft"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:textarea",
                                          "id": "artifact-editor-bundle",
                                          "props": {
                                            "label": "Stored profile bundle JSON",
                                            "placeholder": "{\n  \"format\": \"gik-profile-bundle/1\",\n  ...\n}"
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.editor.bundleText"
                                            },
                                            "on": {
                                              "input": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.editor.bundleText",
                                                  "args": {
                                                    "from": "$event.value"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:button",
                                          "id": "artifact-save-local",
                                          "props": {
                                            "label": "Save local profile",
                                            "tone": "primary"
