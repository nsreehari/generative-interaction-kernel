{
  "gik": "0.1",
  "type": "document",
  "payload": {
    "root": {
      "capability": "ui:screen",
      "id": "console-root",
      "props": {
        "title": "GenUI Profile Console",
        "subtitle": "Author, validate, preview, and promote GenUI profiles"
      },
      "edges": {
        "children": [
          {
            "capability": "ui:row",
            "id": "console-layout",
            "props": {
              "variant": "split"
            },
            "edges": {
              "children": [
                {
                  "capability": "ui:panel",
                  "id": "list-rail",
                  "props": {
                    "title": "Profiles",
                    "variant": "rail"
                  },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:list",
                        "id": "profile-list",
                        "props": {
                          "idKey": "id",
                          "primaryKey": "name",
                          "badgeKey": "status",
                          "valueKey": "version"
                        },
                        "edges": {
                          "read": {
                            "items": "console.profiles",
                            "selectedId": "console.selectedId"
                          },
                          "on": {
                            "select": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "loadProfile"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "create-panel",
                        "props": {
                          "title": "New profile",
                          "variant": "inset"
                        },
                        "edges": {
                          "children": [
                            {
                              "capability": "ui:field",
                              "id": "new-name",
                              "props": {
                                "label": "Name",
                                "placeholder": "e.g. Support Triage"
                              },
                              "edges": {
                                "read": {
                                  "value": "console.newName"
                                },
                                "on": {
                                  "input": [
                                    {
                                      "do": "assign",
                                      "target": "console.newName",
                                      "args": {
                                        "from": "$event.value"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:button",
                              "id": "create-btn",
                              "props": {
                                "label": "Create profile",
                                "tone": "primary"
                              },
                              "edges": {
                                "on": {
                                  "press": [
                                    {
                                      "do": "invoke",
                                      "args": {
                                        "tool": "createProfile"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "detail",
                  "props": {
                    "title": "Editor",
                    "variant": "detail"
                  },
                  "edges": {
                    "children": [
                      {
                        "capability": "ui:panel",
                        "id": "empty-state",
                        "props": {
                          "variant": "tab"
                        },
                        "edges": {
                          "gate": "console.selectedId = ''",
                          "children": [
                            {
                              "capability": "ui:note",
                              "id": "empty-hint",
                              "props": {
                                "tone": "muted",
                                "value": "Select a profile on the left, or create one — meanwhile, here's a scratch Playground."
                              }
                            },
                            {
                              "capability": "ui:embed",
                              "id": "scratch-playground",
                              "props": {
                                "app": "playground",
                                "emptyText": "Playground app not registered."
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "detail-body",
                        "props": {
                          "variant": "detail-body"
                        },
                        "edges": {
                          "gate": "console.selectedId != ''",
                          "children": [
                            {
                              "capability": "ui:tabBar",
                              "id": "detail-tabs",
                              "props": {
                                "options": [
                                  {
                                    "value": "editor",
                                    "label": "Editor"
                                  },
                                  {
                                    "value": "validation",
                                    "label": "Validation"
                                  },
                                  {
                                    "value": "preview",
                                    "label": "Preview"
                                  },
                                  {
                                    "value": "playground",
                                    "label": "Playground"
                                  },
                                  {
                                    "value": "versions",
                                    "label": "Versions"
                                  }
                                ]
                              },
                              "edges": {
                                "read": {
                                  "active": "console.tab"
                                },
                                "on": {
                                  "select": [
                                    {
                                      "do": "assign",
                                      "target": "console.tab",
                                      "args": {
                                        "from": "$event.value"
                                      }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "editor-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'editor'",
                                "children": [
                                  {
                                    "capability": "ui:field",
                                    "id": "draft-name",
                                    "props": {
                                      "label": "Name"
                                    },
                                    "edges": {
                                      "read": {
                                        "value": "console.draft.name"
                                      },
                                      "on": {
                                        "input": [
                                          {
                                            "do": "assign",
                                            "target": "console.draft.name",
                                            "args": {
                                              "from": "$event.value"
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "capability": "ui:textarea",
                                    "id": "draft-description",
                                    "props": {
                                      "label": "Description"
                                    },
                                    "edges": {
                                      "read": {
                                        "value": "console.draft.description"
                                      },
                                      "on": {
                                        "input": [
                                          {
                                            "do": "assign",
                                            "target": "console.draft.description",
                                            "args": {
                                              "from": "$event.value"
                                            }
                                          }
                                        ]
                                      }
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "cap-panel",
                                    "props": {
                                      "title": "Capabilities",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:chips",
                                          "id": "cap-editor",
                                          "props": {
                                            "emptyText": "No capabilities yet."
                                          },
                                          "edges": {
                                            "read": {
                                              "items": "console.draft.capabilities"
                                            },
                                            "on": {
                                              "remove": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "removeCapability"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:field",
                                          "id": "new-cap",
                                          "props": {
                                            "label": "Add capability",
                                            "placeholder": "e.g. ticketList"
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.newCapName"
                                            },
                                            "on": {
                                              "input": [
                                                {
                                                  "do": "assign",
                                                  "target": "console.newCapName",
                                                  "args": {
                                                    "from": "$event.value"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:button",
                                          "id": "add-cap-btn",
                                          "props": {
                                            "label": "Add",
                                            "tone": "default"
                                          },
                                          "edges": {
                                            "on": {
                                              "press": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "addCapability"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "editor-actions",
                                    "props": {
                                      "variant": "actions"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:button",
                                          "id": "save-btn",
                                          "props": {
                                            "label": "Save draft",
                                            "tone": "default"
                                          },
                                          "edges": {
                                            "on": {
                                              "press": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "saveDraft"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:button",
                                          "id": "validate-btn",
                                          "props": {
                                            "label": "Validate",
                                            "tone": "default"
                                          },
                                          "edges": {
                                            "on": {
                                              "press": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "validateProfile"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        },
                                        {
                                          "capability": "ui:button",
                                          "id": "promote-btn",
                                          "props": {
                                            "label": "Promote to active",
                                            "tone": "primary"
                                          },
                                          "edges": {
                                            "on": {
                                              "press": [
                                                {
                                                  "do": "invoke",
                                                  "args": {
                                                    "tool": "promoteProfile"
                                                  }
                                                }
                                              ]
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "validation-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'validation'",
                                "children": [
                                  {
                                    "capability": "ui:panel",
                                    "id": "validation-status",
                                    "props": {
                                      "title": "Status",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:text",
                                          "id": "validation-status-text",
                                          "props": {
                                            "variant": "code"
                                          },
                                          "edges": {
                                            "read": {
                                              "value": "console.validation.status"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "validation-errors",
                                    "props": {
                                      "title": "Errors",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:list",
                                          "id": "validation-error-list",
                                          "props": {
                                            "emptyText": "No errors."
                                          },
                                          "edges": {
                                            "read": {
                                              "items": "console.validation.errors"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  },
                                  {
                                    "capability": "ui:panel",
                                    "id": "validation-warnings",
                                    "props": {
                                      "title": "Warnings",
                                      "variant": "inset"
                                    },
                                    "edges": {
                                      "children": [
                                        {
                                          "capability": "ui:list",
                                          "id": "validation-warning-list",
                                          "props": {
                                            "emptyText": "No warnings."
                                          },
                                          "edges": {
                                            "read": {
                                              "items": "console.validation.warnings"
                                            }
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "preview-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'preview'",
                                "children": [
                                  {
                                    "capability": "ui:embed",
                                    "id": "preview-mount",
                                    "props": {
                                      "emptyText": "Nothing to preview yet."
                                    },
                                    "edges": {
                                      "read": {
                                        "bundle": "console.previewBundle"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "playground-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'playground'",
                                "children": [
                                  {
                                    "capability": "ui:embed",
                                    "id": "playground-mount",
                                    "props": {
                                      "emptyText": "Nothing to play with yet."
                                    },
                                    "edges": {
                                      "read": {
                                        "bundle": "console.playgroundBundle"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            {
                              "capability": "ui:panel",
                              "id": "versions-tab",
                              "props": {
                                "variant": "tab"
                              },
                              "edges": {
                                "gate": "console.tab = 'versions'",
                                "children": [
                                  {
                                    "capability": "ui:table",
                                    "id": "version-list",
                                    "props": {
                                      "idKey": "version",
                                      "emptyText": "No versions captured yet.",
                                      "columns": [
                                        {
                                          "key": "version",
                                          "label": "Version"
                                        },
                                        {
                                          "key": "status",
                                          "label": "Status"
                                        },
                                        {
                                          "key": "capabilityCount",
                                          "label": "Capabilities"
                                        },
                                        {
                                          "key": "capturedAt",
                                          "label": "Captured"
                                        }
                                      ]
                                    },
                                    "edges": {
                                      "read": {
                                        "rows": "console.versions"
                                      }
                                    }
                                  }
                                ]
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:note",
                        "id": "toast",
                        "props": {
                          "tone": "info"
                        },
                        "edges": {
                          "read": {
                            "value": "console.toast"
                          },
                          "gate": "console.toast != ''"
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "manifest": "genui-console/1.0"
  }
}
