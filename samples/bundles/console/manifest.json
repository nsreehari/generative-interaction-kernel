{
  "gik": "0.1",
  "type": "manifest",
  "payload": {
    "version": "genui-console/2.0",
    "expression": "jsonata",
    "namespaces": ["console"],
    "actions": ["assign", "assignFrom", "derive", "invoke", "route", "confirm", "emit"],
    "capabilities": {
      "ui:screen": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:row": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:col": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:panel": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
      "ui:text": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:note": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:metric": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:list": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select"] },
      "ui:table": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["rowSelect"] },
      "ui:field": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["input"] },
      "ui:select": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["change"] },
      "ui:button": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["press"] },
      "ui:tabBar": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select"] },
      "ui:codeBlock": { "propsSchema": { "type": "object", "additionalProperties": true } },
      "ui:embed": { "propsSchema": { "type": "object", "additionalProperties": true } }
    },
    "externals": {
      "projectionViews": {
        "ui": { "from": "floor" }
      },
      "effectHandlers": ["syncCatalog", "loadProfile", "validateProfile", "refreshPreview"]
    }
  }
}
