{
  "gik": "0.1",
  "type": "program",
  "payload": {
    "graph": {
      "nodes": [
        {
          "id": "profile-full",
          "inputs": { "first": "demo.formFirst", "last": "demo.formLast" },
          "outputs": { "full": "demo.formFull" },
          "operation": { "kind": "compute", "expression": "$trim($inputs.first & ' ' & $inputs.last)" }
        },
        {
          "id": "profile-ready",
          "inputs": { "first": "demo.formFirst", "last": "demo.formLast", "consent": "demo.consent" },
          "outputs": { "ready": "demo.formReady" },
          "operation": { "kind": "compute", "expression": "$inputs.first != '' and $inputs.last != '' and ($inputs.consent = true or $inputs.consent = 'true')" }
        },
        {
          "id": "profile-label",
          "inputs": { "ready": "demo.formReady" },
          "outputs": { "label": "demo.submitLabel" },
          "operation": { "kind": "compute", "expression": "$inputs.ready ? 'Create profile' : 'Complete required fields'" }
        },
        {
          "id": "metrics-total",
          "inputs": { "approved": "demo.metricsApproved", "pending": "demo.metricsPending" },
          "outputs": { "total": "demo.metricsTotal" },
          "operation": { "kind": "compute", "expression": "$number($inputs.approved) + $number($inputs.pending)" }
        },
        {
          "id": "metrics-remaining",
          "inputs": { "limit": "demo.metricsLimit", "total": "demo.metricsTotal" },
          "outputs": { "remaining": "demo.metricsRemaining" },
          "operation": { "kind": "compute", "expression": "$number($inputs.limit) - $inputs.total" }
        },
        {
          "id": "metrics-over-limit",
          "inputs": { "limit": "demo.metricsLimit", "total": "demo.metricsTotal" },
          "outputs": { "overLimit": "demo.metricsOverLimit" },
          "operation": { "kind": "compute", "expression": "$inputs.total > $number($inputs.limit)" }
        },
        {
          "id": "metrics-banner",
          "inputs": { "overLimit": "demo.metricsOverLimit" },
          "outputs": { "banner": "demo.metricsBanner" },
          "operation": { "kind": "compute", "expression": "$inputs.overLimit ? 'Capacity exceeded' : 'Capacity available'" }
        }
      ]
    },
    "root": {
      "capability": "ui:screen",
      "id": "reactive-demo-root",
      "props": {
        "title": "Continuous Graph Demo",
        "subtitle": "A continuous GIK port-token graph that propagates changed values to quiescence."
      },
      "edges": {
        "children": [
          {
            "capability": "ui:row",
            "id": "reactive-demo-layout",
            "props": { "variant": "split" },
            "edges": {
              "children": [
                {
                  "capability": "ui:panel",
                  "id": "reactive-demo-context",
                  "props": { "title": "What this demonstrates", "variant": "rail" },
                  "edges": {
                    "children": [
                      {
                        "capability": "fluent:dropdown",
                        "id": "reactive-sample-select",
                        "props": {
                          "label": "Sample",
                          "options": [
                            { "value": "profile-form", "label": "profile-form" },
                            { "value": "capacity-banner", "label": "capacity-banner" }
                          ]
                        },
                        "edges": {
                          "read": { "value": "demo.sample" },
                          "on": {
                            "select": [
                              {
                                "do": "assign",
                                "target": "demo.sample",
                                "args": { "from": "$event.value" }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:heading",
                        "id": "reactive-demo-heading",
                        "props": { "value": "profile-form sample", "level": "3" }
                      },
                      {
                        "capability": "ui:note",
                        "id": "reactive-demo-note-1",
                        "props": {
                          "value": "Base writes publish named tokens. Explicit graph ports propagate changed values through standing compute nodes until the graph reaches quiescence.",
                          "tone": "muted"
                        }
                      },
                      {
                        "capability": "ui:note",
                        "id": "reactive-demo-note-2",
                        "props": {
                          "value": "The right panel is display-only; execution, dependency readiness, and convergence are owned by the Kernel.",
                          "tone": "muted"
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "reactive-form-controls",
                        "props": { "title": "Form inputs", "variant": "inset" },
                        "edges": {
                          "gate": "demo.sample = 'profile-form'",
                          "children": [
                            {
                              "capability": "fluent:text-field",
                              "id": "reactive-form-first",
                              "props": { "label": "First name" },
                              "edges": {
                                "read": { "value": "demo.formFirst" },
                                "on": {
                                  "input": [
                                    {
                                      "do": "assign",
                                      "target": "demo.formFirst",
                                      "args": { "from": "$event.value" }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "fluent:text-field",
                              "id": "reactive-form-last",
                              "props": { "label": "Last name" },
                              "edges": {
                                "read": { "value": "demo.formLast" },
                                "on": {
                                  "input": [
                                    {
                                      "do": "assign",
                                      "target": "demo.formLast",
                                      "args": { "from": "$event.value" }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "fluent:dropdown",
                              "id": "reactive-form-consent",
                              "props": {
                                "label": "Consent",
                                "options": [
                                  { "value": "false", "label": "false" },
                                  { "value": "true", "label": "true" }
                                ]
                              },
                              "edges": {
                                "read": { "value": "demo.consent" },
                                "on": {
                                  "select": [
                                    {
                                      "do": "assign",
                                      "target": "demo.consent",
                                      "args": { "from": "$event.value" }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "reactive-metrics-controls",
                        "props": { "title": "Capacity inputs", "variant": "inset" },
                        "edges": {
                          "gate": "demo.sample = 'capacity-banner'",
                          "children": [
                            {
                              "capability": "fluent:text-field",
                              "id": "reactive-metrics-approved",
                              "props": { "label": "Approved" },
                              "edges": {
                                "read": { "value": "demo.metricsApproved" },
                                "on": {
                                  "input": [
                                    {
                                      "do": "assign",
                                      "target": "demo.metricsApproved",
                                      "args": { "from": "$event.value" }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "fluent:text-field",
                              "id": "reactive-metrics-pending",
                              "props": { "label": "Pending" },
                              "edges": {
                                "read": { "value": "demo.metricsPending" },
                                "on": {
                                  "input": [
                                    {
                                      "do": "assign",
                                      "target": "demo.metricsPending",
                                      "args": { "from": "$event.value" }
                                    }
                                  ]
                                }
                              }
                            },
                            {
                              "capability": "fluent:text-field",
                              "id": "reactive-metrics-limit",
                              "props": { "label": "Limit" },
                              "edges": {
                                "read": { "value": "demo.metricsLimit" },
                                "on": {
                                  "input": [
                                    {
                                      "do": "assign",
                                      "target": "demo.metricsLimit",
                                      "args": { "from": "$event.value" }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                },
                {
                  "capability": "ui:panel",
                  "id": "reactive-demo-host",
                  "props": { "title": "Live sample", "variant": "detail" },
                  "edges": {
                    "children": [
                      {
                        "capability": "demo:reactiveSample",
                        "id": "reactive-sample",
                        "edges": {
                          "read": {
                            "sample": "demo.sample",
                            "formFirst": "demo.formFirst",
                            "formLast": "demo.formLast",
                            "consent": "demo.consent",
                            "metricsApproved": "demo.metricsApproved",
                            "metricsPending": "demo.metricsPending",
                            "metricsLimit": "demo.metricsLimit",
                            "formFull": "demo.formFull",
                            "formReady": "demo.formReady",
                            "submitLabel": "demo.submitLabel",
                            "metricsTotal": "demo.metricsTotal",
                            "metricsRemaining": "demo.metricsRemaining",
                            "metricsOverLimit": "demo.metricsOverLimit",
                            "metricsBanner": "demo.metricsBanner"
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  }
}