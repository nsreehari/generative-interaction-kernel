{
  "gik": "0.1",
  "type": "manifest",
  "payload": {
    "version": "genui-reactive-demo/1.0",
    "expression": "jsonata",
    "namespaces": ["demo"],
    "actions": ["assign", "invoke", "emit"],
    "capabilities": {
      "ui:screen": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:row": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:panel": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "slots": ["children"]
      },
      "ui:heading": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:field": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["input"]
      },
      "ui:select": {
        "propsSchema": { "type": "object", "additionalProperties": true },
        "emits": ["change"]
      },
      "ui:note": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "ui:codeBlock": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      },
      "demo:reactiveSample": {
        "propsSchema": { "type": "object", "additionalProperties": true }
      }
    },
    "externals": {
      "projectionViews": {
        "ui": { "from": "floor" },
        "demo": { "from": "self" }
      }
    }
  }
}