{
  "gik": "0.1",
  "type": "lowering-recipe",
  "payload": {
    "id": "live-cards.presentation-to-runtime",
    "from": "presentation",
    "to": "runtime-document",
    "container": {
      "capability": "ui:board",
      "props": {
        "title": "{{source.subject}}",
        "layout": "{{presentation.layout}}",
        "arrangement": "{{presentation.arrangement}}"
      }
    },
    "rules": [
      {
        "match": { "region": "tasks" },
        "emit": { "capability": "ui:todo", "read": { "items": "{{region.dataPath}}" } }
      },
      {
        "match": { "region": "relationships" },
        "emit": { "capability": "ui:chart", "read": { "data": "{{region.dataPath}}" } }
      },
      {
        "match": { "region": "context" },
        "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } }
      },
      {
        "match": { "region": "explanation" },
        "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } }
      },
      {
        "match": { "region": "content" },
        "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } }
      },
      {
        "match": { "region": "detail" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "match": { "region": "left" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "match": { "region": "right" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "match": { "region": "results" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "match": { "region": "options" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "match": { "region": "alerts" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "match": { "region": "thread" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      { "match": { "role": "summary" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "match": { "role": "metrics" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "match": { "role": "status" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "match": { "role": "narrative" }, "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } } },
      { "match": { "role": "recommendation" }, "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } } },
      { "match": { "role": "collection" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "match": { "role": "detail" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "match": { "role": "timeline" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "match": { "role": "comparison" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "match": { "role": "actions" }, "emit": { "capability": "ui:actions" } },
      { "match": { "role": "graph" }, "emit": { "capability": "ui:chart", "read": { "data": "{{region.dataPath}}" } } }
    ],
    "fallback": {
      "props": {
        "label": "{{region.name}}",
        "priority": "{{region.priority}}",
        "disclosure": "{{region.disclosure}}",
        "presentation": "{{region.presentation}}"
      }
    }
  }
}
