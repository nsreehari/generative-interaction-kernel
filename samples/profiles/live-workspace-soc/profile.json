{
  "gik": "0.1",
  "type": "profile",
  "payload": {
    "id": "live-workspace-soc",
    "kind": "genui-profile",
    "version": "1.0.0",
    "profile-template": "genui",
    "metadata": {
      "productTerm": "semantic-blueprint",
      "pitchBeat": "T3/Beat 3",
      "bundleTarget": "live-workspace-soc",
      "thesis": "Many actors. One state. Multiple views. Governed actions. Complete provenance."
    },
    "layers": [
      {
        "id": "workflow",
        "kind": "workflow",
        "schema": "genui/workflow.schema.json",
        "description": "Fourteen governed SOC acts, each containing one attributable human or agent action.",
        "input": {
          "properties": {
            "workflow": { "title": "Workflow", "default": "governed-soc-investigation", "enum": ["governed-soc-investigation"] },
            "subject": { "title": "Incident", "default": "Privileged access anomaly during payroll cutover" }
          },
          "required": ["workflow", "subject"]
        }
      },
      {
        "id": "interaction",
        "kind": "interaction",
        "schema": "genui/interaction.schema.json",
        "description": "Actor, authority, provenance, semantic regions, and domain action vocabulary."
      },
      {
        "id": "presentation",
        "kind": "presentation",
        "schema": "genui/presentation.schema.json",
        "description": "Context-sensitive arrangement and disclosure over one shared substrate."
      },
      {
        "id": "runtime-document",
        "kind": "runtime-doc",
        "schema": "genui/runtime-document.schema.json",
        "description": "Kernel-ready SOC workspace capability, reads, events, and timer composition."
      }
    ],
    "recipes": [
      { "id": "soc.workflow-to-interaction", "from": "workflow", "to": "interaction" },
      { "id": "soc.interaction-to-presentation", "from": "interaction", "to": "presentation" },
      { "id": "soc.presentation-to-runtime", "from": "presentation", "to": "runtime-document" }
    ],
    "resources": {
      "taxonomy": {
        "inline": {
          "soc-workspace": [
            { "name": "summary", "role": "situation", "required": true },
            { "name": "intent", "role": "investigation-direction", "required": false },
            { "name": "constraints", "role": "operational-boundary", "required": false },
            { "name": "hypothesis", "role": "working-conclusion", "required": false },
            { "name": "exploration", "role": "investigation-plan", "required": false },
            { "name": "evidence", "role": "decision-support", "required": false },
            { "name": "agent-request", "role": "task-envelope", "required": false },
            { "name": "response", "role": "governed-action", "required": false },
            { "name": "authorization", "role": "consequential-decision", "required": false },
            { "name": "causal-record", "role": "provenance", "required": false },
            { "name": "next-act-timer", "role": "presenter-control", "required": true }
          ]
        }
      },
      "intent": {
        "inline": {
          "goal": "Determine the execution origin, contain it safely, preserve evidence, and do not disrupt the protected payroll cutover without Incident Commander authorization.",
          "priorities": ["preserve-evidence", "payroll-continuity", "bounded-containment"],
          "constraints": ["DC-01 is protected", "Priya authorizes consequential containment"]
        }
      },
      "actors": {
        "inline": [
          { "id": "human-morgan", "kind": "human", "role": "SOC Analyst", "authority": ["direct-investigation", "recommend-containment"] },
          { "id": "human-priya", "kind": "human", "role": "Incident Commander", "authority": ["constrain-operations", "authorize-containment"] },
          { "id": "agent-correlation", "kind": "agent", "role": "Evidence correlation", "authority": ["suggest-exploration", "contribute-evidence"] },
          { "id": "agent-response", "kind": "agent", "role": "Containment planning", "authority": ["propose-response", "execute-after-authorization"] }
        ]
      },
      "authorityPolicy": {
        "inline": {
          "protectedTargets": ["DC-01"],
          "consequentialActions": ["isolate"],
          "requiredRole": "Incident Commander",
          "participationDoesNotImplyAuthority": true
        }
      },
      "acts": {
        "inline": [
          { "id": 1, "chapter": 1, "title": "Morgan establishes investigation intent", "steps": ["establishIntent"] },
          { "id": 2, "chapter": 1, "title": "Priya protects the payroll cutover", "steps": ["addConstraint"] },
          { "id": 3, "chapter": 2, "title": "Correlation Agent suggests exploration", "steps": ["suggestExploration"] },
          { "id": 4, "chapter": 2, "title": "Morgan narrows the exploration", "steps": ["amendExploration"] },
          { "id": 5, "chapter": 2, "title": "Correlation Agent replans", "steps": ["replanExploration"] },
          { "id": 6, "chapter": 3, "title": "Correlation Agent commits partial findings", "steps": ["commitPartialFindings"] },
          { "id": 7, "chapter": 3, "title": "Response Agent proposes DC-01 isolation", "steps": ["proposeDc01"] },
          { "id": 8, "chapter": 3, "title": "Correlation Agent resolves the origin", "steps": ["completeCorrelation"] },
          { "id": 9, "chapter": 4, "title": "Response Agent proposes bounded containment", "steps": ["proposeHostA"] },
          { "id": 10, "chapter": 4, "title": "Morgan revises the response", "steps": ["reviseResponse"] },
          { "id": 11, "chapter": 4, "title": "Response Agent validates blast radius", "steps": ["calculateResponse"] },
          { "id": 12, "chapter": 4, "title": "Morgan recommends containment", "steps": ["recommendContainment"] },
          { "id": 13, "chapter": 5, "title": "Priya authorizes containment", "steps": ["authorizeContainment"], "humanBoundary": "human-priya" },
          { "id": 14, "chapter": 5, "title": "Response Agent executes containment", "steps": ["executeContainment"] }
        ]
      },
      "presentationContexts": {
        "inline": [
          { "id": "full-substrate", "actor": "shared", "role": "technical-inspection", "device": "workstation", "task": "inspect-all", "disclosure": "complete", "layout": "console", "frame": "shared", "arrangement": "inspection", "regions": ["summary", "intent", "constraints", "hypothesis", "exploration", "evidence", "response", "authorization", "causal-record"] },
          { "id": "war-room", "actor": "shared", "role": "incident-team", "device": "wall-display", "task": "coordinate", "disclosure": "operational", "layout": "war-room", "frame": "shared", "arrangement": "war-room", "regions": ["summary", "hypothesis", "response", "constraints", "authorization", "causal-record"] },
          { "id": "priya-mobile", "actor": "human-priya", "role": "Incident Commander", "device": "mobile", "task": "authorize", "disclosure": "decision", "layout": "compact", "frame": "mobile", "arrangement": "decision", "regions": ["summary", "authorization", "response", "constraints", "hypothesis"] },
          { "id": "priya-laptop", "actor": "human-priya", "role": "Incident Commander", "device": "laptop", "task": "command", "disclosure": "evidence-summary", "layout": "command", "frame": "laptop", "arrangement": "command", "regions": ["summary", "constraints", "hypothesis", "evidence", "response", "authorization", "causal-record"] },
          { "id": "morgan-pager", "actor": "human-morgan", "role": "SOC Analyst", "device": "pager", "task": "triage", "disclosure": "urgent", "layout": "glanceable", "frame": "pager", "arrangement": "glanceable", "regions": ["summary", "hypothesis", "response"] },
          { "id": "morgan-workstation", "actor": "human-morgan", "role": "SOC Analyst", "device": "workstation", "task": "investigate", "disclosure": "evidence", "layout": "investigation", "frame": "workstation", "arrangement": "investigation", "regions": ["summary", "intent", "constraints", "exploration", "evidence", "hypothesis", "response", "causal-record"] },
          { "id": "correlation-agent", "actor": "agent-correlation", "role": "Evidence correlation", "device": "agent-console", "task": "correlate", "disclosure": "operation", "layout": "agent", "frame": "agent-console", "arrangement": "agent-correlation", "regions": ["summary", "intent", "constraints", "hypothesis", "agent-request", "exploration", "evidence", "causal-record"] },
          { "id": "response-agent", "actor": "agent-response", "role": "Containment planning", "device": "agent-console", "task": "plan-response", "disclosure": "policy-and-execution", "layout": "agent", "frame": "agent-console", "arrangement": "agent-response", "regions": ["summary", "hypothesis", "evidence", "constraints", "agent-request", "response", "authorization", "causal-record"] }
        ]
      }
    },
    "authoring": {
      "tools": [
        { "id": "validateSocWorkflow", "op": "validate", "layer": "workflow", "agentSafe": true, "description": "Validate the governed SOC workflow source." },
        { "id": "validateSocInteraction", "op": "validate", "layer": "interaction", "agentSafe": true, "description": "Validate actor and semantic interaction output." },
        { "id": "validateSocPresentation", "op": "validate", "layer": "presentation", "agentSafe": true, "description": "Validate projection completeness before runtime lowering." },
        { "id": "describeSocBlueprint", "op": "describe", "describe": "soc-blueprint", "agentSafe": true, "description": "Describe the SOC actors, authority, acts, and presentation contexts." }
      ]
    }
  }
}
