{
  "gik": "0.1",
  "type": "lowering-recipe",
  "payload": {
    "id": "soc.presentation-to-runtime",
    "from": "presentation",
    "to": "runtime-doc",
    "metadata": {
      "executor": "lower-document",
      "terminalVocabulary": "live-workspace-soc/1.0"
    },
    "program": [
      {
        "slot": "container",
        "match": {},
        "emit": {
          "id": "soc-workspace-shell",
          "capability": "soc:workspace-shell",
          "children": [
            {
              "id": "soc-header",
              "capability": "soc:header",
              "read": { "incident": "soc.incident" }
            },
            {
              "id": "soc-workspace",
              "capability": "soc:workspace-body",
              "on": {
                "establishIntent": [{ "do": "invoke", "args": { "tool": "establishIntent" } }],
                "addConstraint": [{ "do": "invoke", "args": { "tool": "addConstraint" } }],
                "suggestExploration": [{ "do": "invoke", "args": { "tool": "suggestExploration" } }],
                "amendExploration": [{ "do": "invoke", "args": { "tool": "amendExploration" } }],
                "replanExploration": [{ "do": "invoke", "args": { "tool": "replanExploration" } }],
                "commitPartialFindings": [{ "do": "invoke", "args": { "tool": "commitPartialFindings" } }],
                "proposeDc01": [{ "do": "route", "args": { "tool": "evaluateDc01Policy", "to": "isolate:DC-01" } }],
                "completeCorrelation": [{ "do": "invoke", "args": { "tool": "completeCorrelation" } }],
                "proposeHostA": [{ "do": "invoke", "args": { "tool": "proposeHostA" } }],
                "reviseResponse": [{ "do": "invoke", "args": { "tool": "reviseResponse" } }],
                "calculateResponse": [{ "do": "invoke", "args": { "tool": "calculateResponse" } }],
                "recommendContainment": [{ "do": "invoke", "args": { "tool": "recommendContainment" } }],
                "authorizeContainment": [{ "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }],
                "executeContainment": [{ "do": "invoke", "args": { "tool": "executeContainment" } }],
                "setPresentationContext": [{ "do": "invoke", "args": { "tool": "setPresentationContext" } }],
                "setAgentMode": [{ "do": "invoke", "args": { "tool": "setAgentMode" } }]
              },
              "children": [
                {
                  "id": "soc-substrate-chrome",
                  "capability": "soc:substrate-chrome",
                  "read": {
                    "incident": "soc.incident",
                    "presentation": "soc.presentation",
                    "journal": "soc.journal",
                    "facet": "soc.presentation.regionFacets.summary"
                  },
                  "children": [
                    {
                      "id": "soc-runtime-projection",
                      "capability": "soc:runtime-projection",
                      "props": { "frame": "{{presentation.frame}}" },
                      "read": {
                        "presentation": "soc.presentation",
                        "frame": "soc.presentation.frame"
                      },
                      "children": [
                        {
                          "id": "soc-presentation-layout",
                          "capability": "soc:presentation-layout",
                          "read": {
                            "presentation": "soc.presentation",
                            "actors": "soc.actors"
                          },
                          "children": [
                            {
                              "id": "soc-intent-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'intent').visible = true",
                              "props": { "region": "intent", "title": "Investigation intent", "focusTargets": ["intent"] },
                              "read": { "facet": "soc.presentation.regionFacets.intent" },
                              "children": [
                                {
                                  "id": "soc-intent-region",
                                  "capability": "soc:intent-region",
                                  "read": { "intent": "soc.intent" }
                                }
                              ]
                            },
                            {
                              "id": "soc-constraints-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'constraints').visible = true",
                              "props": { "region": "constraints", "title": "Operating constraints", "focusTargets": ["constraints", "DC-01"] },
                              "read": { "facet": "soc.presentation.regionFacets.constraints" },
                              "children": [
                                {
                                  "id": "soc-constraints-region",
                                  "capability": "soc:constraints-region",
                                  "read": { "constraints": "soc.constraints" }
                                }
                              ]
                            },
                            {
                              "id": "soc-hypothesis-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'hypothesis').visible = true",
                              "props": { "region": "hypothesis", "title": "Working hypothesis", "metricSuffix": "%", "focusTargets": ["hypothesis", "corr-1", "Host-A"] },
                              "read": { "facet": "soc.presentation.regionFacets.hypothesis", "metricValue": "soc.hypothesis.confidence" },
                              "children": [
                                {
                                  "id": "soc-hypothesis-region",
                                  "capability": "soc:hypothesis-region",
                                  "read": { "hypothesis": "soc.hypothesis" }
                                }
                              ]
                            },
                            {
                              "id": "soc-exploration-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'exploration').visible = true",
                              "props": { "region": "exploration", "title": "Exploration" },
                              "read": { "facet": "soc.presentation.regionFacets.exploration" },
                              "children": [
                                {
                                  "id": "soc-exploration-region",
                                  "capability": "soc:exploration-region",
                                  "read": { "explorations": "soc.explorations" }
                                }
                              ]
                            },
                            {
                              "id": "soc-evidence-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'evidence').visible = true",
                              "props": { "region": "evidence", "title": "Evidence" },
                              "read": { "facet": "soc.presentation.regionFacets.evidence" },
                              "children": [
                                {
                                  "id": "soc-evidence-region",
                                  "capability": "soc:evidence-region",
                                  "read": { "evidence": "soc.evidence" }
                                }
                              ]
                            },
                            {
                              "id": "soc-agent-request-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'agent-request').visible = true",
                              "props": { "region": "agent-request", "title": "Agent request" },
                              "readExpr": { "facet": "$lookup(soc.presentation.regionFacets, 'agent-request')" },
                              "children": [
                                {
                                  "id": "soc-agent-request-region",
                                  "capability": "soc:agent-request-region",
                                  "read": {
                                    "presentation": "soc.presentation",
                                    "actors": "soc.actors",
                                    "explorations": "soc.explorations",
                                    "proposal": "soc.proposal"
                                  }
                                }
                              ]
                            },
                            {
                              "id": "soc-response-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'response').visible = true",
                              "props": { "region": "response", "title": "Governed response", "focusTargets": ["proposal-dc01", "proposal-host-a", "rec-1", "authorization", "DC-01", "Host-A"] },
                              "read": { "facet": "soc.presentation.regionFacets.response" },
                              "children": [
                                {
                                  "id": "soc-response-region",
                                  "capability": "soc:response-region",
                                  "read": { "proposal": "soc.proposal" }
                                }
                              ]
                            },
                            {
                              "id": "soc-authorization-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'authorization').visible = true",
                              "props": { "region": "authorization", "title": "Commander authority", "focusTargets": ["authorization", "rec-1", "Host-A"] },
                              "read": { "facet": "soc.presentation.regionFacets.authorization" },
                              "children": [
                                {
                                  "id": "soc-authorization-region",
                                  "capability": "soc:authorization-region",
                                  "read": { "authorization": "soc.authorization" },
                                  "on": {
                                    "authorizeContainment": [{ "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }]
                                  }
                                }
                              ]
                            },
                            {
                              "id": "soc-causal-record-surface",
                              "capability": "soc:region-surface",
                              "gate": "$lookup(soc.presentation.regionFacets, 'causal-record').visible = true",
                              "props": { "region": "causal-record", "title": "Relevant causal record" },
                              "readExpr": { "facet": "$lookup(soc.presentation.regionFacets, 'causal-record')" },
                              "children": [
                                {
                                  "id": "soc-causal-record-region",
                                  "capability": "soc:causal-record-region"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
