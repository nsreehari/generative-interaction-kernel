{
  "gik": "0.1",
  "type": "lowering-recipe",
  "payload": {
    "id": "soc.presentation-to-runtime",
    "from": "presentation",
    "to": "runtime-doc",
    "metadata": {
      "executor": "lower-document",
      "terminalVocabulary": "live-workspace-soc/1.0"
    },
    "program": [
      {
        "slot": "container",
        "match": {},
        "emit": {
          "id": "soc-workspace-shell",
          "capability": "soc:workspace-shell",
          "children": [
            {
              "id": "soc-header",
              "capability": "soc:header",
              "read": {
                "incident": "soc.incident",
                "presentation": "soc.presentation",
                "consolePlane": "soc.consolePlane"
              },
              "on": {
                "setPresentationContext": [{ "do": "invoke", "args": { "tool": "setPresentationContext" } }],
                "setConsolePlane": [{ "do": "assign", "target": "soc.consolePlane", "args": { "from": "$event.plane" } }]
              },
              "children": [
                {
                  "id": "soc-inspector-mode",
                  "capability": "fluent:switch",
                  "props": {
                    "offLabel": "Live inspector",
                    "onLabel": "Blueprint inspector",
                    "offValue": "runtime",
                    "onValue": "blueprint",
                    "ariaLabel": "Workspace inspector mode"
                  },
                  "read": { "value": "soc.consolePlane" },
                  "on": {
                    "toggle": [{ "do": "assign", "target": "soc.consolePlane", "args": { "from": "$event.value" } }]
                  }
                }
              ]
            },
            {
              "id": "soc-workspace",
              "capability": "soc:workspace-body",
              "on": {
                "establishIntent": [{ "do": "invoke", "args": { "tool": "establishIntent" } }],
                "addConstraint": [{ "do": "invoke", "args": { "tool": "addConstraint" } }],
                "suggestExploration": [{ "do": "invoke", "args": { "tool": "suggestExploration" } }],
                "amendExploration": [{ "do": "invoke", "args": { "tool": "amendExploration" } }],
                "replanExploration": [{ "do": "invoke", "args": { "tool": "replanExploration" } }],
                "commitPartialFindings": [{ "do": "invoke", "args": { "tool": "commitPartialFindings" } }],
                "proposeDc01": [{ "do": "route", "args": { "tool": "evaluateDc01Policy", "to": "isolate:DC-01" } }],
                "completeCorrelation": [{ "do": "invoke", "args": { "tool": "completeCorrelation" } }],
                "proposeHostA": [{ "do": "invoke", "args": { "tool": "proposeHostA" } }],
                "reviseResponse": [{ "do": "invoke", "args": { "tool": "reviseResponse" } }],
                "calculateResponse": [{ "do": "invoke", "args": { "tool": "calculateResponse" } }],
                "recommendContainment": [{ "do": "invoke", "args": { "tool": "recommendContainment" } }],
                "authorizeContainment": [{ "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }],
                "executeContainment": [{ "do": "invoke", "args": { "tool": "executeContainment" } }],
                "setPresentationContext": [{ "do": "invoke", "args": { "tool": "setPresentationContext" } }],
                "setAgentMode": [{ "do": "invoke", "args": { "tool": "setAgentMode" } }],
                "selectJournal": [{ "do": "assign", "target": "soc.ui.selectedJournalId", "args": { "from": "$event.id" } }]
              },
              "children": [
                {
                  "id": "soc-substrate-chrome",
                  "capability": "soc:substrate-chrome",
                  "read": {
                    "incident": "soc.incident",
                    "presentation": "soc.presentation",
                    "consolePlane": "soc.consolePlane"
                  },
                  "children": [
                    {
                      "id": "soc-blueprint-inspector",
                      "capability": "soc:blueprint-inspector",
                      "gate": "soc.consolePlane = 'blueprint'",
                      "read": { "presentation": "soc.presentation" }
                    },
                    {
                      "id": "soc-runtime-projection",
                      "capability": "soc:runtime-projection",
                      "gate": "soc.consolePlane = 'runtime'",
                      "props": { "frame": "{{presentation.frame}}" },
                      "read": {
                        "presentation": "soc.presentation",
                        "frame": "soc.presentation.frame"
                      },
                      "children": [
                        {
                          "id": "soc-viewpoint-header",
                          "capability": "soc:viewpoint-header",
                          "read": { "presentation": "soc.presentation" }
                        },
                        {
                          "id": "soc-shared-summary",
                          "capability": "soc:shared-summary",
                          "read": {
                            "presentation": "soc.presentation",
                            "journal": "soc.journal"
                          }
                        },
                        {
                          "id": "soc-agent-envelope",
                          "capability": "soc:agent-envelope",
                          "gate": "soc.presentation.selectedContext = 'correlation-agent' or soc.presentation.selectedContext = 'response-agent'",
                          "read": {
                            "presentation": "soc.presentation",
                            "stage": "soc.stage",
                            "actors": "soc.actors",
                            "constraints": "soc.constraints",
                            "explorations": "soc.explorations",
                            "evidence": "soc.evidence",
                            "hypothesis": "soc.hypothesis",
                            "proposal": "soc.proposal",
                            "journal": "soc.journal"
                          }
                        },
                        {
                          "id": "soc-operational-view",
                          "capability": "soc:operational-view",
                          "gate": "soc.presentation.selectedContext != 'correlation-agent' and soc.presentation.selectedContext != 'response-agent'",
                          "read": {
                            "presentation": "soc.presentation",
                            "actors": "soc.actors",
                            "intent": "soc.intent",
                            "constraints": "soc.constraints",
                            "explorations": "soc.explorations",
                            "evidence": "soc.evidence",
                            "hypothesis": "soc.hypothesis",
                            "proposal": "soc.proposal",
                            "authorization": "soc.authorization",
                            "journal": "soc.journal",
                            "selectedJournalId": "soc.ui.selectedJournalId"
                          },
                          "on": {
                            "authorizeContainment": [{ "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }]
                          }
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "soc-journal-region",
                  "capability": "soc:journal",
                  "read": {
                    "incident": "soc.incident",
                    "actors": "soc.actors",
                    "journal": "soc.journal",
                    "journalMode": "soc.ui.journalMode",
                    "selectedJournalId": "soc.ui.selectedJournalId"
                  },
                  "on": {
                    "setJournalMode": [{ "do": "assign", "target": "soc.ui.journalMode", "args": { "from": "$event.mode" } }],
                    "selectJournal": [{ "do": "assign", "target": "soc.ui.selectedJournalId", "args": { "from": "$event.id" } }]
                  }
                }
              ]
            },
            {
              "id": "soc-participants-region",
              "capability": "soc:participants",
              "read": {
                "actors": "soc.actors",
                "agentProviders": "soc.agentProviders",
                "authorization": "soc.authorization",
                "journal": "soc.journal",
                "selectedJournalId": "soc.ui.selectedJournalId",
                "expanded": "soc.ui.participantsExpanded"
              },
              "on": {
                "toggleDrawer": [{ "do": "assign", "target": "soc.ui.participantsExpanded", "args": { "from": "$event.expanded" } }],
                "authorizeContainment": [{ "do": "confirm", "args": { "tool": "authorizeContainment", "title": "Authorize Host-A isolation", "message": "Authorize the evidence-backed, reversible isolation plan?", "confirmLabel": "Authorize", "danger": true } }]
              },
              "children": [
                {
                  "id": "correlation-agent-provider-mode",
                  "capability": "fluent:switch",
                  "props": {
                    "name": "agent-correlation",
                    "offLabel": "Mock",
                    "onLabel": "Live",
                    "offValue": "mock",
                    "onValue": "live",
                    "ariaLabel": "Correlation Agent provider mode"
                  },
                  "readExpr": { "value": "$lookup(soc.agentProviders, 'agent-correlation').mode" },
                  "on": { "toggle": [{ "do": "invoke", "args": { "tool": "setAgentMode" } }] }
                },
                {
                  "id": "response-agent-provider-mode",
                  "capability": "fluent:switch",
                  "props": {
                    "name": "agent-response",
                    "offLabel": "Mock",
                    "onLabel": "Live",
                    "offValue": "mock",
                    "onValue": "live",
                    "ariaLabel": "Response Agent provider mode"
                  },
                  "readExpr": { "value": "$lookup(soc.agentProviders, 'agent-response').mode" },
                  "on": { "toggle": [{ "do": "invoke", "args": { "tool": "setAgentMode" } }] }
                }
              ]
            }
          ]
        }
      }
    ]
  }
}
