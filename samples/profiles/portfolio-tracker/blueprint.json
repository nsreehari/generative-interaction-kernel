                "do": "invoke",
                "args": {
                  "tool": "setPresentationContext"
                }
              }
            ]
          }
        }
      },
      "cells": [
        {
          "id": "http-proxy-access-gate",
          "capability": "http-proxy:access-gate",
          "provides": [
            {
              "token": "http-proxy-access",
              "read": "portfolio.httpProxyAccessStatus",
              "when": "portfolio.httpProxyAccessStatus = 'ready'"
            }
          ],
          "edges": {
            "read": {
              "status": "portfolio.httpProxyAccessStatus",
              "error": "portfolio.httpProxyAccessError"
            },
            "on": {
              "accessRequested": [
                {
                  "do": "invoke",
                  "args": {
                    "tool": "checkHttpProxyAccess"
                  }
                }
              ],
              "accessCleared": [
                {
                  "do": "assign",
                  "target": "portfolio.httpProxyAccessStatus",
                  "args": {
                    "value": "required"
                  }
                },
                {
                  "do": "assign",
                  "target": "portfolio.httpProxyAccessError",
                  "args": {
                    "value": ""
                  }
                }
              ]
            }
          }
        },
        {
          "id": "holdings",
          "capability": "ui:editable-table",
          "provides": [
            "holding:$TICKER"
          ],
          "props": {
            "label": "holdings",
            "spec": {
              "schema": {
                "properties": {
                  "ticker": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number"
                  },
                  "costBasis": {
                    "type": "number"
                  }
                }
              }
            }
          },
