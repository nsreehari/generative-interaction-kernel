{
  "gik": "0.1",
  "type": "profile",
  "payload": {
    "id": "portfolio-tracker",
    "kind": "genui-profile",
    "version": "1.0.0",
    "layers": [
      { "id": "portfolio", "kind": "portfolio" },
      { "id": "presentation", "kind": "portfolio-presentation" },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [
      { "id": "portfolio.to-presentation", "from": "portfolio", "to": "presentation" },
      { "id": "portfolio.presentation-to-runtime", "from": "presentation", "to": "runtime-document" }
    ],
    "services": {
      "portfolio-intelligence": {
        "kind": "deterministic-agent",
        "version": "1",
        "operations": ["analyze", "propose-strategies"],
        "config": { "handler": "portfolio-intelligence-deterministic" },
        "scope": "per-blueprint",
        "operationPolicies": {
          "analyze": {
            "guardrails": [
              {
                "kind": "ajv-schema",
                "message": "Portfolio intelligence response is invalid",
                "schema": {
                  "type": "object",
                  "required": ["summary", "observations", "risks", "evidence", "investorProfile", "provider"],
                  "properties": {
                    "summary": { "type": "string", "minLength": 1 },
                    "observations": { "type": "array", "items": { "type": "string" } },
                    "risks": { "type": "array", "items": { "type": "string" } },
                    "evidence": { "type": "array", "items": { "type": "string" } },
                    "investorProfile": {},
                    "provider": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              }
            ],
            "onViolation": { "action": "fail" }
          },
          "propose-strategies": {
            "guardrails": [
              {
                "kind": "ajv-schema",
                "message": "Portfolio strategies response is invalid",
                "schema": {
                  "type": "object",
                  "required": ["strategies", "recommendation", "provider"],
                  "properties": {
                    "strategies": {
                      "type": "object",
                      "minProperties": 1,
                      "additionalProperties": {
                        "type": "object",
                        "required": ["id", "rationale", "targetWeights"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1 },
                          "rationale": { "type": "string", "minLength": 1 },
                          "targetWeights": {
                            "type": "object",
                            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "recommendation": {
                      "type": "object",
                      "required": ["selected", "reason", "status"],
                      "properties": {
                        "selected": { "type": "string", "minLength": 1 },
                        "reason": { "type": "string", "minLength": 1 },
                        "status": { "const": "proposed" }
                      },
                      "additionalProperties": false
                    },
                    "provider": { "type": "string", "minLength": 1 }
                  },
                  "additionalProperties": false
                }
              },
              {
                "kind": "jsonata",
                "expr": "$count(data.strategies.*[$abs($sum(targetWeights.*) - 1) > 0.001]) = 0",
                "message": "Every strategy's target weights must total 1",
                "code": "target-weights-sum"
              },
              {
                "kind": "jsonata",
                "expr": "$exists($lookup(data.strategies, data.recommendation.selected))",
                "message": "Portfolio recommendation must select a returned strategy",
                "code": "recommendation-selects-known-strategy"
              }
            ],
            "onViolation": { "action": "fail" }
          }
        }
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["portfolio"],
      "contexts": ["control"],
      "actions": ["invoke", "emit"],
      "capabilities": {
        "portfolio:workspace": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"], "emits": ["setHoldings", "upsertHolding", "removeHolding", "refreshPrices", "requestIntelligence", "calculateStrategies", "setPresentationContext"] },
        "ui:editable-table": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["save"], "dataProp": "rows" },
        "ui:table": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "rows" },
        "portfolio:summary": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "portfolio:narrative": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "portfolio:recommendation": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["apply"], "dataProp": "value" }
      },
      "externals": {
        "projectionViews": {
          "ui": { "from": "floor" },
          "portfolio": { "from": "self" }
        },
        "effectHandlers": ["setHoldings", "upsertHolding", "removeHolding", "refreshPrices", "applyRecommendation", "saveHoldings", "setPresentationContext"],
        "serviceBindings": [
          {
            "invoke": "requestIntelligence",
            "use": {
              "service": "portfolio-intelligence",
              "operation": "analyze",
              "contract": "portfolio-intelligence/v1"
            },
            "request": "{'input': {'positions':state.portfolio.positions,'summary':state.portfolio.summary,'investorProfile':state.portfolio.investorProfile},'actorId':effect.actorId}",
            "result": "{'ops':[{'op':'set','path':'portfolio.intelligence','value':result.output}],'detail':{'provider':result.output.provider}}"
          },
          {
            "invoke": "calculateStrategies",
            "use": {
              "service": "portfolio-intelligence",
              "operation": "propose-strategies",
              "contract": "portfolio-strategies/v1"
            },
            "request": "{'input': {'positions':state.portfolio.positions,'summary':state.portfolio.summary,'investorProfile':state.portfolio.investorProfile,'intelligence':state.portfolio.intelligence},'actorId':effect.actorId}",
            "result": "{'ops':[{'op':'set','path':'portfolio.strategies','value':result.output.strategies},{'op':'set','path':'portfolio.recommendation','value':result.output.recommendation}],'detail':{'provider':result.output.provider}}"
          }
        ]
      },
      "state": {
        "portfolio": {
          "holdings": {},
          "quotes": {},
          "positions": {},
          "summary": { "marketValue": 0, "costBasis": 0, "gainLoss": 0 },
          "intelligence": null,
          "strategies": {},
          "recommendation": null,
          "investorProfile": null,
          "appliedRecommendation": null,
          "presentationContext": "portfolio-overview"
        }
      }
    },
    "resources": {
      "cells": {
        "inline": [
          { "id": "holdings", "provides": ["holding:$TICKER"] },
          { "id": "market-prices", "requires": ["holding:$TICKER"], "provides": ["quote:$TICKER"] },
          { "id": "positions", "requires": ["holding:$TICKER", "quote:$TICKER"], "provides": ["position:$TICKER"] },
          { "id": "summary", "requires": ["position:$TICKER"], "provides": ["portfolio-summary"] },
          { "id": "portfolio-intelligence", "requires": ["portfolio-summary", "position:$TICKER", "investor-profile"], "provides": ["portfolio-intelligence"], "service": { "service": "portfolio-intelligence", "operation": "analyze", "contract": "portfolio-intelligence/v1" } },
          { "id": "conservative-rebalance", "requires": ["position:$TICKER", "portfolio-summary", "portfolio-intelligence", "investor-profile"], "provides": ["rebalance-conservative"] },
          { "id": "growth-rebalance", "requires": ["position:$TICKER", "portfolio-summary", "portfolio-intelligence", "investor-profile"], "provides": ["rebalance-growth"] },
          { "id": "rebalance-comparison", "requires": ["rebalance-conservative", "rebalance-growth"], "provides": ["rebalance-recommendation"], "service": { "service": "portfolio-intelligence", "operation": "propose-strategies", "contract": "portfolio-strategies/v1" } }
        ]
      }
    }
  }
}
