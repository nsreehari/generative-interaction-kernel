{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "briefing",
    "kind": "briefing-profile",
    "version": "0.1.0",
        "runtime": {
          "capabilities": {}
        },
    "recipes": [
      {
        "id": "briefing.interaction-to-runtime",
        "from": "agent-interaction",
        "to": "runtime-doc",
        "metadata": {
          "executor": "compose-document"
        },
        "planner": {
          "id": "briefing.interaction-to-presentation",
          "from": "agent-interaction",
          "to": "presentation",
          "metadata": {
            "executor": "plan-presentation"
          },
          "templates": [
            {
              "name": "briefing",
              "arrangement": "narrative",
              "maxRegions": 6
            }
          ],
          "program": [
            {
              "slot": "template",
              "match": {},
              "emit": {
                "template": "briefing",
                "layout": "briefing"
              }
            },
            {
              "slot": "rank",
              "match": {
                "required": true
              },
              "emit": {
                "rank": 0
              }
            },
            {
              "slot": "rank",
              "match": {},
              "emit": {
                "rank": 1
              }
            },
            {
              "slot": "priority",
              "match": {
                "index": 0
              },
              "emit": {
                "priority": "primary"
              }
            },
            {
              "slot": "priority",
              "match": {
                "required": true
              },
              "emit": {
                "priority": "secondary"
              }
            },
            {
              "slot": "priority",
              "match": {},
              "emit": {
                "priority": "tertiary"
              }
            },
            {
              "slot": "disclosure",
              "match": {
                "priority": "primary"
              },
              "emit": {
                "disclosure": "always"
              }
            },
            {
              "slot": "disclosure",
              "match": {},
              "emit": {
                "disclosure": "collapsed"
              }
            },
            {
              "slot": "rationale",
              "match": {},
              "emit": {
                "template": "briefing region {{region.role}} ({{region.priority}})"
              }
            }
          ],
          "cap": {
            "preserveRequired": true
          }
        },
        "runtime": {
          "id": "briefing.presentation-to-runtime",
          "from": "presentation",
          "to": "runtime-doc",
          "metadata": {
            "executor": "lower-document"
          },
          "program": [
            {
              "slot": "container",
              "match": {},
              "emit": {
                "capability": "ui:board",
                "props": {
                  "title": "{{source.subject}}",
                  "layout": "{{presentation.layout}}"
                }
              }
            },
            {
              "slot": "region",
              "match": {
                "role": "metrics"
              },
              "emit": {
                "capability": "ui:metric",
                "read": {
                  "value": "{{region.dataPath}}"
                }
              }
            },
            {
              "slot": "region",
              "match": {
                "role": "summary"
              },
              "emit": {
                "capability": "ui:metric",
                "read": {
                  "value": "{{region.dataPath}}"
                }
              }
            },
            {
              "slot": "region",
              "match": {
                "role": "status"
              },
              "emit": {
                "capability": "ui:metric",
                "read": {
                  "value": "{{region.dataPath}}"
                }
              }
            },
            {
              "slot": "region",
              "match": {
                "role": "collection"
              },
              "emit": {
                "capability": "ui:table",
                "read": {
                  "rows": "{{region.dataPath}}"
                }
              }
            },
            {
              "slot": "region",
              "match": {
                "role": "detail"
              },
              "emit": {
                "capability": "ui:table",
                "read": {
                  "rows": "{{region.dataPath}}"
                }
              }
            },
            {
              "slot": "region",
              "match": {},
              "emit": {
                "capability": "ui:markdown",
                "read": {
                  "value": "{{region.dataPath}}"
                },
                "props": {
                  "label": "{{region.name}}",
                  "priority": "{{region.priority}}",
                  "disclosure": "{{region.disclosure}}"
                }
              }
            }
          ]
        }
      }
    ],
    "authoring": {
      "tools": [
        {
          "id": "describeInteractions",
          "op": "describe",
          "describe": "interaction-catalog",
          "agentSafe": true,
          "description": "List the interaction taxonomy (every kind with its facets) — vocabulary discovery."
        },
        {
          "id": "validateInteraction",
          "op": "validate",
          "layer": "agent-interaction",
          "agentSafe": true,
          "description": "Validate an InteractionSpec (kind known, subject present, facet/data references)."
        },
        {
          "id": "validateIntent",
          "op": "validate",
          "checks": [
            "intent-spec"
          ],
          "agentSafe": true,
          "description": "Validate an IntentSpec; when an interaction is supplied, check targets against its facets.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "object",
                "properties": {
                  "goal": {
                    "type": "string"
                  },
                  "priorities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "constraints": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "interaction": {
                "type": "object"
              }
            },
            "required": [
              "intent"
            ],
            "additionalProperties": false
          }
        },
        {
          "id": "intentToEdits",
          "op": "project",
          "projectExpression": "($priorities := intent.priorities ? intent.priorities : []; {\"disabled\": [], \"priority\": ($count($priorities) = 0 ? {} : $merge($priorities@$v#$i.{ $v: ($i = 0 ? \"primary\" : \"secondary\") })), \"disclosure\": {}, \"order\": $priorities})",
          "agentSafe": true,
          "description": "Project an IntentSpec into PresentationEdits (the sanctioned override channel).",
          "inputSchema": {
            "type": "object",
            "properties": {
              "intent": {
                "type": "object"
              }
            },
            "required": [
              "intent"
            ],
            "additionalProperties": false
          }
        }
      ]
    },
    "blueprint-template": "genui1",
    "tiers": [
      {
        "id": "agent-interaction",
        "kind": "agent-interaction",
        "schema": "genui1/interaction.schema.json",
        "input": {
          "properties": {
            "interaction": {
              "title": "Interaction",
              "default": "review",
              "enum": [
                "investigate",
                "compare",
                "review",
                "approve",
                "monitor",
                "explore",
                "create",
                "configure",
                "collaborate",
                "plan",
                "learn",
                "decide"
              ]
            },
            "subject": {
              "title": "Subject",
              "default": "briefing",
              "placeholder": "briefing"
            },
            "capabilities": {
              "title": "Capabilities (optional override)",
              "type": "array",
              "items": {
                "type": "string"
              },
              "validators": [
                {
                  "kind": "jsonata",
                  "expr": "($allowed := $lookup($catalog, 'interaction-catalog')[interaction = $root.spec.interaction].facets.name; $count($allowed) = 0 or $count($[$not($ in $allowed)]) = 0)",
                  "message": "one or more capabilities are not taxonomy facets of this interaction; they become synthesized detail facets",
                  "level": "warning",
                  "code": "synthesized-facet"
                }
              ]
            },
            "data": {
              "title": "Input data (optional)",
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "rows": 6,
              "placeholder": "{ }",
              "validators": [
                {
                  "kind": "jsonata",
                  "expr": "($allowed := $count($root.spec.capabilities) > 0 ? $root.spec.capabilities : $lookup($catalog, 'interaction-catalog')[interaction = $root.spec.interaction].facets.name; $count($allowed) = 0 or $count($keys($)[$not($ in $allowed)]) = 0)",
                  "message": "one or more data bindings target no facet of this interaction",
                  "level": "warning",
                  "code": "data-for-unknown-facet"
                }
              ]
            },
            "facetViews": {
              "title": "Facet views (optional)",
              "type": "object",
              "additionalProperties": {
                "type": "object"
              },
              "validators": [
                {
                  "kind": "jsonata",
                  "expr": "($allowed := $count($root.spec.capabilities) > 0 ? $root.spec.capabilities : $lookup($catalog, 'interaction-catalog')[interaction = $root.spec.interaction].facets.name; $count($allowed) = 0 or $count($keys($)[$not($ in $allowed)]) = 0)",
                  "message": "one or more facetViews entries target no facet of this interaction",
                  "level": "warning",
                  "code": "view-for-unknown-facet"
                }
              ]
            }
          },
          "required": [
            "interaction",
            "subject"
          ]
        }
      },
      {
        "id": "runtime-doc",
        "kind": "runtime-doc",
        "schema": "genui1/runtime-document.schema.json"
      }
    ]
  }
}
