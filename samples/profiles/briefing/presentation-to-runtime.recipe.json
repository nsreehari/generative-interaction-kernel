{
  "gik": "0.1",
  "type": "lowering-recipe",
  "payload": {
    "id": "briefing.presentation-to-runtime",
    "from": "presentation",
    "to": "runtime-document",
    "program": [
      {
        "slot": "container",
        "match": {},
        "emit": {
          "capability": "ui:board",
          "props": {
            "title": "{{source.subject}}",
            "layout": "{{presentation.layout}}"
          }
        }
      },
      { "slot": "region", "match": { "role": "metrics" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "summary" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "status" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "collection" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "detail" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      {
        "slot": "region",
        "match": {},
        "emit": {
          "capability": "ui:markdown",
          "read": { "value": "{{region.dataPath}}" },
          "props": {
            "label": "{{region.name}}",
            "priority": "{{region.priority}}",
            "disclosure": "{{region.disclosure}}"
          }
        }
      }
    ]
  }
}
