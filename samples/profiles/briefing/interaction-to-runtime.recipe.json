{
  "gik": "0.1",
  "type": "lowering-recipe",
  "payload": {
    "id": "briefing.interaction-to-runtime",
    "from": "agent-interaction",
    "to": "runtime-doc",
    "metadata": { "executor": "compose-document" },
    "planner": {
      "id": "briefing.interaction-to-presentation",
      "from": "agent-interaction",
      "to": "presentation",
      "metadata": { "executor": "plan-presentation" },
      "templates": [
        { "name": "briefing", "arrangement": "narrative", "maxRegions": 6 }
      ],
      "program": [
        { "slot": "template", "match": {}, "emit": { "template": "briefing", "layout": "briefing" } },
        { "slot": "rank", "match": { "required": true }, "emit": { "rank": 0 } },
        { "slot": "rank", "match": {}, "emit": { "rank": 1 } },
        { "slot": "priority", "match": { "index": 0 }, "emit": { "priority": "primary" } },
        { "slot": "priority", "match": { "required": true }, "emit": { "priority": "secondary" } },
        { "slot": "priority", "match": {}, "emit": { "priority": "tertiary" } },
        { "slot": "disclosure", "match": { "priority": "primary" }, "emit": { "disclosure": "always" } },
        { "slot": "disclosure", "match": {}, "emit": { "disclosure": "collapsed" } },
        { "slot": "rationale", "match": {}, "emit": { "template": "briefing region {{region.role}} ({{region.priority}})" } }
      ],
      "cap": {
        "preserveRequired": true
      }
    },
    "runtime": {
      "id": "briefing.presentation-to-runtime",
      "from": "presentation",
      "to": "runtime-doc",
      "metadata": { "executor": "lower-document" },
      "program": [
        {
          "slot": "container",
          "match": {},
          "emit": {
            "capability": "ui:board",
            "props": {
              "title": "{{source.subject}}",
              "layout": "{{presentation.layout}}"
            }
          }
        },
        { "slot": "region", "match": { "role": "metrics" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
        { "slot": "region", "match": { "role": "summary" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
        { "slot": "region", "match": { "role": "status" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
        { "slot": "region", "match": { "role": "collection" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
        { "slot": "region", "match": { "role": "detail" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
        {
          "slot": "region",
          "match": {},
          "emit": {
            "capability": "ui:markdown",
            "read": { "value": "{{region.dataPath}}" },
            "props": {
              "label": "{{region.name}}",
              "priority": "{{region.priority}}",
              "disclosure": "{{region.disclosure}}"
            }
          }
        }
      ]
    }
  }
}