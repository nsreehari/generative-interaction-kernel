{
  "gik": "0.1",
  "type": "lowering-recipe",
  "payload": {
    "id": "4layers.presentation-to-runtime",
    "from": "presentation",
    "to": "runtime-doc",
    "metadata": { "executor": "lower-document" },
    "program": [
      {
        "slot": "container",
        "match": {},
        "emit": {
          "capability": "ui:board",
          "props": {
            "title": "{{source.subject}}",
            "layout": "{{presentation.layout}}",
            "arrangement": "{{presentation.arrangement}}"
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "tasks" },
        "emit": { "capability": "ui:todo", "read": { "items": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "region": "relationships" },
        "emit": { "capability": "ui:chart", "read": { "data": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "role": "timeline" },
        "emit": { "capability": "ui:timeline", "read": { "items": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "role": "metrics" },
        "emit": { "capability": "ui:stats", "read": { "items": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "presentation": "diff" },
        "emit": { "capability": "ui:diff", "read": { "before": "{{region.dataPath}}", "after": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "role": "form" },
        "emit": { "capability": "ui:form", "read": { "schema": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "role": "actions" },
        "emit": { "capability": "ui:actions", "read": { "items": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": {},
        "emit": { "capability": "ui:panel", "read": { "data": "{{region.dataPath}}" }, "props": { "presentation": "{{region.presentation}}" } }
      }
    ]
  }
}