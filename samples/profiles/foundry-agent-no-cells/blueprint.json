        "ui:button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "press"
          ]
        },
        "ui:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "ui": {
            "from": "floor"
          },
          "agent": {
            "from": "self"
          },
          "foundry": {
            "from": "foundry",
            "use": [
