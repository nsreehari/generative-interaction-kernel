          }
        },
        "effectHandlers": [
          "clearFoundryAccess",
          "signOut"
        ]
      },
      "state": {
        "agent": {
          "accessStatus": "required",
          "accessError": "",
          "agentName": "",
          "draft": "",
          "reply": "",
          "lastAsked": "",
          "conversationId": "",
          "agentOptions": [],
          "agentsStatus": "idle",
          "agentsError": "",
          "error": ""
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Authored terminal document for this hosted Blueprint."
      }
