{
  "gik": "0.1",
  "type": "profile",
  "payload": {
    "id": "foundry-agent",
    "kind": "runtime-blueprint",
    "version": "1.0",
    "layers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Authored terminal document for this hosted Blueprint."
      }
    ],
    "recipes": [],
    "resources": {
      "document": {
        "inline": {
          "root": {
            "capability": "ui:screen",
            "id": "foundry-agent-root",
            "props": {
              "title": "Foundry Agent",
              "subtitle": "Choose an available agent and start a conversation."
            },
            "edges": {
              "children": [
                {
                  "capability": "agent:access-modal",
                  "id": "foundry-access-gate",
                  "props": {
                    "required": true,
                    "proxyBaseUrl": "https://sz-foundry-proxy.azurewebsites.net"
                  },
                  "edges": {
                    "on": {
                      "accessResolved": [
                        {
                          "do": "invoke",
                          "args": {
                            "tool": "acceptFoundryAccess"
                          }
                        }
                      ],
                      "accessCleared": [
                        {
                          "do": "invoke",
                          "args": {
                            "tool": "clearFoundryAccess"
                          }
                        }
                      ]
                    }
                  }
                },
                {
                  "capability": "agent:ask-page",
                  "id": "agent-demo",
                  "props": {
                    "title": "Ask the agent"
                  },
                  "edges": {
                    "children": [
                      {
                        "capability": "agent:agent-selector",
                        "id": "agent-selector",
                        "edges": {
                          "read": {
                            "agentName": "agent.agentName",
                            "agentOptions": "agent.agentOptions"
                          },
                          "on": {
                            "select": [
                              {
                                "do": "assign",
                                "target": "agent.agentName",
                                "args": {
                                  "from": "$event.value"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:alert",
                        "id": "agent-connected",
                        "props": {
                          "label": "Connected to",
                          "level": "good"
                        },
                        "edges": {
                          "read": {
                            "value": "agent.agentName"
                          }
                        }
                      },
                      {
                        "capability": "ui:field",
                        "id": "agent-message-field",
                        "props": {
                          "label": "Message",
                          "placeholder": "Ask the agent something..."
                        },
                        "edges": {
                          "read": {
                            "value": "agent.draft"
                          },
                          "on": {
                            "input": [
                              {
                                "do": "assign",
                                "target": "agent.draft",
                                "args": {
                                  "from": "$event.value"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:button",
                        "id": "agent-ask-btn",
                        "props": {
                          "label": "Ask",
                          "tone": "primary"
                        },
                        "edges": {
                          "on": {
                            "press": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "askAgent"
                                }
                              }
                            ]
                          }
                        }
                      },
                      {
                        "capability": "ui:alert",
                        "id": "agent-request-error",
                        "props": {
                          "label": "Something went wrong",
                          "level": "error"
                        },
                        "edges": {
                          "gate": "agent.error != ''",
                          "read": {
                            "value": "agent.error"
                          }
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "agent-asked-panel",
                        "props": {
                          "title": "You asked",
                          "variant": "inset"
                        },
                        "edges": {
                          "gate": "agent.lastAsked != ''",
                          "children": [
                            {
                              "capability": "ui:note",
                              "id": "agent-asked-value",
                              "props": {
                                "tone": "muted"
                              },
                              "edges": {
                                "read": {
                                  "value": "agent.lastAsked"
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:panel",
                        "id": "agent-reply-panel",
                        "props": {
                          "title": "Reply",
                          "variant": "inset"
                        },
                        "edges": {
                          "children": [
                            {
                              "capability": "ui:note",
                              "id": "agent-reply-empty",
                              "props": {
                                "value": "Send a message to see the agent's reply.",
                                "tone": "muted"
                              },
                              "edges": {
                                "gate": "agent.reply = ''"
                              }
                            },
                            {
                              "capability": "ui:markdown",
                              "id": "agent-reply-value",
                              "edges": {
                                "gate": "agent.reply != ''",
                                "read": {
                                  "value": "agent.reply"
                                }
                              }
                            }
                          ]
                        }
                      },
                      {
                        "capability": "ui:button",
                        "id": "agent-signout-btn",
                        "props": {
                          "label": "Sign out"
                        },
                        "edges": {
                          "on": {
                            "press": [
                              {
                                "do": "invoke",
                                "args": {
                                  "tool": "signOut"
                                }
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "services": {
      "assistant": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": [
          "chat"
        ],
        "config": {
          "endpoint": "https://sz-foundry-proxy.azurewebsites.net",
          "credentialRef": "foundry-agent/access-key"
        },
        "scope": "per-session",
        "operationPolicies": {
          "chat": {
            "guardrails": [
              {
                "kind": "ajv-schema",
                "message": "Foundry agent returned an invalid chat response",
                "schema": {
                  "type": "object",
                  "required": ["conversationId", "responseId", "reply"],
                  "properties": {
                    "conversationId": { "type": "string" },
                    "responseId": { "type": "string", "minLength": 1 },
                    "reply": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              }
            ],
            "onViolation": { "action": "fail" }
          }
        }
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "agent"
      ],
      "actions": [
        "assign",
        "invoke"
      ],
      "capabilities": {
        "ui:screen": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:col": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:row": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:heading": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:note": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:alert": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:field": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "input"
          ]
        },
        "agent:access-modal": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "accessResolved",
            "accessCleared"
          ]
        },
        "agent:agent-selector": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "select"
          ]
        },
        "agent:ask-page": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "press"
          ]
        },
        "ui:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "ui": {
            "from": "floor"
          },
          "agent": {
            "from": "self"
          }
        },
        "effectHandlers": [
          "acceptFoundryAccess",
          "clearFoundryAccess",
          "signOut"
        ],
        "serviceBindings": [
          {
            "invoke": "askAgent",
            "use": {
              "service": "assistant",
              "operation": "chat",
              "contract": "foundry-chat/v1"
            },
            "subject": {
              "kind": "chat",
              "blueprintId": "foundry-agent",
              "turnId": "current"
            },
            "request": "{'input': {'message': $trim(state.agent.draft), 'agentName': $trim(state.agent.agentName), 'conversationId': state.agent.conversationId = '' ? null : state.agent.conversationId}, 'actorId': effect.actorId}",
            "result": "{'ops': [{'op':'set','path':'agent.error','value':''}, {'op':'set','path':'agent.lastAsked','value':$trim(state.agent.draft)}, {'op':'set','path':'agent.draft','value':''}, {'op':'set','path':'agent.conversationId','value':result.output.conversationId}, {'op':'set','path':'agent.reply','value':result.output.reply}], 'detail': {'provider':'foundry-agent','responseId':result.output.responseId,'conversationId':result.output.conversationId}}"
          }
        ]
      },
      "state": {
        "agent": {
          "agentName": "",
          "draft": "",
          "reply": "",
          "lastAsked": "",
          "conversationId": "",
          "agentOptions": [],
          "error": ""
        }
      }
    }
  }
}
