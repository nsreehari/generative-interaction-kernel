{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "blueprint-studio",
    "kind": "blueprint-studio",
    "version": "1.0.0",
    "structureMode": "fixed",
    "tiers": [
      {
        "id": "studio-domain",
        "kind": "blueprint-studio-domain"
      },
      {
        "id": "studio-presentation",
        "kind": "runtime-document"
      }
    ],
    "recipes": [
      {
        "id": "studio-domain-to-presentation",
        "from": "studio-domain",
        "to": "studio-presentation",
        "representations": [
          {
            "id": "studio-read-workspace",
            "views": {
              "studio-root": {
                "capability": "primitive:container",
                "props": {
                  "variant": "row",
                  "gap": "l",
                  "align": "start",
                  "fullWidth": true,
                  "ariaLabel": "Blueprint Studio"
                }
              },
              "blueprint-list-region": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "s",
                  "ariaLabel": "Blueprint catalog",
                  "style": {
                    "flex": "0 0 22rem",
                    "width": "22rem"
                  }
                }
              },
              "blueprint-list": {
                "capability": "fluent:list",
                "props": {
                  "variant": "selectable",
                  "selectionMode": "single",
                  "ariaLabel": "Blueprints"
                },
                "before": [
                  {
                    "capability": "fluent:text",
                    "props": {
                      "value": "Blueprints",
                      "as": "h2",
                      "variant": "subtitle",
                      "block": true
                    }
                  },
                  {
                    "capability": "fluent:spinner",
                    "props": {
                      "label": "Loading Blueprints",
                      "size": "medium"
                    },
                    "visibility": "systemInputs.numSourcesRunning > 0"
                  }
                ],
                "bindings": {
                  "items": {
                    "from": "studio.blueprintOptions"
                  },
                  "selectedValues": {
                    "expression": "studio.selectedBlueprintId != '' ? [studio.selectedBlueprintId] : []"
                  }
                }
              },
              "individual-blueprint": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "m",
                  "grow": true,
                  "fullWidth": true,
                  "ariaLabel": "Selected Blueprint"
                }
              },
              "individual-blueprint-tabs": {
                "capability": "fluent:tab-bar",
                "props": {
                  "ariaLabel": "Blueprint views",
                  "tabs": [
                    { "value": "overview", "headerLabel": "Overview" },
                    { "value": "form", "headerLabel": "Form" },
                    { "value": "preview", "headerLabel": "Preview" }
                  ]
                },
                "bindings": {
                  "active": {
                    "from": "studio.activeTab"
                  }
                },
                "before": [
                  {
                    "capability": "fluent:text",
                    "props": {
                      "as": "h2",
                      "variant": "subtitle",
                      "block": true
                    },
                    "bindings": {
                      "value": {
                        "expression": "studio.selected ? studio.selected.id : 'Select a Blueprint'"
                      }
                    }
                  }
                ]
              },
              "blueprint-overview-pane": {
                "capability": "primitive:markdown",
                "bindings": {
                  "value": {
                    "from": "studio.overviewMarkdown"
                  }
                }
              },
              "blueprint-form-pane": {
                "capability": "primitive:form",
                "props": {
                  "fields": {
                    "properties": {
                      "id": {
                        "title": "Blueprint ID",
                        "type": "string",
                        "span": 12
                      },
                      "blueprint": {
                        "title": "Blueprint JSON",
                        "type": "json",
                        "format": "json",
                        "rows": 24,
                        "span": 12
                      }
                    },
                    "required": ["id", "blueprint"]
                  }
                },
                "bindings": {
                  "value": {
                    "expression": "{'id':studio.selected.id,'blueprint':studio.selected.artifact}"
                  },
                  "readOnly": {
                    "expression": "true"
                  }
                }
              },
              "blueprint-preview-pane": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "m",
                  "fullWidth": true,
                  "ariaLabel": "Blueprint preview"
                }
              },
              "blueprint-preview-context-form": {
                "capability": "primitive:form",
                "props": {
                  "initiallyDirty": false
                },
                "bindings": {
                  "fields": {
                    "expression": "studio.previewContextFormSpec.fields"
                  },
                  "value": {
                    "from": "studio.previewExternalContext"
                  },
                  "saveLabel": {
                    "expression": "studio.previewContextFormSpec.saveLabel ? studio.previewContextFormSpec.saveLabel : 'Apply context'"
                  },
                  "discardLabel": {
                    "expression": "studio.previewContextFormSpec.discardLabel ? studio.previewContextFormSpec.discardLabel : 'Discard'"
                  }
                },
                "visibility": "studio.previewContextFormSpec != null"
              },
              "blueprint-preview-content": {
                "capability": "gik:blueprint",
                "bindings": {
                  "blueprint": {
                    "expression": "studio.selected.artifact"
                  },
                  "externalContext": {
                    "from": "studio.previewExternalContext"
                  },
                  "instanceKey": {
                    "expression": "$string(studio.previewExternalContext)"
                  }
                },
                "visibility": "studio.activeTab = 'preview'"
              }
            },
            "presentation": {
              "roots": ["studio-root"],
              "placements": [
                {
                  "cell": "blueprint-list-region",
                  "parent": "studio-root",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "individual-blueprint",
                  "parent": "studio-root",
                  "slot": "children",
                  "order": 1
                },
                {
                  "cell": "blueprint-list",
                  "parent": "blueprint-list-region",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "individual-blueprint-tabs",
                  "parent": "individual-blueprint",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "blueprint-overview-pane",
                  "parent": "individual-blueprint-tabs",
                  "slot": "panes",
                  "order": 0
                },
                {
                  "cell": "blueprint-form-pane",
                  "parent": "individual-blueprint-tabs",
                  "slot": "panes",
                  "order": 1
                },
                {
                  "cell": "blueprint-preview-pane",
                  "parent": "individual-blueprint-tabs",
                  "slot": "panes",
                  "order": 2
                },
                {
                  "cell": "blueprint-preview-context-form",
                  "parent": "blueprint-preview-pane",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "blueprint-preview-content",
                  "parent": "blueprint-preview-pane",
                  "slot": "children",
                  "order": 1
                }
              ]
            }
          }
        ],
        "fallback": "studio-read-workspace"
      }
    ],
    "services": {
      "blueprint-studio-data": {
        "blueprint": {
          "$ref": "blueprint:blueprint-studio-crud@1.0.0"
        },
        "version": "1",
        "operations": {
          "listBlueprints": {
            "operation": "list-blueprints",
            "contract": "blueprint-studio-list/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "fetchBlueprint": {
            "operation": "fetch-blueprint",
            "contract": "blueprint-studio-record/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':input.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["studio"],
      "actions": ["assign"],
      "capabilities": {
        "gik:blueprint": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:container": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": ["children"]
        },
        "primitive:form": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:list": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": ["select"]
        },
        "fluent:spinner": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:tab-bar": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": ["panes"],
          "emits": ["select"]
        },
        "fluent:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "fluent": {
            "from": "fluent",
            "use": ["list", "spinner", "tab-bar", "text"]
          },
          "primitive": {
            "from": "primitive",
            "use": ["container", "form", "markdown"]
          }
        }
      },
      "state": {
        "studio": {
          "selectedBlueprintId": "",
          "activeTab": "overview",
          "blueprints": [],
          "blueprintOptions": [],
          "selected": null,
          "overviewMarkdown": "",
          "previewContextFormSpec": null,
          "previewExternalContext": {}
        }
      }
    },
    "cells": {
      "studio-root": {
        "id": "studio-root"
      },
      "blueprint-list-region": {
        "id": "blueprint-list-region",
        "kind": "blueprint-list-region"
      },
      "blueprint-list": {
        "id": "blueprint-list",
        "kind": "blueprint-list",
        "systemInputs": ["numSourcesRunning"],
        "inputs": [
          {
            "token": "studio.selectedBlueprintId",
            "as": "selectedBlueprintId"
          }
        ],
        "sources": [
          {
            "id": "blueprint-list.source",
            "service": "blueprint-studio-data",
            "operation": "listBlueprints",
            "contract": "blueprint-studio-list/v1",
            "output": {
              "kind": "jsonata",
              "expr": "response.blueprints"
            }
          }
        ],
        "compute": [
          {
            "id": "blueprint-records",
            "expression": "$exists(sources.`blueprint-list.source`) ? sources.`blueprint-list.source` : []",
            "assign": "studio.blueprints",
            "dependencies": ["sources.blueprint-list.source"]
          },
          {
            "id": "blueprint-options",
            "expression": "$exists(sources.`blueprint-list.source`) ? sources.`blueprint-list.source`.{'value':id,'label':label & ' · ' & version} : []",
            "assign": "studio.blueprintOptions",
            "dependencies": ["sources.blueprint-list.source"]
          }
        ],
        "outputs": [
          {
            "token": "selectedBlueprintId",
            "from": "inputs.selectedBlueprintId",
            "when": "$exists(inputs.selectedBlueprintId) and $length(inputs.selectedBlueprintId) > 0"
          }
        ],
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "studio.selectedBlueprintId",
                "args": {
                  "from": "$event.values[0]"
                }
              }
            ]
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "individual-blueprint": {
        "id": "individual-blueprint",
        "kind": "individual-blueprint",
        "inputs": [
          {
            "token": "selectedBlueprintId",
            "as": "selectedBlueprintId",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "individual-blueprint.source",
            "service": "blueprint-studio-data",
            "operation": "fetchBlueprint",
            "contract": "blueprint-studio-record/v1",
            "input": {
              "kind": "jsonata",
              "expr": "{'id':inputs.selectedBlueprintId}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response"
            }
          }
        ],
        "compute": [
          {
            "id": "selected-blueprint",
            "expression": "sources.`individual-blueprint.source`",
            "assign": "studio.selected",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-overview",
            "expression": "($bp := sources.`individual-blueprint.source`; $bp ? '# ' & $bp.id & '\\n\\n- **Version:** ' & $bp.version & '\\n- **Kind:** ' & $bp.kind & '\\n- **Source:** ' & ($bp.readonly ? 'Repository bootstrap' : 'User workspace') & '\\n- **Tiers:** ' & $join($bp.artifact.payload.tiers.id, ', ') & '\\n- **Recipes:** ' & $string($count($bp.artifact.payload.recipes)) : '')",
            "assign": "studio.overviewMarkdown",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-context-form",
            "expression": "sources.`individual-blueprint.source`.contextFormSpec",
            "assign": "studio.previewContextFormSpec",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-initial-context",
            "expression": "sources.`individual-blueprint.source`.initialExternalContext",
            "assign": "studio.previewExternalContext",
            "dependencies": ["sources.individual-blueprint.source"]
          }
        ]
      },
      "individual-blueprint-tabs": {
        "id": "individual-blueprint-tabs",
        "kind": "blueprint-tabs",
        "inputs": [
          {
            "token": "selectedBlueprintId",
            "as": "selectedBlueprintId",
            "required": true
          }
        ],
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "studio.activeTab",
                "args": {
                  "from": "$event.value"
                }
              }
            ]
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "blueprint-overview-pane": {
        "id": "blueprint-overview-pane",
        "kind": "blueprint-overview"
      },
      "blueprint-form-pane": {
        "id": "blueprint-form-pane",
        "kind": "blueprint-form"
      },
      "blueprint-preview-pane": {
        "id": "blueprint-preview-pane",
        "kind": "blueprint-preview"
      },
      "blueprint-preview-content": {
        "id": "blueprint-preview-content",
        "kind": "blueprint-preview-content"
      },
      "blueprint-preview-context-form": {
        "id": "blueprint-preview-context-form",
        "kind": "blueprint-preview-context-form",
        "inputs": [
          {
            "token": "selectedBlueprintId",
            "as": "selectedBlueprintId",
            "required": true
          }
        ],
        "behavior": {
          "on": {
            "save": [
              {
                "do": "assign",
                "target": "studio.previewExternalContext",
                "args": {
                  "from": "$event.values"
                }
              }
            ]
          }
        },
        "events": {
          "save": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
