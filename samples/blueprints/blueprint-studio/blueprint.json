{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "blueprint-studio",
    "kind": "blueprint-studio",
    "version": "1.0.0",
    "structureMode": "fixed",
    "tiers": [
      {
        "id": "studio-domain",
        "kind": "blueprint-studio-domain"
      },
      {
        "id": "studio-presentation",
        "kind": "runtime-document"
      }
    ],
    "recipes": [
      {
        "id": "studio-domain-to-presentation",
        "from": "studio-domain",
        "to": "studio-presentation",
        "representations": [
          {
            "id": "studio-read-workspace",
            "views": {
              "studio-root": {
                "capability": "primitive:container",
                "props": {
                  "variant": "row",
                  "gap": "l",
                  "align": "start",
                  "fullWidth": true,
                  "ariaLabel": "Blueprint Studio"
                }
              },
              "blueprint-list-region": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "s",
                  "ariaLabel": "Blueprint catalog",
                  "style": {
                    "flex": "0 0 22rem",
                    "width": "22rem"
                  }
                }
              },
              "blueprint-list": {
                "capability": "fluent:list",
                "props": {
                  "variant": "selectable",
                  "selectionMode": "single",
                  "ariaLabel": "Blueprints"
                },
                "before": [
                  {
                    "capability": "fluent:text",
                    "props": {
                      "value": "Blueprints",
                      "as": "h2",
                      "variant": "subtitle",
                      "block": true
                    }
                  },
                  {
                    "capability": "fluent:spinner",
                    "props": {
                      "label": "Loading Blueprints",
                      "size": "medium"
                    },
                    "visibility": "systemInputs.numSourcesRunning > 0"
                  }
                ],
                "bindings": {
                  "items": {
                    "from": "studio.blueprintOptions"
                  },
                  "selectedValues": {
                    "expression": "studio.selectedBlueprintId != '' ? [studio.selectedBlueprintId] : []"
                  }
                }
              },
              "blueprint-new-form": {
                "capability": "primitive:form",
                "props": {
                  "fields": {
                    "properties": {
                      "id": {
                        "title": "New Blueprint ID",
                        "type": "string",
                        "pattern": "^[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$",
                        "span": 12
                      },
                      "kind": {
                        "title": "Kind",
                        "type": "string",
                        "span": 12
                      },
                      "version": {
                        "title": "Initial version",
                        "type": "string",
                        "span": 12
                      }
                    },
                    "required": [
                      "id",
                      "kind",
                      "version"
                    ],
                    "additionalProperties": false
                  },
                  "value": {
                    "id": "",
                    "kind": "runtime-blueprint",
                    "version": "1.0.0"
                  },
                  "saveLabel": "Create draft",
                  "discardLabel": "Reset"
                }
              },
              "individual-blueprint": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "m",
                  "grow": true,
                  "fullWidth": true,
                  "ariaLabel": "Selected Blueprint"
                }
              },
              "blueprint-actions": {
                "capability": "primitive:container",
                "props": {
                  "variant": "row",
                  "gap": "s",
                  "align": "center",
                  "ariaLabel": "Blueprint actions"
                }
              },
              "blueprint-edit-action": {
                "capability": "fluent:button",
                "props": {
                  "label": "Edit as draft",
                  "appearance": "primary"
                },
                "visibility": "studio.selected != null and studio.selected.draft = null"
              },
              "blueprint-promote-draft-action": {
                "capability": "fluent:button",
                "props": {
                  "label": "Promote draft",
                  "appearance": "primary"
                },
                "visibility": "studio.selected.draft != null"
              },
              "blueprint-delete-draft-action": {
                "capability": "fluent:button",
                "props": {
                  "label": "Delete draft"
                },
                "visibility": "studio.selected.draft != null"
              },
              "blueprint-delete-action": {
                "capability": "fluent:button",
                "props": {
                  "label": "Delete Blueprint"
                },
                "visibility": "studio.selected != null and studio.selected.readonly = false"
              },
              "individual-blueprint-tabs": {
                "capability": "fluent:tab-bar",
                "props": {
                  "ariaLabel": "Blueprint views",
                  "tabs": [
                    {
                      "value": "overview",
                      "headerLabel": "Overview"
                    },
                    {
                      "value": "form",
                      "headerLabel": "Current"
                    },
                    {
                      "value": "draft",
                      "headerLabel": "Draft"
                    },
                    {
                      "value": "preview",
                      "headerLabel": "Preview"
                    },
                    {
                      "value": "preview-draft",
                      "headerLabel": "Preview Draft"
                    }
                  ]
                },
                "bindings": {
                  "active": {
                    "from": "studio.activeTab"
                  }
                },
                "before": [
                  {
                    "capability": "fluent:text",
                    "props": {
                      "as": "h2",
                      "variant": "subtitle",
                      "block": true
                    },
                    "bindings": {
                      "value": {
                        "expression": "studio.selected ? studio.selected.id : 'Select a Blueprint'"
                      }
                    }
                  }
                ]
              },
              "blueprint-overview-pane": {
                "capability": "primitive:markdown",
                "bindings": {
                  "value": {
                    "from": "studio.overviewMarkdown"
                  }
                }
              },
              "blueprint-form-pane": {
                "capability": "primitive:form",
                "props": {
                  "fields": {
                    "properties": {
                      "id": {
                        "title": "Blueprint ID",
                        "type": "string",
                        "span": 12
                      },
                      "blueprint": {
                        "title": "Blueprint JSON",
                        "type": "json",
                        "format": "json",
                        "rows": 24,
                        "span": 12
                      }
                    },
                    "required": [
                      "id",
                      "blueprint"
                    ]
                  }
                },
                "bindings": {
                  "value": {
                    "expression": "{'id':studio.selected.id,'blueprint':studio.selected.artifact}"
                  },
                  "readOnly": {
                    "expression": "true"
                  }
                }
              },
              "blueprint-draft-form-pane": {
                "capability": "primitive:form",
                "props": {
                  "fields": {
                    "properties": {
                      "gik": {
                        "title": "GIK version",
                        "type": "string",
                        "readOnly": true,
                        "span": 6
                      },
                      "type": {
                        "title": "Document type",
                        "type": "string",
                        "readOnly": true,
                        "span": 6
                      },
                      "payload": {
                        "title": "Blueprint payload",
                        "type": "json",
                        "format": "json",
                        "rows": 24,
                        "span": 12
                      }
                    },
                    "required": [
                      "gik",
                      "type",
                      "payload"
                    ],
                    "additionalProperties": false,
                    "validators": [
                      {
                        "kind": "blueprint",
                        "code": "blueprint-draft",
                        "message": "The draft Blueprint is invalid"
                      }
                    ]
                  },
                  "saveLabel": "Save draft",
                  "discardLabel": "Discard changes"
                },
                "bindings": {
                  "value": {
                    "expression": "studio.selected.draft.artifact"
                  }
                },
                "visibility": "studio.selected.draft != null"
              },
              "blueprint-preview-pane": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "m",
                  "fullWidth": true,
                  "ariaLabel": "Blueprint preview"
                }
              },
              "blueprint-preview-context-form": {
                "capability": "primitive:form",
                "props": {
                  "initiallyDirty": false
                },
                "bindings": {
                  "fields": {
                    "expression": "studio.previewContextFormSpec.fields"
                  },
                  "value": {
                    "from": "studio.previewExternalContext"
                  },
                  "saveLabel": {
                    "expression": "studio.previewContextFormSpec.saveLabel ? studio.previewContextFormSpec.saveLabel : 'Apply context'"
                  },
                  "discardLabel": {
                    "expression": "studio.previewContextFormSpec.discardLabel ? studio.previewContextFormSpec.discardLabel : 'Discard'"
                  }
                },
                "visibility": "studio.previewContextFormSpec != null"
              },
              "blueprint-preview-content": {
                "capability": "gik:blueprint",
                "bindings": {
                  "blueprint": {
                    "expression": "{'$ref':studio.previewBlueprintRef}"
                  },
                  "externalContext": {
                    "from": "studio.previewExternalContext"
                  },
                  "instanceKey": {
                    "expression": "studio.previewBlueprintRef & ':' & $string(studio.previewExternalContext)"
                  }
                },
                "visibility": "studio.activeTab = 'preview'"
              },
              "blueprint-draft-preview-pane": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "m",
                  "fullWidth": true,
                  "ariaLabel": "Draft Blueprint preview"
                }
              },
              "blueprint-draft-preview-context-form": {
                "capability": "primitive:form",
                "props": {
                  "initiallyDirty": false
                },
                "bindings": {
                  "fields": {
                    "expression": "studio.selected.draft.artifact.payload.contextFormSpec.fields"
                  },
                  "value": {
                    "from": "studio.draftPreviewExternalContext"
                  },
                  "saveLabel": {
                    "expression": "studio.selected.draft.artifact.payload.contextFormSpec.saveLabel ? studio.selected.draft.artifact.payload.contextFormSpec.saveLabel : 'Apply context'"
                  },
                  "discardLabel": {
                    "expression": "studio.selected.draft.artifact.payload.contextFormSpec.discardLabel ? studio.selected.draft.artifact.payload.contextFormSpec.discardLabel : 'Discard'"
                  }
                },
                "visibility": "studio.selected.draft.artifact.payload.contextFormSpec != null"
              },
              "blueprint-draft-preview-content": {
                "capability": "gik:blueprint",
                "bindings": {
                  "blueprint": {
                    "expression": "{'$ref':studio.selected.draft.ref}"
                  },
                  "externalContext": {
                    "from": "studio.draftPreviewExternalContext"
                  },
                  "instanceKey": {
                    "expression": "studio.selected.draft.ref & ':' & studio.selected.draft.revision & ':' & $string(studio.draftPreviewExternalContext)"
                  }
                },
                "visibility": "studio.activeTab = 'preview-draft' and studio.selected.draft != null"
              }
            },
            "presentation": {
              "roots": [
                "studio-root"
              ],
              "composition": {
                "studio-root": {
                  "slots": {
                    "catalog": [
                      "blueprint-list-region"
                    ],
                    "workspace": [
                      "individual-blueprint"
                    ]
                  }
                },
                "blueprint-list-region": {
                  "slots": {
                    "create": [
                      "blueprint-new-form"
                    ],
                    "catalog": [
                      "blueprint-list"
                    ]
                  }
                },
                "individual-blueprint": {
                  "slots": {
                    "actions": [
                      "blueprint-actions"
                    ],
                    "content": [
                      "individual-blueprint-tabs"
                    ]
                  }
                },
                "blueprint-actions": {
                  "slots": {
                    "children": [
                      "blueprint-edit-action",
                      "blueprint-promote-draft-action",
                      "blueprint-delete-draft-action",
                      "blueprint-delete-action"
                    ]
                  }
                },
                "individual-blueprint-tabs": {
                  "slots": {
                    "children": [
                      "blueprint-overview-pane",
                      "blueprint-form-pane",
                      "blueprint-draft-form-pane",
                      "blueprint-preview-pane",
                      "blueprint-draft-preview-pane"
                    ]
                  }
                },
                "blueprint-preview-pane": {
                  "slots": {
                    "context": [
                      "blueprint-preview-context-form"
                    ],
                    "content": [
                      "blueprint-preview-content"
                    ]
                  }
                },
                "blueprint-draft-preview-pane": {
                  "slots": {
                    "context": [
                      "blueprint-draft-preview-context-form"
                    ],
                    "content": [
                      "blueprint-draft-preview-content"
                    ]
                  }
                }
              }
            }
          }
        ],
        "fallback": "studio-read-workspace"
      }
    ],
    "services": {
      "blueprint-studio-data": {
        "blueprint": {
          "$ref": "blueprint:blueprint-studio-crud@1.0.0"
        },
        "version": "1",
        "operations": {
          "listBlueprints": {
            "operation": "list-blueprints",
            "contract": "blueprint-studio-list/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "fetchBlueprint": {
            "operation": "fetch-blueprint",
            "contract": "blueprint-studio-record/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':input.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "createDraft": {
            "operation": "create-draft",
            "contract": "blueprint-studio-create-draft/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':studio.selectedBlueprintId}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "response.blueprint ? {'ops':[{'op':'set','path':'studio.selected','value':response.blueprint},{'op':'set','path':'studio.activeTab','value':'draft'}]} : {'ops':[]}"
              }
            }
          },
          "createBlueprintDraft": {
            "operation": "create-blueprint-draft",
            "contract": "blueprint-studio-create-blueprint-draft/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "($id := $trim(input.values.id); {'id':$id,'blueprint':{'gik':'0.1','type':'blueprint','payload':{'id':$id,'kind':input.values.kind,'version':input.values.version,'structureMode':'fixed','tiers':[],'recipes':[],'runtime':{'expression':'jsonata','namespaces':[],'actions':[],'state':{}},'cells':{}}}})"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "response.blueprint ? {'ops':[{'op':'set','path':'studio.selectedBlueprintId','value':response.blueprint.id},{'op':'set','path':'studio.selected','value':response.blueprint},{'op':'set','path':'studio.blueprints','value':response.blueprints},{'op':'set','path':'studio.blueprintOptions','value':response.blueprints.{'value':id,'label':label & ' · ' & version}},{'op':'set','path':'studio.activeTab','value':'draft'}]} : {'ops':[]}"
              }
            }
          },
          "saveDraft": {
            "operation": "save-draft",
            "contract": "blueprint-studio-save-draft/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':studio.selectedBlueprintId,'blueprint':input.values}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "response.blueprint ? {'ops':[{'op':'set','path':'studio.selected','value':response.blueprint}]} : {'ops':[]}"
              }
            }
          },
          "deleteDraft": {
            "operation": "delete-draft",
            "contract": "blueprint-studio-delete-draft/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':studio.selectedBlueprintId}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "response.deleted ? {'ops':[{'op':'set','path':'studio.selectedBlueprintId','value':''},{'op':'set','path':'studio.selected','value':null},{'op':'set','path':'studio.blueprints','value':response.blueprints},{'op':'set','path':'studio.blueprintOptions','value':response.blueprints.{'value':id,'label':label & ' · ' & version}},{'op':'set','path':'studio.activeTab','value':'overview'}]} : response.blueprint ? {'ops':[{'op':'set','path':'studio.selected','value':response.blueprint},{'op':'set','path':'studio.activeTab','value':'form'}]} : {'ops':[]}"
              }
            }
          },
          "promoteDraft": {
            "operation": "promote-draft",
            "contract": "blueprint-studio-promote-draft/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':studio.selectedBlueprintId}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "response.blueprint ? {'ops':[{'op':'set','path':'studio.selected','value':response.blueprint},{'op':'set','path':'studio.blueprints','value':response.blueprints},{'op':'set','path':'studio.blueprintOptions','value':response.blueprints.{'value':id,'label':label & ' · ' & version}},{'op':'set','path':'studio.selectedBlueprintRef','value':response.blueprint.ref},{'op':'set','path':'studio.previewBlueprintRef','value':response.blueprint.ref},{'op':'set','path':'studio.activeTab','value':'overview'}]} : {'ops':[]}"
              }
            }
          },
          "deleteBlueprint": {
            "operation": "delete-blueprint",
            "contract": "blueprint-studio-delete/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':studio.selectedBlueprintId}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "response.deleted ? {'ops':[{'op':'set','path':'studio.selectedBlueprintId','value':''},{'op':'set','path':'studio.selected','value':null},{'op':'set','path':'studio.blueprints','value':response.blueprints},{'op':'set','path':'studio.blueprintOptions','value':response.blueprints.{'value':id,'label':label & ' · ' & version}},{'op':'set','path':'studio.activeTab','value':'overview'}]} : {'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["studio"],
      "actions": ["assign", "invoke"],
      "capabilities": {
        "gik:blueprint": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:container": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": ["children"]
        },
        "primitive:form": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:list": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": ["select"]
        },
        "fluent:button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": ["press"]
        },
        "fluent:spinner": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:tab-bar": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": ["select"]
        },
        "fluent:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "fluent": {
            "from": "fluent",
            "use": ["button", "list", "spinner", "tab-bar", "text"]
          },
          "primitive": {
            "from": "primitive",
            "use": ["container", "form", "markdown"]
          }
        }
      },
      "state": {
        "studio": {
          "selectedBlueprintId": "",
          "activeTab": "overview",
          "blueprints": [],
          "blueprintOptions": [],
          "selected": null,
          "overviewMarkdown": "",
          "previewContextFormSpec": null,
          "previewBlueprintRef": "",
          "previewExternalContext": {},
          "draftPreviewExternalContext": {}
        }
      }
    },
    "cells": {
      "studio-root": {
        "id": "studio-root"
      },
      "blueprint-list-region": {
        "id": "blueprint-list-region",
        "kind": "blueprint-list-region"
      },
      "blueprint-list": {
        "id": "blueprint-list",
        "kind": "blueprint-list",
        "systemInputs": ["numSourcesRunning"],
        "inputs": [
          {
            "token": "studio.selectedBlueprintId",
            "as": "selectedBlueprintId"
          }
        ],
        "sources": [
          {
            "id": "blueprint-list.source",
            "service": "blueprint-studio-data",
            "operation": "listBlueprints",
            "contract": "blueprint-studio-list/v1",
            "output": {
              "kind": "jsonata",
              "expr": "response.blueprints"
            }
          }
        ],
        "compute": [
          {
            "id": "blueprint-records",
            "expression": "$exists(sources.`blueprint-list.source`) ? sources.`blueprint-list.source` : []",
            "assign": "studio.blueprints",
            "dependencies": ["sources.blueprint-list.source"]
          },
          {
            "id": "blueprint-options",
            "expression": "$exists(sources.`blueprint-list.source`) ? sources.`blueprint-list.source`.{'value':id,'label':label & ' · ' & version} : []",
            "assign": "studio.blueprintOptions",
            "dependencies": ["sources.blueprint-list.source"]
          }
        ],
        "outputs": [
          {
            "token": "selectedBlueprintId",
            "from": "inputs.selectedBlueprintId",
            "when": "$exists(inputs.selectedBlueprintId) and $length(inputs.selectedBlueprintId) > 0"
          }
        ],
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "studio.selectedBlueprintId",
                "args": {
                  "from": "$event.values[0]"
                }
              }
            ]
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "blueprint-new-form": {
        "id": "blueprint-new-form",
        "kind": "blueprint-new-form",
        "behavior": {
          "on": {
            "save": [
              {
                "do": "invoke",
                "control": { "tool": "createBlueprintDraft" }
              }
            ]
          }
        },
        "events": {
          "save": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "individual-blueprint": {
        "id": "individual-blueprint",
        "kind": "individual-blueprint",
        "inputs": [
          {
            "token": "selectedBlueprintId",
            "as": "selectedBlueprintId",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "individual-blueprint.source",
            "service": "blueprint-studio-data",
            "operation": "fetchBlueprint",
            "contract": "blueprint-studio-record/v1",
            "input": {
              "kind": "jsonata",
              "expr": "{'id':inputs.selectedBlueprintId}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response"
            }
          }
        ],
        "compute": [
          {
            "id": "selected-blueprint",
            "expression": "sources.`individual-blueprint.source`",
            "assign": "studio.selected",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-overview",
            "expression": "($bp := sources.`individual-blueprint.source`; $bp.artifact ? '# ' & $bp.id & '\\n\\n- **Version:** ' & $bp.version & '\\n- **Kind:** ' & $bp.kind & '\\n- **Source:** ' & ($bp.readonly ? 'Repository bootstrap' : 'User workspace') & '\\n- **Tiers:** ' & $join($bp.artifact.payload.tiers.id, ', ') & '\\n- **Recipes:** ' & $string($count($bp.artifact.payload.recipes)) : $bp ? '# ' & $bp.id & '\\n\\nDraft only; promote the draft to create the first published version.' : '')",
            "assign": "studio.overviewMarkdown",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-context-form",
            "expression": "sources.`individual-blueprint.source`.artifact.payload.contextFormSpec",
            "assign": "studio.previewContextFormSpec",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-reference",
            "expression": "($bp := sources.`individual-blueprint.source`.artifact.payload; $bp ? 'blueprint:' & $bp.id & '@' & $bp.version : '')",
            "assign": "studio.selectedBlueprintRef",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-initial-context",
            "expression": "($spec := sources.`individual-blueprint.source`.artifact.payload.contextFormSpec; $spec ? $merge([$merge($keys($spec.fields.properties).($name := $; $field := $lookup($spec.fields.properties, $name); $exists($field.default) ? {$name:$field.default} : {})), $spec.initialValue ? $spec.initialValue : {}]) : {})",
            "assign": "studio.previewExternalContext",
            "dependencies": ["sources.individual-blueprint.source"]
          }
        ],
        "outputs": [
          {
            "token": "selectedBlueprintRef",
            "from": "computed.studio.selectedBlueprintRef",
            "when": "$exists(computed.studio.selectedBlueprintRef) and $length(computed.studio.selectedBlueprintRef) > 0"
          }
        ]
      },
