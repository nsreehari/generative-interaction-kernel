{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "blueprint-studio",
    "kind": "blueprint-studio",
    "version": "1.0.0",
    "structureMode": "fixed",
    "tiers": [
      {
        "id": "studio-domain",
        "kind": "blueprint-studio-domain"
      },
      {
        "id": "studio-presentation",
        "kind": "runtime-document"
      }
    ],
    "recipes": [
      {
        "id": "studio-domain-to-presentation",
        "from": "studio-domain",
        "to": "studio-presentation",
        "representations": [
          {
            "id": "studio-read-workspace",
            "views": {
              "studio-root": {
                "capability": "primitive:container",
                "props": {
                  "variant": "row",
                  "gap": "m",
                  "fill": true,
                  "fullWidth": true,
                  "ariaLabel": "Blueprint Studio",
                  "style": {
                    "gridTemplateColumns": "minmax(16rem, 22rem) minmax(0, 1fr)",
                    "alignItems": "start"
                  }
                }
              },
              "blueprint-list": {
                "capability": "fluent:list",
                "props": {
                  "variant": "selectable",
                  "selectionMode": "single",
                  "ariaLabel": "Blueprints"
                },
                "before": [
                  {
                    "capability": "fluent:text",
                    "props": {
                      "value": "Blueprints",
                      "as": "h2",
                      "variant": "subtitle",
                      "block": true
                    }
                  },
                  {
                    "capability": "fluent:spinner",
                    "props": {
                      "label": "Loading Blueprints",
                      "size": "medium"
                    },
                    "visibility": "systemInputs.numSourcesRunning > 0"
                  }
                ],
                "bindings": {
                  "items": {
                    "from": "studio.blueprintOptions"
                  },
                  "selectedValues": {
                    "expression": "studio.selectedId != '' ? [studio.selectedId] : []"
                  }
                }
              },
              "individual-blueprint": {
                "capability": "primitive:container",
                "props": {
                  "variant": "column",
                  "gap": "m",
                  "fill": true,
                  "ariaLabel": "Selected Blueprint"
                },
                "before": [
                  {
                    "capability": "fluent:text",
                    "props": {
                      "as": "h2",
                      "variant": "subtitle",
                      "block": true
                    },
                    "bindings": {
                      "value": {
                        "expression": "studio.selected ? studio.selected.id : 'Select a Blueprint'"
                      }
                    }
                  },
                  {
                    "capability": "fluent:tab-bar",
                    "props": {
                      "options": [
                        { "value": "overview", "label": "Overview" },
                        { "value": "form", "label": "Form" },
                        { "value": "preview", "label": "Preview" }
                      ]
                    },
                    "bindings": {
                      "active": {
                        "from": "studio.activeTab"
                      }
                    },
                    "visibility": "studio.selected != null"
                  },
                  {
                    "capability": "primitive:markdown",
                    "bindings": {
                      "value": {
                        "from": "studio.overviewMarkdown"
                      }
                    },
                    "visibility": "studio.selected != null and studio.activeTab = 'overview'"
                  },
                  {
                    "capability": "primitive:form",
                    "props": {
                      "fields": {
                        "properties": {
                          "id": {
                            "title": "Blueprint ID",
                            "type": "string",
                            "span": 12
                          },
                          "blueprint": {
                            "title": "Blueprint JSON",
                            "type": "json",
                            "format": "json",
                            "rows": 24,
                            "span": 12
                          }
                        },
                        "required": ["id", "blueprint"]
                      }
                    },
                    "bindings": {
                      "value": {
                        "expression": "{'id':studio.selected.id,'blueprint':studio.selected.artifact}"
                      },
                      "readOnly": {
                        "expression": "true"
                      }
                    },
                    "visibility": "studio.selected != null and studio.activeTab = 'form'"
                  },
                  {
                    "capability": "gik:blueprint",
                    "bindings": {
                      "blueprint": {
                        "expression": "studio.selected.artifact"
                      }
                    },
                    "visibility": "studio.selected != null and studio.activeTab = 'preview'"
                  }
                ]
              }
            },
            "presentation": {
              "roots": ["studio-root"],
              "placements": [
                {
                  "cell": "blueprint-list",
                  "parent": "studio-root",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "individual-blueprint",
                  "parent": "studio-root",
                  "slot": "children",
                  "order": 1
                }
              ]
            }
          }
        ],
        "fallback": "studio-read-workspace"
      }
    ],
    "services": {
      "blueprint-studio-data": {
        "blueprint": {
          "$ref": "blueprint:blueprint-studio-crud@1.0.0"
        },
        "version": "1",
        "operations": {
          "listBlueprints": {
            "operation": "list-blueprints",
            "contract": "blueprint-studio-list/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          },
          "fetchBlueprint": {
            "operation": "fetch-blueprint",
            "contract": "blueprint-studio-record/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'id':input.id}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["studio"],
      "actions": ["assign"],
      "capabilities": {
        "gik:blueprint": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:container": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": ["children"]
        },
        "primitive:form": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:list": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": ["select"]
        },
        "fluent:spinner": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:tab-bar": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": ["select"]
        },
        "fluent:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "fluent": {
            "from": "fluent",
            "use": ["list", "spinner", "tab-bar", "text"]
          },
          "primitive": {
            "from": "primitive",
            "use": ["container", "form", "markdown"]
          }
        }
      },
      "state": {
        "studio": {
          "selectedId": "",
          "activeTab": "overview",
          "blueprints": [],
          "blueprintOptions": [],
          "selected": null,
          "overviewMarkdown": ""
        }
      }
    },
    "cells": {
      "studio-root": {
        "id": "studio-root"
      },
      "blueprint-list": {
        "id": "blueprint-list",
        "kind": "blueprint-list",
        "systemInputs": ["numSourcesRunning"],
        "inputs": [
          {
            "token": "studio.selectedId",
            "as": "selection"
          }
        ],
        "sources": [
          {
            "id": "blueprint-list.source",
            "service": "blueprint-studio-data",
            "operation": "listBlueprints",
            "contract": "blueprint-studio-list/v1",
            "output": {
              "kind": "jsonata",
              "expr": "response.blueprints"
            }
          }
        ],
        "compute": [
          {
            "id": "blueprint-records",
            "expression": "$exists(sources.`blueprint-list.source`) ? sources.`blueprint-list.source` : []",
            "assign": "studio.blueprints",
            "dependencies": ["sources.blueprint-list.source"]
          },
          {
            "id": "blueprint-options",
            "expression": "$exists(sources.`blueprint-list.source`) ? sources.`blueprint-list.source`.{'value':id,'label':label & ' · ' & version} : []",
            "assign": "studio.blueprintOptions",
            "dependencies": ["sources.blueprint-list.source"]
          }
        ],
        "outputs": [
          {
            "token": "selected_bp",
            "from": "inputs.selection",
            "when": "$exists(inputs.selection) and $length(inputs.selection) > 0"
          }
        ],
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "studio.selectedId",
                "args": {
                  "from": "$event.values[0]"
                }
              }
            ]
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "individual-blueprint": {
        "id": "individual-blueprint",
        "kind": "individual-blueprint",
        "inputs": [
          {
            "token": "selected_bp",
            "as": "selectedBp",
            "required": true
          }
        ],
        "sources": [
          {
            "id": "individual-blueprint.source",
            "service": "blueprint-studio-data",
            "operation": "fetchBlueprint",
            "contract": "blueprint-studio-record/v1",
            "input": {
              "kind": "jsonata",
              "expr": "{'id':inputs.selectedBp}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response"
            }
          }
        ],
        "compute": [
          {
            "id": "selected-blueprint",
            "expression": "sources.`individual-blueprint.source`",
            "assign": "studio.selected",
            "dependencies": ["sources.individual-blueprint.source"]
          },
          {
            "id": "selected-blueprint-overview",
            "expression": "($bp := sources.`individual-blueprint.source`; $bp ? '# ' & $bp.id & '\\n\\n- **Version:** ' & $bp.version & '\\n- **Kind:** ' & $bp.kind & '\\n- **Source:** ' & ($bp.readonly ? 'Repository bootstrap' : 'User workspace') & '\\n- **Tiers:** ' & $join($bp.artifact.payload.tiers.id, ', ') & '\\n- **Recipes:** ' & $string($count($bp.artifact.payload.recipes)) : '')",
            "assign": "studio.overviewMarkdown",
            "dependencies": ["sources.individual-blueprint.source"]
          }
        ],
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "studio.activeTab",
                "args": {
                  "from": "$event.value"
                }
              }
            ]
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
