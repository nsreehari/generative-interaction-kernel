{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "backend-order-processing",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "interface": {
      "events": ["submit", "approve", "charged", "declined"]
    },
    "recipes": [],
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["order", "payment"],
      "actions": ["assign", "confirm", "invoke", "route"],
      "state": {
        "order": {
          "status": "draft",
          "fulfillment": "not_queued",
          "amount": 129.5
        },
        "payment": {
          "status": "not_started",
          "receipt": null
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Headless order workflow driven by backend events and orchestrator effects."
      }
    ],
    "cells": {
      "order-controller": {
        "id": "order-controller",
        "kind": "backend-workflow",
        "behavior": {
          "events": {
            "submit": [
              { "do": "assign", "target": "order.status", "args": { "value": "pending_review" } },
              { "do": "confirm", "args": { "message": "Manager approval required", "onConfirm": "approve" } }
            ],
            "approve": [
              { "do": "assign", "target": "order.status", "args": { "value": "charging" } },
              { "do": "assign", "target": "payment.status", "args": { "value": "processing" } },
              { "do": "invoke", "args": { "tool": "chargeCard" } }
            ],
            "charged": [
              { "do": "assign", "target": "order.status", "args": { "value": "confirmed" } },
              { "do": "assign", "target": "payment.status", "args": { "value": "captured" } },
              { "do": "assign", "target": "order.fulfillment", "args": { "value": "queued" } },
              { "do": "route", "args": { "to": "queue:fulfillment" } }
            ],
            "declined": [
              { "do": "assign", "target": "order.status", "args": { "value": "payment_failed" } },
              { "do": "assign", "target": "payment.status", "args": { "value": "declined" } }
            ]
          }
        }
      }
    },
    "metadata": {
      "scope": "backend",
      "executionMedium": "headless",
      "nativeEffects": "native/effect_handlers/backendOrderProcessingEffectHandlers.ts"
    }
  }
}