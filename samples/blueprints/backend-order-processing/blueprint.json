{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "backend-order-processing",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "interface": {
      "events": ["submit", "approve", "charged", "declined"]
    },
    "recipes": [],
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["order", "payment"],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "state": {
        "order": {
          "status": "draft",
          "fulfillment": "not_queued",
          "amount": 129.5
        },
        "payment": {
          "status": "not_started",
          "receipt": null
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Headless order workflow driven by backend events and orchestrator effects."
      }
    ],
    "cells": {
      "order-controller": {
        "id": "order-controller",
        "kind": "backend-workflow",
        "behavior": {
          "on": {
            "submit": [
              {
                "do": "assign",
                "target": "order.status",
                "args": {
                  "value": "pending_review"
                }
              },
              {
                "do": "request",
                "control": {
                  "kind": "decision",
                  "responseSchema": {
                    "type": "object",
                    "required": ["approved"],
                    "properties": {
                      "approved": { "type": "boolean" }
                    }
                  }
                },
                "data": {
                  "message": "Manager approval required",
                  "amount": 129.5
                }
              }
            ],
            "resolved": [
              {
                "do": "assign",
                "target": "order.status",
                "args": {
                  "value": "charging"
                }
              },
              {
                "do": "assign",
                "target": "payment.status",
                "args": {
                  "value": "processing"
                }
              },
              {
                "do": "invoke",
                "control": {
                  "tool": "chargeCard"
                }
              }
            ],
            "charged": [
              {
                "do": "assign",
                "target": "order.status",
                "args": {
                  "value": "confirmed"
                }
              },
              {
                "do": "assign",
                "target": "payment.status",
                "args": {
                  "value": "captured"
                }
              },
              {
                "do": "assign",
                "target": "order.fulfillment",
                "args": {
                  "value": "queued"
                }
              },
              {
                "do": "route",
                "control": {
                  "to": "queue:fulfillment"
                }
              }
            ],
            "declined": [
              {
                "do": "assign",
                "target": "order.status",
                "args": {
                  "value": "payment_failed"
                }
              },
              {
                "do": "assign",
                "target": "payment.status",
                "args": {
                  "value": "declined"
                }
              }
            ]
          }
        },
        "events": {
          "submit": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "resolved": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "charged": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "declined": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    },
    "metadata": {
      "scope": "backend",
      "executionMedium": "headless",
      "nativeEffects": "native/effect_handlers/backendOrderProcessingEffectHandlers.ts"
    }
  }
}