{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-report-explorer-3",
    "kind": "incident-semantic-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": { "inputs": { "incident_report": { "required": true, "schema": { "type": "string" }, "description": "Incident report Markdown supplied by the parent Blueprint." } } },
    "agentLifecycle": {
      "profiles": {
        "use": {
          "id": "use-blueprint",
          "version": "1.0.0",
          "description": "Use the incident report explorer to select or edit source material and request source-faithful semantic analysis.",
          "targetKinds": ["blueprint-instance", "incident-report"],
          "intentKinds": ["select-sample", "save-report", "analyze-report"],
          "goals": [
            "Preserve source assertions and ordering while producing the declared semantic incident model.",
            "Complete only operations declared by the incident report explorer runtime."
          ],
          "constraints": [
            "Do not infer or invent incident facts, causality, status, severity, urgency, attribution, or recommendations.",
            "Return semantic facts and representation notes rather than components, layout, styling, flights, or presentation variants.",
            "Do not propose Foundry credential changes or structural changes to this fixed Blueprint.",
            "Do not select flights, fullscreen state, or presentation presets; authored interactions and lowering own representation."
          ]
        }
      }
    },
    "tiers": [
      {
        "id": "incident-semantic",
        "kind": "incident-semantic-model",
        "description": "Normalized incident facts, relationships, evidence, response actions, and explicit representation notes."
      },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [
      {
        "id": "incident-semantic-to-runtime",
        "from": "incident-semantic",
        "to": "runtime-document",
        "representations": [
          {
            "id": "hosted-analysis",
            "when": "externalContext.hostedAnalysis = true",
            "views": {
              "foundry-access-gate": { "capability": "host:credential-access", "props": { "dependency": { "kind": "credential", "ref": "foundry-agent/access-key" } }, "bindings": { "access": { "expression": "{'title':'Connect to Foundry','requiredMessage':'Enter your access key to continue.','checkingMessage':'Checking Foundry access...','errorMessage':\"Couldn't verify Foundry access.\",'triggered': incident3.foundryAccessStatus != 'ready' and incident3.foundryAccessStatus != 'empty', 'status': incident3.foundryAccessStatus = 'checking' ? 'checking' : (incident3.foundryAccessStatus = 'required' ? 'required' : 'error'), 'error': incident3.foundryAccessError}" } } },
              "incident-semantic-analyzer": { "capability": "incident3:report", "props": { "title": "Source-faithful views" }, "bindings": { "value": { "from": "incident3.model" }, "content": { "expression": "externalContext.incident_report" }, "analyzedContent": { "from": "incident3.analyzedContent" }, "error": { "from": "incident3.error" }, "fullscreen": { "from": "incident3.fullscreen" }, "pending": { "from": "incident3.analysisPending" } } },
              "incident-analyze-report": { "capability": "fluent:button", "props": { "label": "Analyze report", "appearance": "primary" }, "bindings": { "disabled": { "from": "incident3.analysisPending" }, "loading": { "from": "incident3.analysisPending" } }, "visibility": "incident3.model = null or externalContext.incident_report != incident3.analyzedContent" },
              "incident-flight-a": { "capability": "incident3:incident-story", "bindings": { "value": { "from": "incident3.model" } } },
              "incident-flight-b": { "capability": "incident3:investigation-canvas", "bindings": { "value": { "from": "incident3.model" } } }
            },
            "presentation": {
              "roots": ["foundry-access-gate"],
              "placements": [
                { "cell": "incident-semantic-analyzer", "parent": "foundry-access-gate", "slot": "children", "order": 0 },
                { "cell": "incident-flight-a", "parent": "incident-semantic-analyzer", "slot": "children", "order": 0 },
                { "cell": "incident-flight-b", "parent": "incident-semantic-analyzer", "slot": "children", "order": 1 },
                { "cell": "incident-analyze-report", "parent": "incident-semantic-analyzer", "slot": "children", "order": 2 }
              ]
            }
          },
          {
            "id": "operational",
            "when": "externalContext.attention = 'operational'",
            "views": {
              "incident-workspace": { "capability": "incident3:workspace", "props": { "title": "Incident intelligence", "preset": "flights" }, "bindings": { "fullscreen": { "from": "incident3.fullscreen" } } },
              "foundry-access-gate": { "capability": "host:credential-access", "props": { "dependency": { "kind": "credential", "ref": "foundry-agent/access-key" } }, "bindings": { "access": { "expression": "{'title': incident3.foundryAccessStatus = 'unconfigured' ? 'Foundry is unavailable' : 'Connect to Foundry', 'requiredMessage':'Enter your access key to continue.', 'checkingMessage':'Checking Foundry access...', 'errorMessage': incident3.foundryAccessStatus = 'unconfigured' ? 'Configure the Foundry proxy for this host before running semantic analysis.' : 'Unable to verify Foundry access.', 'triggered': incident3.foundryAccessStatus != 'ready' and incident3.foundryAccessStatus != 'empty', 'status': incident3.foundryAccessStatus = 'checking' ? 'checking' : (incident3.foundryAccessStatus = 'required' ? 'required' : 'error'), 'error': incident3.foundryAccessError}" } } },
              "incident-semantic-analyzer": { "capability": "incident3:report", "props": { "title": "Two flights · one source" }, "bindings": { "value": { "from": "incident3.model" }, "content": { "expression": "externalContext.incident_report" }, "analyzedContent": { "from": "incident3.analyzedContent" }, "error": { "from": "incident3.error" }, "fullscreen": { "from": "incident3.fullscreen" }, "pending": { "from": "incident3.analysisPending" } } },
              "incident-analyze-report": { "capability": "fluent:button", "props": { "label": "Analyze report", "appearance": "primary" }, "bindings": { "disabled": { "from": "incident3.analysisPending" }, "loading": { "from": "incident3.analysisPending" } }, "visibility": "incident3.model = null or externalContext.incident_report != incident3.analyzedContent" },
              "incident-view-fullscreen": { "capability": "fluent:button", "props": { "variant": "icon", "icon": "full-screen-maximize", "ariaLabel": "View full screen" }, "visibility": "incident3.model != null and $not(incident3.fullscreen)" },
              "incident-exit-fullscreen": { "capability": "fluent:button", "props": { "variant": "icon", "icon": "full-screen-minimize", "ariaLabel": "Exit full screen" }, "visibility": "incident3.fullscreen" },
              "incident-flight-a": { "capability": "incident3:incident-story", "bindings": { "value": { "from": "incident3.model" } } },
              "incident-flight-b": { "capability": "incident3:investigation-canvas", "bindings": { "value": { "from": "incident3.model" } } }
            },
            "presentation": {
              "roots": ["incident-workspace"],
              "placements": [
                { "cell": "foundry-access-gate", "parent": "incident-workspace", "slot": "children", "order": 1 },
                { "cell": "incident-semantic-analyzer", "parent": "foundry-access-gate", "slot": "children", "order": 0 },
                { "cell": "incident-flight-a", "parent": "incident-semantic-analyzer", "slot": "children", "order": 0 },
                { "cell": "incident-flight-b", "parent": "incident-semantic-analyzer", "slot": "children", "order": 1 },
                { "cell": "incident-analyze-report", "parent": "incident-semantic-analyzer", "slot": "children", "order": 2 },
                { "cell": "incident-view-fullscreen", "parent": "incident-semantic-analyzer", "slot": "children", "order": 3 },
                { "cell": "incident-exit-fullscreen", "parent": "incident-semantic-analyzer", "slot": "children", "order": 4 }
              ]
            }
          },
          {
            "id": "brief",
            "when": "externalContext.attention = 'brief'",
            "extends": "operational",
            "views": {
              "incident-workspace": { "capability": "incident3:workspace", "props": { "title": "Incident intelligence", "preset": "flights" }, "bindings": { "fullscreen": { "from": "incident3.fullscreen" } } },
              "incident-semantic-analyzer": { "capability": "incident3:report", "props": { "title": "Two flights · one source" }, "bindings": { "value": { "from": "incident3.model" }, "content": { "expression": "externalContext.incident_report" }, "analyzedContent": { "from": "incident3.analyzedContent" }, "error": { "from": "incident3.error" }, "fullscreen": { "from": "incident3.fullscreen" }, "pending": { "from": "incident3.analysisPending" } } }
            },
            "presentation": {
              "roots": ["incident-workspace"],
              "placements": [
                { "cell": "foundry-access-gate", "parent": "incident-workspace", "slot": "children", "order": 1 },
                { "cell": "incident-semantic-analyzer", "parent": "foundry-access-gate", "slot": "children", "order": 0 },
                { "cell": "incident-flight-a", "parent": "incident-semantic-analyzer", "slot": "children", "order": 0 },
                { "cell": "incident-flight-b", "parent": "incident-semantic-analyzer", "slot": "children", "order": 1 },
                { "cell": "incident-analyze-report", "parent": "incident-semantic-analyzer", "slot": "children", "order": 2 },
                { "cell": "incident-view-fullscreen", "parent": "incident-semantic-analyzer", "slot": "children", "order": 3 },
                { "cell": "incident-exit-fullscreen", "parent": "incident-semantic-analyzer", "slot": "children", "order": 4 }
              ]
            }
          }
        ],
        "fallback": "operational"
      }
    ],
    "services": {
      "incident-semantic-analysis": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "analyzeReport": {
            "operation": "chat",
            "contract": "incident-semantic-model/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'message':'Extract a source-faithful incident semantic model from this investigation report. Report Markdown:\n\n' & state.incident3.pendingContent,'instructions':'Return only facts, relationships, verdicts, impacts, priorities, and actions explicitly asserted by the source document. Do not infer causality, compromise status, severity, urgency, attribution, or recommendations. Do not choose components, layouts, disclosure, colors, flights, or presentation candidates. Preserve source ordering and typed references. Put ambiguity, missing linkage, normalization loss, unsupported concepts, conflicting evidence, and schema gaps in representationNotes rather than resolving them. Use stable concise ids and reference only ids declared in this response.','maxOutputTokens':10000}"
              }
            },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "provider-structured-output",
                  "message": "Incident semantic model is invalid",
                  "schema": {
                    "type": "object",
                    "required": ["identity", "verdict", "summary", "phases", "entities", "relationships", "events", "techniques", "alerts", "evidence", "indicators", "impacts", "actions", "representationNotes"],
                    "properties": {
                      "identity": { "type": "object", "required": ["incidentId", "title", "startTime", "endTime"], "properties": { "incidentId": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "startTime": { "type": "string" }, "endTime": { "type": "string" } }, "additionalProperties": false },
                      "verdict": { "type": "object", "required": ["classification", "determination", "confidence", "rationale", "impact"], "properties": { "classification": { "type": "string", "minLength": 1 }, "determination": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] }, "rationale": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
                      "summary": { "type": "string", "minLength": 1 },
                      "phases": { "type": "array", "items": { "type": "object", "required": ["id", "name", "order", "summary"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "summary": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
                      "entities": { "type": "array", "items": { "type": "object", "required": ["id", "type", "label", "status", "role", "description", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "enum": ["actor", "ip", "user", "mailbox", "device", "virtual-machine", "managed-identity", "service-principal", "application", "secret", "storage", "data-asset", "cloud-resource", "other"] }, "label": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["compromised", "affected", "targeted", "observed", "unknown"] }, "role": { "type": "string" }, "description": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "relationships": { "type": "array", "items": { "type": "object", "required": ["id", "sourceId", "targetId", "kind", "label", "phaseId", "evidenceIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["targeted", "sprayed", "authenticated-to", "stole-token-from", "enumerated", "retrieved-secret-from", "retrieved-keys-for", "accessed", "collected-from", "exfiltrated-from", "pivoted-to", "other"] }, "label": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "events": { "type": "array", "items": { "type": "object", "required": ["id", "time", "title", "detail", "phaseId", "entityIds", "evidenceIds", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "time": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "entityIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "techniques": { "type": "array", "items": { "type": "object", "required": ["id", "tactic", "technique", "techniqueId", "description", "phaseId", "evidenceIds", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "tactic": { "type": "string", "minLength": 1 }, "technique": { "type": "string", "minLength": 1 }, "techniqueId": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "alerts": { "type": "array", "items": { "type": "object", "required": ["id", "title", "verdict", "summary", "eventIds", "evidenceIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "verdict": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "eventIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "evidence": { "type": "array", "items": { "type": "object", "required": ["id", "sourceType", "timestamp", "summary", "correlationId"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceType": { "type": "string", "minLength": 1 }, "timestamp": { "type": "string" }, "summary": { "type": "string", "minLength": 1 }, "correlationId": { "type": "string" } }, "additionalProperties": false } },
                      "indicators": { "type": "array", "items": { "type": "object", "required": ["id", "type", "value", "context", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 }, "context": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "impacts": { "type": "array", "items": { "type": "object", "required": ["id", "category", "title", "detail", "severity", "entityIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "category": { "type": "string", "enum": ["credential-exposure", "data-access", "data-exfiltration", "identity-compromise", "resource-compromise", "business-impact", "other"] }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] }, "entityIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "actions": { "type": "array", "items": { "type": "object", "required": ["id", "priority", "category", "title", "detail", "entityIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "priority": { "type": "string", "enum": ["immediate", "next", "follow-up"] }, "category": { "type": "string", "enum": ["containment", "investigation", "recovery", "hardening"] }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "entityIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "representationNotes": { "type": "array", "items": { "type": "object", "required": ["id", "category", "severity", "sourceSection", "commentary", "suggestedVocabularyExtension"], "properties": { "id": { "type": "string", "minLength": 1 }, "category": { "type": "string", "enum": ["source-ambiguity", "insufficient-evidence", "normalization-loss", "unsupported-concept", "conflicting-evidence", "schema-gap"] }, "severity": { "type": "string", "enum": ["info", "warning", "critical"] }, "sourceSection": { "type": "string" }, "commentary": { "type": "string", "minLength": 1 }, "suggestedVocabularyExtension": { "type": "string" } }, "additionalProperties": false } }
                    },
                    "additionalProperties": false
                  }
                }
              ]
            },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident3.model','value':response},{'op':'set','path':'incident3.analyzedContent','value':state.incident3.pendingContent},{'op':'set','path':'incident3.pendingContent','value':null},{'op':'set','path':'incident3.analysisPending','value':false},{'op':'set','path':'incident3.error','value':''}],'events':externalContext.sourceId and externalContext.analyzerId and externalContext.variant ? [{'node':'incident-cache','name':'persist'}] : []}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'foundry-agent/access-key'; $access := $missing or error.status = 401 or error.status = 403; {'ops':[{'op':'set','path':'incident3.pendingContent','value':null},{'op':'set','path':'incident3.analysisPending','value':false},{'op':'set','path':'incident3.error','value':$access ? '' : error.message},{'op':'set','path':'incident3.foundryAccessStatus','value':$access ? 'required' : state.incident3.foundryAccessStatus},{'op':'set','path':'incident3.foundryAccessError','value':$access ? (error.status = 401 or error.status = 403 ? 'That access key was rejected.' : 'Foundry access is required.') : state.incident3.foundryAccessError}]})" } },
            "onViolation": { "action": "fail" }
          },
          "checkFoundryAccess": {
            "operation": "check-access",
            "contract": "foundry-access-check/v1",
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident3.foundryAccessStatus','value':'ready'},{'op':'set','path':'incident3.foundryAccessError','value':''}]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'foundry-agent/access-key'; {'ops':[{'op':'set','path':'incident3.foundryAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'incident3.foundryAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : error.message)}]})" } },
            "onViolation": { "action": "fail" }
          }
        },
        "config": { "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}", "agent": "Incident-Report-Semantic-Agent", "credentialRef": "foundry-agent/access-key" },
        "scope": "per-blueprint"
      },
      "incident-analysis-cache": {
        "blueprint": { "$ref": "blueprint:incident-analysis-assets@1.0.0" },
        "version": "1",
        "operations": {
          "persistIncidentAnalysis": {
            "operation": "put-asset",
            "contract": "incident-runtime-asset/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'sourceId':externalContext.sourceId,'analyzerId':externalContext.analyzerId,'variant':externalContext.variant,'value':state.incident3.model}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'detail':{'cacheKey':response.asset.sourceId & '/' & response.asset.analyzerId & '/' & response.asset.variant}}" } }
          }
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incident3"],
      "actions": ["assign", "invoke"],
      "capabilities": {
        "incident3:workspace": { "propsSchema": { "type": "object", "required": ["title", "preset"], "properties": { "title": { "type": "string" }, "preset": { "type": "string", "enum": ["flights"] } }, "additionalProperties": false }, "slots": ["children"] },
        "incident3:report": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["analyze"], "slots": ["children"], "dataProp": "value" },
        "incident3:incident-story": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:investigation-canvas": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:verdict-brief": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:attack-path": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:blast-radius": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:phase-timeline": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:ttp-chain": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:response-plan": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "incident3:representation-notes": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "host:credential-access": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["accessRequested", "accessCleared"], "slots": ["children"] },
        "fluent:button": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["press"] }
      },
      "externals": {
        "projectionViews": { "incident3": { "from": "self" }, "host": { "from": "host", "use": ["credential-access"] }, "fluent": { "from": "fluent", "use": ["button"] } },
        "effectHandlers": ["prepareAnalysis"]
      },
      "state": {
        "incident3": { "model": null, "analyzedContent": null, "pendingContent": null, "fullscreen": false, "analysisPending": false, "foundryAccessStatus": "checking", "foundryAccessError": "", "error": "" }
      }
    },
    "cells": {
      "incident-workspace": { "id": "incident-workspace", "kind": "workspace" },
      "foundry-access-gate": { "id": "foundry-access-gate", "kind": "access-gate", "behavior": { "events": { "accessRequested": [{ "do": "assign", "target": "incident3.foundryAccessStatus", "args": { "value": "checking" } }, { "do": "assign", "target": "incident3.foundryAccessError", "args": { "value": "" } }, { "do": "invoke", "args": { "tool": "checkFoundryAccess" } }], "accessCleared": [{ "do": "assign", "target": "incident3.foundryAccessStatus", "args": { "value": "checking" } }, { "do": "assign", "target": "incident3.foundryAccessError", "args": { "value": "" } }, { "do": "invoke", "args": { "tool": "checkFoundryAccess" } }] } } },
      "incident-semantic-analyzer": { "id": "incident-semantic-analyzer", "kind": "semantic-analysis-agent", "sources": [{ "id": "incident-semantic-analyzer.source", "service": "incident-semantic-analysis", "operation": "analyzeReport", "contract": "incident-semantic-model/v1" }], "behavior": { "events": { "analyze": [{ "do": "invoke", "args": { "tool": "prepareAnalysis" } }, { "do": "invoke", "args": { "tool": "analyzeReport" } }] } }, "outputs": [{ "token": "incident-semantic-model", "from": "incident3.model", "when": "incident3.model != null" }] },
