{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "portfolio-tracker-2tiers",
    "kind": "portfolio-intent-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "agentLifecycle": {
      "profiles": {
        "use": {
          "id": "use-blueprint",
          "version": "1.0.0",
          "description": "Use the portfolio tracker to maintain holdings and refresh market prices while authored lowering owns representation selection.",
          "targetKinds": ["blueprint-instance"],
          "intentKinds": ["set-holdings", "refresh-prices"],
          "goals": [
            "Keep holdings, quotes, positions, and summary values synchronized through declared operations."
          ],
          "constraints": [
            "Use declared holdings and market-data operations instead of directly mutating runtime state.",
            "Do not propose presentation variants; immutable external context and authored lowering select the representation.",
            "Do not invent holdings or market prices."
          ]
        }
      }
    },
    "tiers": [
      { "id": "portfolio-intent", "kind": "portfolio-domain" },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [
      {
        "id": "portfolio-intent-to-runtime",
        "from": "portfolio-intent",
        "to": "runtime-document",
        "representations": [
          {
            "id": "mobile-glanceable",
            "when": "externalContext.view = 'mobile' and externalContext.attention = 'glanceable'",
            "views": {
              "portfolio-workspace": { "capability": "primitive:container", "props": { "variant": "column", "gap": "m", "fill": true, "ariaLabel": "Portfolio" } },
              "http-proxy-access-gate": { "capability": "host:credential-access", "props": { "dependency": { "kind": "credential", "ref": "http-proxy/access-key" } }, "bindings": { "access": { "expression": "($s := portfolio.httpProxyAccessStatus; {'title':'Connect to HTTP proxy','requiredMessage':'Enter your access key to continue.','checkingMessage':'Checking HTTP proxy access...','errorMessage':\"Couldn't verify HTTP proxy access.\",'triggered': $s != 'ready' and $s != 'empty', 'status': $s = 'checking' ? 'checking' : ($s = 'required' ? 'required' : 'error'), 'error': portfolio.httpProxyAccessError})" } } },
              "summary": { "capability": "portfolio:summary", "bindings": { "value": { "from": "portfolio.summary" } } },
              "portfolio-status": { "capability": "primitive:note", "props": { "tone": "info" }, "bindings": { "value": { "from": "portfolio.status.message" } } }
            },
            "presentation": {
              "roots": ["portfolio-workspace"],
              "placements": [
                { "cell": "http-proxy-access-gate", "parent": "portfolio-workspace", "slot": "children", "order": 0 },
                { "cell": "summary", "parent": "portfolio-workspace", "slot": "children", "order": 1 },
                { "cell": "portfolio-status", "parent": "portfolio-workspace", "slot": "children", "order": 2 }
              ]
            }
          },
          {
            "id": "mobile-detailed",
            "when": "externalContext.view = 'mobile' and externalContext.attention = 'detailed'",
            "extends": "mobile-glanceable",
            "views": {
              "holdings": {
                "capability": "primitive:editable-table",
                "props": { "label": "Holdings", "columns": [{ "key": "ticker", "label": "Ticker" }, { "key": "quantity", "label": "Quantity" }, { "key": "costBasis", "label": "Cost basis" }] },
                "bindings": { "rows": { "expression": "[portfolio.holdings.*]" } }
              },
              "positions": { "capability": "fluent:table", "props": { "ariaLabel": "Positions", "columns": [{ "id": "ticker", "label": "Ticker" }, { "id": "quantity", "label": "Quantity" }, { "id": "price", "label": "Price" }, { "id": "value", "label": "Value" }, { "id": "gainLoss", "label": "Gain/loss" }] }, "bindings": { "rows": { "expression": "[portfolio.positions.*.{'id':$string(ticker),'cells':{'ticker':ticker,'quantity':quantity,'price':price,'value':value,'gainLoss':gainLoss}}]" } } }
            },
            "presentationAppend": [
              { "cell": "holdings", "parent": "portfolio-workspace", "slot": "children", "order": 3 },
              { "cell": "positions", "parent": "portfolio-workspace", "slot": "children", "order": 4 }
            ]
          },
          {
            "id": "laptop-glanceable",
            "when": "externalContext.view = 'laptop' and externalContext.attention = 'glanceable'",
            "extends": "mobile-glanceable",
            "views": {
              "positions": { "capability": "fluent:table", "props": { "ariaLabel": "Top positions", "columns": [{ "id": "ticker", "label": "Ticker" }, { "id": "value", "label": "Value" }, { "id": "gainLoss", "label": "Gain/loss" }] }, "bindings": { "rows": { "expression": "[portfolio.positions.*.{'id':$string(ticker),'cells':{'ticker':ticker,'value':value,'gainLoss':gainLoss}}]" } } }
            },
            "presentationAppend": [
              { "cell": "positions", "parent": "portfolio-workspace", "slot": "children", "order": 3 }
            ]
          },
          {
            "id": "desktop-glanceable",
            "when": "externalContext.view = 'desktop' and externalContext.attention = 'glanceable'",
            "extends": "laptop-glanceable",
            "views": {}
          },
          {
            "id": "laptop-detailed",
            "when": "externalContext.view = 'laptop' and externalContext.attention = 'detailed'",
            "extends": "mobile-detailed",
            "views": {
              "market-prices": { "capability": "fluent:table", "props": { "ariaLabel": "Market prices", "columns": [{ "id": "ticker", "label": "Ticker" }, { "id": "price", "label": "Price" }] }, "bindings": { "rows": { "expression": "[portfolio.quotes.*.{'id':$string(ticker),'cells':{'ticker':ticker,'price':price}}]" } } }
            },
            "presentationAppend": [
              { "cell": "market-prices", "parent": "portfolio-workspace", "slot": "children", "order": 5 }
            ]
          },
          {
            "id": "desktop-detailed",
            "when": "externalContext.view = 'desktop' and externalContext.attention = 'detailed'",
            "extends": "laptop-detailed",
            "views": {}
          }
        ],
        "fallback": "desktop-detailed",
        "implementationPrograms": [
          {
            "id": "live-market",
            "when": "externalContext.marketMode = 'live'"
          },
          {
            "id": "mock-market",
            "when": "externalContext.marketMode = 'mock'",
            "services": {
              "portfolio-market-data": {
                "kind": "deterministic-agent",
                "version": "1",
                "operations": {
                  "checkHttpProxyAccess": {
                    "operation": "check-access",
                    "contract": "http-proxy-access-check/v1",
                    "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'portfolio.httpProxyAccessStatus','value':'ready'},{'op':'set','path':'portfolio.httpProxyAccessError','value':''}]}" } }
                  },
                  "refreshPrices": {
                    "operation": "fetch-quotes",
                    "contract": "portfolio-market-quotes/v1",
                    "request": { "transform": { "kind": "jsonata", "expr": "{'holdings':state.portfolio.holdings}" } },
                    "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'portfolio.quotes','value':response.quotes}],'detail':{'provider':response.provider,'quoteCount':$count(response.quotes.*)}}" } }
                  }
                },
                "config": { "handler": "portfolio-market-data-mock" },
                "scope": "per-blueprint"
              }
            }
          }
        ],
        "implementationFallback": "live-market"
      }
    ],
    "services": {
      "portfolio-market-data": {
        "kind": "http-service",
        "version": "1",
        "operations": {
          "checkHttpProxyAccess": {
            "operation": "check-access",
            "contract": "http-proxy-access-check/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'portfolio.httpProxyAccessStatus','value':'ready'},{'op':'set','path':'portfolio.httpProxyAccessError','value':''}]}"
              }
            },
            "failureSettlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'http-proxy/access-key'; {'ops':[{'op':'set','path':'portfolio.httpProxyAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'portfolio.httpProxyAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'HTTP proxy access is required.' : error.message)}]})"
              }
            },
            "onViolation": { "action": "fail" }
          },
          "refreshPrices": {
            "operation": "fetch-quotes",
            "contract": "portfolio-market-quotes/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'requests':state.portfolio.holdings.*.{'key':ticker,'url':'https://query1.finance.yahoo.com/v8/finance/chart/' & ticker & '?interval=1d&range=1d','headers':{'User-Agent':'Mozilla/5.0 (compatible; portfolio-tracker-demo/1.0)'},'meta':{'quantity':quantity,'costBasis':costBasis}}}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'portfolio.quotes','value':$count(response.results) > 0 ? $merge(response.results.{key:{'ticker':key,'price':$round(body.chart.result[0].meta.regularMarketPrice, 2)}}) : {}}],'detail':{'provider':'yahoo-finance-http-service','quoteCount':$count(response.results)}}"
              }
            }
          }
        },
        "config": { "endpoint": "${GIK_HTTP_PROXY_ORIGIN}", "credentialRef": "http-proxy/access-key" },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["portfolio"],
      "contexts": ["control"],
      "actions": ["assign", "invoke"],
      "capabilities": {
        "primitive:container": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
        "primitive:editable-table": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["save"], "dataProp": "rows" },
        "fluent:table": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "rows" },
        "primitive:note": { "propsSchema": { "type": "object", "additionalProperties": true } },
        "host:credential-access": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["accessRequested", "accessCleared"] },
        "portfolio:summary": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" }
      },
      "externals": {
        "projectionViews": {
          "fluent": { "from": "fluent", "use": ["table"] },
          "primitive": { "from": "primitive", "use": ["container", "editable-table", "note"] },
          "host": { "from": "host", "use": ["credential-access"] },
          "portfolio": { "from": "self", "use": ["summary"] }
        },
        "effectHandlers": ["setHoldings", "saveHoldings"]
      },
      "state": {
        "portfolio": {
          "httpProxyAccessStatus": "checking",
          "httpProxyAccessError": "",
          "holdings": {
            "AAPL": { "ticker": "AAPL", "quantity": 10, "costBasis": 182.5 },
            "MSFT": { "ticker": "MSFT", "quantity": 5, "costBasis": 420 }
          },
          "quotes": {
            "AAPL": { "ticker": "AAPL", "price": 218.42 },
            "MSFT": { "ticker": "MSFT", "price": 447.31 }
          },
          "positions": {
            "AAPL": { "ticker": "AAPL", "quantity": 10, "price": 218.42, "value": 2184.2, "costBasis": 1825, "gainLoss": 359.2 },
            "MSFT": { "ticker": "MSFT", "quantity": 5, "price": 447.31, "value": 2236.55, "costBasis": 2100, "gainLoss": 136.55 }
          },
          "summary": { "marketValue": 4420.75, "costBasis": 3925, "gainLoss": 495.75 },
          "status": { "tone": "positive", "message": "Portfolio is above cost basis." }
        }
      }
    },
    "cells": {
      "portfolio-workspace": {
        "id": "portfolio-workspace",
        "kind": "portfolio-cell",
        "metadata": { "role": "workspace" },
        "behavior": {
          "events": {
            "setHoldings": [{ "do": "invoke", "args": { "tool": "setHoldings" } }]
          }
        }
      },
      "http-proxy-access-gate": {
        "id": "http-proxy-access-gate",
        "kind": "portfolio-cell",
        "metadata": { "role": "authorize-market-data" },
        "outputs": [{ "token": "http-proxy-access", "from": "portfolio.httpProxyAccessStatus", "when": "portfolio.httpProxyAccessStatus = 'ready'" }],
        "behavior": {
          "events": {
            "accessRequested": [{ "do": "invoke", "args": { "tool": "checkHttpProxyAccess" } }],
            "accessCleared": [
              { "do": "assign", "target": "portfolio.httpProxyAccessStatus", "args": { "value": "required" } },
              { "do": "assign", "target": "portfolio.httpProxyAccessError", "args": { "value": "" } }
            ]
          }
        }
      },
      "holdings": {
        "id": "holdings",
        "kind": "portfolio-cell",
        "metadata": { "role": "manage-holdings" },
        "outputs": [{ "token": "holding:$TICKER" }],
        "behavior": { "events": { "save": [{ "do": "invoke", "args": { "tool": "saveHoldings" } }] } }
      },
      "market-prices": {
        "id": "market-prices",
        "kind": "portfolio-cell",
        "metadata": { "role": "acquire-market-prices" },
        "inputs": [{ "token": "http-proxy-access" }, { "token": "holding:$TICKER" }],
        "sources": [{ "id": "market-prices.source", "service": "portfolio-market-data", "operation": "refreshPrices", "contract": "portfolio-market-quotes/v1" }],
        "outputs": [{ "token": "quote:$TICKER" }],
        "behavior": {
          "reactions": [{
            "when": "portfolio.httpProxyAccessStatus = 'ready' ? $string(portfolio.holdings) : null",
            "run": [{ "do": "invoke", "args": { "tool": "refreshPrices" } }]
          }]
        }
      },
      "positions": {
        "id": "positions",
        "kind": "portfolio-cell",
        "metadata": { "role": "derive-positions" },
        "inputs": [{ "token": "holding:$TICKER" }, { "token": "quote:$TICKER" }],
        "outputs": [{ "token": "position:$TICKER" }],
        "compute": [{
          "id": "positions-by-ticker",
          "expression": "($holdings := portfolio.holdings; $quotes := portfolio.quotes; $rows := $each($holdings, function($holding, $ticker) { $lookup($quotes, $ticker) ? {$ticker:{'ticker':$ticker,'quantity':$holding.quantity,'price':$lookup($quotes, $ticker).price,'value':$round($holding.quantity * $lookup($quotes, $ticker).price, 2),'costBasis':$round($holding.quantity * $holding.costBasis, 2),'gainLoss':$round(($holding.quantity * $lookup($quotes, $ticker).price) - ($holding.quantity * $holding.costBasis), 2)}} : {} }); $count($rows) > 0 ? $merge($rows) : {})",
          "assign": "portfolio.positions",
          "dependencies": ["portfolio.holdings", "portfolio.quotes"]
        }]
      },
      "summary": {
        "id": "summary",
        "kind": "portfolio-cell",
        "metadata": { "role": "summarize-portfolio" },
        "inputs": [{ "token": "position:$TICKER" }],
        "outputs": [{ "token": "portfolio-summary" }],
        "compute": [{
          "id": "portfolio-totals",
          "expression": "{'marketValue':$count(portfolio.positions.*) > 0 ? $round($sum(portfolio.positions.*.value), 2) : 0,'costBasis':$count(portfolio.positions.*) > 0 ? $round($sum(portfolio.positions.*.costBasis), 2) : 0,'gainLoss':$count(portfolio.positions.*) > 0 ? $round($sum(portfolio.positions.*.gainLoss), 2) : 0}",
          "assign": "portfolio.summary",
          "dependencies": ["portfolio.positions"]
        }]
      },
      "portfolio-status": {
        "id": "portfolio-status",
        "kind": "portfolio-cell",
        "metadata": { "role": "classify-performance" },
        "inputs": [{ "token": "portfolio-summary" }],
        "outputs": [{ "token": "portfolio-status" }],
        "compute": [{
          "id": "classify-gain-loss",
          "expression": "{'tone':portfolio.summary.gainLoss > 0 ? 'positive' : portfolio.summary.gainLoss < 0 ? 'negative' : 'neutral','message':portfolio.summary.gainLoss > 0 ? 'Portfolio is above cost basis.' : portfolio.summary.gainLoss < 0 ? 'Portfolio is below cost basis.' : 'Portfolio is at cost basis.'}",
          "assign": "portfolio.status",
          "dependencies": ["portfolio.summary"]
        }]
      }
    }
  }
}
