{
  "id": "portfolio-intent-to-runtime",
  "from": "portfolio-intent",
  "to": "runtime-document",
  "preserve": {
    "cells": true,
    "facets": [
      "inputs",
      "outputs",
      "sources",
      "compute",
      "behavior"
    ]
  },
  "representations": [
    {
      "id": "mobile-glanceable",
      "when": "externalContext.surface = 'mobile' and externalContext.attention = 'glanceable'",
      "views": {
        "portfolio-workspace": {
          "capability": "ui:screen",
          "props": {
            "title": "Portfolio"
          }
        },
        "http-proxy-access-gate": {
          "capability": "http-proxy:access-gate",
          "bindings": {
            "status": {
              "from": "portfolio.httpProxyAccessStatus"
            },
            "error": {
              "from": "portfolio.httpProxyAccessError"
            }
          }
        },
        "summary": {
          "capability": "portfolio:summary",
          "bindings": {
            "value": {
              "from": "portfolio.summary"
            }
          }
        },
        "portfolio-status": {
          "capability": "ui:note",
          "bindings": {
            "text": {
              "from": "portfolio.status.message"
            }
          }
        }
      },
      "presentation": {
        "roots": [
          "portfolio-workspace"
        ],
        "placements": [
          {
            "cell": "http-proxy-access-gate",
            "parent": "portfolio-workspace",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "summary",
            "parent": "portfolio-workspace",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "portfolio-status",
            "parent": "portfolio-workspace",
            "slot": "children",
            "order": 2
          }
        ]
      }
    },
    {
      "id": "mobile-detailed",
      "when": "externalContext.surface = 'mobile' and externalContext.attention = 'detailed'",
      "extends": "mobile-glanceable",
      "views": {
        "holdings": {
          "capability": "ui:editable-table",
          "props": {
            "label": "Holdings",
            "spec": {
              "schema": {
                "properties": {
                  "ticker": {
                    "type": "string"
                  },
                  "quantity": {
                    "type": "number"
                  },
                  "costBasis": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "bindings": {
            "rows": {
              "expression": "[portfolio.holdings.*]"
            }
          }
        },
        "positions": {
          "capability": "ui:table",
          "props": {
            "label": "Positions",
            "static": true
          },
          "bindings": {
            "rows": {
              "expression": "[portfolio.positions.*]"
            }
          }
        }
      },
      "presentationAppend": [
        {
          "cell": "holdings",
          "parent": "portfolio-workspace",
          "slot": "children",
          "order": 3
        },
        {
          "cell": "positions",
          "parent": "portfolio-workspace",
          "slot": "children",
          "order": 4
        }
      ]
    },
    {
      "id": "laptop-glanceable",
      "when": "externalContext.surface = 'laptop' and externalContext.attention = 'glanceable'",
      "extends": "mobile-glanceable",
      "views": {
        "positions": {
          "capability": "ui:table",
          "props": {
            "label": "Positions",
            "static": true,
            "maxRows": 5
          },
          "bindings": {
            "rows": {
              "expression": "[portfolio.positions.*]"
            }
          }
        }
      },
      "presentationAppend": [
        {
          "cell": "positions",
          "parent": "portfolio-workspace",
          "slot": "children",
          "order": 3
        }
      ]
    },
    {
      "id": "desktop-glanceable",
      "when": "externalContext.surface = 'desktop' and externalContext.attention = 'glanceable'",
      "extends": "laptop-glanceable"
    },
    {
      "id": "laptop-detailed",
      "when": "externalContext.surface = 'laptop' and externalContext.attention = 'detailed'",
      "extends": "mobile-detailed",
      "views": {
        "market-prices": {
          "capability": "ui:table",
          "props": {
            "label": "Market prices",
            "static": true
          },
          "bindings": {
            "rows": {
              "expression": "[portfolio.quotes.*]"
            }
          }
        }
      },
      "presentationAppend": [
        {
          "cell": "market-prices",
          "parent": "portfolio-workspace",
          "slot": "children",
          "order": 5
        }
      ]
    },
    {
      "id": "desktop-detailed",
      "when": "externalContext.surface = 'desktop' and externalContext.attention = 'detailed'",
      "extends": "laptop-detailed"
    }
  ],
  "fallback": "desktop-detailed"
}
