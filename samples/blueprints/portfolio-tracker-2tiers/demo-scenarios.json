{
  "contextFormSpec": {
    "fields": {
      "properties": {
        "view": {
          "type": "string",
          "title": "View",
          "enum": ["mobile", "laptop", "desktop"],
          "enumNames": ["Mobile", "Laptop", "Desktop"]
        },
        "attention": {
          "type": "string",
          "title": "Attention",
          "enum": ["glanceable", "detailed"],
          "enumNames": ["Glanceable", "Detailed"]
        },
        "marketMode": {
          "type": "string",
          "title": "Market mode",
          "enum": ["mock", "live"],
          "enumNames": ["Mock", "Live"]
        }
      },
      "required": ["view", "attention", "marketMode"]
    },
    "saveLabel": "Apply context",
    "discardLabel": "Discard"
  },
  "namedPresetContexts": {
    "desktop-detailed": {
      "label": "Desktop, detailed",
      "context": { "view": "desktop", "attention": "detailed", "marketMode": "mock" }
    },
    "laptop-detailed": {
      "label": "Laptop, detailed",
      "context": { "view": "laptop", "attention": "detailed", "marketMode": "mock" }
    },
    "mobile-glanceable": {
      "label": "Mobile, glanceable",
      "context": { "view": "mobile", "attention": "glanceable", "marketMode": "mock" }
    },
    "desktop-detailed-live": {
      "label": "Desktop, detailed, live market",
      "context": { "view": "desktop", "attention": "detailed", "marketMode": "live" }
    }
  },
  "scenarios": [
    {
      "id": "live-portfolio",
      "shortDescription": "Live portfolio",
      "resetBlueprintStateAtStart": true,
      "participants": {
        "raam": {
          "name": "Raam",
          "type": "human",
          "description": "Portfolio owner"
        },
        "market-price-service": {
          "name": "Market price service",
          "type": "service",
          "description": "Provides current prices in response to the Blueprint's market-price source"
        }
      },
      "sequence": [
        {
          "kind": "act",
          "id": "add-msft",
          "participantId": "raam",
          "shortDescription": "Add 100 MSFT shares",
          "longDescription": "Raam adds 100 MSFT shares at a 300 cost basis.",
          "event": {
            "gik": "0.1",
            "type": "event",
            "payload": {
              "node": "holdings",
              "name": "save",
              "payload": {
                "rows": [
                  { "ticker": "MSFT", "quantity": 100, "costBasis": 300 }
                ]
              }
            }
          }
        },
        {
          "kind": "act",
          "id": "add-nvda",
          "participantId": "raam",
          "shortDescription": "Add 50 NVDA shares",
          "longDescription": "Raam adds 50 NVDA shares at a 350 cost basis while retaining MSFT.",
          "event": {
            "gik": "0.1",
            "type": "event",
            "payload": {
              "node": "holdings",
              "name": "save",
              "payload": {
                "rows": [
                  { "ticker": "MSFT", "quantity": 100, "costBasis": 300 },
                  { "ticker": "NVDA", "quantity": 50, "costBasis": 350 }
                ]
              }
            }
          }
        },
        {
          "kind": "wait",
          "id": "wait-for-market-prices",
          "participantId": "market-price-service",
          "shortDescription": "Wait for both market prices",
          "when": "$exists($state.portfolio.quotes.MSFT.price) and $exists($state.portfolio.quotes.NVDA.price)"
        },
        {
          "kind": "wait",
          "id": "wait-for-portfolio-values",
          "shortDescription": "Wait for both portfolio positions",
          "when": "$state.portfolio.positions.MSFT.quantity = 100 and $state.portfolio.positions.NVDA.quantity = 50 and $exists($state.portfolio.positions.MSFT.value) and $exists($state.portfolio.positions.NVDA.value)"
        },
        {
          "kind": "observe",
          "id": "observe-live-portfolio",
          "shortDescription": "Record live portfolio",
          "select": {
            "holdings": "$state.portfolio.holdings",
            "marketPrices": "$state.portfolio.quotes",
            "positions": "$state.portfolio.positions",
            "summary": "$state.portfolio.summary"
          }
        }
      ]
    }
  ]
}