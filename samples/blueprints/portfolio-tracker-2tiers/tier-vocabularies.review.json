{
  "intent": {
    "id": "portfolio-intent",
    "kind": "portfolio-domain",
    "cellVocabulary": {
      "roles": [
        "workspace",
        "authorize-market-data",
        "manage-holdings",
        "acquire-market-prices",
        "derive-positions",
        "summarize-portfolio",
        "classify-performance"
      ],
      "stableFacets": [
        "id",
        "kind",
        "metadata",
        "inputs",
        "outputs",
        "sources",
        "compute",
        "behavior"
      ],
      "forbiddenRepresentationFacets": [
        "view",
        "projections"
      ]
    }
  },
  "runtime": {
    "id": "runtime-document",
    "kind": "runtime-document",
    "representationVocabulary": {
      "context": {
        "surface": [
          "mobile",
          "laptop",
          "desktop"
        ],
        "attention": [
          "glanceable",
          "detailed"
        ]
      },
      "operations": [
        "setCellView",
        "setPresentation"
      ],
      "constraints": {
        "preserveCellIdentity": true,
        "preserveDataFlowFacets": [
          "inputs",
          "outputs",
          "sources",
          "compute",
          "behavior"
        ],
        "exactlyOnePresentationRoot": true
      }
    }
  }
}
