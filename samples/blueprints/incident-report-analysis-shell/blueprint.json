{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-report-analysis-shell",
    "kind": "incident-report-analysis-shell",
    "version": "1.0.0",
    "structureMode": "fixed",
    "tiers": [{ "id": "runtime-document", "kind": "runtime-document" }],
    "recipes": [],
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incident1a"],
      "actions": ["assign", "invoke"],
      "capabilities": {
        "primitive:container": { "propsSchema": { "type": "object", "additionalProperties": false, "properties": { "variant": { "enum": ["row", "column", "stack", "flex"] }, "gap": { "enum": ["none", "xs", "s", "m", "l", "xl"] }, "align": { "enum": ["stretch", "start", "center", "end", "baseline"] }, "justify": { "enum": ["start", "center", "end", "space-between", "space-around", "space-evenly"] }, "wrap": { "type": "boolean" }, "direction": { "enum": ["row", "row-reverse", "column", "column-reverse"] }, "fill": { "type": "boolean" }, "grow": { "type": "boolean" }, "fullWidth": { "type": "boolean" }, "fullHeight": { "type": "boolean" }, "ariaLabel": { "type": "string", "minLength": 1 }, "className": { "type": "string" }, "style": { "type": "object", "additionalProperties": { "type": ["string", "number"] } } } }, "slots": ["children"] },
        "primitive:markdown": { "propsSchema": { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": "string" }, "className": { "type": "string" }, "style": { "type": "object", "additionalProperties": { "type": ["string", "number"] } } } }, "dataProp": "value" },
        "fluent:dropdown": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select"], "dataProp": "value" },
        "fluent:switch": { "propsSchema": { "type": "object", "additionalProperties": false, "properties": { "value": { "type": "string" }, "checked": { "type": "boolean" }, "onValue": { "type": "string" }, "offValue": { "type": "string" }, "label": { "type": "string" }, "onLabel": { "type": "string" }, "offLabel": { "type": "string" }, "disabled": { "type": "boolean" }, "ariaLabel": { "type": "string" }, "name": { "type": "string" }, "size": { "enum": ["small", "medium", "large"] }, "variant": { "enum": ["standard", "compact"] }, "className": { "type": "string" }, "style": { "type": "object", "additionalProperties": { "type": ["string", "number"] } } } }, "emits": ["toggle"] },
        "fluent:text": { "propsSchema": { "type": "object", "additionalProperties": false, "required": ["value"], "properties": { "value": { "type": "string" }, "variant": { "enum": ["body", "caption", "subtitle", "title", "display"] }, "as": { "enum": ["span", "p", "div", "label", "h1", "h2", "h3", "h4", "h5", "h6"] }, "htmlFor": { "type": "string" }, "align": { "enum": ["start", "center", "end", "justify"] }, "block": { "type": "boolean" }, "italic": { "type": "boolean" }, "truncate": { "type": "boolean" }, "underline": { "type": "boolean" }, "wrap": { "type": "boolean" }, "className": { "type": "string" }, "style": { "type": "object", "additionalProperties": { "type": ["string", "number"] } } } }, "dataProp": "value" },
        "host:hosted-blueprint": { "propsSchema": { "type": "object", "additionalProperties": true } }
      },
      "externals": {
        "projectionViews": {
          "fluent": { "from": "fluent", "use": ["dropdown", "switch", "text"] },
          "primitive": { "from": "primitive", "use": ["container", "markdown"] },
          "host": { "from": "blueprint-host", "use": ["hosted-blueprint"] }
        },
        "effectHandlers": ["selectSampleReport"]
      },
      "state": {
        "incident1a": {
          "selectedSampleId": "password-spray-mailbox",
          "showAllThree": false,
          "leftSelection": "source",
          "rightSelection": "analysis-1a",
          "blueprint": [
            { "id": "analysis-1a", "label": "Semantic refinement", "$ref": "blueprint:incident-report-explorer-1a@1.0.0" },
            { "id": "analysis-2", "label": "Operational model", "$ref": "blueprint:incident-report-explorer-2@1.0.0" },
            { "id": "analysis-3", "label": "Source-faithful views", "$ref": "blueprint:incident-report-explorer-3@1.0.0" }
          ],
          "content": "# Loading incident report...",
          "error": ""
        }
      }
    },
    "cells": {
      "incident-shell": { "id": "incident-shell", "kind": "workspace", "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true } } },
      "workbench-heading": { "id": "workbench-heading", "kind": "heading", "view": { "capability": "fluent:text", "props": { "as": "h1", "variant": "title", "block": true, "value": "Incident report analysis workbench" } } },
      "source-selector-row": { "id": "source-selector-row", "kind": "source-selector-layout", "view": { "capability": "primitive:container", "props": { "variant": "row", "gap": "m", "fullWidth": true, "align": "end" } } },
      "source-selector-control": { "id": "source-selector-control", "kind": "source-selector-control", "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "none", "grow": true } } },
      "source-report-selector": { "id": "source-report-selector", "kind": "source-selector", "outputs": [{ "token": "source-content", "from": "incident1a.content", "schema": { "type": "string" } }], "view": { "capability": "fluent:dropdown", "props": { "label": "Source report", "ariaLabel": "Choose sample incident", "style": { "width": "100%" }, "options": [{ "value": "password-spray-mailbox", "label": "Password spray and mailbox compromise" }, { "value": "blob-storage-exfiltration", "label": "Blob storage exfiltration" }, { "value": "identity-compromise", "label": "Identity and cloud resource compromise" }, { "value": "device-code-bec", "label": "Device-code phishing and BEC" }, { "value": "supply-chain-sap-bec", "label": "Supply-chain SAP and procurement BEC" }] }, "bindings": { "value": { "from": "incident1a.selectedSampleId" } } }, "behavior": { "events": { "select": [{ "do": "invoke", "args": { "tool": "selectSampleReport" } }] } } },
      "show-all-three-switch": { "id": "show-all-three-switch", "kind": "layout-mode", "view": { "capability": "fluent:switch", "props": { "label": "Show all three", "ariaLabel": "Show all three analyses" }, "bindings": { "checked": { "from": "incident1a.showAllThree" } } }, "behavior": { "events": { "toggle": [{ "do": "assign", "target": "incident1a.showAllThree", "args": { "from": "$event.checked" } }] } } },
      "comparison-row": { "id": "comparison-row", "kind": "comparison", "view": { "capability": "primitive:container", "props": { "variant": "row", "gap": "m", "fill": true, "align": "stretch" }, "visibility": "$not(incident1a.showAllThree)" } },
      "left-column": { "id": "left-column", "kind": "comparison-column", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true } } },
      "right-column": { "id": "right-column", "kind": "comparison-column", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true } } },
      "left-view-selector": { "id": "left-view-selector", "kind": "view-selector", "view": { "capability": "fluent:dropdown", "props": { "ariaLabel": "Choose left comparison view" }, "bindings": { "options": { "expression": "[{'value':'source','label':'Source report'},{'value':incident1a.blueprint[0].id,'label':incident1a.blueprint[0].label},{'value':incident1a.blueprint[1].id,'label':incident1a.blueprint[1].label},{'value':incident1a.blueprint[2].id,'label':incident1a.blueprint[2].label}]" }, "value": { "from": "incident1a.leftSelection" } } }, "behavior": { "events": { "select": [{ "do": "assign", "target": "incident1a.leftSelection", "args": { "from": "$event.value" } }] } } },
      "right-view-selector": { "id": "right-view-selector", "kind": "view-selector", "view": { "capability": "fluent:dropdown", "props": { "ariaLabel": "Choose right comparison view" }, "bindings": { "options": { "expression": "[{'value':'source','label':'Source report'},{'value':incident1a.blueprint[0].id,'label':incident1a.blueprint[0].label},{'value':incident1a.blueprint[1].id,'label':incident1a.blueprint[1].label},{'value':incident1a.blueprint[2].id,'label':incident1a.blueprint[2].label}]" }, "value": { "from": "incident1a.rightSelection" } } }, "behavior": { "events": { "select": [{ "do": "assign", "target": "incident1a.rightSelection", "args": { "from": "$event.value" } }] } } },
      "left-source": { "id": "left-source", "kind": "source-view", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true }, "visibility": "incident1a.leftSelection = 'source'" } },
      "left-source-heading": { "id": "left-source-heading", "kind": "heading", "view": { "capability": "fluent:text", "props": { "as": "h2", "variant": "subtitle", "block": true, "value": "Source report" } } },
      "left-source-markdown": { "id": "left-source-markdown", "kind": "source-reader", "view": { "capability": "primitive:markdown", "bindings": { "value": { "from": "incident1a.content" } } } },
      "right-source": { "id": "right-source", "kind": "source-view", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true }, "visibility": "incident1a.rightSelection = 'source'" } },
      "right-source-heading": { "id": "right-source-heading", "kind": "heading", "view": { "capability": "fluent:text", "props": { "as": "h2", "variant": "subtitle", "block": true, "value": "Source report" } } },
      "right-source-markdown": { "id": "right-source-markdown", "kind": "source-reader", "view": { "capability": "primitive:markdown", "bindings": { "value": { "from": "incident1a.content" } } } },
      "left-analysis-1a": { "id": "left-analysis-1a", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-1a@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "component-data-refinement" }, "bindings": { "content": { "from": "incident1a.content" } }, "visibility": "incident1a.leftSelection = 'analysis-1a'" } },
      "left-analysis-2": { "id": "left-analysis-2", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-2@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "operational-semantic-model", "attention": "operational" }, "bindings": { "content": { "from": "incident1a.content" } }, "visibility": "incident1a.leftSelection = 'analysis-2'" } },
      "left-analysis-3": { "id": "left-analysis-3", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-3@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "source-faithful-flights", "attention": "operational" }, "bindings": { "content": { "from": "incident1a.content" } }, "visibility": "incident1a.leftSelection = 'analysis-3'" } },
      "right-analysis-1a": { "id": "right-analysis-1a", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-1a@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "component-data-refinement" }, "bindings": { "content": { "from": "incident1a.content" } }, "visibility": "incident1a.rightSelection = 'analysis-1a'" } },
      "right-analysis-2": { "id": "right-analysis-2", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-2@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "operational-semantic-model", "attention": "operational" }, "bindings": { "content": { "from": "incident1a.content" } }, "visibility": "incident1a.rightSelection = 'analysis-2'" } },
      "right-analysis-3": { "id": "right-analysis-3", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-3@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "source-faithful-flights", "attention": "operational" }, "bindings": { "content": { "from": "incident1a.content" } }, "visibility": "incident1a.rightSelection = 'analysis-3'" } },
      "all-three-row": { "id": "all-three-row", "kind": "all-analyses", "view": { "capability": "primitive:container", "props": { "variant": "row", "gap": "m", "fill": true, "align": "stretch" }, "visibility": "incident1a.showAllThree" } },
      "all-three-column-0": { "id": "all-three-column-0", "kind": "analysis-column", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true } } },
      "all-three-column-1": { "id": "all-three-column-1", "kind": "analysis-column", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true } } },
      "all-three-column-2": { "id": "all-three-column-2", "kind": "analysis-column", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "view": { "capability": "primitive:container", "props": { "variant": "column", "gap": "s", "fill": true } } },
      "all-three-heading-0": { "id": "all-three-heading-0", "kind": "heading", "view": { "capability": "fluent:text", "props": { "as": "h2", "variant": "subtitle", "block": true, "value": "Analysis" }, "bindings": { "value": { "expression": "incident1a.blueprint[0].label" } } } },
      "all-three-heading-1": { "id": "all-three-heading-1", "kind": "heading", "view": { "capability": "fluent:text", "props": { "as": "h2", "variant": "subtitle", "block": true, "value": "Analysis" }, "bindings": { "value": { "expression": "incident1a.blueprint[1].label" } } } },
      "all-three-heading-2": { "id": "all-three-heading-2", "kind": "heading", "view": { "capability": "fluent:text", "props": { "as": "h2", "variant": "subtitle", "block": true, "value": "Analysis" }, "bindings": { "value": { "expression": "incident1a.blueprint[2].label" } } } },
      "all-three-analysis-0": { "id": "all-three-analysis-0", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-1a@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "component-data-refinement" }, "bindings": { "content": { "from": "incident1a.content" } } } },
      "all-three-analysis-1": { "id": "all-three-analysis-1", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-2@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "operational-semantic-model", "attention": "operational" }, "bindings": { "content": { "from": "incident1a.content" } } } },
      "all-three-analysis-2": { "id": "all-three-analysis-2", "kind": "hosted-analysis", "inputs": [{ "token": "source-content", "as": "content", "required": true, "schema": { "type": "string" } }], "blueprint": { "$ref": "blueprint:incident-report-explorer-3@1.0.0" }, "view": { "capability": "host:hosted-blueprint", "props": { "hostedAnalysis": true, "analysis": "source-faithful-flights", "attention": "operational" }, "bindings": { "content": { "from": "incident1a.content" } } } }
    },
    "projections": {
      "presentation": {
        "roots": ["incident-shell"],
        "placements": [
          { "cell": "workbench-heading", "parent": "incident-shell", "slot": "children", "order": 0 },
          { "cell": "source-selector-row", "parent": "incident-shell", "slot": "children", "order": 1 },
          { "cell": "comparison-row", "parent": "incident-shell", "slot": "children", "order": 2 },
          { "cell": "all-three-row", "parent": "incident-shell", "slot": "children", "order": 3 },
          { "cell": "source-selector-control", "parent": "source-selector-row", "slot": "children", "order": 0 },
          { "cell": "show-all-three-switch", "parent": "source-selector-row", "slot": "children", "order": 1 },
          { "cell": "source-report-selector", "parent": "source-selector-control", "slot": "children", "order": 0 },
          { "cell": "left-column", "parent": "comparison-row", "slot": "children", "order": 0 },
          { "cell": "right-column", "parent": "comparison-row", "slot": "children", "order": 1 },
          { "cell": "left-view-selector", "parent": "left-column", "slot": "children", "order": 0 },
          { "cell": "left-source", "parent": "left-column", "slot": "children", "order": 1 },
          { "cell": "left-analysis-1a", "parent": "left-column", "slot": "children", "order": 2 },
          { "cell": "left-analysis-2", "parent": "left-column", "slot": "children", "order": 3 },
          { "cell": "left-analysis-3", "parent": "left-column", "slot": "children", "order": 4 },
          { "cell": "right-view-selector", "parent": "right-column", "slot": "children", "order": 0 },
          { "cell": "right-source", "parent": "right-column", "slot": "children", "order": 1 },
          { "cell": "right-analysis-1a", "parent": "right-column", "slot": "children", "order": 2 },
          { "cell": "right-analysis-2", "parent": "right-column", "slot": "children", "order": 3 },
          { "cell": "right-analysis-3", "parent": "right-column", "slot": "children", "order": 4 },
          { "cell": "left-source-heading", "parent": "left-source", "slot": "children", "order": 0 },
          { "cell": "left-source-markdown", "parent": "left-source", "slot": "children", "order": 1 },
          { "cell": "right-source-heading", "parent": "right-source", "slot": "children", "order": 0 },
          { "cell": "right-source-markdown", "parent": "right-source", "slot": "children", "order": 1 },
          { "cell": "all-three-column-0", "parent": "all-three-row", "slot": "children", "order": 0 },
          { "cell": "all-three-column-1", "parent": "all-three-row", "slot": "children", "order": 1 },
          { "cell": "all-three-column-2", "parent": "all-three-row", "slot": "children", "order": 2 },
          { "cell": "all-three-heading-0", "parent": "all-three-column-0", "slot": "children", "order": 0 },
          { "cell": "all-three-analysis-0", "parent": "all-three-column-0", "slot": "children", "order": 1 },
          { "cell": "all-three-heading-1", "parent": "all-three-column-1", "slot": "children", "order": 0 },
          { "cell": "all-three-analysis-1", "parent": "all-three-column-1", "slot": "children", "order": 1 },
          { "cell": "all-three-heading-2", "parent": "all-three-column-2", "slot": "children", "order": 0 },
          { "cell": "all-three-analysis-2", "parent": "all-three-column-2", "slot": "children", "order": 1 }
        ]
      }
    }
  }
}