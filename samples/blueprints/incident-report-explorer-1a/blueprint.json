{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-report-explorer-1a",
    "kind": "incident-report-semantic-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": {
      "inputs": {
        "incident_report": {
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Incident report Markdown supplied by the parent Blueprint."
        },
        "cached_analysis_report": {
          "required": false,
          "description": "Cached analyzer report supplied by the parent Blueprint."
        },
        "analysis_as_on": {
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Timestamp supplied by the parent cache boundary."
        }
      },
      "outputs": {
        "analysis_report": {
          "from": "analysis_report",
          "description": "Fresh analyzer report returned to the parent Blueprint."
        }
      }
    },
    "agentLifecycle": {
      "profiles": {
        "use": {
          "id": "use-blueprint",
          "version": "1.0.0",
          "description": "Use the incident report explorer to refine an authored report into presentation-neutral semantic component data.",
          "targetKinds": ["blueprint-instance", "incident-report"],
          "intentKinds": ["select-sample", "save-report", "improve-report"],
          "goals": [
            "Preserve every source section and fact while producing component-ready semantic data.",
            "Complete only operations declared by the incident report explorer runtime."
          ],
          "constraints": [
            "Do not invent, omit, or factually alter incident content.",
            "Return semantic data rather than components, layout, styling, or presentation variants.",
            "Do not propose structural changes to this fixed Blueprint."
          ]
        }
      }
    },
    "tiers": [
      { "id": "incident-report-semantic", "kind": "incident-report-semantic-model", "description": "Presentation-neutral incident meaning with explicit source-section coverage and content-preservation assertions." },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [{
      "id": "incident-report-semantic-to-runtime",
      "from": "incident-report-semantic",
      "to": "runtime-document",
      "representations": [{
        "id": "hosted-analysis",
        "when": "externalContext.hostedAnalysis = true",
        "views": {
          "analysis-layout": { "capability": "primitive:container", "props": { "variant": "column", "gap": "l", "fullWidth": true, "ariaLabel": "Incident report refinement" } },
          "report-presentation": {
            "capability": "semantic:narrative",
            "props": {
              "variant": "article",
              "spec": {
                "title": "Report refinement",
                "emptyText": "No refinement available.",
                "density": "comfortable",
                "fields": {
                  "id": "id",
                  "heading": "heading",
                  "body": "body",
                  "order": "order",
                  "role": "role",
                  "tone": "tone"
                },
                "toneMap": {
                  "preferred": "primary",
                  "supporting": "supporting"
                }
              }
            },
            "bindings": {
              "sections": {
                "expression": "cached_analysis_report ? ([{'id':'preservation','heading':'Preservation summary','body':cached_analysis_report.preservationSummary,'order':0,'role':'Preserved','tone':'preferred'}] & cached_analysis_report.sections.{'id':id,'heading':sourceHeading,'body':$join(options.((relationship = 'preferred' ? 'Preferred' : relationship) & ' ' & capability & '\n' & reason & '\n\n' & data),'\n\n'),'order':order + 1,'role':'Section','tone':'supporting'}) : []"
              }
            }
          },
          "analysis-as-on": {
            "capability": "primitive:datetime",
            "props": {
              "variant": "timestamp",
              "ariaLabel": "As on"
            },
            "bindings": {
              "value": {
                "from": "analysis_as_on"
              }
            },
            "visibility": "cached_analysis_report != null"
          },
          "analysis-runner": {
            "capability": "fluent:spinner",
            "props": {
              "label": "Improving report",
              "size": "medium",
              "style": {
                "position": "fixed",
                "top": "16px",
                "right": "20px",
                "zIndex": 1000,
                "padding": "8px 12px",
                "background": "var(--colorNeutralBackground1)",
                "boxShadow": "var(--shadow8)",
                "borderRadius": "6px"
              }
            },
            "visibility": "systemInputs.numSourcesRunning != 0"
          }
        },
        "presentation": {
          "roots": ["analysis-layout"],
          "placements": [
            {
              "cell": "analysis-runner",
              "parent": "analysis-layout",
              "slot": "children",
              "order": 0
            },
            {
              "cell": "analysis-as-on",
              "parent": "analysis-layout",
              "slot": "children",
              "order": 1
            },
            {
              "cell": "report-presentation",
              "parent": "analysis-layout",
              "slot": "children",
              "order": 2
            }
          ]
        }
      }],
      "fallback": "hosted-analysis"
    }],
    "services": {
      "incident-report-refinement": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "improveReport": {
            "operation": "chat",
            "contract": "incident-report-component-data/v2",
            "request": { "transform": { "kind": "jsonata", "expr": "{'message':'Transform each section of this incident report into component-ready semantic data. Report Markdown:\n\n' & input.incident_report,'instructions':'PRESERVE every fact and source section. SELECT one preferred semantic contract per section and up to two useful alternatives or complements. Suggestions are guidance only: Verdict decision/argument/narrative; Summary narrative/decision/measure-set; Attack Graph attack-path/relationship-set/process; Correlated Incidents and Alerts evidence-case/relationship-set/entity-set; Timeline event-series/process/milestones; Compromised Entities entity-set/relationship-set/attack-path; TTPs and Key Activities process/entity-set/evidence-case; IOCs and Evidence evidence-case/entity-set/relationship-set; Recommended Actions work-set/process/milestones. Choose another available contract when more appropriate and state why. TRANSFORM data to the selected contract. Return data, not components, variants, layout, styling, or other presentation. Do not invent options or content.','maxOutputTokens':16000}" } },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "provider-structured-output",
                  "message": "Incident report semantic refinement is invalid",
                  "schema": {
                    "type": "object",
                    "required": ["sections", "sectionCoverage", "preservationSummary", "factualChanges", "omissions"],
                    "properties": {
                      "sections": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "sourceHeading", "order", "options"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceHeading": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "options": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object", "required": ["id", "capability", "relationship", "reason", "data"], "properties": { "id": { "type": "string", "minLength": 1 }, "capability": { "type": "string", "enum": ["semantic:argument", "semantic:decision", "semantic:entity-set", "semantic:event-series", "semantic:evidence-case", "semantic:measure-set", "semantic:milestones", "semantic:narrative", "semantic:process", "semantic:relationship-set", "semantic:work-set", "security:attack-path"] }, "relationship": { "type": "string", "enum": ["preferred", "alternative", "complementary"] }, "reason": { "type": "string", "minLength": 1 }, "data": { "type": "string", "minLength": 2, "description": "JSON-encoded component-ready semantic data" } }, "additionalProperties": false } } }, "additionalProperties": false } },
                      "sectionCoverage": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "sourceSectionId", "sourceHeading", "order", "representationIds", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceSectionId": { "type": "string", "minLength": 1 }, "sourceHeading": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "representationIds": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } }, "status": { "type": "string", "const": "preserved" } }, "additionalProperties": false } },
                      "preservationSummary": { "type": "string", "minLength": 1 },
                      "factualChanges": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
                      "omissions": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
                    },
                    "additionalProperties": false
                  }
                },
                { "kind": "jsonata", "expr": "$count(data.factualChanges) = 0 and $count(data.omissions) = 0 and $count(data.sectionCoverage[status != 'preserved']) = 0 and $count(data.sections[$count(options[relationship = 'preferred']) != 1]) = 0", "message": "Every source section must be preserved with exactly one preferred semantic representation", "code": "content-preservation" }
              ]
            },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'foundry-agent/access-key'; $access := $missing or error.status = 401 or error.status = 403; {'ops':[{'op':'set','path':'incident1a.error','value':$access ? '' : error.message},{'op':'set','path':'incident1a.foundryAccessStatus','value':$access ? 'required' : state.incident1a.foundryAccessStatus},{'op':'set','path':'incident1a.foundryAccessError','value':$access ? (error.status = 401 or error.status = 403 ? 'That access key was rejected.' : 'Foundry access is required.') : state.incident1a.foundryAccessError}]})" } },
            "onViolation": { "action": "fail" }
          },
          "checkFoundryAccess": {
            "operation": "check-access",
            "contract": "foundry-access-check/v1",
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident1a.foundryAccessStatus','value':'ready'},{'op':'set','path':'incident1a.foundryAccessError','value':''}]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'foundry-agent/access-key'; {'ops':[{'op':'set','path':'incident1a.foundryAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'incident1a.foundryAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : error.message)}]})" } },
            "onViolation": { "action": "fail" }
          }
        },
        "config": { "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}", "agent": "Incident-Report-Refinement-Agent", "credentialRef": "foundry-agent/access-key" },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incident1a"],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "capabilities": {
        "primitive:container": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
        "semantic:narrative": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "sections"
        },
        "primitive:datetime": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        },
        "fluent:spinner": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": { "primitive": { "from": "primitive", "use": [
              "container",
              "datetime"
            ] }, "semantic": { "from": "semantic", "use": ["narrative"] }, "fluent": { "from": "fluent", "use": ["spinner"] } }
      },
      "state": {
        "incident1a": {
          "foundryAccessStatus": "required",
          "foundryAccessError": "",
          "error": ""
        }
      }
    },
    "cells": {
      "analysis-layout": { "id": "analysis-layout", "kind": "incident-analysis-layout" },
      "report-presentation": {
        "id": "report-presentation",
        "kind": "incident-analysis-presentation",
        "inputs": [
          {
            "token": "cached_analysis_report",
            "as": "cached_analysis_report",
            "required": false
          }
        ]
      },
      "analysis-as-on": {
        "id": "analysis-as-on",
        "kind": "analysis-timestamp",
        "inputs": [
          {
            "token": "analysis_as_on",
            "as": "analysis_as_on",
            "required": false
          }
        ]
      },
      "analysis-runner": {
        "id": "analysis-runner",
        "kind": "incident-analysis-runner",
        "systemInputs": ["numSourcesRunning"],
        "inputs": [
          {
            "token": "incident_report",
            "as": "incident_report",
            "required": true
          },
          {
            "token": "cached_analysis_report",
            "as": "cached_analysis_report",
            "required": false
          }
        ],
        "sources": [
          {
            "id": "analysis-runner.source",
            "service": "incident-report-refinement",
            "operation": "improveReport",
            "contract": "incident-report-component-data/v2",
            "when": "($not($exists(inputs.cached_analysis_report)) or inputs.cached_analysis_report = null) and $not($exists(sources.`analysis-runner.source`))",
            "input": { "kind": "jsonata", "expr": "{'incident_report':inputs.incident_report}" },
            "output": { "kind": "jsonata", "expr": "response" }
          }
        ],
        "compute": [
          { "id": "analysis-report", "expression": "sources.`analysis-runner.source`", "assign": "analysisReport" }
        ],
        "outputs": [
          {
            "token": "analysis_report",
            "from": "computed.analysisReport",
            "when": "computed.analysisReport != null"
          }
        ]
      }
    },
    "metadata": { "projectionPattern": "semantic-report-to-authored-runtime" }
  }
}
