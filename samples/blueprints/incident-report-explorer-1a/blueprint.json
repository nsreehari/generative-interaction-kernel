{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-report-explorer-1a",
    "kind": "incident-report-semantic-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "tiers": [
      { "id": "incident-report-semantic", "kind": "incident-report-semantic-model", "description": "Presentation-neutral incident meaning with explicit source-section coverage and content-preservation assertions." },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [{
      "id": "incident-report-semantic-to-runtime",
      "from": "incident-report-semantic",
      "to": "runtime-document",
      "representations": [{
        "id": "operational-report",
        "views": {
          "incident-workspace": { "capability": "incident1a:workspace", "props": { "title": "Incident report refinement" } },
          "incident-report": { "capability": "incident1a:editor", "props": { "title": "Source report" }, "bindings": { "value": { "from": "incident1a.content" } } },
          "incident-report-selector": { "capability": "fluent:dropdown", "props": { "ariaLabel": "Choose sample incident", "options": [{ "value": "password-spray-mailbox", "label": "Password spray and mailbox compromise" }, { "value": "blob-storage-exfiltration", "label": "Blob storage exfiltration" }, { "value": "identity-compromise", "label": "Identity and cloud resource compromise" }, { "value": "device-code-bec", "label": "Device-code phishing and BEC" }, { "value": "supply-chain-sap-bec", "label": "Supply-chain SAP and procurement BEC" }] }, "bindings": { "value": { "from": "incident1a.selectedSampleId" } }, "visibility": "true" },
          "incident-report-markdown": { "capability": "ui:markdown", "bindings": { "value": { "from": "incident1a.content" } } },
          "incident-report-form": { "capability": "primitive:form", "props": { "fields": { "properties": { "content": { "title": "Markdown content", "type": "string", "format": "textarea", "rows": 34, "minLength": 1, "span": 12 } }, "required": ["content"] }, "saveLabel": "Save report", "discardLabel": "Discard changes" }, "bindings": { "value": { "from": "incident1a.formValue" } } },
          "foundry-access-gate": { "capability": "foundry:access-gate", "bindings": { "access": { "expression": "($s := incident1a.foundryAccessStatus; {'triggered': $s != 'ready' and $s != 'empty', 'status': $s = 'checking' ? 'checking' : ($s = 'required' ? 'required' : 'error'), 'error': incident1a.foundryAccessError})" } } },
          "incident-refinement": { "capability": "incident1a:refinement", "props": { "title": "Improved semantic report" }, "bindings": { "value": { "from": "incident1a.model" }, "content": { "from": "incident1a.content" }, "refinedContent": { "from": "incident1a.refinedContent" }, "error": { "from": "incident1a.error" }, "pending": { "from": "incident1a.refinementPending" } } },
          "incident-improve-report": { "capability": "fluent:button", "props": { "label": "Improve report", "appearance": "primary" }, "bindings": { "disabled": { "from": "incident1a.refinementPending" }, "loading": { "from": "incident1a.refinementPending" } }, "visibility": "incident1a.model = null or incident1a.content != incident1a.refinedContent" },
          "incident-sections": { "capability": "semantic:component-data-sections", "bindings": { "sections": { "from": "incident1a.model.sections" } } }
        },
        "presentation": {
          "roots": ["incident-workspace"],
          "placements": [
            { "cell": "incident-report", "parent": "incident-workspace", "slot": "children", "order": 0 },
            { "cell": "incident-report-selector", "parent": "incident-report", "slot": "children", "order": 0 },
            { "cell": "incident-report-markdown", "parent": "incident-report", "slot": "children", "order": 1 },
            { "cell": "incident-report-form", "parent": "incident-report", "slot": "children", "order": 2 },
            { "cell": "foundry-access-gate", "parent": "incident-workspace", "slot": "children", "order": 1 },
            { "cell": "incident-refinement", "parent": "foundry-access-gate", "slot": "children", "order": 0 },
            { "cell": "incident-sections", "parent": "incident-refinement", "slot": "children", "order": 0 },
            { "cell": "incident-improve-report", "parent": "incident-refinement", "slot": "children", "order": 1 }
          ]
        }
      }],
      "fallback": "operational-report"
    }],
    "services": {
      "incident-report-refinement": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "improveReport": {
            "operation": "chat",
            "contract": "incident-report-component-data/v2",
            "request": { "transform": { "kind": "jsonata", "expr": "{'message':'Transform each section of this incident report into component-ready semantic data. Report Markdown:\n\n' & state.incident1a.pendingContent,'instructions':'PRESERVE every fact and source section. SELECT one preferred semantic contract per section and up to two useful alternatives or complements. Suggestions are guidance only: Verdict decision/argument/narrative; Summary narrative/decision/measure-set; Attack Graph attack-path/relationship-set/process; Correlated Incidents and Alerts evidence-case/relationship-set/entity-set; Timeline event-series/process/milestones; Compromised Entities entity-set/relationship-set/attack-path; TTPs and Key Activities process/entity-set/evidence-case; IOCs and Evidence evidence-case/entity-set/relationship-set; Recommended Actions work-set/process/milestones. Choose another available contract when more appropriate and state why. TRANSFORM data to the selected contract. Return data, not components, variants, layout, styling, or other presentation. Do not invent options or content.','maxOutputTokens':16000}" } },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "provider-structured-output",
                  "message": "Incident report semantic refinement is invalid",
                  "schema": {
                    "type": "object",
                    "required": ["sections", "sectionCoverage", "preservationSummary", "factualChanges", "omissions"],
                    "properties": {
                      "sections": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "sourceHeading", "order", "options"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceHeading": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "options": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "object", "required": ["id", "capability", "relationship", "reason", "data"], "properties": { "id": { "type": "string", "minLength": 1 }, "capability": { "type": "string", "enum": ["semantic:argument", "semantic:decision", "semantic:entity-set", "semantic:event-series", "semantic:evidence-case", "semantic:measure-set", "semantic:milestones", "semantic:narrative", "semantic:process", "semantic:relationship-set", "semantic:work-set", "security:attack-path"] }, "relationship": { "type": "string", "enum": ["preferred", "alternative", "complementary"] }, "reason": { "type": "string", "minLength": 1 }, "data": { "type": "string", "minLength": 2, "description": "JSON-encoded component-ready semantic data" } }, "additionalProperties": false } } }, "additionalProperties": false } },
                      "sectionCoverage": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "sourceSectionId", "sourceHeading", "order", "representationIds", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceSectionId": { "type": "string", "minLength": 1 }, "sourceHeading": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "representationIds": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } }, "status": { "type": "string", "const": "preserved" } }, "additionalProperties": false } },
                      "preservationSummary": { "type": "string", "minLength": 1 },
                      "factualChanges": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
                      "omissions": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
                    },
                    "additionalProperties": false
                  }
                },
                { "kind": "jsonata", "expr": "$count(data.factualChanges) = 0 and $count(data.omissions) = 0 and $count(data.sectionCoverage[status != 'preserved']) = 0 and $count(data.sections[$count(options[relationship = 'preferred']) != 1]) = 0", "message": "Every source section must be preserved with exactly one preferred semantic representation", "code": "content-preservation" }
              ]
            },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident1a.model','value':response},{'op':'set','path':'incident1a.refinedContent','value':state.incident1a.pendingContent},{'op':'set','path':'incident1a.pendingContent','value':null},{'op':'set','path':'incident1a.refinementPending','value':false},{'op':'set','path':'incident1a.error','value':''}]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($access := error.message = 'Foundry access is required' or error.status = 401 or error.status = 403; {'ops':[{'op':'set','path':'incident1a.pendingContent','value':null},{'op':'set','path':'incident1a.refinementPending','value':false},{'op':'set','path':'incident1a.error','value':$access ? '' : error.message},{'op':'set','path':'incident1a.foundryAccessStatus','value':$access ? 'required' : state.incident1a.foundryAccessStatus},{'op':'set','path':'incident1a.foundryAccessError','value':$access ? (error.status = 401 or error.status = 403 ? 'That access key was rejected.' : 'Foundry access is required.') : state.incident1a.foundryAccessError}]})" } },
            "onViolation": { "action": "fail" }
          },
          "checkFoundryAccess": {
            "operation": "check-access",
            "contract": "foundry-access-check/v1",
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident1a.foundryAccessStatus','value':'ready'},{'op':'set','path':'incident1a.foundryAccessError','value':''}]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.message = 'Foundry access is required'; {'ops':[{'op':'set','path':'incident1a.foundryAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'incident1a.foundryAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : error.message)}]})" } },
            "onViolation": { "action": "fail" }
          }
        },
        "config": { "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}", "agent": "Incident-Report-Refinement-Agent", "credentialRef": "foundry-agent/access-key" },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incident1a"],
      "actions": ["assign", "invoke"],
      "capabilities": {
        "incident1a:workspace": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
        "incident1a:editor": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"], "dataProp": "value" },
        "incident1a:refinement": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"], "dataProp": "value" },
        "semantic:component-data-sections": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "sections" },
        "foundry:access-gate": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["accessRequested", "accessCleared"], "slots": ["children"] },
        "fluent:dropdown": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select"], "dataProp": "value" },
        "fluent:button": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["press"] },
        "ui:markdown": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "primitive:form": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["save"] }
      },
      "externals": {
        "projectionViews": { "incident1a": { "from": "self" }, "semantic": { "from": "semantic", "use": ["component-data-sections"] }, "foundry": { "from": "foundry", "use": ["access-gate"] }, "fluent": { "from": "fluent", "use": ["dropdown", "button"] }, "ui": { "from": "floor", "use": ["markdown"] }, "primitive": { "from": "primitive", "use": ["form"] } },
        "effectHandlers": ["selectSampleReport", "saveReport", "prepareRefinement"]
      },
      "state": { "incident1a": { "selectedSampleId": "password-spray-mailbox", "content": "# Loading incident report...", "formValue": { "content": "# Loading incident report..." }, "model": null, "refinedContent": null, "pendingContent": null, "refinementPending": false, "foundryAccessStatus": "required", "foundryAccessError": "", "error": "" } }
    },
    "cells": {
      "incident-workspace": { "id": "incident-workspace", "kind": "workspace" },
      "incident-report": { "id": "incident-report", "kind": "incident-source", "outputs": [{ "token": "incident-report-content", "from": "incident1a.content", "when": "$length(incident1a.content) > 0" }] },
      "incident-report-selector": { "id": "incident-report-selector", "kind": "source-selector", "behavior": { "events": { "select": [{ "do": "invoke", "args": { "tool": "selectSampleReport" } }] } } },
      "incident-report-markdown": { "id": "incident-report-markdown", "kind": "source-reader", "inputs": [{ "token": "incident-report-content" }] },
      "incident-report-form": { "id": "incident-report-form", "kind": "source-editor", "inputs": [{ "token": "incident-report-content" }], "behavior": { "events": { "save": [{ "do": "invoke", "args": { "tool": "saveReport" } }] } } },
      "foundry-access-gate": { "id": "foundry-access-gate", "kind": "access-gate", "behavior": { "events": { "accessRequested": [{ "do": "assign", "target": "incident1a.foundryAccessStatus", "args": { "value": "checking" } }, { "do": "assign", "target": "incident1a.foundryAccessError", "args": { "value": "" } }, { "do": "invoke", "args": { "tool": "checkFoundryAccess" } }], "accessCleared": [{ "do": "assign", "target": "incident1a.foundryAccessStatus", "args": { "value": "required" } }, { "do": "assign", "target": "incident1a.foundryAccessError", "args": { "value": "" } }] } } },
      "incident-refinement": { "id": "incident-refinement", "kind": "semantic-refinement-agent", "inputs": [{ "token": "incident-report-content" }], "sources": [{ "id": "incident-refinement.source", "service": "incident-report-refinement", "operation": "improveReport", "contract": "incident-report-component-data/v2" }], "outputs": [{ "token": "incident-report-semantic-model", "from": "incident1a.model", "when": "incident1a.model != null" }] },
      "incident-improve-report": { "id": "incident-improve-report", "kind": "command", "behavior": { "events": { "press": [{ "do": "assign", "target": "incident1a.refinementPending", "args": { "value": true } }, { "do": "invoke", "args": { "tool": "prepareRefinement" } }, { "do": "invoke", "args": { "tool": "improveReport" } }] } } },
      "incident-sections": { "id": "incident-sections", "kind": "semantic-data-host", "inputs": [{ "token": "incident-report-semantic-model" }] }
    },
    "metadata": { "projectionPattern": "semantic-report-to-authored-runtime" }
  }
}