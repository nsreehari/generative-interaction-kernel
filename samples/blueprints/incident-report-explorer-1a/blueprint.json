{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-report-explorer-1a",
    "kind": "incident-report-semantic-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "tiers": [
      { "id": "incident-report-semantic", "kind": "incident-report-semantic-model", "description": "Presentation-neutral incident meaning with explicit source-section coverage and content-preservation assertions." },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [{
      "id": "incident-report-semantic-to-runtime",
      "from": "incident-report-semantic",
      "to": "runtime-document",
      "representations": [{
        "id": "operational-report",
        "views": {
          "incident-workspace": { "capability": "incident1a:workspace", "props": { "title": "Incident report refinement" } },
          "incident-report": { "capability": "incident1a:editor", "props": { "title": "Source report" }, "bindings": { "value": { "from": "incident1a.content" } } },
          "incident-report-selector": { "capability": "fluent:dropdown", "props": { "ariaLabel": "Choose sample incident", "options": [{ "value": "password-spray-mailbox", "label": "Password spray and mailbox compromise" }, { "value": "blob-storage-exfiltration", "label": "Blob storage exfiltration" }, { "value": "identity-compromise", "label": "Identity and cloud resource compromise" }, { "value": "device-code-bec", "label": "Device-code phishing and BEC" }, { "value": "supply-chain-sap-bec", "label": "Supply-chain SAP and procurement BEC" }] }, "bindings": { "value": { "from": "incident1a.selectedSampleId" } }, "visibility": "true" },
          "incident-report-markdown": { "capability": "ui:markdown", "bindings": { "value": { "from": "incident1a.content" } } },
          "incident-report-form": { "capability": "primitive:form", "props": { "fields": { "properties": { "content": { "title": "Markdown content", "type": "string", "format": "textarea", "rows": 34, "minLength": 1, "span": 12 } }, "required": ["content"] }, "saveLabel": "Save report", "discardLabel": "Discard changes" }, "bindings": { "value": { "from": "incident1a.formValue" } } },
          "foundry-access-gate": { "capability": "foundry:access-gate", "bindings": { "access": { "expression": "($s := incident1a.foundryAccessStatus; {'triggered': $s != 'ready' and $s != 'empty', 'status': $s = 'checking' ? 'checking' : ($s = 'required' ? 'required' : 'error'), 'error': incident1a.foundryAccessError})" } } },
          "incident-refinement": { "capability": "incident1a:refinement", "props": { "title": "Improved semantic report" }, "bindings": { "value": { "from": "incident1a.model" }, "content": { "from": "incident1a.content" }, "refinedContent": { "from": "incident1a.refinedContent" }, "error": { "from": "incident1a.error" } } },
          "incident-verdict": { "capability": "semantic:decision", "props": { "variant": "summary", "spec": { "eyebrow": "Incident determination", "fields": { "title": "identity.title", "summary": "summary", "outcome": "verdict.classification", "rationale": "verdict.rationale", "confidence": "verdict.confidence", "impact": "verdict.impact", "tone": "verdict.confidence" }, "labels": { "rationale": "Rationale", "confidence": "Confidence", "impact": "Impact" }, "toneMap": { "high": "affirmative", "medium": "cautionary", "low": "uncertain" } } }, "bindings": { "decision": { "from": "incident1a.model" } } },
          "incident-attack-path": { "capability": "semantic:attack-path", "props": { "variant": "canvas", "height": 560, "controls": true, "miniMap": true, "spec": { "title": "Attack path", "description": "Entity relationships derived from the preserved report semantics", "entityFields": { "id": "id", "label": "label", "detail": "description", "type": "type", "tone": "status" }, "relationshipFields": { "id": "id", "source": "sourceId", "target": "targetId", "label": "label" }, "toneMap": { "compromised": "danger", "affected": "warning", "targeted": "warning", "observed": "neutral", "unknown": "neutral" } } }, "bindings": { "graph": { "expression": "{'entities':incident1a.model.entities,'relationships':incident1a.model.relationships}" } } },
          "incident-alerts": { "capability": "semantic:process", "props": { "variant": "stages", "spec": { "title": "Correlated alerts", "description": "Reported alert determinations and evidence", "fields": { "id": "id", "title": "title", "detail": "summary", "reference": "verdict", "status": "confidence" }, "toneMap": { "high": "complete", "medium": "current", "low": "unknown" } } }, "bindings": { "items": { "from": "incident1a.model.alerts" } } },
          "incident-timeline": { "capability": "semantic:event-series", "props": { "variant": "chronology", "spec": { "title": "Incident timeline", "description": "Events in reported order", "fields": { "id": "id", "title": "title", "timestamp": "time", "detail": "detail", "status": "confidence" }, "sort": { "direction": "ascending" }, "toneMap": { "high": "current", "medium": "upcoming", "low": "unknown" } } }, "bindings": { "items": { "from": "incident1a.model.events" } } },
          "incident-entities": { "capability": "semantic:entity-set", "props": { "variant": "clusters", "spec": { "title": "Affected entities", "description": "Entities grouped by reported condition", "fields": { "id": "id", "label": "label", "description": "description", "type": "type", "status": "status", "group": "status" }, "groups": [{ "value": "compromised", "label": "Compromised" }, { "value": "affected", "label": "Affected" }, { "value": "targeted", "label": "Targeted" }, { "value": "observed", "label": "Observed" }, { "value": "unknown", "label": "Unknown" }], "toneMap": { "compromised": "affected", "affected": "affected", "targeted": "at-risk", "observed": "observed", "unknown": "unknown" } } }, "bindings": { "items": { "from": "incident1a.model.entities" } } },
          "incident-techniques": { "capability": "semantic:process", "props": { "variant": "flow", "spec": { "title": "ATT&CK progression", "description": "Techniques in reported order", "fields": { "id": "id", "title": "technique", "detail": "description", "reference": "techniqueId", "status": "confidence" }, "toneMap": { "high": "complete", "medium": "current", "low": "unknown" } } }, "bindings": { "items": { "from": "incident1a.model.techniques" } } },
          "incident-indicators": { "capability": "semantic:process", "props": { "variant": "stages", "spec": { "title": "Indicators", "description": "Reported observables and context", "fields": { "id": "id", "title": "type", "detail": "context", "reference": "value", "status": "confidence" }, "toneMap": { "high": "complete", "medium": "current", "low": "unknown" } } }, "bindings": { "items": { "from": "incident1a.model.indicators" } } },
          "incident-actions": { "capability": "semantic:work-set", "props": { "variant": "board", "spec": { "title": "Recommended actions", "description": "Source actions ordered by urgency", "fields": { "id": "id", "title": "title", "detail": "detail", "group": "priority" }, "groups": [{ "value": "immediate", "label": "Immediate" }, { "value": "next", "label": "Next" }, { "value": "follow-up", "label": "Follow-up" }] } }, "bindings": { "items": { "from": "incident1a.model.actions" } } }
        },
        "presentation": {
          "roots": ["incident-workspace"],
          "placements": [
            { "cell": "incident-report", "parent": "incident-workspace", "slot": "children", "order": 0 },
            { "cell": "incident-report-selector", "parent": "incident-report", "slot": "children", "order": 0 },
            { "cell": "incident-report-markdown", "parent": "incident-report", "slot": "children", "order": 1 },
            { "cell": "incident-report-form", "parent": "incident-report", "slot": "children", "order": 2 },
            { "cell": "foundry-access-gate", "parent": "incident-workspace", "slot": "children", "order": 1 },
            { "cell": "incident-refinement", "parent": "foundry-access-gate", "slot": "children", "order": 0 },
            { "cell": "incident-verdict", "parent": "incident-refinement", "slot": "children", "order": 0 },
            { "cell": "incident-attack-path", "parent": "incident-refinement", "slot": "children", "order": 1 },
            { "cell": "incident-alerts", "parent": "incident-refinement", "slot": "children", "order": 2 },
            { "cell": "incident-timeline", "parent": "incident-refinement", "slot": "children", "order": 3 },
            { "cell": "incident-entities", "parent": "incident-refinement", "slot": "children", "order": 4 },
            { "cell": "incident-techniques", "parent": "incident-refinement", "slot": "children", "order": 5 },
            { "cell": "incident-indicators", "parent": "incident-refinement", "slot": "children", "order": 6 },
            { "cell": "incident-actions", "parent": "incident-refinement", "slot": "children", "order": 7 }
          ]
        }
      }],
      "fallback": "operational-report"
    }],
    "services": {
      "incident-report-refinement": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "improveReport": {
            "operation": "chat",
            "contract": "incident-report-semantic-refinement/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'message':'Build a clearer semantic incident report from this investigation without changing its content. Report Markdown:\n\n' & state.incident1a.pendingContent,'instructions':'Return presentation-neutral incident semantics only. Preserve every source fact and source section. Improve only semantic organization and wording clarity without adding, omitting, weakening, strengthening, or inferring content. Keep source ordering in phases, alerts, events, techniques, indicators, actions, and sectionCoverage. Use stable ids and reference only ids declared in this response. Every source heading must appear exactly once in sectionCoverage. factualChanges and omissions must be empty. Do not return Markdown, components, layouts, visual hierarchy, disclosure, canvas positions, colors, or presentation candidates.','maxOutputTokens':16000}" } },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "provider-structured-output",
                  "message": "Incident report semantic refinement is invalid",
                  "schema": {
                    "type": "object",
                    "required": ["identity", "verdict", "summary", "phases", "entities", "relationships", "alerts", "events", "techniques", "indicators", "actions", "sectionCoverage", "preservationSummary", "factualChanges", "omissions"],
                    "properties": {
                      "identity": { "type": "object", "required": ["incidentId", "title", "startTime", "endTime"], "properties": { "incidentId": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "startTime": { "type": "string" }, "endTime": { "type": "string" } }, "additionalProperties": false },
                      "verdict": { "type": "object", "required": ["classification", "determination", "confidence", "rationale", "impact"], "properties": { "classification": { "type": "string", "minLength": 1 }, "determination": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] }, "rationale": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
                      "summary": { "type": "string", "minLength": 1 },
                      "phases": { "type": "array", "items": { "type": "object", "required": ["id", "name", "order", "summary"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "summary": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
                      "entities": { "type": "array", "items": { "type": "object", "required": ["id", "type", "label", "status", "description", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["compromised", "affected", "targeted", "observed", "unknown"] }, "description": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "relationships": { "type": "array", "items": { "type": "object", "required": ["id", "sourceId", "targetId", "label", "phaseId"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" } }, "additionalProperties": false } },
                      "alerts": { "type": "array", "items": { "type": "object", "required": ["id", "title", "verdict", "summary", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "verdict": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "events": { "type": "array", "items": { "type": "object", "required": ["id", "time", "title", "detail", "phaseId", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "time": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "techniques": { "type": "array", "items": { "type": "object", "required": ["id", "technique", "techniqueId", "description", "phaseId", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "technique": { "type": "string", "minLength": 1 }, "techniqueId": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "indicators": { "type": "array", "items": { "type": "object", "required": ["id", "type", "value", "context", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 }, "context": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "actions": { "type": "array", "items": { "type": "object", "required": ["id", "priority", "category", "title", "detail"], "properties": { "id": { "type": "string", "minLength": 1 }, "priority": { "type": "string", "enum": ["immediate", "next", "follow-up"] }, "category": { "type": "string", "enum": ["containment", "investigation", "recovery", "hardening"] }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
                      "sectionCoverage": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "sourceHeading", "semanticField", "order", "status"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceHeading": { "type": "string", "minLength": 1 }, "semanticField": { "type": "string", "enum": ["verdict", "summary", "attack-path", "alerts", "timeline", "entities", "techniques", "indicators", "actions"] }, "order": { "type": "integer", "minimum": 0 }, "status": { "type": "string", "const": "preserved" } }, "additionalProperties": false } },
                      "preservationSummary": { "type": "string", "minLength": 1 },
                      "factualChanges": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
                      "omissions": { "type": "array", "maxItems": 0, "items": { "type": "string" } }
                    },
                    "additionalProperties": false
                  }
                },
                { "kind": "jsonata", "expr": "$count(data.factualChanges) = 0 and $count(data.omissions) = 0 and $count(data.sectionCoverage[status != 'preserved']) = 0", "message": "Semantic refinement must preserve every source section without factual changes or omissions", "code": "content-preservation" }
              ]
            },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident1a.model','value':response},{'op':'set','path':'incident1a.refinedContent','value':state.incident1a.pendingContent},{'op':'set','path':'incident1a.pendingContent','value':null},{'op':'set','path':'incident1a.error','value':''}]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($access := error.message = 'Foundry access is required' or error.status = 401 or error.status = 403; {'ops':[{'op':'set','path':'incident1a.pendingContent','value':null},{'op':'set','path':'incident1a.error','value':$access ? '' : error.message},{'op':'set','path':'incident1a.foundryAccessStatus','value':$access ? 'required' : state.incident1a.foundryAccessStatus},{'op':'set','path':'incident1a.foundryAccessError','value':$access ? (error.status = 401 or error.status = 403 ? 'That access key was rejected.' : 'Foundry access is required.') : state.incident1a.foundryAccessError}]})" } },
            "onViolation": { "action": "fail" }
          },
          "checkFoundryAccess": {
            "operation": "check-access",
            "contract": "foundry-access-check/v1",
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident1a.foundryAccessStatus','value':'ready'},{'op':'set','path':'incident1a.foundryAccessError','value':''}]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.message = 'Foundry access is required'; {'ops':[{'op':'set','path':'incident1a.foundryAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'incident1a.foundryAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : error.message)}]})" } },
            "onViolation": { "action": "fail" }
          }
        },
        "config": { "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}", "agent": "Incident-Report-Refinement-Agent", "credentialRef": "foundry-agent/access-key" },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incident1a"],
      "actions": ["assign", "invoke"],
      "capabilities": {
        "incident1a:workspace": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
        "incident1a:editor": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"], "dataProp": "value" },
        "incident1a:refinement": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["improve"], "slots": ["children"], "dataProp": "value" },
        "semantic:event-series": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "items" },
        "semantic:process": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "items" },
        "semantic:entity-set": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "items" },
        "semantic:decision": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "decision" },
        "semantic:work-set": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select", "activate", "reorder", "move"], "dataProp": "items" },
        "foundry:access-gate": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["accessRequested", "accessCleared"], "slots": ["children"] },
        "fluent:dropdown": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["select"], "dataProp": "value" },
        "ui:markdown": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "primitive:form": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["save"] }
      },
      "externals": {
        "projectionViews": { "incident1a": { "from": "self" }, "semantic": { "from": "semantic", "use": ["attack-graph", "timeline", "sequence", "entity-constellation", "decision-summary", "action-board"] }, "foundry": { "from": "foundry", "use": ["access-gate"] }, "fluent": { "from": "fluent", "use": ["dropdown"] }, "ui": { "from": "floor", "use": ["markdown"] }, "primitive": { "from": "primitive", "use": ["form"] } },
        "effectHandlers": ["selectSampleReport", "saveReport", "prepareRefinement"]
      },
      "state": { "incident1a": { "selectedSampleId": "password-spray-mailbox", "content": "# Loading incident report...", "formValue": { "content": "# Loading incident report..." }, "model": null, "refinedContent": null, "pendingContent": null, "foundryAccessStatus": "required", "foundryAccessError": "", "error": "" } }
    },
    "cells": {
      "incident-workspace": { "id": "incident-workspace", "kind": "workspace" },
      "incident-report": { "id": "incident-report", "kind": "incident-source", "outputs": [{ "token": "incident-report-content", "from": "incident1a.content", "when": "$length(incident1a.content) > 0" }] },
      "incident-report-selector": { "id": "incident-report-selector", "kind": "source-selector", "behavior": { "events": { "select": [{ "do": "invoke", "args": { "tool": "selectSampleReport" } }] } } },
      "incident-report-markdown": { "id": "incident-report-markdown", "kind": "source-reader", "inputs": [{ "token": "incident-report-content" }] },
      "incident-report-form": { "id": "incident-report-form", "kind": "source-editor", "inputs": [{ "token": "incident-report-content" }], "behavior": { "events": { "save": [{ "do": "invoke", "args": { "tool": "saveReport" } }] } } },
      "foundry-access-gate": { "id": "foundry-access-gate", "kind": "access-gate", "behavior": { "events": { "accessRequested": [{ "do": "assign", "target": "incident1a.foundryAccessStatus", "args": { "value": "checking" } }, { "do": "assign", "target": "incident1a.foundryAccessError", "args": { "value": "" } }, { "do": "invoke", "args": { "tool": "checkFoundryAccess" } }], "accessCleared": [{ "do": "assign", "target": "incident1a.foundryAccessStatus", "args": { "value": "required" } }, { "do": "assign", "target": "incident1a.foundryAccessError", "args": { "value": "" } }] } } },
      "incident-refinement": { "id": "incident-refinement", "kind": "semantic-refinement-agent", "inputs": [{ "token": "incident-report-content" }], "sources": [{ "id": "incident-refinement.source", "service": "incident-report-refinement", "operation": "improveReport", "contract": "incident-report-semantic-refinement/v1" }], "behavior": { "events": { "improve": [{ "do": "invoke", "args": { "tool": "prepareRefinement" } }, { "do": "invoke", "args": { "tool": "improveReport" } }] } }, "outputs": [{ "token": "incident-report-semantic-model", "from": "incident1a.model", "when": "incident1a.model != null" }] },
      "incident-verdict": { "id": "incident-verdict", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] },
      "incident-attack-path": { "id": "incident-attack-path", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] },
      "incident-alerts": { "id": "incident-alerts", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] },
      "incident-timeline": { "id": "incident-timeline", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] },
      "incident-entities": { "id": "incident-entities", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] },
      "incident-techniques": { "id": "incident-techniques", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] },
      "incident-indicators": { "id": "incident-indicators", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] },
      "incident-actions": { "id": "incident-actions", "kind": "semantic-leaf", "inputs": [{ "token": "incident-report-semantic-model" }] }
    },
    "metadata": { "projectionPattern": "semantic-report-to-authored-runtime" }
  }
}