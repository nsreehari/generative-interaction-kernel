{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "portfolio-tracker-2tiers-headless",
    "kind": "portfolio-intent-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "agentLifecycle": {
      "profiles": {
        "use": {
          "id": "use-blueprint",
          "version": "1.0.0",
          "description": "Operate the portfolio tracker as a headless state and service workflow.",
          "targetKinds": ["blueprint-instance"],
          "intentKinds": ["set-holdings", "refresh-prices"],
          "goals": [
            "Keep holdings, quotes, positions, summary values, and status synchronized through declared operations.",
            "Expose deterministic state transitions and service effects to API, middleware, and durable-worker hosts."
          ],
          "constraints": [
            "Use declared holdings and market-data operations instead of directly mutating runtime state.",
            "Do not invent holdings or market prices.",
            "Do not require or synthesize presentation capabilities."
          ]
        }
      }
    },
    "tiers": [
      { "id": "portfolio-intent", "kind": "portfolio-domain" },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [
      {
        "id": "portfolio-intent-to-runtime",
        "from": "portfolio-intent",
        "to": "runtime-document",
        "representations": [
          { "id": "headless-runtime", "headless": true }
        ],
        "fallback": "headless-runtime",
        "implementationPrograms": [
          {
            "id": "live-market",
            "when": "externalContext.marketMode = 'live'"
          },
          {
            "id": "mock-market",
            "when": "externalContext.marketMode = 'mock'",
            "services": {
              "portfolio-market-data": {
                "kind": "deterministic-agent",
                "version": "1",
                "operations": {
                  "checkHttpProxyAccess": {
                    "operation": "check-access",
                    "contract": "http-proxy-access-check/v1",
                    "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'portfolio.httpProxyAccessStatus','value':'ready'},{'op':'set','path':'portfolio.httpProxyAccessError','value':''}]}" } }
                  },
                  "refreshPrices": {
                    "operation": "fetch-quotes",
                    "contract": "portfolio-market-quotes/v1",
                    "request": { "transform": { "kind": "jsonata", "expr": "{'holdings':state.portfolio.holdings}" } },
                    "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'portfolio.quotes','value':response.quotes}],'detail':{'provider':response.provider,'quoteCount':$count(response.quotes.*)}}" } }
                  }
                },
                "config": { "handler": "portfolio-market-data-mock" },
                "scope": "per-blueprint"
              }
            }
          }
        ],
        "implementationFallback": "live-market"
      }
    ],
    "services": {
      "portfolio-market-data": {
        "kind": "http-service",
        "version": "1",
        "operations": {
          "checkHttpProxyAccess": {
            "operation": "check-access",
            "contract": "http-proxy-access-check/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'portfolio.httpProxyAccessStatus','value':'ready'},{'op':'set','path':'portfolio.httpProxyAccessError','value':''}]}"
              }
            },
            "failureSettlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'http-proxy/access-key'; {'ops':[{'op':'set','path':'portfolio.httpProxyAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'portfolio.httpProxyAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'HTTP proxy access is required.' : error.message)}]})"
              }
            },
            "onViolation": { "action": "fail" }
          },
          "refreshPrices": {
            "operation": "fetch-quotes",
            "contract": "portfolio-market-quotes/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'requests':state.portfolio.holdings.*.{'key':ticker,'url':'https://query1.finance.yahoo.com/v8/finance/chart/' & ticker & '?interval=1d&range=1d','headers':{'User-Agent':'Mozilla/5.0 (compatible; portfolio-tracker-demo/1.0)'},'meta':{'quantity':quantity,'costBasis':costBasis}}}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'portfolio.quotes','value':$count(response.results) > 0 ? $merge(response.results.{key:{'ticker':key,'price':$round(body.chart.result[0].meta.regularMarketPrice, 2)}}) : {}}],'detail':{'provider':'yahoo-finance-http-service','quoteCount':$count(response.results)}}"
              }
            }
          }
        },
        "config": { "endpoint": "${GIK_HTTP_PROXY_ORIGIN}", "credentialRef": "http-proxy/access-key" },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["portfolio"],
      "contexts": ["control"],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "externals": {
        "effectHandlers": ["setHoldings", "saveHoldings"]
      },
      "state": {
        "portfolio": {
          "httpProxyAccessStatus": "checking",
          "httpProxyAccessError": "",
          "holdings": {
            "AAPL": { "ticker": "AAPL", "quantity": 10, "costBasis": 182.5 },
            "MSFT": { "ticker": "MSFT", "quantity": 5, "costBasis": 420 }
          },
          "quotes": {
            "AAPL": { "ticker": "AAPL", "price": 218.42 },
            "MSFT": { "ticker": "MSFT", "price": 447.31 }
          },
          "positions": {
            "AAPL": { "ticker": "AAPL", "quantity": 10, "price": 218.42, "value": 2184.2, "costBasis": 1825, "gainLoss": 359.2 },
            "MSFT": { "ticker": "MSFT", "quantity": 5, "price": 447.31, "value": 2236.55, "costBasis": 2100, "gainLoss": 136.55 }
          },
          "summary": { "marketValue": 4420.75, "costBasis": 3925, "gainLoss": 495.75 },
          "status": { "tone": "positive", "message": "Portfolio is above cost basis." }
        }
      }
    },
    "cells": {
      "portfolio-workspace": {
        "id": "portfolio-workspace",
        "kind": "portfolio-cell",
        "metadata": { "role": "workspace" },
        "behavior": {
          "on": {
            "setHoldings": [
              {
                "do": "invoke",
                "control": {
                  "tool": "setHoldings"
                }
              }
            ]
          }
        },
        "events": {
          "setHoldings": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "http-proxy-access-gate": {
        "id": "http-proxy-access-gate",
        "kind": "portfolio-cell",
        "metadata": { "role": "authorize-market-data" },
        "behavior": {
          "on": {
            "accessRequested": [
              {
                "do": "invoke",
                "control": {
                  "tool": "checkHttpProxyAccess"
                }
              }
            ],
            "accessCleared": [
              {
                "do": "assign",
                "target": "portfolio.httpProxyAccessStatus",
                "args": {
                  "value": "required"
                }
              },
              {
                "do": "assign",
                "target": "portfolio.httpProxyAccessError",
                "args": {
                  "value": ""
                }
              }
            ]
          }
        },
        "events": {
          "accessRequested": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "accessCleared": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "holdings": {
        "id": "holdings",
        "kind": "portfolio-cell",
        "metadata": { "role": "manage-holdings" },
        "behavior": {
          "on": {
            "save": [
              {
                "do": "invoke",
                "control": {
                  "tool": "saveHoldings"
                }
              }
            ]
          }
        },
        "events": {
          "save": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "market-prices": {
        "id": "market-prices",
        "kind": "portfolio-cell",
        "metadata": { "role": "acquire-market-prices" },
        "inputs": [
          { "token": "portfolio.httpProxyAccessStatus", "as": "access" },
          { "token": "portfolio.holdings", "as": "holdings" }
        ],
        "sources": [{
          "id": "market-prices.source",
          "service": "portfolio-market-data",
          "operation": "refreshPrices",
          "contract": "portfolio-market-quotes/v1",
          "when": "inputs.access = 'ready' and $count(inputs.holdings.*) > 0",
          "output": { "kind": "jsonata", "expr": "response.quotes" }
        }],
        "outputs": [{ "token": "portfolio-quotes", "from": "computed.portfolio.quotes" }],
        "compute": [{
          "id": "settled-market-prices",
          "expression": "sources.`market-prices.source`",
          "assign": "portfolio.quotes",
          "dependencies": ["sources.market-prices.source"]
        }],
        "events": { "refresh": { "payloadSchema": { "type": "object" } } },
        "behavior": {
          "on": { "refresh": [{ "do": "invoke", "control": { "tool": "refreshPrices" } }] }
        }
      },
      "positions": {
        "id": "positions",
        "kind": "portfolio-cell",
        "metadata": { "role": "derive-positions" },
        "inputs": [
          { "token": "portfolio.holdings", "as": "holdings" },
          { "token": "portfolio-quotes", "as": "quotes" }
        ],
        "outputs": [{ "token": "portfolio-positions", "from": "computed.portfolio.positions" }],
        "compute": [{
          "id": "positions-by-ticker",
          "expression": "$merge(inputs.holdings.*.($quote := $lookup($$.inputs.quotes, ticker); {ticker:{'ticker':ticker,'quantity':quantity,'price':$quote.price,'value':$round(quantity * $quote.price, 2),'costBasis':$round(quantity * costBasis, 2),'gainLoss':$round((quantity * $quote.price) - (quantity * costBasis), 2)}}))",
          "assign": "portfolio.positions",
          "dependencies": ["portfolio.holdings", "portfolio.quotes"]
        }]
      },
      "summary": {
        "id": "summary",
        "kind": "portfolio-cell",
        "metadata": { "role": "summarize-portfolio" },
        "inputs": [{ "token": "portfolio-positions", "as": "positions" }],
        "outputs": [{ "token": "portfolio-summary", "from": "computed.portfolio.summary" }],
        "compute": [{
          "id": "portfolio-totals",
          "expression": "{'marketValue':$count(inputs.positions.*) > 0 ? $round($sum(inputs.positions.*.value), 2) : 0,'costBasis':$count(inputs.positions.*) > 0 ? $round($sum(inputs.positions.*.costBasis), 2) : 0,'gainLoss':$count(inputs.positions.*) > 0 ? $round($sum(inputs.positions.*.gainLoss), 2) : 0}",
          "assign": "portfolio.summary",
          "dependencies": ["portfolio.positions"]
        }]
      },
      "portfolio-status": {
        "id": "portfolio-status",
        "kind": "portfolio-cell",
        "metadata": { "role": "classify-performance" },
        "inputs": [{ "token": "portfolio-summary", "as": "summary" }],
        "outputs": [{ "token": "portfolio-status", "from": "computed.portfolio.status" }],
        "compute": [{
          "id": "classify-gain-loss",
          "expression": "{'tone':inputs.summary.gainLoss > 0 ? 'positive' : inputs.summary.gainLoss < 0 ? 'negative' : 'neutral','message':inputs.summary.gainLoss > 0 ? 'Portfolio is above cost basis.' : inputs.summary.gainLoss < 0 ? 'Portfolio is below cost basis.' : 'Portfolio is at cost basis.'}",
          "assign": "portfolio.status",
          "dependencies": ["portfolio.summary"]
        }]
      }
    }
  }
}
