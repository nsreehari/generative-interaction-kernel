{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "middleware-continuity",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "interface": {
      "events": ["queue", "complete"]
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["continuity"],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "state": {
        "continuity": {
          "job": {
            "status": "idle",
            "result": "",
            "requestedBy": "",
            "completedBy": ""
          }
        }
      }
    },
    "serviceTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Control-plane continuity workflow shared by MCP and a background worker."
      }
    ],
    "serviceRecipes": [],
    "projectionTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Control-plane continuity workflow shared by MCP and a background worker."
      }
    ],
    "projectionRecipes": [],
    "cells": {
      "continuity-controller": {
        "id": "continuity-controller",
        "kind": "middleware-workflow",
        "behavior": {
          "on": {
            "queue": [
              {
                "do": "assign",
                "target": "continuity.job.status",
                "args": {
                  "value": "queued"
                }
              },
              {
                "do": "assign",
                "target": "continuity.job.result",
                "args": {
                  "value": ""
                }
              },
              {
                "do": "assign",
                "target": "continuity.job.requestedBy",
                "args": {
                  "value": "mcp-control"
                }
              },
              {
                "do": "assign",
                "target": "continuity.job.completedBy",
                "args": {
                  "value": ""
                }
              }
            ],
            "complete": [
              {
                "do": "assign",
                "target": "continuity.job.status",
                "args": {
                  "value": "completed"
                }
              },
              {
                "do": "assign",
                "target": "continuity.job.result",
                "args": {
                  "value": "background-analysis-ready"
                }
              },
              {
                "do": "assign",
                "target": "continuity.job.completedBy",
                "args": {
                  "value": "background-worker"
                }
              }
            ]
          }
        },
        "events": {
          "queue": {
            "payloadSchema": {
              "type": "object"
            }
          },
          "complete": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    },
    "metadata": {
      "scope": "middleware",
      "executionMedium": "mcp-control-plane",
      "sourceSample": "samples/apps/node-host/service.ts"
    }
  }
}