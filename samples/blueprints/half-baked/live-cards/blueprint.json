{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "live-cards",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "recipes": [],
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "liveCards"
      ],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "capabilities": {
        "primitive:container": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "fluent:row": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "fluent:panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "fluent:data-grid": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "select",
            "sort"
          ]
        },
        "primitive:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        },
        "fluent:toolbar": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": ["children"]
        },
        "fluent:button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": ["press"]
        }
      },
      "externals": {
        "projectionViews": {
          "primitive": {
            "from": "primitive",
            "use": ["container", "markdown"]
          },
          "fluent": {
            "from": "fluent",
            "use": ["button", "data-grid", "panel", "row", "text", "toolbar"]
          }
        }
      },
      "state": {
        "liveCards": {
          "selectedId": "incident",
          "cards": [
            {
              "id": "incident",
              "title": "Incident status",
              "status": "Investigating",
              "owner": "SOC",
              "detail": "## Incident status\n\nThe investigation is active. Host-A is contained, evidence is preserved, and lateral movement has not been confirmed."
            },
            {
              "id": "evidence",
              "title": "Evidence",
              "status": "Current",
              "owner": "Correlation",
              "detail": "## Evidence\n\nIdentity, endpoint, and network observations point to Host-A as the execution origin."
            },
            {
              "id": "response",
              "title": "Response plan",
              "status": "Authorized",
              "owner": "Incident command",
              "detail": "## Response plan\n\nMaintain bounded containment, verify dependencies, and retain the reversible recovery path."
            }
          ],
          "shortcuts": [
            {
              "id": "incident",
              "label": "Incident"
            },
            {
              "id": "evidence",
              "label": "Evidence"
            },
            {
              "id": "response",
              "label": "Response"
            }
          ]
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Canonical Kernel-executable live cards document."
      }
    ],
    "cells": {
      "live-cards-root": {
        "id": "live-cards-root",
        "view": {
          "capability": "primitive:container",
          "props": {
            "variant": "column",
            "gap": "m",
            "fill": true,
            "ariaLabel": "Live cards"
          }
        }
      },
      "live-cards-title": {
        "id": "live-cards-title",
        "view": {
          "capability": "fluent:text",
          "props": { "value": "Live cards", "as": "h1", "variant": "title", "block": true }
        }
      },
      "live-cards-subtitle": {
        "id": "live-cards-subtitle",
        "view": {
          "capability": "fluent:text",
          "props": { "value": "One state model projected into selectable operational cards", "as": "p", "variant": "subtitle", "block": true }
        }
      },
      "live-cards-layout": {
        "id": "live-cards-layout",
        "view": {
          "capability": "fluent:row"
        }
      },
      "live-cards-catalog": {
        "id": "live-cards-catalog",
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "liveCards.selectedId",
                "args": {
                  "from": "$event.rowIds[0]"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:data-grid",
          "props": {
            "ariaLabel": "Cards",
            "selectionMode": "single",
            "columns": [
              {
                "id": "title",
                "label": "Card"
              },
              {
                "id": "status",
                "label": "Status"
              },
              {
                "id": "owner",
                "label": "Owner"
              }
            ]
          },
          "bindings": {
            "rows": {
              "expression": "liveCards.cards.{'id':$string(id),'cells':{'title':title,'status':status,'owner':owner}}"
            },
            "selectedRowIds": {
              "expression": "liveCards.selectedId != '' ? [liveCards.selectedId] : []"
            }
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "live-cards-detail": {
        "id": "live-cards-detail",
        "view": {
          "capability": "fluent:panel",
          "props": {
            "title": "Selected card"
          }
        }
      },
      "live-cards-detail-text": {
        "id": "live-cards-detail-text",
        "view": {
          "capability": "primitive:markdown",
          "bindings": {
            "value": {
              "expression": "liveCards.cards[id = liveCards.selectedId][0].detail"
            }
          }
        }
      },
      "live-cards-shortcuts": {
        "id": "live-cards-shortcuts",
        "view": {
          "capability": "fluent:toolbar",
          "props": { "ariaLabel": "Choose live card" }
        }
      },
      "live-cards-shortcut-incident": {
        "id": "live-cards-shortcut-incident",
        "behavior": {
          "on": {
            "press": [
              {
                "do": "assign",
                "target": "liveCards.selectedId",
                "args": {
                  "value": "incident"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:button",
          "props": { "label": "Incident" }
        },
        "events": {
          "press": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "live-cards-shortcut-evidence": {
        "id": "live-cards-shortcut-evidence",
        "behavior": {
          "on": {
            "press": [
              {
                "do": "assign",
                "target": "liveCards.selectedId",
                "args": {
                  "value": "evidence"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:button",
          "props": { "label": "Evidence" }
        },
        "events": {
          "press": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "live-cards-shortcut-response": {
        "id": "live-cards-shortcut-response",
        "behavior": {
          "on": {
            "press": [
              {
                "do": "assign",
                "target": "liveCards.selectedId",
                "args": {
                  "value": "response"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:button",
          "props": { "label": "Response" }
        },
        "events": {
          "press": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": [
          "live-cards-root"
        ],
        "placements": [
          {
            "cell": "live-cards-title",
            "parent": "live-cards-root",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "live-cards-subtitle",
            "parent": "live-cards-root",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "live-cards-shortcuts",
            "parent": "live-cards-root",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "live-cards-shortcut-incident",
            "parent": "live-cards-shortcuts",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "live-cards-shortcut-evidence",
            "parent": "live-cards-shortcuts",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "live-cards-shortcut-response",
            "parent": "live-cards-shortcuts",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "live-cards-layout",
            "parent": "live-cards-root",
            "slot": "children",
            "order": 3
          },
          {
            "cell": "live-cards-catalog",
            "parent": "live-cards-layout",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "live-cards-detail",
            "parent": "live-cards-layout",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "live-cards-detail-text",
            "parent": "live-cards-detail",
            "slot": "children",
            "order": 0
          }
        ]
      }
    },
    "metadata": {
      "executionModel": "direct-runtime",
      "authoredStages": [
        "interaction",
        "presentation",
        "runtime-document"
      ]
    }
  }
}
