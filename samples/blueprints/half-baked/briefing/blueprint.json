{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "briefing",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "briefing"
      ],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "capabilities": {
        "primitive:container": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "fluent:row": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "fluent:panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "primitive:metric": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        },
        "fluent:table": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        },
        "primitive:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        }
      },
      "externals": {
        "projectionViews": {
          "primitive": {
            "from": "primitive",
            "use": ["container", "markdown", "metric"]
          },
          "fluent": {
            "from": "fluent",
            "use": ["panel", "row", "table", "text"]
          }
        }
      },
      "state": {
        "briefing": {
          "headline": "Investigation remains contained with no confirmed lateral movement.",
          "metrics": {
            "activeIncidents": 3,
            "highPriority": 1,
            "coverage": "94%"
          },
          "updates": [
            {
              "id": "update-1",
              "priority": "High",
              "area": "Identity",
              "update": "Privileged sign-in review is in progress",
              "owner": "SOC"
            },
            {
              "id": "update-2",
              "priority": "Medium",
              "area": "Endpoint",
              "update": "Host-A containment evidence is preserved",
              "owner": "Response"
            },
            {
              "id": "update-3",
              "priority": "Low",
              "area": "Cloud",
              "update": "No related control-plane changes detected",
              "owner": "Platform"
            }
          ],
          "nextSteps": "### Next steps\n\n1. Complete the privileged sign-in review.\n2. Verify Host-A dependencies before release.\n3. Reassess incident priority at the next handoff."
        }
      }
    },
    "serviceTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Canonical Kernel-executable briefing document."
      }
    ],
    "serviceRecipes": [],
    "projectionTiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Canonical Kernel-executable briefing document."
      }
    ],
    "projectionRecipes": [],
    "cells": {
      "briefing-root": {
        "id": "briefing-root",
        "view": {
          "capability": "primitive:container",
          "props": {
            "variant": "column",
            "gap": "m",
            "fill": true,
            "ariaLabel": "Operational briefing"
          }
        }
      },
      "briefing-title": {
        "id": "briefing-title",
        "view": {
          "capability": "fluent:text",
          "props": {
            "value": "Operational briefing",
            "as": "h1",
            "variant": "title",
            "block": true
          }
        }
      },
      "briefing-subtitle": {
        "id": "briefing-subtitle",
        "view": {
          "capability": "fluent:text",
          "props": {
            "value": "Current posture, material updates, and next steps",
            "as": "p",
            "variant": "subtitle",
            "block": true
          }
        }
      },
      "briefing-headline": {
        "id": "briefing-headline",
        "view": {
          "capability": "primitive:markdown",
          "bindings": {
            "value": {
              "from": "briefing.headline"
            }
          }
        }
      },
      "briefing-metrics": {
        "id": "briefing-metrics",
        "view": {
          "capability": "fluent:row"
        }
      },
      "briefing-active": {
        "id": "briefing-active",
        "view": {
          "capability": "primitive:metric",
          "props": {
            "label": "Active incidents"
          },
          "bindings": {
            "value": {
              "from": "briefing.metrics.activeIncidents"
            }
          }
        }
      },
      "briefing-priority": {
        "id": "briefing-priority",
        "view": {
          "capability": "primitive:metric",
          "props": {
            "label": "High priority"
          },
          "bindings": {
            "value": {
              "from": "briefing.metrics.highPriority"
            }
          }
        }
      },
      "briefing-coverage": {
        "id": "briefing-coverage",
        "view": {
          "capability": "primitive:metric",
          "props": {
            "label": "Coverage"
          },
          "bindings": {
            "value": {
              "from": "briefing.metrics.coverage"
            }
          }
        }
      },
      "briefing-updates": {
        "id": "briefing-updates",
        "view": {
          "capability": "fluent:table",
          "props": {
            "ariaLabel": "Material updates",
            "columns": [
              {
                "id": "priority",
                "label": "Priority"
              },
              {
                "id": "area",
                "label": "Area"
              },
              {
                "id": "update",
                "label": "Update"
              },
              {
                "id": "owner",
                "label": "Owner"
              }
            ]
          },
          "bindings": {
            "rows": {
              "expression": "briefing.updates.{'id':$string(id),'cells':{'priority':priority,'area':area,'update':update,'owner':owner}}"
            }
          }
        }
      },
      "briefing-next": {
        "id": "briefing-next",
        "view": {
          "capability": "fluent:panel",
          "props": {
            "title": "Next steps"
          }
        }
      },
      "briefing-next-text": {
        "id": "briefing-next-text",
        "view": {
          "capability": "primitive:markdown",
          "bindings": {
            "value": {
              "from": "briefing.nextSteps"
            }
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": [
          "briefing-root"
        ],
        "placements": [
          {
            "cell": "briefing-title",
            "parent": "briefing-root",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "briefing-subtitle",
            "parent": "briefing-root",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "briefing-headline",
            "parent": "briefing-root",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "briefing-metrics",
            "parent": "briefing-root",
            "slot": "children",
            "order": 3
          },
          {
            "cell": "briefing-active",
            "parent": "briefing-metrics",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "briefing-priority",
            "parent": "briefing-metrics",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "briefing-coverage",
            "parent": "briefing-metrics",
            "slot": "children",
            "order": 4
          },
          {
            "cell": "briefing-updates",
            "parent": "briefing-root",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "briefing-next",
            "parent": "briefing-root",
            "slot": "children",
            "order": 5
          },
          {
            "cell": "briefing-next-text",
            "parent": "briefing-next",
            "slot": "children",
            "order": 0
          }
        ]
      }
    },
    "metadata": {
      "executionModel": "direct-runtime",
      "authoredStages": [
        "agent-interaction",
        "runtime-document"
      ]
    }
  }
}
