{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-report-explorer",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "recipes": [],
    "services": {
      "incident-report-intelligence": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "analyzeReport": {
            "operation": "chat",
            "contract": "incident-report-intelligence/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'message':'Transform this security investigation report into an engaging, high-signal incident intelligence view. Report Markdown:\n\n' & state.incident.pendingContent,'instructions':'Use only facts in the supplied report. Return reusable semantic items, then two projection candidates that reference item ids. Candidate one must be glanceable and candidate two focused. Available primitives: hero-signal, metric-strip, signal-list, timeline, entity-grid, technique-list, action-list, narrative. Priority: primary, secondary, tertiary. Disclosure: always, collapsed, on-demand. Item fields: id, kind, title, detail, salience, confidence, value, unit, date. Keep the output concise and operationally useful.','maxOutputTokens':2500}"
              }
            },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "provider-structured-output",
                  "message": "Incident intelligence response is invalid",
                  "schema": {
                    "type": "object",
                    "required": ["headline", "summary", "asOf", "items", "projectionCandidates"],
                    "properties": {
                      "headline": { "type": "string", "minLength": 1 },
                      "summary": { "type": "string", "minLength": 1 },
                      "asOf": { "type": "string", "minLength": 1 },
                      "items": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["id", "kind", "title", "detail", "salience", "confidence", "value", "unit", "date"],
                          "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "kind": { "type": "string", "enum": ["fact", "risk", "judgment", "uncertainty", "event", "entity", "technique", "action"] },
                            "title": { "type": "string", "minLength": 1 },
                            "detail": { "type": "string", "minLength": 1 },
                            "salience": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
                            "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
                            "value": { "type": "string" },
                            "unit": { "type": "string" },
                            "date": { "type": "string" }
                          },
                          "additionalProperties": false
                        }
                      },
                      "projectionCandidates": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": {
                          "type": "object",
                          "required": ["id", "label", "attention", "rationale", "sections"],
                          "properties": {
                            "id": { "type": "string", "minLength": 1 },
                            "label": { "type": "string", "minLength": 1 },
                            "attention": { "type": "string", "enum": ["glanceable", "focused"] },
                            "rationale": { "type": "string", "minLength": 1 },
                            "sections": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "type": "object",
                                "required": ["id", "title", "primitive", "priority", "disclosure", "contentIds"],
                                "properties": {
                                  "id": { "type": "string", "minLength": 1 },
                                  "title": { "type": "string", "minLength": 1 },
                                  "primitive": { "type": "string", "enum": ["hero-signal", "metric-strip", "signal-list", "timeline", "entity-grid", "technique-list", "action-list", "narrative"] },
                                  "priority": { "type": "string", "enum": ["primary", "secondary", "tertiary"] },
                                  "disclosure": { "type": "string", "enum": ["always", "collapsed", "on-demand"] },
                                  "contentIds": { "type": "array", "items": { "type": "string" } }
                                },
                                "additionalProperties": false
                              }
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                },
                {
                  "kind": "jsonata",
                  "expr": "$count(data.projectionCandidates[attention = 'glanceable']) > 0 and $count(data.projectionCandidates[attention = 'focused']) > 0",
                  "message": "Incident intelligence must provide glanceable and focused projections",
                  "code": "projection-attention-coverage"
                }
              ]
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incident.intelligence','value':$merge([response,{'provider':'foundry-agent:Incident-Report-Intelligence-Agent'}])},{'op':'set','path':'incident.analyzedContent','value':state.incident.pendingContent},{'op':'set','path':'incident.pendingContent','value':null},{'op':'set','path':'incident.error','value':''}]}"
              }
            },
            "failureSettlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($access := error.message = 'Foundry access is required' or error.status = 401 or error.status = 403; {'ops':[{'op':'set','path':'incident.pendingContent','value':null},{'op':'set','path':'incident.error','value':$access ? '' : error.message},{'op':'set','path':'incident.foundryAccessStatus','value':$access ? 'required' : state.incident.foundryAccessStatus},{'op':'set','path':'incident.foundryAccessError','value':$access ? (error.status = 401 or error.status = 403 ? 'That access key was rejected.' : 'Foundry access is required.') : state.incident.foundryAccessError}]})"
              }
            },
            "onViolation": { "action": "fail" }
          },
          "checkFoundryAccess": {
            "operation": "check-access",
            "contract": "foundry-access-check/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incident.foundryAccessStatus','value':'ready'},{'op':'set','path':'incident.foundryAccessError','value':''}]}"
              }
            },
            "failureSettlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.message = 'Foundry access is required'; {'ops':[{'op':'set','path':'incident.foundryAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'incident.foundryAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : error.message)}]})"
              }
            },
            "onViolation": { "action": "fail" }
          }
        },
        "config": {
          "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}",
          "agent": "Incident-Report-Intelligence-Agent",
          "credentialRef": "foundry-agent/access-key"
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incident"],
      "actions": ["assign", "invoke"],
      "capabilities": {
        "incident:workspace": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
        "incident:editor": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"], "dataProp": "value" },
        "incident:projections": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["analyze"], "dataProp": "value" },
        "foundry:access-gate": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["accessRequested", "accessCleared"], "slots": ["children"] },
        "ui:markdown": { "propsSchema": { "type": "object", "additionalProperties": true }, "dataProp": "value" },
        "ui:form": { "propsSchema": { "type": "object", "additionalProperties": true }, "emits": ["save"] }
      },
      "externals": {
        "projectionViews": {
          "incident": { "from": "self" },
          "foundry": { "from": "foundry", "use": ["access-gate"] },
          "ui": { "from": "floor", "use": ["markdown", "form"] }
        },
        "effectHandlers": ["saveReport", "prepareAnalysis"]
      },
      "state": {
        "incident": {
          "content": "# Loading incident report…",
          "formValue": { "content": "# Loading incident report…" },
          "intelligence": null,
          "analyzedContent": null,
          "pendingContent": null,
          "foundryAccessStatus": "required",
          "foundryAccessError": "",
          "error": ""
        }
      }
    },
    "tiers": [{ "id": "runtime-document", "kind": "runtime-document" }],
    "cells": {
      "incident-workspace": {
        "id": "incident-workspace",
        "view": { "capability": "incident:workspace", "props": { "title": "Incident report intelligence" } }
      },
      "incident-report": {
        "id": "incident-report",
        "outputs": [{ "token": "incident-report-content", "from": "incident.content", "when": "$length(incident.content) > 0" }],
        "view": {
          "capability": "incident:editor",
          "props": { "title": "Investigation report" },
          "bindings": { "value": { "from": "incident.content" } }
        }
      },
      "incident-report-markdown": {
        "id": "incident-report-markdown",
        "inputs": [{ "token": "incident-report-content" }],
        "view": { "capability": "ui:markdown", "bindings": { "value": { "from": "incident.content" } } }
      },
      "incident-report-form": {
        "id": "incident-report-form",
        "inputs": [{ "token": "incident-report-content" }],
        "behavior": {
          "events": {
            "save": [{ "do": "invoke", "args": { "tool": "saveReport" } }]
          }
        },
        "view": {
          "capability": "ui:form",
          "props": {
            "fields": {
              "properties": {
                "content": { "title": "Markdown content", "type": "string", "format": "textarea", "rows": 34, "minLength": 1, "span": 12 }
              },
              "required": ["content"]
            },
            "saveLabel": "Save report",
            "discardLabel": "Discard changes"
          },
          "bindings": { "value": { "from": "incident.formValue" } }
        }
      },
      "foundry-access-gate": {
        "id": "foundry-access-gate",
        "behavior": {
          "events": {
            "accessRequested": [
              { "do": "assign", "target": "incident.foundryAccessStatus", "args": { "value": "checking" } },
              { "do": "assign", "target": "incident.foundryAccessError", "args": { "value": "" } },
              { "do": "invoke", "args": { "tool": "checkFoundryAccess" } }
            ],
            "accessCleared": [
              { "do": "assign", "target": "incident.foundryAccessStatus", "args": { "value": "required" } },
              { "do": "assign", "target": "incident.foundryAccessError", "args": { "value": "" } }
            ]
          }
        },
        "view": {
          "capability": "foundry:access-gate",
          "bindings": {
            "status": { "from": "incident.foundryAccessStatus" },
            "error": { "from": "incident.foundryAccessError" }
          }
        }
      },
      "incident-intelligence": {
        "id": "incident-intelligence",
        "inputs": [{ "token": "incident-report-content" }],
        "sources": [{ "id": "incident-intelligence.source", "service": "incident-report-intelligence", "operation": "analyzeReport", "contract": "incident-report-intelligence/v1" }],
        "behavior": {
          "events": {
            "analyze": [
              { "do": "invoke", "args": { "tool": "prepareAnalysis" } },
              { "do": "invoke", "args": { "tool": "analyzeReport" } }
            ]
          }
        },
        "outputs": [{ "token": "incident-intelligence" }],
        "view": {
          "capability": "incident:projections",
          "props": {
            "title": "Agent analysis",
            "projectionRecipe": {
              "contexts": { "default": { "attention": "focused", "showDisclosure": ["always", "collapsed"], "maxSections": 8 } },
              "fallback": { "attention": "focused", "showDisclosure": ["always", "collapsed"], "maxSections": 8 }
            }
          },
          "bindings": {
            "value": { "from": "incident.intelligence" },
            "content": { "from": "incident.content" },
            "analyzedContent": { "from": "incident.analyzedContent" },
            "error": { "from": "incident.error" }
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": ["incident-workspace"],
        "placements": [
          { "cell": "incident-report", "parent": "incident-workspace", "slot": "children", "order": 0 },
          { "cell": "incident-report-markdown", "parent": "incident-report", "slot": "children", "order": 0 },
          { "cell": "incident-report-form", "parent": "incident-report", "slot": "children", "order": 1 },
          { "cell": "foundry-access-gate", "parent": "incident-workspace", "slot": "children", "order": 1 },
          { "cell": "incident-intelligence", "parent": "foundry-access-gate", "slot": "children", "order": 0 }
        ]
      }
    },
    "metadata": { "projectionPattern": "editable-source-to-agent-projection" }
  }
}