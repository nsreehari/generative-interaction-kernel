{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-analysis-new-shell",
    "kind": "incident-analysis-shell",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": {
      "inputs": {
        "analyzer_blueprint_ref": {
          "required": true,
          "schema": { "type": "string", "minLength": 1 },
          "description": "Blueprint reference for the incident analyzer hosted by this shell."
        }
      }
    },
    "tiers": [{ "id": "runtime-document", "kind": "runtime-document" }],
    "recipes": [],
    "services": {
      "incident-sources": {
        "blueprint": { "$ref": "blueprint:incident-analysis-assets@1.0.0" },
        "version": "1",
        "operations": {
          "listSourceReports": {
            "operation": "list-sources",
            "contract": "incident-sources/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentShell.source_options','value':response.sources}]}"
              }
            }
          },
          "getSourceReport": {
            "operation": "get-source",
            "contract": "incident-source/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'sourceId':state.incidentShell.selected_report_key}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentShell.incident_report','value':response.content}]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      },
      "incident-cache": {
        "blueprint": { "$ref": "blueprint:incident-analysis-assets@1.0.0" },
        "version": "1",
        "operations": {
          "getCachedAnalysis": {
            "operation": "get-asset",
            "contract": "cached-analysis-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':state.incidentShell.selected_report_key,'analysis_key':state.analyzer_blueprint_ref}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentShell.cached_analysis_report','value':response ? response.analysisReport : null},{'op':'set','path':'incidentShell.analysis_as_on','value':response ? response.asOn : null},{'op':'set','path':'incidentShell.cache_lookup_complete','value':true}]}"
              }
            }
          },
          "putCachedAnalysis": {
            "operation": "put-asset",
            "contract": "cached-analysis-envelope/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'source_report_key':state.incidentShell.selected_report_key,'analysis_key':state.analyzer_blueprint_ref,'cached_analysis_envelope':{'asOn':$now(),'analysisReport':state.incidentShell.analysis_report}}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentShell.cached_analysis_report','value':response ? response.analysisReport : null},{'op':'set','path':'incidentShell.analysis_as_on','value':response ? response.asOn : null},{'op':'set','path':'incidentShell.cache_lookup_complete','value':true}]}"
              }
            }
          }
        },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incidentShell", "analyzer_blueprint_ref"],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "capabilities": {
        "fluent:dropdown": {
          "propsSchema": { "type": "object", "additionalProperties": true },
          "emits": ["select"],
          "dataProp": "value"
        },
        "fluent:spinner": {
          "propsSchema": { "type": "object", "additionalProperties": true }
        },
        "primitive:markdown": {
          "propsSchema": { "type": "object", "additionalProperties": true },
          "dataProp": "value"
        },
        "primitive:drawer": {
          "propsSchema": { "type": "object", "additionalProperties": true },
          "emits": ["openChange"],
          "slots": ["children"]
        }
      },
      "externals": {
        "projectionViews": {
          "fluent": { "from": "fluent", "use": ["dropdown", "spinner"] },
          "primitive": { "from": "primitive", "use": ["markdown", "drawer"] }
        }
      },
      "state": {
        "incidentShell": {
          "selected_report_key": "password-spray-mailbox",
          "source_options": [],
          "incident_report": "",
          "drawer_open": true,
          "cached_analysis_report": null,
          "analysis_as_on": null,
          "analysis_report": null,
          "cache_lookup_complete": false
        }
      }
    },
    "cells": {
      "analysis-loader": {
        "id": "analysis-loader",
        "kind": "analysis-readiness-loader",
        "view": {
          "capability": "fluent:spinner",
          "props": {
            "label": "Loading analysis",
            "size": "medium",
            "style": {
              "position": "fixed",
              "top": "16px",
              "right": "20px",
              "zIndex": 1000,
              "padding": "8px 12px",
              "background": "var(--colorNeutralBackground1)",
              "boxShadow": "var(--shadow8)",
              "borderRadius": "6px"
            }
          },
          "visibility": "$not(incidentShell.cache_lookup_complete) or $length(incidentShell.incident_report) = 0"
        }
      },
      "incident-analyzer": {
        "id": "incident-analyzer",
        "kind": "hosted-incident-analyzer",
        "inputs": [
          {
            "token": "incident_report",
            "as": "incident_report",
            "required": true
          },
          {
            "token": "cached_analysis_report",
            "as": "cached_analysis_report",
            "required": false
          },
          {
            "token": "analysis_as_on",
            "as": "analysis_as_on",
            "required": false
          },
          {
            "token": "incidentShell.analysis_report",
            "as": "analysisReport",
            "required": false
          }
        ],
        "outputs": [
          { "token": "analysis_report", "from": "inputs.analysisReport", "when": "inputs.analysisReport != null" }
        ],
        "blueprint": { "$ref": { "expression": "analyzer_blueprint_ref" } },
        "view": {
          "props": { "hostedAnalysis": true },
          "visibility": "incidentShell.cache_lookup_complete and $length(incidentShell.incident_report) > 0",
          "bindings": {
            "incident_report": {
              "from": "incidentShell.incident_report"
            },
            "cached_analysis_report": {
              "from": "incidentShell.cached_analysis_report"
            },
            "analysis_as_on": {
              "from": "incidentShell.analysis_as_on"
            }
          }
        }
      },
      "analyzer-options": {
        "id": "analyzer-options",
        "kind": "incident-analyzer-options",
        "inputs": [{
          "token": "analyzer_blueprint_ref",
          "as": "analyzerBlueprintRef",
          "required": true
        }],
        "outputs": [{
          "token": "analysis_key",
          "from": "inputs.analyzerBlueprintRef",
          "when": "$length(inputs.analyzerBlueprintRef) > 0"
        }],
        "view": {
          "capability": "fluent:dropdown",
          "props": {
            "label": "Incident analyzer",
            "ariaLabel": "Choose incident analyzer",
            "options": [
              { "value": "blueprint:incident-report-explorer-1a@1.0.0", "label": "Semantic component refinement" },
              { "value": "blueprint:incident-report-explorer-2@1.0.0", "label": "Normalized incident analysis" },
              { "value": "blueprint:incident-report-explorer-3@1.0.0", "label": "Source-faithful incident analysis" }
            ]
          },
          "bindings": { "value": { "from": "analyzer_blueprint_ref" } }
        },
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "analyzer_blueprint_ref",
                "args": {
                  "from": "$event.value"
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.cached_analysis_report",
                "args": {
                  "value": null
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.analysis_report",
                "args": {
                  "value": null
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.analysis_as_on",
                "args": {
                  "value": null
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.cache_lookup_complete",
                "args": {
                  "value": false
                }
              }
            ]
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "source-options": {
        "id": "source-options",
        "kind": "incident-source-options",
        "sources": [{
          "id": "source-options.source",
          "service": "incident-sources",
          "operation": "listSourceReports",
          "contract": "incident-sources/v1",
          "output": { "kind": "jsonata", "expr": "response.sources" }
        }],
        "compute": [{
          "id": "source-options",
          "expression": "$exists(sources.`source-options.source`) ? sources.`source-options.source` : []",
          "assign": "incidentShell.source_options",
          "dependencies": ["sources.source-options.source"]
        }],
        "view": {
          "capability": "fluent:dropdown",
          "props": { "label": "Source report", "ariaLabel": "Choose incident source" },
          "bindings": {
            "value": { "from": "incidentShell.selected_report_key" },
            "options": { "expression": "incidentShell.source_options.{'value':id,'label':label}" }
          }
        },
        "behavior": {
          "on": {
            "select": [
              {
                "do": "assign",
                "target": "incidentShell.selected_report_key",
                "args": {
                  "from": "$event.value"
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.incident_report",
                "args": {
                  "value": ""
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.cached_analysis_report",
                "args": {
                  "value": null
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.analysis_report",
                "args": {
                  "value": null
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.analysis_as_on",
                "args": {
                  "value": null
                }
              },
              {
                "do": "assign",
                "target": "incidentShell.cache_lookup_complete",
                "args": {
                  "value": false
                }
              }
            ]
          }
        },
        "events": {
          "select": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "selected-report-key": {
        "id": "selected-report-key",
        "kind": "selected-report-key",
        "inputs": [{
          "token": "incidentShell.selected_report_key",
          "as": "selectedReportKey",
          "required": true
        }],
        "outputs": [{
          "token": "selected_report_key",
          "from": "inputs.selectedReportKey",
          "when": "$length(inputs.selectedReportKey) > 0"
        }]
      },
      "selected-source": {
        "id": "selected-source",
        "kind": "selected-incident-source",
        "inputs": [{ "token": "selected_report_key", "required": true }],
        "sources": [{
          "id": "selected-source.source",
          "service": "incident-sources",
          "operation": "getSourceReport",
          "contract": "incident-source/v1",
          "output": { "kind": "jsonata", "expr": "response.content" }
        }],
        "compute": [{
          "id": "selected-source",
          "expression": "$exists(sources.`selected-source.source`) ? sources.`selected-source.source` : ''",
          "assign": "incidentShell.incident_report",
          "dependencies": ["sources.selected-source.source"]
        }],
        "outputs": [{
          "token": "incident_report",
          "from": "computed.incidentShell.incident_report",
          "when": "$length(computed.incidentShell.incident_report) > 0"
        }],
        "view": {
          "capability": "primitive:markdown",
          "bindings": { "value": { "from": "incidentShell.incident_report" } }
        }
      },
      "cache-retriever": {
        "id": "cache-retriever",
        "kind": "analysis-cache-retriever",
        "inputs": [
          { "token": "selected_report_key", "required": true },
          { "token": "analysis_key", "required": true }
        ],
        "sources": [{
          "id": "cache-retriever.source",
          "service": "incident-cache",
          "operation": "getCachedAnalysis",
          "contract": "cached-analysis-envelope/v1"
        }],
        "compute": [
          {
            "id": "cached-analysis-report",
            "expression": "$exists(sources.`cache-retriever.source`) and sources.`cache-retriever.source` != null ? sources.`cache-retriever.source`.analysisReport : null",
            "assign": "incidentShell.cached_analysis_report",
            "dependencies": ["sources.cache-retriever.source"]
          },
          {
            "id": "cached-analysis-as-on",
            "expression": "$exists(sources.`cache-retriever.source`) and sources.`cache-retriever.source` != null ? sources.`cache-retriever.source`.asOn : null",
            "assign": "incidentShell.analysis_as_on",
            "dependencies": ["sources.cache-retriever.source"]
          },
          {
            "id": "cache-lookup-complete",
            "expression": "$exists(sources.`cache-retriever.source`)",
            "assign": "incidentShell.cache_lookup_complete",
            "dependencies": ["sources.cache-retriever.source"]
          }
        ],
        "outputs": [
          {
            "token": "cached_analysis_report",
            "from": "computed.incidentShell.cached_analysis_report",
            "when": "computed.incidentShell.cached_analysis_report != null"
          },
          {
            "token": "analysis_as_on",
            "from": "computed.incidentShell.analysis_as_on",
            "when": "computed.incidentShell.analysis_as_on != null"
          }
        ]
      },
      "cache-writer": {
        "id": "cache-writer",
        "kind": "analysis-cache-writer",
        "inputs": [{ "token": "analysis_report", "as": "analysisReport", "required": true }],
        "sources": [{
          "id": "cache-writer.source",
          "service": "incident-cache",
          "operation": "putCachedAnalysis",
          "contract": "cached-analysis-envelope/v1"
        }],
        "compute": [
          {
            "id": "analysis-report",
            "expression": "inputs.analysisReport",
            "assign": "incidentShell.analysis_report",
            "dependencies": ["inputs.analysisReport"]
          },
          {
            "id": "written-analysis-report",
            "expression": "$exists(sources.`cache-writer.source`) and sources.`cache-writer.source` != null ? sources.`cache-writer.source`.analysisReport : null",
            "assign": "incidentShell.cached_analysis_report",
            "dependencies": ["sources.cache-writer.source"]
          },
          {
            "id": "written-analysis-as-on",
            "expression": "$exists(sources.`cache-writer.source`) and sources.`cache-writer.source` != null ? sources.`cache-writer.source`.asOn : null",
            "assign": "incidentShell.analysis_as_on",
            "dependencies": ["sources.cache-writer.source"]
          },
          {
            "id": "cache-write-complete",
            "expression": "$exists(sources.`cache-writer.source`)",
            "assign": "incidentShell.cache_lookup_complete",
            "dependencies": ["sources.cache-writer.source"]
          }
        ],
        "outputs": [
          {
            "token": "cached_analysis_report",
            "from": "computed.incidentShell.cached_analysis_report",
            "when": "computed.incidentShell.cached_analysis_report != null"
          },
          {
            "token": "analysis_as_on",
            "from": "computed.incidentShell.analysis_as_on",
            "when": "computed.incidentShell.analysis_as_on != null"
          }
        ]
      },
      "source-drawer": {
        "id": "source-drawer",
        "kind": "source-panel-layout",
        "view": {
          "capability": "primitive:drawer",
          "props": {
            "variant": "panel-vertical",
            "fabPosition": "top-left",
            "title": "Incident source",
            "ariaLabel": "Incident source",
            "panelWidthPercent": 80
          },
          "bindings": { "open": { "from": "incidentShell.drawer_open" } }
        },
        "behavior": {
          "on": {
            "openChange": [
              {
                "do": "assign",
                "target": "incidentShell.drawer_open",
                "args": {
                  "from": "$event.open"
                }
              }
            ]
          }
        },
        "events": {
          "openChange": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": ["analysis-loader", "incident-analyzer", "source-drawer"],
        "placements": [
          { "cell": "analyzer-options", "parent": "source-drawer", "slot": "children", "order": 0 },
          { "cell": "source-options", "parent": "source-drawer", "slot": "children", "order": 1 },
          { "cell": "selected-source", "parent": "source-drawer", "slot": "children", "order": 2 }
        ]
      }
    },
    "metadata": { "compositionPattern": "runtime-bound-analyzer-with-source-drawer" }
  }
}
