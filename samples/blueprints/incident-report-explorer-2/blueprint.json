{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-report-explorer-2",
    "kind": "incident-semantic-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": {
      "inputs": {
        "incident_report": {
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Incident report Markdown supplied by the parent Blueprint."
        },
        "cached_analysis_report": {
          "required": false,
          "description": "Cached analyzer report supplied by the parent Blueprint."
        },
        "analysis_as_on": {
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Timestamp supplied by the parent cache boundary."
        }
      },
      "outputs": {
        "analysis_report": {
          "from": "analysis_report",
          "description": "Fresh analyzer report returned to the parent Blueprint."
        }
      }
    },
    "agentLifecycle": {
      "profiles": {
        "use": {
          "id": "use-blueprint",
          "version": "1.0.0",
          "description": "Use the incident report explorer to select or edit source material and request presentation-neutral semantic analysis.",
          "targetKinds": ["blueprint-instance", "incident-report"],
          "intentKinds": ["select-sample", "save-report", "analyze-report"],
          "goals": [
            "Preserve incident evidence and causal ordering while producing the declared semantic incident model.",
            "Complete only operations declared by the incident report explorer runtime."
          ],
          "constraints": [
            "Do not invent, omit, or factually alter incident evidence.",
            "Return semantic facts and representation notes rather than components, layout, styling, or presentation variants.",
            "Do not propose Foundry credential changes or structural changes to this fixed Blueprint.",
            "Do not select operational or brief presentation; immutable external context and authored lowering own representation selection."
          ]
        }
      }
    },
    "tiers": [
      {
        "id": "incident-semantic",
        "kind": "incident-semantic-model",
        "description": "Normalized incident facts, relationships, evidence, response actions, and explicit representation notes."
      },
      { "id": "runtime-document", "kind": "runtime-document" }
    ],
    "recipes": [
      {
        "id": "incident-semantic-to-runtime",
        "from": "incident-semantic",
        "to": "runtime-document",
        "representations": [
          {
            "id": "hosted-analysis",
            "when": "externalContext.hostedAnalysis = true",
            "views": {
              "analysis-layout": { "capability": "primitive:container", "props": { "variant": "column", "gap": "l", "fullWidth": true, "ariaLabel": "Incident analysis" } },
              "report-presentation": {
                "capability": "semantic:narrative",
                "props": {
                  "variant": "article",
                  "spec": {
                    "title": "Incident analysis",
                    "emptyText": "No analysis available.",
                    "density": "comfortable",
                    "fields": {
                      "id": "id",
                      "heading": "heading",
                      "body": "body",
                      "order": "order",
                      "role": "role",
                      "tone": "tone"
                    },
                    "toneMap": {
                      "high": "critical",
                      "medium": "caution",
                      "low": "supporting",
                      "primary": "primary",
                      "supporting": "supporting"
                    }
                  }
                },
                "bindings": {
                  "sections": {
                    "expression": "cached_analysis_report ? ([{'id':'summary','heading':cached_analysis_report.identity.title,'body':cached_analysis_report.summary,'order':0,'role':cached_analysis_report.verdict.classification,'tone':cached_analysis_report.verdict.confidence},{'id':'verdict','heading':'Verdict','body':cached_analysis_report.verdict.rationale & '\n\nImpact: ' & cached_analysis_report.verdict.impact,'order':1,'role':cached_analysis_report.verdict.determination,'tone':cached_analysis_report.verdict.confidence},{'id':'phases','heading':'Incident phases','body':$join(cached_analysis_report.phases.($string(order) & '. ' & name & ' — ' & summary),'\n'),'order':2,'role':'Sequence','tone':'primary'},{'id':'events','heading':'Timeline','body':$join(cached_analysis_report.events.(time & ' — ' & title & '\n' & detail),'\n\n'),'order':3,'role':'Observed events','tone':'primary'},{'id':'entities','heading':'Entities','body':$join(cached_analysis_report.entities.(label & ' — ' & status & (role ? ' (' & role & ')' : '') & '\n' & description),'\n\n'),'order':4,'role':'Scope','tone':'supporting'},{'id':'alerts','heading':'Alerts and evidence','body':$join(cached_analysis_report.alerts.(title & ' — ' & verdict & '\n' & summary),'\n\n') & ($count(cached_analysis_report.evidence) > 0 ? '\n\nEvidence\n' & $join(cached_analysis_report.evidence.(timestamp & ' — ' & sourceType & ': ' & summary),'\n') : ''),'order':5,'role':'Evidence','tone':'supporting'},{'id':'techniques','heading':'Techniques and indicators','body':$join(cached_analysis_report.techniques.(techniqueId & ' — ' & technique & '\n' & description),'\n\n') & ($count(cached_analysis_report.indicators) > 0 ? '\n\nIndicators\n' & $join(cached_analysis_report.indicators.(type & ': ' & value & ' — ' & context),'\n') : ''),'order':6,'role':'Findings','tone':'supporting'},{'id':'impacts','heading':'Impacts','body':$join(cached_analysis_report.impacts.(title & ' — ' & severity & '\n' & detail),'\n\n'),'order':7,'role':'Impact','tone':'high'},{'id':'actions','heading':'Recommended actions','body':$join(cached_analysis_report.actions.(priority & ' — ' & title & '\n' & detail),'\n\n'),'order':8,'role':'Response','tone':'primary'},{'id':'notes','heading':'Representation notes','body':$join(cached_analysis_report.representationNotes.(category & ' — ' & commentary),'\n\n'),'order':9,'role':'Notes','tone':'supporting'}]) : []"
                  }
                }
              },
              "analysis-as-on": {
                "capability": "primitive:datetime",
                "props": {
                  "variant": "timestamp",
                  "ariaLabel": "As on"
                },
                "bindings": {
                  "value": {
                    "from": "analysis_as_on"
                  }
                },
                "visibility": "cached_analysis_report != null"
              },
              "analysis-runner": {
                "capability": "fluent:spinner",
                "props": {
                  "label": "Analyzing report",
                  "size": "medium",
                  "style": {
                    "position": "fixed",
                    "top": "16px",
                    "right": "20px",
                    "zIndex": 1000,
                    "padding": "8px 12px",
                    "background": "var(--colorNeutralBackground1)",
                    "boxShadow": "var(--shadow8)",
                    "borderRadius": "6px"
                  }
                },
                "visibility": "systemInputs.numSourcesRunning != 0"
              }
            },
            "presentation": {
              "roots": ["analysis-layout"],
              "placements": [
                {
                  "cell": "analysis-runner",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "analysis-as-on",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 1
                },
                {
                  "cell": "report-presentation",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 2
                }
              ]
            }
          },
          {
            "id": "operational",
            "when": "externalContext.attention = 'operational'",
            "views": {
              "analysis-layout": { "capability": "primitive:container", "props": { "variant": "column", "gap": "l", "fullWidth": true, "ariaLabel": "Incident analysis" } },
              "report-presentation": {
                "capability": "semantic:narrative",
                "props": {
                  "variant": "article",
                  "spec": {
                    "title": "Incident analysis",
                    "emptyText": "No analysis available.",
                    "density": "comfortable",
                    "fields": {
                      "id": "id",
                      "heading": "heading",
                      "body": "body",
                      "order": "order",
                      "role": "role",
                      "tone": "tone"
                    },
                    "toneMap": {
                      "high": "critical",
                      "medium": "caution",
                      "low": "supporting",
                      "primary": "primary",
                      "supporting": "supporting"
                    }
                  }
                },
                "bindings": {
                  "sections": {
                    "expression": "cached_analysis_report ? ([{'id':'summary','heading':cached_analysis_report.identity.title,'body':cached_analysis_report.summary,'order':0,'role':cached_analysis_report.verdict.classification,'tone':cached_analysis_report.verdict.confidence},{'id':'verdict','heading':'Verdict','body':cached_analysis_report.verdict.rationale & '\n\nImpact: ' & cached_analysis_report.verdict.impact,'order':1,'role':cached_analysis_report.verdict.determination,'tone':cached_analysis_report.verdict.confidence},{'id':'phases','heading':'Incident phases','body':$join(cached_analysis_report.phases.($string(order) & '. ' & name & ' — ' & summary),'\n'),'order':2,'role':'Sequence','tone':'primary'},{'id':'events','heading':'Timeline','body':$join(cached_analysis_report.events.(time & ' — ' & title & '\n' & detail),'\n\n'),'order':3,'role':'Observed events','tone':'primary'},{'id':'entities','heading':'Entities','body':$join(cached_analysis_report.entities.(label & ' — ' & status & (role ? ' (' & role & ')' : '') & '\n' & description),'\n\n'),'order':4,'role':'Scope','tone':'supporting'},{'id':'alerts','heading':'Alerts and evidence','body':$join(cached_analysis_report.alerts.(title & ' — ' & verdict & '\n' & summary),'\n\n') & ($count(cached_analysis_report.evidence) > 0 ? '\n\nEvidence\n' & $join(cached_analysis_report.evidence.(timestamp & ' — ' & sourceType & ': ' & summary),'\n') : ''),'order':5,'role':'Evidence','tone':'supporting'},{'id':'techniques','heading':'Techniques and indicators','body':$join(cached_analysis_report.techniques.(techniqueId & ' — ' & technique & '\n' & description),'\n\n') & ($count(cached_analysis_report.indicators) > 0 ? '\n\nIndicators\n' & $join(cached_analysis_report.indicators.(type & ': ' & value & ' — ' & context),'\n') : ''),'order':6,'role':'Findings','tone':'supporting'},{'id':'impacts','heading':'Impacts','body':$join(cached_analysis_report.impacts.(title & ' — ' & severity & '\n' & detail),'\n\n'),'order':7,'role':'Impact','tone':'high'},{'id':'actions','heading':'Recommended actions','body':$join(cached_analysis_report.actions.(priority & ' — ' & title & '\n' & detail),'\n\n'),'order':8,'role':'Response','tone':'primary'},{'id':'notes','heading':'Representation notes','body':$join(cached_analysis_report.representationNotes.(category & ' — ' & commentary),'\n\n'),'order':9,'role':'Notes','tone':'supporting'}]) : []"
                  }
                }
              },
              "analysis-as-on": {
                "capability": "primitive:datetime",
                "props": {
                  "variant": "timestamp",
                  "ariaLabel": "As on"
                },
                "bindings": {
                  "value": {
                    "from": "analysis_as_on"
                  }
                },
                "visibility": "cached_analysis_report != null"
              },
              "analysis-runner": {
                "capability": "fluent:spinner",
                "props": {
                  "label": "Analyzing report",
                  "size": "medium",
                  "style": {
                    "position": "fixed",
                    "top": "16px",
                    "right": "20px",
                    "zIndex": 1000,
                    "padding": "8px 12px",
                    "background": "var(--colorNeutralBackground1)",
                    "boxShadow": "var(--shadow8)",
                    "borderRadius": "6px"
                  }
                },
                "visibility": "systemInputs.numSourcesRunning != 0"
              }
            },
            "presentation": {
              "roots": ["analysis-layout"],
              "placements": [
                {
                  "cell": "analysis-runner",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "analysis-as-on",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 1
                },
                {
                  "cell": "report-presentation",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 2
                }
              ]
            }
          },
          {
            "id": "brief",
            "when": "externalContext.attention = 'brief'",
            "extends": "operational",
            "views": {
              "analysis-layout": { "capability": "primitive:container", "props": { "variant": "column", "gap": "l", "fullWidth": true, "ariaLabel": "Incident analysis" } },
              "report-presentation": {
                "capability": "semantic:narrative",
                "props": {
                  "variant": "briefing",
                  "spec": {
                    "title": "Incident analysis",
                    "emptyText": "No analysis available.",
                    "density": "compact",
                    "fields": {
                      "id": "id",
                      "heading": "heading",
                      "body": "body",
                      "order": "order",
                      "role": "role",
                      "tone": "tone"
                    },
                    "toneMap": {
                      "high": "critical",
                      "medium": "caution",
                      "low": "supporting",
                      "primary": "primary",
                      "supporting": "supporting"
                    }
                  }
                },
                "bindings": {
                  "sections": {
                    "expression": "cached_analysis_report ? ([{'id':'summary','heading':cached_analysis_report.identity.title,'body':cached_analysis_report.summary,'order':0,'role':cached_analysis_report.verdict.classification,'tone':cached_analysis_report.verdict.confidence},{'id':'verdict','heading':'Verdict','body':cached_analysis_report.verdict.rationale & '\n\nImpact: ' & cached_analysis_report.verdict.impact,'order':1,'role':cached_analysis_report.verdict.determination,'tone':cached_analysis_report.verdict.confidence},{'id':'phases','heading':'Incident phases','body':$join(cached_analysis_report.phases.($string(order) & '. ' & name & ' — ' & summary),'\n'),'order':2,'role':'Sequence','tone':'primary'},{'id':'events','heading':'Timeline','body':$join(cached_analysis_report.events.(time & ' — ' & title & '\n' & detail),'\n\n'),'order':3,'role':'Observed events','tone':'primary'},{'id':'entities','heading':'Entities','body':$join(cached_analysis_report.entities.(label & ' — ' & status & (role ? ' (' & role & ')' : '') & '\n' & description),'\n\n'),'order':4,'role':'Scope','tone':'supporting'},{'id':'alerts','heading':'Alerts and evidence','body':$join(cached_analysis_report.alerts.(title & ' — ' & verdict & '\n' & summary),'\n\n') & ($count(cached_analysis_report.evidence) > 0 ? '\n\nEvidence\n' & $join(cached_analysis_report.evidence.(timestamp & ' — ' & sourceType & ': ' & summary),'\n') : ''),'order':5,'role':'Evidence','tone':'supporting'},{'id':'techniques','heading':'Techniques and indicators','body':$join(cached_analysis_report.techniques.(techniqueId & ' — ' & technique & '\n' & description),'\n\n') & ($count(cached_analysis_report.indicators) > 0 ? '\n\nIndicators\n' & $join(cached_analysis_report.indicators.(type & ': ' & value & ' — ' & context),'\n') : ''),'order':6,'role':'Findings','tone':'supporting'},{'id':'impacts','heading':'Impacts','body':$join(cached_analysis_report.impacts.(title & ' — ' & severity & '\n' & detail),'\n\n'),'order':7,'role':'Impact','tone':'high'},{'id':'actions','heading':'Recommended actions','body':$join(cached_analysis_report.actions.(priority & ' — ' & title & '\n' & detail),'\n\n'),'order':8,'role':'Response','tone':'primary'},{'id':'notes','heading':'Representation notes','body':$join(cached_analysis_report.representationNotes.(category & ' — ' & commentary),'\n\n'),'order':9,'role':'Notes','tone':'supporting'}]) : []"
                  }
                }
              },
              "analysis-as-on": {
                "capability": "primitive:datetime",
                "props": {
                  "variant": "timestamp",
                  "ariaLabel": "As on"
                },
                "bindings": {
                  "value": {
                    "from": "analysis_as_on"
                  }
                },
                "visibility": "cached_analysis_report != null"
              },
              "analysis-runner": {
                "capability": "fluent:spinner",
                "props": {
                  "label": "Analyzing report",
                  "size": "medium",
                  "style": {
                    "position": "fixed",
                    "top": "16px",
                    "right": "20px",
                    "zIndex": 1000,
                    "padding": "8px 12px",
                    "background": "var(--colorNeutralBackground1)",
                    "boxShadow": "var(--shadow8)",
                    "borderRadius": "6px"
                  }
                },
                "visibility": "systemInputs.numSourcesRunning != 0"
              }
            },
            "presentation": {
              "roots": ["analysis-layout"],
              "placements": [
                {
                  "cell": "analysis-runner",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 0
                },
                {
                  "cell": "analysis-as-on",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 1
                },
                {
                  "cell": "report-presentation",
                  "parent": "analysis-layout",
                  "slot": "children",
                  "order": 2
                }
              ]
            }
          }
        ],
        "fallback": "operational"
      }
    ],
    "services": {
      "incident-semantic-analysis": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "analyzeReport": {
            "operation": "chat",
            "contract": "incident-semantic-model/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'message':'Extract a normalized incident semantic model from this investigation report. Report Markdown:\n\n' & input.incident_report,'instructions':'Return semantic facts only. Do not choose components, layouts, disclosure, colors, or presentation candidates. Preserve causal ordering and typed references. Put any source ambiguity, normalization loss, unsupported concept, conflicting evidence, or schema gap in representationNotes rather than silently dropping it. Use stable concise ids and reference only ids declared in this response.','maxOutputTokens':10000}"
              }
            },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "provider-structured-output",
                  "message": "Incident semantic model is invalid",
                  "schema": {
                    "type": "object",
                    "required": ["identity", "verdict", "summary", "phases", "entities", "relationships", "events", "techniques", "alerts", "evidence", "indicators", "impacts", "actions", "representationNotes"],
                    "properties": {
                      "identity": { "type": "object", "required": ["incidentId", "title", "startTime", "endTime"], "properties": { "incidentId": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "startTime": { "type": "string" }, "endTime": { "type": "string" } }, "additionalProperties": false },
                      "verdict": { "type": "object", "required": ["classification", "determination", "confidence", "rationale", "impact"], "properties": { "classification": { "type": "string", "minLength": 1 }, "determination": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] }, "rationale": { "type": "string", "minLength": 1 }, "impact": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
                      "summary": { "type": "string", "minLength": 1 },
                      "phases": { "type": "array", "items": { "type": "object", "required": ["id", "name", "order", "summary"], "properties": { "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1 }, "order": { "type": "integer", "minimum": 0 }, "summary": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
                      "entities": { "type": "array", "items": { "type": "object", "required": ["id", "type", "label", "status", "role", "description", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "enum": ["actor", "ip", "user", "mailbox", "device", "virtual-machine", "managed-identity", "service-principal", "application", "secret", "storage", "data-asset", "cloud-resource", "other"] }, "label": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["compromised", "affected", "targeted", "observed", "unknown"] }, "role": { "type": "string" }, "description": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "relationships": { "type": "array", "items": { "type": "object", "required": ["id", "sourceId", "targetId", "kind", "label", "phaseId", "evidenceIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "minLength": 1 }, "targetId": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["targeted", "sprayed", "authenticated-to", "stole-token-from", "enumerated", "retrieved-secret-from", "retrieved-keys-for", "accessed", "collected-from", "exfiltrated-from", "pivoted-to", "other"] }, "label": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "events": { "type": "array", "items": { "type": "object", "required": ["id", "time", "title", "detail", "phaseId", "entityIds", "evidenceIds", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "time": { "type": "string" }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "entityIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "techniques": { "type": "array", "items": { "type": "object", "required": ["id", "tactic", "technique", "techniqueId", "description", "phaseId", "evidenceIds", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "tactic": { "type": "string", "minLength": 1 }, "technique": { "type": "string", "minLength": 1 }, "techniqueId": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 }, "phaseId": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "alerts": { "type": "array", "items": { "type": "object", "required": ["id", "title", "verdict", "summary", "eventIds", "evidenceIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 }, "verdict": { "type": "string", "minLength": 1 }, "summary": { "type": "string", "minLength": 1 }, "eventIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "evidence": { "type": "array", "items": { "type": "object", "required": ["id", "sourceType", "timestamp", "summary", "correlationId"], "properties": { "id": { "type": "string", "minLength": 1 }, "sourceType": { "type": "string", "minLength": 1 }, "timestamp": { "type": "string" }, "summary": { "type": "string", "minLength": 1 }, "correlationId": { "type": "string" } }, "additionalProperties": false } },
                      "indicators": { "type": "array", "items": { "type": "object", "required": ["id", "type", "value", "context", "confidence"], "properties": { "id": { "type": "string", "minLength": 1 }, "type": { "type": "string", "minLength": 1 }, "value": { "type": "string", "minLength": 1 }, "context": { "type": "string", "minLength": 1 }, "confidence": { "type": "string", "enum": ["high", "medium", "low"] } }, "additionalProperties": false } },
                      "impacts": { "type": "array", "items": { "type": "object", "required": ["id", "category", "title", "detail", "severity", "entityIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "category": { "type": "string", "enum": ["credential-exposure", "data-access", "data-exfiltration", "identity-compromise", "resource-compromise", "business-impact", "other"] }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] }, "entityIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "actions": { "type": "array", "items": { "type": "object", "required": ["id", "priority", "category", "title", "detail", "entityIds"], "properties": { "id": { "type": "string", "minLength": 1 }, "priority": { "type": "string", "enum": ["immediate", "next", "follow-up"] }, "category": { "type": "string", "enum": ["containment", "investigation", "recovery", "hardening"] }, "title": { "type": "string", "minLength": 1 }, "detail": { "type": "string", "minLength": 1 }, "entityIds": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
                      "representationNotes": { "type": "array", "items": { "type": "object", "required": ["id", "category", "severity", "sourceSection", "commentary", "suggestedVocabularyExtension"], "properties": { "id": { "type": "string", "minLength": 1 }, "category": { "type": "string", "enum": ["source-ambiguity", "insufficient-evidence", "normalization-loss", "unsupported-concept", "conflicting-evidence", "schema-gap"] }, "severity": { "type": "string", "enum": ["info", "warning", "critical"] }, "sourceSection": { "type": "string" }, "commentary": { "type": "string", "minLength": 1 }, "suggestedVocabularyExtension": { "type": "string" } }, "additionalProperties": false } }
                    },
                    "additionalProperties": false
                  }
                }
              ]
            },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'foundry-agent/access-key'; $access := $missing or error.status = 401 or error.status = 403; {'ops':[{'op':'set','path':'incident2.error','value':$access ? '' : error.message},{'op':'set','path':'incident2.foundryAccessStatus','value':$access ? 'required' : state.incident2.foundryAccessStatus},{'op':'set','path':'incident2.foundryAccessError','value':$access ? (error.status = 401 or error.status = 403 ? 'That access key was rejected.' : 'Foundry access is required.') : state.incident2.foundryAccessError}]})" } },
            "onViolation": { "action": "fail" }
          },
          "checkFoundryAccess": {
            "operation": "check-access",
            "contract": "foundry-access-check/v1",
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incident2.foundryAccessStatus','value':'ready'},{'op':'set','path':'incident2.foundryAccessError','value':''}]}" } },
            "failureSettlement": { "transform": { "kind": "jsonata", "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.code = 'service-dependency-unsatisfied' and error.dependency.kind = 'credential' and error.dependency.ref = 'foundry-agent/access-key'; {'ops':[{'op':'set','path':'incident2.foundryAccessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'incident2.foundryAccessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : error.message)}]})" } },
            "onViolation": { "action": "fail" }
          }
        },
        "config": { "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}", "agent": "Incident-Report-Semantic-Agent", "credentialRef": "foundry-agent/access-key" },
        "scope": "per-blueprint"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incident2"],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "capabilities": {
        "primitive:container": { "propsSchema": { "type": "object", "additionalProperties": true }, "slots": ["children"] },
        "semantic:narrative": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "sections"
        },
        "primitive:datetime": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        },
        "fluent:spinner": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": { "primitive": { "from": "primitive", "use": [
              "container",
              "datetime"
            ] }, "semantic": { "from": "semantic", "use": ["narrative"] }, "fluent": { "from": "fluent", "use": ["spinner"] } }
      },
      "state": {
        "incident2": {
          "foundryAccessStatus": "checking",
          "foundryAccessError": "",
          "error": ""
        }
      }
    },
    "cells": {
      "analysis-layout": {
        "id": "analysis-layout",
        "kind": "incident-analysis-layout"
      },
      "report-presentation": {
        "id": "report-presentation",
        "kind": "incident-analysis-presentation",
        "inputs": [{ "token": "cached_analysis_report", "as": "cached_analysis_report", "required": false }]
      },
      "analysis-as-on": {
        "id": "analysis-as-on",
        "kind": "analysis-timestamp",
        "inputs": [
          {
            "token": "analysis_as_on",
            "as": "analysis_as_on",
            "required": false
          }
        ]
      },
      "analysis-runner": {
        "id": "analysis-runner",
        "kind": "incident-analysis-runner",
        "systemInputs": ["numSourcesRunning"],
        "inputs": [
          {
            "token": "incident_report",
            "as": "incident_report",
            "required": true
          },
          {
            "token": "cached_analysis_report",
            "as": "cached_analysis_report",
            "required": false
          }
        ],
        "sources": [
          {
            "id": "analysis-runner.source",
            "service": "incident-semantic-analysis",
            "operation": "analyzeReport",
            "contract": "incident-semantic-model/v1",
            "when": "($not($exists(inputs.cached_analysis_report)) or inputs.cached_analysis_report = null) and $not($exists(sources.`analysis-runner.source`))",
            "input": {
              "kind": "jsonata",
              "expr": "{'incident_report':inputs.incident_report}"
            },
            "output": {
              "kind": "jsonata",
              "expr": "response"
            }
          }
        ],
        "compute": [
          {
            "id": "analysis-report",
            "expression": "sources.`analysis-runner.source`",
            "assign": "analysisReport"
          }
        ],
        "outputs": [
          {
            "token": "analysis_report",
            "from": "computed.analysisReport",
            "when": "computed.analysisReport != null"
          }
        ]
      }
    },
    "metadata": {
      "closedGrammarOwnership": "Blueprint authors tiers, recipes, cells, leaves, presets, layout, interactions, and responsive behavior; the agent emits incident-semantic-model/v1 only.",
      "agentOutput": "semantic-tokens-and-representation-notes",
      "presentationPresets": ["operational", "brief"]
    }
  }
}
