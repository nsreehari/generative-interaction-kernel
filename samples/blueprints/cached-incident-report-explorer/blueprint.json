{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "cached-incident-report-explorer",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "recipes": [],
    "services": {},
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "incident"
      ],
      "actions": [
        "invoke"
      ],
      "capabilities": {
        "incident:workspace": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "incident:editor": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ],
          "dataProp": "value"
        },
        "incident:projections": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "analyze"
          ],
          "dataProp": "value"
        },
        "foundry:access-gate": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "accessRequested",
            "accessCleared"
          ],
          "slots": [
            "children"
          ]
        },
        "ui:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        },
        "fluent:dropdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "select"
          ],
          "dataProp": "value"
        },
        "primitive:form": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "save"
          ]
        }
      },
      "externals": {
        "projectionViews": {
          "incident": {
            "from": "self"
          },
          "fluent": {
            "from": "fluent",
            "use": [
              "dropdown"
            ]
          },
          "ui": {
            "from": "floor",
            "use": [
              "markdown"
            ]
          }
        },
        "effectHandlers": [
          "selectCachedSampleReport"
        ]
      },
      "state": {
        "incident": {
          "selectedSampleId": "password-spray-mailbox",
          "content": "# Loading cached incident report...",
          "intelligence": null,
          "analyzedContent": null,
          "error": ""
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document"
      }
    ],
    "cells": {
      "incident-workspace": {
        "id": "incident-workspace",
        "view": {
          "capability": "incident:workspace",
          "props": {
            "title": "Cached incident intelligence"
          }
        }
      },
      "incident-report": {
        "id": "incident-report",
        "outputs": [
          {
            "token": "incident-report-content",
            "from": "incident.content",
            "when": "$length(incident.content) > 0"
          }
        ],
        "view": {
          "capability": "incident:editor",
          "props": {
            "title": "Investigation report",
            "readonly": true
          },
          "bindings": {
            "value": {
              "from": "incident.content"
            }
          }
        }
      },
      "incident-report-selector": {
        "id": "incident-report-selector",
        "behavior": {
          "events": {
            "select": [
              {
                "do": "invoke",
                "args": {
                  "tool": "selectCachedSampleReport"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:dropdown",
          "props": {
            "ariaLabel": "Choose sample incident",
            "options": [
              {
                "value": "password-spray-mailbox",
                "label": "Password spray and mailbox compromise"
              },
              {
                "value": "blob-storage-exfiltration",
                "label": "Blob storage exfiltration"
              },
              {
                "value": "identity-compromise",
                "label": "Identity and cloud resource compromise"
              },
              {
                "value": "device-code-bec",
                "label": "Device-code phishing and BEC"
              },
              {
                "value": "supply-chain-sap-bec",
                "label": "Supply-chain SAP and procurement BEC"
              }
            ]
          },
          "bindings": {
            "value": {
              "from": "incident.selectedSampleId"
            }
          }
        }
      },
      "incident-report-markdown": {
        "id": "incident-report-markdown",
        "inputs": [
          {
            "token": "incident-report-content"
          }
        ],
        "view": {
          "capability": "ui:markdown",
          "bindings": {
            "value": {
              "from": "incident.content"
            }
          }
        }
      },
      "incident-intelligence": {
        "id": "incident-intelligence",
        "inputs": [
          {
            "token": "incident-report-content"
          }
        ],
        "view": {
          "capability": "incident:projections",
          "props": {
            "title": "Cached agent analysis",
            "projectionRecipe": {
              "contexts": {
                "default": {
                  "attention": "focused",
                  "showDisclosure": [
                    "always",
                    "collapsed"
                  ],
                  "maxSections": 8
                }
              },
              "fallback": {
                "attention": "focused",
                "showDisclosure": [
                  "always",
                  "collapsed"
                ],
                "maxSections": 8
              }
            },
            "readonly": true
          },
          "bindings": {
            "value": {
              "from": "incident.intelligence"
            },
            "content": {
              "from": "incident.content"
            },
            "analyzedContent": {
              "from": "incident.analyzedContent"
            },
            "error": {
              "from": "incident.error"
            }
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": [
          "incident-workspace"
        ],
        "placements": [
          {
            "cell": "incident-report",
            "parent": "incident-workspace",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "incident-report-selector",
            "parent": "incident-report",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "incident-report-markdown",
            "parent": "incident-report",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "incident-intelligence",
            "parent": "incident-workspace",
            "slot": "children",
            "order": 1
          }
        ]
      }
    },
    "metadata": {
      "projectionPattern": "cached-source-to-agent-projection"
    }
  }
}
