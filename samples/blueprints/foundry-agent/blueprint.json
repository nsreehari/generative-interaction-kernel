{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "foundry-agent",
    "kind": "runtime-blueprint",
    "version": "1.0",
    "recipes": [],
    "services": {
      "assistant": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "askAgent": {
            "operation": "chat",
            "contract": "foundry-chat/v1",
            "subject": {
              "kind": "chat",
              "blueprintId": "foundry-agent",
              "turnId": "current"
            },
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "input"
              }
            },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "message": "Foundry agent returned an invalid chat response",
                  "schema": {
                    "type": "object",
                    "required": [
                      "conversationId",
                      "responseId",
                      "reply"
                    ],
                    "properties": {
                      "conversationId": {
                        "type": "string"
                      },
                      "responseId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reply": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              ]
            },
            "onViolation": {
              "action": "fail"
            }
          },
          "discoverAgents": {
            "operation": "discover",
            "contract": "foundry-agent-list/v1",
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "message": "Foundry returned an invalid agent list",
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "onViolation": {
              "action": "fail"
            }
          }
        },
        "config": {
          "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}",
          "credentialRef": "foundry-agent/access-key"
        },
        "scope": "per-session"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "agent"
      ],
      "actions": [
        "assign",
        "emit",
        "invoke",
        "route",
        "request"
      ],
      "capabilities": {
        "primitive:container": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "fluent:panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "primitive:note": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:spinner": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:alert": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "primitive:form": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "save"
          ]
        },
        "primitive:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "fluent": {
            "from": "fluent",
            "use": [
              "spinner",
              "text"
            ]
          },
          "primitive": {
            "from": "primitive",
            "use": [
              "container",
              "form",
              "markdown"
            ]
          },
          "agent": {
            "from": "self"
          }
        },
        "effectHandlers": []
      },
      "state": {
        "agent": {
          "agentOptions": [],
          "formValue": {
            "agentName": "",
            "message": ""
          },
          "request": null,
          "reply": "",
          "conversationId": ""
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Authored terminal document for this hosted Blueprint."
      }
    ],
    "cells": {
      "foundry-agent-root": {
        "id": "foundry-agent-root",
        "view": {
          "capability": "primitive:container",
          "props": {
            "variant": "column",
            "gap": "m",
            "fill": true,
            "ariaLabel": "Foundry Agent"
          }
        }
      },
      "fetch-agents": {
        "id": "fetch-agents",
        "systemInputs": ["numSourcesRunning"],
        "sources": [
          {
            "id": "fetch-agents.source",
            "service": "assistant",
            "operation": "discoverAgents",
            "contract": "foundry-agent-list/v1",
            "output": { "kind": "jsonata", "expr": "response" }
          }
        ],
        "compute": [
          {
            "id": "agent-options",
            "expression": "$exists(sources.`fetch-agents.source`) ? sources.`fetch-agents.source`.{'value':$, 'label':$} : []",
            "assign": "agent.agentOptions",
            "dependencies": ["sources.fetch-agents.source"]
          }
        ],
        "outputs": [
          {
            "token": "foundry-agent-options",
            "from": "computed.agent.agentOptions"
          }
        ],
        "view": {
          "capability": "fluent:spinner",
          "props": {
            "label": "Loading agents",
            "size": "medium"
          },
          "visibility": "systemInputs.numSourcesRunning > 0"
        }
      },
      "agent-query-form": {
        "id": "agent-query-form",
        "inputs": [
          { "token": "foundry-agent-options", "as": "agentOptions", "required": true },
          { "token": "agent.request", "as": "request" }
        ],
        "outputs": [
          {
            "token": "foundry-agent-query",
            "from": "inputs.request",
            "when": "$exists(inputs.request) and $trim(inputs.request.agentName) != '' and $trim(inputs.request.message) != ''"
          }
        ],
        "behavior": {
          "on": {
            "save": [
              {
                "do": "assign",
                "target": "agent.formValue",
                "args": {
                  "from": "$event.values"
                }
              },
              {
                "do": "assign",
                "target": "agent.request",
                "args": {
                  "from": "$event.values"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "primitive:form",
          "props": {
            "saveLabel": "Ask",
            "discardLabel": "Discard",
            "initiallyDirty": true
          },
          "bindings": {
            "fields": {
              "expression": "{'properties':{'agentName':{'title':'Agent','type':'string','options':agent.agentOptions,'placeholder':'Choose an agent','span':12},'message':{'title':'Message','type':'string','format':'textarea','rows':5,'minLength':1,'placeholder':'Ask the agent something...','span':12}},'required':['agentName','message']}"
            },
            "value": { "from": "agent.formValue" }
          },
          "visibility": "$count(agent.agentOptions) > 0"
        },
        "events": {
          "save": {
            "payloadSchema": {
              "type": "object"
            }
          }
        }
      },
      "agent-response": {
        "id": "agent-response",
        "systemInputs": ["numSourcesRunning"],
        "inputs": [
          { "token": "foundry-agent-query", "as": "query", "required": true },
          { "token": "agent.conversationId", "as": "conversationId" }
        ],
        "sources": [
          {
            "id": "agent-response.source",
            "service": "assistant",
            "operation": "askAgent",
            "contract": "foundry-chat/v1",
            "input": {
              "kind": "jsonata",
              "expr": "{'message':$trim(inputs.query.message),'agentName':$trim(inputs.query.agentName),'conversationId':inputs.conversationId = '' ? null : inputs.conversationId}"
            },
            "output": { "kind": "jsonata", "expr": "response" }
          }
        ],
        "compute": [
          {
            "id": "agent-response-assign",
            "expression": "$exists(sources.`agent-response.source`) ? sources.`agent-response.source`.reply : ''",
            "assign": "agent.reply",
            "dependencies": ["sources.agent-response.source"]
          },
          {
            "id": "agent-conversation-assign",
            "expression": "$exists(sources.`agent-response.source`) ? sources.`agent-response.source`.conversationId : ''",
            "assign": "agent.conversationId",
            "dependencies": ["sources.agent-response.source"]
          }
        ],
        "view": {
          "capability": "primitive:markdown",
          "before": [
            {
              "capability": "fluent:spinner",
              "props": {
                "label": "Waiting for agent response",
                "size": "medium"
              },
              "visibility": "systemInputs.numSourcesRunning > 0"
            }
          ],
          "bindings": {
            "value": { "from": "agent.reply" }
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": [
          "foundry-agent-root"
        ],
        "placements": [
          {
            "cell": "fetch-agents",
            "parent": "foundry-agent-root",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "agent-query-form",
            "parent": "foundry-agent-root",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "agent-response",
            "parent": "foundry-agent-root",
            "slot": "children",
            "order": 2
          }
        ]
      }
    }
  }
}
