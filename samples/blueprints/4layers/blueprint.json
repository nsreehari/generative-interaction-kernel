{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "4layers",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "recipes": [],
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "architecture"
      ],
      "actions": [],
      "capabilities": {
        "primitive:container": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "fluent:panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "primitive:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        },
        "fluent:table": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "dataProp": "value"
        }
      },
      "externals": {
        "projectionViews": {
          "primitive": {
            "from": "primitive",
            "use": ["container", "markdown"]
          },
          "fluent": {
            "from": "fluent",
            "use": ["panel", "table", "text"]
          }
        }
      },
      "state": {
        "architecture": {
          "summary": "The Blueprint is converted directly to a Kernel program. The four conceptual stages remain visible as design context; no runtime recipe interpreter is required.",
          "layers": [
            {
              "id": "workflow",
              "stage": "Workflow",
              "responsibility": "Capture the domain goal and source data",
              "example": "Incident triage"
            },
            {
              "id": "interaction",
              "stage": "Interaction",
              "responsibility": "Define how a participant works with the goal",
              "example": "Investigate"
            },
            {
              "id": "presentation",
              "stage": "Presentation",
              "responsibility": "Organize the information for the active surface",
              "example": "Workspace"
            },
            {
              "id": "runtime",
              "stage": "Runtime document",
              "responsibility": "Declare concrete Cells, bindings, and actions",
              "example": "This executable screen"
            }
          ],
          "contract": "Blueprint owns the authored declaration. Kernel owns state, actions, projection, and execution."
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Canonical Kernel-executable terminal document."
      }
    ],
    "cells": {
      "four-layers-root": {
        "id": "four-layers-root",
        "view": {
          "capability": "primitive:container",
          "props": {
            "variant": "column",
            "gap": "m",
            "fill": true,
            "ariaLabel": "Four-layer Blueprint"
          }
        }
      },
      "four-layers-title": {
        "id": "four-layers-title",
        "view": {
          "capability": "fluent:text",
          "props": {
            "value": "Four-layer Blueprint",
            "as": "h1",
            "variant": "title",
            "block": true
          }
        }
      },
      "four-layers-subtitle": {
        "id": "four-layers-subtitle",
        "view": {
          "capability": "fluent:text",
          "props": {
            "value": "From domain intent to a concrete executable projection",
            "as": "p",
            "variant": "subtitle",
            "block": true
          }
        }
      },
      "four-layers-summary": {
        "id": "four-layers-summary",
        "view": {
          "capability": "primitive:markdown",
          "bindings": {
            "value": {
              "from": "architecture.summary"
            }
          }
        }
      },
      "four-layers-stages": {
        "id": "four-layers-stages",
        "view": {
          "capability": "fluent:table",
          "props": {
            "ariaLabel": "Architecture stages",
            "columns": [
              {
                "id": "stage",
                "label": "Stage"
              },
              {
                "id": "responsibility",
                "label": "Responsibility"
              },
              {
                "id": "example",
                "label": "Example"
              }
            ]
          },
          "bindings": {
            "rows": {
              "expression": "architecture.layers.{'id':$string(id),'cells':{'stage':stage,'responsibility':responsibility,'example':example}}"
            }
          }
        }
      },
      "four-layers-contract": {
        "id": "four-layers-contract",
        "view": {
          "capability": "fluent:panel",
          "props": {
            "title": "Execution boundary"
          }
        }
      },
      "four-layers-contract-text": {
        "id": "four-layers-contract-text",
        "view": {
          "capability": "primitive:markdown",
          "bindings": {
            "value": {
              "from": "architecture.contract"
            }
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": [
          "four-layers-root"
        ],
        "placements": [
          {
            "cell": "four-layers-title",
            "parent": "four-layers-root",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "four-layers-subtitle",
            "parent": "four-layers-root",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "four-layers-summary",
            "parent": "four-layers-root",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "four-layers-stages",
            "parent": "four-layers-root",
            "slot": "children",
            "order": 3
          },
          {
            "cell": "four-layers-contract",
            "parent": "four-layers-root",
            "slot": "children",
            "order": 4
          },
          {
            "cell": "four-layers-contract-text",
            "parent": "four-layers-contract",
            "slot": "children",
            "order": 0
          }
        ]
      }
    },
    "metadata": {
      "reauthoredFrom": "legacy-tiered-sample",
      "executionModel": "direct-runtime",
      "authoredStages": [
        "workflow",
        "interaction",
        "presentation",
        "runtime-document"
      ]
    }
  }
}
