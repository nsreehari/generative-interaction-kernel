{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "manage-blueprints",
    "kind": "runtime-blueprint",
    "version": "1.0",
    "recipes": [],
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "manageBlueprints"
      ],
      "actions": [
        "assign",
        "invoke",
        "emit"
      ],
      "capabilities": {
        "ui:screen": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:row": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:col": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:heading": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:note": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:property": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:list": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "select"
          ]
        },
        "fluent:text-field": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "input"
          ]
        },
        "fluent:textarea": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "input"
          ]
        },
        "fluent:button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "press"
          ]
        },
        "fluent:tab-bar": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "select"
          ]
        },
        "primitive:form": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "save"
          ]
        },
        "primitive:file-input": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "select"
          ]
        },
        "primitive:file-download": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "download"
          ]
        },
        "ui:math-challenge": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "confirm",
            "cancel"
          ]
        },
        "manage-blueprints:catalog-loader": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "load"
          ]
        },
        "manage-blueprints:blueprint-preview": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "ui": {
            "from": "floor"
          },
          "fluent": {
            "from": "fluent",
            "use": [
              "button",
              "tab-bar"
            ]
          },
          "primitive": {
            "from": "primitive",
            "use": [
              "file-download",
              "file-input",
              "form"
            ]
          },
          "manage-blueprints": {
            "from": "self"
          }
        },
        "effectHandlers": [
          "listBlueprints",
          "getBlueprint",
          "selectBlueprintTab",
          "createBlueprint",
          "importBlueprint",
          "cloneBlueprint",
          "saveBlueprint",
          "requestDeleteBlueprint",
          "cancelDeleteBlueprint",
          "deleteBlueprint"
        ]
      },
      "state": {
        "manageBlueprints": {
          "blueprints": [],
          "catalogStatus": "Loading blueprint catalog...",
          "selectedId": "",
          "selected": {
            "id": "",
            "source": "",
            "sourceLabel": "",
            "readonly": true,
            "version": "",
            "structureMode": "fixed",
            "tiers": "",
            "recipeCount": 0,
            "tabs": []
          },
          "tab": "overview",
          "editor": {
            "id": "",
            "blueprintText": "",
            "formValue": {},
            "persisted": true,
            "status": "Select a blueprint, or create a browser-local blueprint.",
            "error": ""
          },
          "validation": {
            "valid": false,
            "previewable": false,
            "summary": "Not validated.",
            "errors": "",
            "warnings": ""
          },
          "previewBlueprint": null,
          "previewReference": "",
          "previewError": "",
          "deleteChallenge": {
            "open": false,
            "message": ""
          }
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Authored terminal document for this hosted Blueprint."
      }
    ],
    "cells": {
      "catalog-loader": {
        "id": "catalog-loader",
        "behavior": {
          "events": {
            "load": [
              {
                "do": "invoke",
                "args": {
                  "tool": "listBlueprints"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "manage-blueprints:catalog-loader"
        }
      },
      "manage-blueprints-root": {
        "id": "manage-blueprints-root",
        "view": {
          "capability": "ui:screen",
          "props": {
            "title": "Manage Blueprints",
            "subtitle": "Browse built-in Blueprints and manage your editable copies"
          }
        }
      },
      "manage-blueprints-layout": {
        "id": "manage-blueprints-layout",
        "view": {
          "capability": "ui:row",
          "props": {
            "variant": "split"
          }
        }
      },
      "blueprint-catalog": {
        "id": "blueprint-catalog",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "Blueprints",
            "variant": "rail"
          }
        }
      },
      "catalog-status": {
        "id": "catalog-status",
        "view": {
          "capability": "ui:note",
          "props": {
            "tone": "info"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.catalogStatus"
            }
          }
        }
      },
      "catalog-actions": {
        "id": "catalog-actions",
        "view": {
          "capability": "ui:row"
        }
      },
      "create-blueprint": {
        "id": "create-blueprint",
        "behavior": {
          "events": {
            "press": [
              {
                "do": "invoke",
                "args": {
                  "tool": "createBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:button",
          "props": {
            "label": "New Blueprint",
            "appearance": "primary"
          }
        }
      },
      "import-blueprint": {
        "id": "import-blueprint",
        "behavior": {
          "events": {
            "select": [
              {
                "do": "invoke",
                "args": {
                  "tool": "importBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "primitive:file-input",
          "props": {
            "label": "Import file",
            "accept": "application/json,.json",
            "readAs": "text"
          }
        }
      },
      "blueprint-list": {
        "id": "blueprint-list",
        "behavior": {
          "events": {
            "select": [
              {
                "do": "invoke",
                "args": {
                  "tool": "getBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "ui:list",
          "props": {
            "idKey": "id",
            "primaryKey": "label",
            "secondaryKey": "detail",
            "badgeKeys": [
              "scopeLabel",
              "sourceLabel"
            ],
            "emptyText": "No Blueprints found."
          },
          "bindings": {
            "items": {
              "from": "manageBlueprints.blueprints"
            },
            "selectedId": {
              "from": "manageBlueprints.selectedId"
            }
          }
        }
      },
      "blueprint-detail": {
        "id": "blueprint-detail",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "Blueprint",
            "variant": "detail"
          }
        }
      },
      "empty-selection": {
        "id": "empty-selection",
        "view": {
          "capability": "ui:note",
          "props": {
            "value": "Select a Blueprint or create a new one.",
            "tone": "muted"
          },
          "visibility": "manageBlueprints.selectedId = '' and manageBlueprints.editor.blueprintText = ''"
        }
      },
      "blueprint-tabs": {
        "id": "blueprint-tabs",
        "behavior": {
          "events": {
            "select": [
              {
                "do": "invoke",
                "args": {
                  "tool": "selectBlueprintTab"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:tab-bar",
          "bindings": {
            "options": {
              "from": "manageBlueprints.selected.tabs"
            },
            "active": {
              "from": "manageBlueprints.tab"
            }
          },
          "visibility": "manageBlueprints.selected.id != ''"
        }
      },
      "blueprint-overview": {
        "id": "blueprint-overview",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "Details",
            "variant": "tab"
          },
          "visibility": "manageBlueprints.tab = 'overview' and manageBlueprints.selected.id != ''"
        }
      },
      "blueprint-id": {
        "id": "blueprint-id",
        "view": {
          "capability": "ui:property",
          "props": {
            "label": "ID"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.selected.id"
            }
          }
        }
      },
      "blueprint-source": {
        "id": "blueprint-source",
        "view": {
          "capability": "ui:property",
          "props": {
            "label": "Source"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.selected.sourceLabel"
            }
          }
        }
      },
      "blueprint-version": {
        "id": "blueprint-version",
        "view": {
          "capability": "ui:property",
          "props": {
            "label": "Version"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.selected.version"
            }
          }
        }
      },
      "blueprint-structure-mode": {
        "id": "blueprint-structure-mode",
        "view": {
          "capability": "ui:property",
          "props": {
            "label": "Structure mode"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.selected.structureMode"
            }
          }
        }
      },
      "blueprint-tiers": {
        "id": "blueprint-tiers",
        "view": {
          "capability": "ui:property",
          "props": {
            "label": "Tiers"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.selected.tiers"
            }
          }
        }
      },
      "blueprint-recipes": {
        "id": "blueprint-recipes",
        "view": {
          "capability": "ui:property",
          "props": { "label": "Recipes" },
          "bindings": {
            "value": {
              "from": "manageBlueprints.selected.recipeCount"
            }
          }
        }
      },
      "overview-actions": {
        "id": "overview-actions",
        "view": {
          "capability": "ui:row"
        }
      },
      "clone-blueprint": {
        "id": "clone-blueprint",
        "behavior": {
          "events": {
            "press": [
              {
                "do": "invoke",
                "args": {
                  "tool": "cloneBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:button",
          "props": {
            "label": "Clone to edit"
          },
          "visibility": "manageBlueprints.selectedId != ''"
        }
      },
      "delete-blueprint": {
        "id": "delete-blueprint",
        "behavior": {
          "events": {
            "press": [
              {
                "do": "invoke",
                "args": {
                  "tool": "requestDeleteBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:button",
          "props": {
            "label": "Delete"
          },
          "visibility": "manageBlueprints.selectedId != '' and manageBlueprints.selected.readonly = false"
        }
      },
      "blueprint-draft": {
        "id": "blueprint-draft",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "JSON editor",
            "variant": "tab"
          },
          "visibility": "manageBlueprints.tab = 'draft'"
        }
      },
      "editor-error": {
        "id": "editor-error",
        "view": {
          "capability": "ui:note",
          "props": {
            "tone": "danger"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.editor.error"
            }
          },
          "visibility": "manageBlueprints.editor.error != ''"
        }
      },
      "editor-form": {
        "id": "editor-form",
        "behavior": {
          "events": {
            "save": [
              {
                "do": "invoke",
                "args": {
                  "tool": "saveBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "primitive:form",
          "props": {
            "fields": {
              "properties": {
                "id": {
                  "title": "Blueprint ID",
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "minLength": 1,
                  "span": 12
                },
                "blueprint": {
                  "title": "Blueprint JSON",
                  "type": "json",
                  "format": "json",
                  "rows": 22,
                  "span": 12
                }
              },
              "required": [
                "id",
                "blueprint"
              ],
              "validators": [
                {
                  "kind": "ajv-schema",
                  "code": "blueprint-editor-shape",
                  "message": "Enter a valid Blueprint ID and Blueprint document.",
                  "schema": {
                    "type": "object",
                    "required": ["id", "blueprint"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      },
                      "blueprint": {
                        "type": "object",
                        "required": ["gik", "type", "payload"],
                        "properties": {
                          "gik": { "type": "string" },
                          "type": { "const": "blueprint" },
                          "payload": {
                            "type": "object",
                            "required": ["id", "kind", "version", "tiers", "recipes"]
                          }
                        }
                      }
                    }
                  }
                },
                {
                  "kind": "jsonata",
                  "code": "blueprint-id-unique",
                  "message": "Blueprint ID already exists.",
                  "expr": "data.id = $currentId or $not(data.id in $blueprintIds)"
                }
              ]
            },
            "saveLabel": "Save",
            "discardLabel": "Discard changes"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.editor.formValue"
            },
            "initiallyDirty": {
              "expression": "$not(manageBlueprints.editor.persisted)"
            },
            "readOnly": {
              "from": "manageBlueprints.selected.readonly"
            },
            "validationContext": {
              "expression": "{'currentId': manageBlueprints.selectedId, 'blueprintIds': manageBlueprints.blueprints.id}"
            }
          }
        }
      },
      "editor-actions": {
        "id": "editor-actions",
        "view": {
          "capability": "ui:row"
        }
      },
      "export-blueprint": {
        "id": "export-blueprint",
        "view": {
          "capability": "primitive:file-download",
          "props": {
            "label": "Export JSON",
            "mediaType": "application/json"
          },
          "bindings": {
            "filename": {
              "expression": "manageBlueprints.editor.id & '.blueprint.json'"
            },
            "content": {
              "from": "manageBlueprints.editor.blueprintText"
            },
            "disabled": {
              "expression": "manageBlueprints.editor.blueprintText = ''"
            }
          }
        }
      },
      "blueprint-preview": {
        "id": "blueprint-preview",
        "view": {
          "capability": "ui:col",
          "visibility": "manageBlueprints.tab = 'preview'"
        }
      },
      "preview-error": {
        "id": "preview-error",
        "view": {
          "capability": "ui:note",
          "props": {
            "tone": "warning"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.previewError"
            }
          },
          "visibility": "manageBlueprints.previewError != ''"
        }
      },
      "portable-blueprint-preview": {
        "id": "portable-blueprint-preview",
        "view": {
          "capability": "manage-blueprints:blueprint-preview",
          "bindings": {
            "blueprint": {
              "from": "manageBlueprints.previewBlueprint"
            },
            "reference": {
              "from": "manageBlueprints.previewReference"
            }
          },
          "visibility": "manageBlueprints.previewBlueprint != null"
        }
      },
      "delete-blueprint-challenge": {
        "id": "delete-blueprint-challenge",
        "behavior": {
          "events": {
            "confirm": [
              {
                "do": "invoke",
                "args": {
                  "tool": "deleteBlueprint"
                }
              }
            ],
            "cancel": [
              {
                "do": "invoke",
                "args": {
                  "tool": "cancelDeleteBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "ui:math-challenge",
          "props": {
            "title": "Confirm blueprint deletion",
            "operandA": 6,
            "operandB": 7,
            "confirmLabel": "Delete blueprint"
          },
          "bindings": {
            "message": {
              "from": "manageBlueprints.deleteChallenge.message"
            }
          },
          "visibility": "manageBlueprints.deleteChallenge.open = true"
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": [
          "manage-blueprints-root"
        ],
        "placements": [
          {
            "cell": "catalog-loader",
            "parent": "manage-blueprints-root",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "manage-blueprints-layout",
            "parent": "manage-blueprints-root",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "blueprint-catalog",
            "parent": "manage-blueprints-layout",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "catalog-status",
            "parent": "blueprint-catalog",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "catalog-actions",
            "parent": "blueprint-catalog",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "create-blueprint",
            "parent": "catalog-actions",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "blueprint-list",
            "parent": "blueprint-catalog",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "blueprint-detail",
            "parent": "manage-blueprints-layout",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "empty-selection",
            "parent": "blueprint-detail",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "blueprint-tabs",
            "parent": "blueprint-detail",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "blueprint-overview",
            "parent": "blueprint-detail",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "blueprint-id",
            "parent": "blueprint-overview",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "blueprint-source",
            "parent": "blueprint-overview",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "blueprint-version",
            "parent": "blueprint-overview",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "blueprint-structure-mode",
            "parent": "blueprint-overview",
            "slot": "children",
            "order": 3
          },
          {
            "cell": "blueprint-tiers",
            "parent": "blueprint-overview",
            "slot": "children",
            "order": 4
          },
          {
            "cell": "blueprint-recipes",
            "parent": "blueprint-overview",
            "slot": "children",
            "order": 5
          },
          {
            "cell": "overview-actions",
            "parent": "blueprint-overview",
            "slot": "children",
            "order": 6
          },
          {
            "cell": "clone-blueprint",
            "parent": "overview-actions",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "delete-blueprint",
            "parent": "overview-actions",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "blueprint-draft",
            "parent": "blueprint-detail",
            "slot": "children",
            "order": 3
          },
          {
            "cell": "editor-error",
            "parent": "blueprint-draft",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "editor-form",
            "parent": "blueprint-draft",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "editor-actions",
            "parent": "blueprint-draft",
            "slot": "children",
            "order": 7
          },
          {
            "cell": "export-blueprint",
            "parent": "editor-actions",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "import-blueprint",
            "parent": "editor-actions",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "blueprint-preview",
            "parent": "blueprint-detail",
            "slot": "children",
            "order": 4
          },
          {
            "cell": "preview-error",
            "parent": "blueprint-preview",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "portable-blueprint-preview",
            "parent": "blueprint-preview",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "delete-blueprint-challenge",
            "parent": "manage-blueprints-root",
            "slot": "children",
            "order": 1
          }
        ]
      }
    }
  }
}
