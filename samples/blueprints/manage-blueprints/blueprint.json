      "manage-blueprints-root": {
        "id": "manage-blueprints-root",
        "view": {
          "capability": "ui:screen",
          "props": {
            "title": "Manage Blueprints",
            "subtitle": "Inspect repository blueprints and manage portable browser-local blueprint artifacts"
          }
        }
      },
      "manage-blueprints-layout": {
        "id": "manage-blueprints-layout",
        "view": {
          "capability": "ui:row",
          "props": {
            "variant": "split"
          }
        }
      },
      "blueprint-catalog": {
        "id": "blueprint-catalog",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "Blueprint catalog",
            "variant": "rail"
          }
        }
      },
      "catalog-status": {
        "id": "catalog-status",
        "view": {
          "capability": "ui:note",
          "props": {
            "tone": "info"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.catalogStatus"
            }
          }
        }
      },
      "catalog-actions": {
        "id": "catalog-actions",
        "view": {
          "capability": "ui:row"
        }
      },
      "refresh-blueprints": {
        "id": "refresh-blueprints",
        "behavior": {
          "events": {
            "press": [
              {
                "do": "invoke",
                "args": {
                  "tool": "listBlueprints"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "ui:button",
          "props": {
            "label": "Refresh"
          }
        }
      },
      "create-blueprint": {
        "id": "create-blueprint",
        "behavior": {
          "events": {
            "press": [
              {
                "do": "invoke",
                "args": {
                  "tool": "createBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "ui:button",
          "props": {
            "label": "New local blueprint",
            "tone": "primary"
          }
        }
      },
      "import-blueprint": {
        "id": "import-blueprint",
        "behavior": {
          "events": {
            "import": [
              {
                "do": "invoke",
                "args": {
                  "tool": "importBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "manage-blueprints:blueprint-import"
        }
      },
      "blueprint-list": {
        "id": "blueprint-list",
        "behavior": {
          "events": {
            "select": [
              {
                "do": "invoke",
                "args": {
                  "tool": "getBlueprint"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "ui:list",
          "props": {
            "idKey": "id",
            "primaryKey": "label",
            "secondaryKey": "detail",
            "badgeKey": "source",
            "emptyText": "No blueprint artifacts found."
          },
          "bindings": {
            "items": {
              "from": "manageBlueprints.blueprints"
            },
            "selectedId": {
              "from": "manageBlueprints.selectedId"
            }
          }
        }
      },
      "blueprint-detail": {
        "id": "blueprint-detail",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "Blueprint artifact",
            "variant": "detail"
          }
        }
      },
      "empty-selection": {
        "id": "empty-selection",
        "view": {
          "capability": "ui:note",
          "props": {
            "value": "Select a repository or local blueprint, or create a new local artifact.",
            "tone": "muted"
          },
          "visibility": "manageBlueprints.selectedId = '' and manageBlueprints.editor.blueprintText = ''"
        }
      },
      "blueprint-tabs": {
        "id": "blueprint-tabs",
        "behavior": {
          "events": {
            "select": [
              {
                "do": "assign",
                "target": "manageBlueprints.tab",
                "args": {
                  "from": "$event.value"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "ui:tabBar",
          "props": {
            "options": [
              {
                "value": "overview",
                "label": "Overview"
              },
              {
                "value": "draft",
                "label": "Draft"
              },
              {
                "value": "preview",
                "label": "Preview"
              }
            ]
          },
          "bindings": {
            "active": {
              "from": "manageBlueprints.tab"
            }
          }
        }
      },
      "blueprint-overview": {
        "id": "blueprint-overview",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "Artifact boundary",
            "variant": "tab"
