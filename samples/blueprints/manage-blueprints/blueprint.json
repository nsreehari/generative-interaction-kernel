          "visibility": "manageBlueprints.tab = 'overview'"
        }
      },
      "blueprint-id": {
        "id": "blueprint-id",
        "view": {
          "capability": "ui:property",
          "props": {
            "label": "ID"
          },
          "bindings": {
            "value": {
              "from": "manageBlueprints.selected.id"
