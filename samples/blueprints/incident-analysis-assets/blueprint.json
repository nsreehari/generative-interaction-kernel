{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "incident-analysis-assets",
    "kind": "runtime-blueprint",
    "version": "1.0.0",
    "structureMode": "fixed",
    "interface": {
      "events": ["list-sources", "get-source", "list-assets", "get-asset", "put-asset", "delete-asset", "clear-assets"],
      "outputs": {
        "result": {
          "from": "incidentAssets.result",
          "description": "Result of the most recently completed incident asset operation."
        }
      }
    },
    "tiers": [{ "id": "runtime-document", "kind": "runtime-document" }],
    "recipes": [],
    "runtime": {
      "expression": "jsonata",
      "namespaces": ["incidentAssets"],
      "actions": ["invoke"],
      "state": { "incidentAssets": { "result": null, "runtimeAssetKeys": [] } }
    },
    "cells": {
      "asset-controller": {
        "id": "asset-controller",
        "kind": "incident-asset-backend",
        "behavior": {
          "events": {
            "list-sources": [{ "do": "invoke", "args": { "tool": "readSourceIndex" } }],
            "get-source": [{ "do": "invoke", "args": { "tool": "readIncidentSource" } }],
            "list-assets": [{ "do": "invoke", "args": { "tool": "listRuntimeAssets" } }],
            "list-seed-assets": [{ "do": "invoke", "args": { "tool": "listSeedAssets" } }],
            "get-asset": [{ "do": "invoke", "args": { "tool": "readRuntimeAsset" } }],
            "get-seed-asset": [{ "do": "invoke", "args": { "tool": "readSeedAsset" } }],
            "put-asset": [{ "do": "invoke", "args": { "tool": "writeIncidentAsset" } }],
            "delete-asset": [{ "do": "invoke", "args": { "tool": "deleteIncidentAsset" } }],
            "clear-assets": [{ "do": "invoke", "args": { "tool": "listAssetsToClear" } }],
            "delete-storage-key": [{ "do": "invoke", "args": { "tool": "deleteStorageKey" } }]
          }
        }
      }
    },
    "services": {
      "storage": {
        "kind": "durable-storage",
        "version": "1",
        "operations": {
          "readSourceIndex": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'key':'index:sources'}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':{'sources':response}}]}" } }
          },
          "readIncidentSource": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'key':'source:' & effect.payload.sourceId}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':response}]}" } }
          },
          "listRuntimeAssets": {
            "operation": "listKeys",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'prefix':'asset:' & effect.payload.sourceId & '/' & effect.payload.analyzerId & '/'}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incidentAssets.runtimeAssetKeys','value':response}],'events':[{'node':'asset-controller','name':'list-seed-assets','payload':effect.payload}]}" } }
          },
          "listSeedAssets": {
            "operation": "listKeys",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'prefix':'seed-asset:' & effect.payload.sourceId & '/' & effect.payload.analyzerId & '/'}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "($keys := $append(state.incidentAssets.runtimeAssetKeys, response); {'ops':[{'op':'set','path':'incidentAssets.result','value':{'assets':[$keys.($parts := $split($replace($,/^(seed-)?asset:/,''),'/'); {'sourceId':$parts[0],'analyzerId':$parts[1],'variant':$parts[2]})]}}]})" } }
          },
          "readRuntimeAsset": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'key':'asset:' & effect.payload.sourceId & '/' & effect.payload.analyzerId & '/' & effect.payload.variant}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "response != null ? {'ops':[{'op':'set','path':'incidentAssets.result','value':response}]} : {'events':[{'node':'asset-controller','name':'get-seed-asset','payload':effect.payload}]}" } }
          },
          "readSeedAsset": {
            "operation": "read",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'key':'seed-asset:' & effect.payload.sourceId & '/' & effect.payload.analyzerId & '/' & effect.payload.variant}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':response}]}" } }
          },
          "writeIncidentAsset": {
            "operation": "write",
            "contract": "storage-kv/v1",
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'key':'asset:' & effect.payload.sourceId & '/' & effect.payload.analyzerId & '/' & effect.payload.variant,'value':{'sourceId':effect.payload.sourceId,'analyzerId':effect.payload.analyzerId,'variant':effect.payload.variant,'value':effect.payload.value,'persistedAt':effect.payload.persistedAt}}"
              }
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':{'asset':{'sourceId':effect.payload.sourceId,'analyzerId':effect.payload.analyzerId,'variant':effect.payload.variant,'value':effect.payload.value,'persistedAt':effect.payload.persistedAt}}}]}"
              }
            }
          },
          "deleteIncidentAsset": {
            "operation": "delete",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'key':'asset:' & effect.payload.sourceId & '/' & effect.payload.analyzerId & '/' & effect.payload.variant}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':{'deleted':true}}]}" } }
          },
          "listAssetsToClear": {
            "operation": "listKeys",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'prefix':'asset:'}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'ops':[{'op':'set','path':'incidentAssets.result','value':{'cleared':$count(response)}}],'events':[response.{'node':'asset-controller','name':'delete-storage-key','payload':{'key':$}}]}" } }
          },
          "deleteStorageKey": {
            "operation": "delete",
            "contract": "storage-kv/v1",
            "request": { "transform": { "kind": "jsonata", "expr": "{'key':effect.payload.key}" } },
            "settlement": { "transform": { "kind": "jsonata", "expr": "{'outcome':'completed'}" } }
          }
        },
        "config": { "connection": "incident-runtime-cache" },
        "scope": "per-blueprint"
      }
    },
    "metadata": {
      "scope": "backend",
      "executionMedium": "headless"
    }
  }
}