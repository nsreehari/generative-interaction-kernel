{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "foundry-agent-no-cells",
    "kind": "runtime-blueprint",
    "version": "1.0",
    "metadata": {
      "sampleVariant": "behavior-only-no-dataflow",
      "description": "Foundry workflow authored without Cell input/output token wiring."
    },
    "recipes": [],
    "services": {
      "assistant": {
        "kind": "foundry-agent",
        "version": "1",
        "operations": {
          "askAgent": {
            "operation": "chat",
            "contract": "foundry-chat/v1",
            "subject": {
              "kind": "chat",
              "blueprintId": "foundry-agent",
              "turnId": "current"
            },
            "request": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'message':$trim(state.agent.draft),'agentName':$trim(state.agent.agentName),'conversationId':state.agent.conversationId = '' ? null : state.agent.conversationId}"
              }
            },
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "message": "Foundry agent returned an invalid chat response",
                  "schema": {
                    "type": "object",
                    "required": [
                      "conversationId",
                      "responseId",
                      "reply"
                    ],
                    "properties": {
                      "conversationId": {
                        "type": "string"
                      },
                      "responseId": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reply": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                }
              ]
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'agent.error','value':''},{'op':'set','path':'agent.lastAsked','value':$trim(state.agent.draft)},{'op':'set','path':'agent.draft','value':''},{'op':'set','path':'agent.conversationId','value':response.conversationId},{'op':'set','path':'agent.reply','value':response.reply}],'detail':{'provider':'foundry-agent','responseId':response.responseId,'conversationId':response.conversationId}}"
              }
            },
            "failureSettlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($access := error.message = 'Foundry access is required' or error.status = 401 or error.status = 403; {'ops':[{'op':'set','path':'agent.error','value':$access ? '' : error.message},{'op':'set','path':'agent.accessStatus','value':$access ? 'required' : state.agent.accessStatus},{'op':'set','path':'agent.accessError','value':$access ? (error.status = 401 or error.status = 403 ? 'That access key was rejected.' : 'Foundry access is required.') : state.agent.accessError}]})"
              }
            },
            "onViolation": {
              "action": "fail"
            }
          },
          "checkFoundryAccess": {
            "operation": "check-access",
            "contract": "foundry-access-check/v1",
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'agent.accessStatus','value':'ready'},{'op':'set','path':'agent.accessError','value':''}]}"
              }
            },
            "failureSettlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.message = 'Foundry access is required'; {'ops':[{'op':'set','path':'agent.accessStatus','value':($rejected or $missing) ? 'required' : 'error'},{'op':'set','path':'agent.accessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : error.message)}]})"
              }
            },
            "onViolation": {
              "action": "fail"
            }
          },
          "discoverAgents": {
            "operation": "discover",
            "contract": "foundry-agent-list/v1",
            "response": {
              "validators": [
                {
                  "kind": "ajv-schema",
                  "message": "Foundry returned an invalid agent list",
                  "schema": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            },
            "settlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "{'ops':[{'op':'set','path':'agent.agentOptions','value':response},{'op':'set','path':'agent.agentName','value':$count(response) > 0 ? response[0] : ''},{'op':'set','path':'agent.agentsStatus','value':$count(response) > 0 ? 'ready' : 'empty'},{'op':'set','path':'agent.agentsError','value':''}]}"
              }
            },
            "failureSettlement": {
              "transform": {
                "kind": "jsonata",
                "expr": "($rejected := error.status = 401 or error.status = 403; $missing := error.message = 'Foundry access is required'; {'ops':[{'op':'set','path':'agent.agentOptions','value':[]},{'op':'set','path':'agent.agentName','value':''},{'op':'set','path':'agent.accessStatus','value':($rejected or $missing) ? 'required' : state.agent.accessStatus},{'op':'set','path':'agent.accessError','value':$rejected ? 'That access key was rejected.' : ($missing ? 'Foundry access is required.' : state.agent.accessError)},{'op':'set','path':'agent.agentsStatus','value':($rejected or $missing) ? 'idle' : 'error'},{'op':'set','path':'agent.agentsError','value':($rejected or $missing) ? '' : error.message}]})"
              }
            },
            "onViolation": {
              "action": "fail"
            }
          }
        },
        "config": {
          "endpoint": "${GIK_FOUNDRY_PROXY_ORIGIN}",
          "credentialRef": "foundry-agent/access-key"
        },
        "scope": "per-session"
      }
    },
    "runtime": {
      "expression": "jsonata",
      "namespaces": [
        "agent"
      ],
      "actions": [
        "assign",
        "invoke"
      ],
      "capabilities": {
        "ui:screen": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:panel": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:col": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:row": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "ui:heading": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:note": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:text": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "ui:alert": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "fluent:text-field": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "input"
          ]
        },
        "foundry:access-gate": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "accessRequested",
            "accessCleared"
          ],
          "slots": [
            "children"
          ]
        },
        "agent:agent-selector": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "agentsRequested",
            "select"
          ]
        },
        "agent:ask-page": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "slots": [
            "children"
          ]
        },
        "agent:sign-out-button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "press"
          ]
        },
        "fluent:button": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          },
          "emits": [
            "press"
          ]
        },
        "ui:markdown": {
          "propsSchema": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "externals": {
        "projectionViews": {
          "ui": {
            "from": "floor"
          },
          "fluent": {
            "from": "fluent",
            "use": [
              "button",
              "text-field"
            ]
          },
          "agent": {
            "from": "self"
          },
          "foundry": {
            "from": "foundry",
            "use": [
              "access-gate"
            ]
          }
        },
        "effectHandlers": [
          "clearFoundryAccess",
          "signOut"
        ]
      },
      "state": {
        "agent": {
          "accessStatus": "required",
          "accessError": "",
          "agentName": "",
          "draft": "",
          "reply": "",
          "lastAsked": "",
          "conversationId": "",
          "agentOptions": [],
          "agentsStatus": "idle",
          "agentsError": "",
          "error": ""
        }
      }
    },
    "tiers": [
      {
        "id": "runtime-document",
        "kind": "runtime-document",
        "description": "Authored terminal document for this hosted Blueprint."
      }
    ],
    "cells": {
      "foundry-agent-root": {
        "id": "foundry-agent-root",
        "view": {
          "capability": "ui:screen",
          "props": {
            "title": "Foundry Agent",
            "subtitle": "Choose an available agent and start a conversation."
          }
        }
      },
      "foundry-access-gate": {
        "id": "foundry-access-gate",
        "behavior": {
          "events": {
            "accessRequested": [
              {
                "do": "assign",
                "target": "agent.accessStatus",
                "args": {
                  "value": "checking"
                }
              },
              {
                "do": "assign",
                "target": "agent.accessError",
                "args": {
                  "value": ""
                }
              },
              {
                "do": "invoke",
                "args": {
                  "tool": "checkFoundryAccess"
                }
              }
            ],
            "accessCleared": [
              {
                "do": "invoke",
                "args": {
                  "tool": "clearFoundryAccess"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "foundry:access-gate",
          "bindings": {
            "access": {
              "expression": "($s := agent.accessStatus; {'triggered': $s != 'ready' and $s != 'empty', 'status': $s = 'checking' ? 'checking' : ($s = 'required' ? 'required' : 'error'), 'error': agent.accessError})"
            }
          }
        }
      },
      "agent-demo": {
        "id": "agent-demo",
        "view": {
          "capability": "agent:ask-page",
          "props": {
            "title": "Ask the agent"
          }
        }
      },
      "agent-selector": {
        "id": "agent-selector",
        "behavior": {
          "events": {
            "agentsRequested": [
              {
                "do": "assign",
                "target": "agent.agentsStatus",
                "args": {
                  "value": "loading"
                }
              },
              {
                "do": "assign",
                "target": "agent.agentsError",
                "args": {
                  "value": ""
                }
              },
              {
                "do": "invoke",
                "args": {
                  "tool": "discoverAgents"
                }
              }
            ],
            "select": [
              {
                "do": "assign",
                "target": "agent.agentName",
                "args": {
                  "from": "$event.value"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "agent:agent-selector",
          "bindings": {
            "agentName": {
              "from": "agent.agentName"
            },
            "agentOptions": {
              "from": "agent.agentOptions"
            },
            "agentsStatus": {
              "from": "agent.agentsStatus"
            },
            "agentsError": {
              "from": "agent.agentsError"
            }
          }
        }
      },
      "agent-connected": {
        "id": "agent-connected",
        "view": {
          "capability": "ui:alert",
          "props": {
            "label": "Connected to",
            "level": "good"
          },
          "bindings": {
            "value": {
              "from": "agent.agentName"
            }
          }
        }
      },
      "agent-message-field": {
        "id": "agent-message-field",
        "behavior": {
          "events": {
            "input": [
              {
                "do": "assign",
                "target": "agent.draft",
                "args": {
                  "from": "$event.value"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:text-field",
          "props": {
            "label": "Message",
            "placeholder": "Ask the agent something..."
          },
          "bindings": {
            "value": {
              "from": "agent.draft"
            }
          }
        }
      },
      "agent-ask-btn": {
        "id": "agent-ask-btn",
        "behavior": {
          "events": {
            "press": [
              {
                "do": "invoke",
                "args": {
                  "tool": "askAgent"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "fluent:button",
          "props": {
            "label": "Ask",
            "appearance": "primary"
          }
        }
      },
      "agent-request-error": {
        "id": "agent-request-error",
        "view": {
          "capability": "ui:alert",
          "props": {
            "label": "Something went wrong",
            "level": "error"
          },
          "bindings": {
            "value": {
              "from": "agent.error"
            }
          },
          "visibility": "agent.error != ''"
        }
      },
      "agent-asked-panel": {
        "id": "agent-asked-panel",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "You asked",
            "variant": "inset"
          },
          "visibility": "agent.lastAsked != ''"
        }
      },
      "agent-asked-value": {
        "id": "agent-asked-value",
        "view": {
          "capability": "ui:note",
          "props": {
            "tone": "muted"
          },
          "bindings": {
            "value": {
              "from": "agent.lastAsked"
            }
          }
        }
      },
      "agent-reply-panel": {
        "id": "agent-reply-panel",
        "view": {
          "capability": "ui:panel",
          "props": {
            "title": "Reply",
            "variant": "inset"
          }
        }
      },
      "agent-reply-empty": {
        "id": "agent-reply-empty",
        "view": {
          "capability": "ui:note",
          "props": {
            "value": "Send a message to see the agent's reply.",
            "tone": "muted"
          },
          "visibility": "agent.reply = ''"
        }
      },
      "agent-reply-value": {
        "id": "agent-reply-value",
        "view": {
          "capability": "ui:markdown",
          "bindings": {
            "value": {
              "from": "agent.reply"
            }
          },
          "visibility": "agent.reply != ''"
        }
      },
      "agent-signout-btn": {
        "id": "agent-signout-btn",
        "behavior": {
          "events": {
            "press": [
              {
                "do": "invoke",
                "args": {
                  "tool": "signOut"
                }
              }
            ]
          }
        },
        "view": {
          "capability": "agent:sign-out-button",
          "props": {
            "label": "Sign out"
          }
        }
      }
    },
    "projections": {
      "presentation": {
        "roots": [
          "foundry-agent-root"
        ],
        "placements": [
          {
            "cell": "foundry-access-gate",
            "parent": "foundry-agent-root",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "agent-demo",
            "parent": "foundry-access-gate",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "agent-selector",
            "parent": "agent-demo",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "agent-connected",
            "parent": "agent-demo",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "agent-message-field",
            "parent": "agent-demo",
            "slot": "children",
            "order": 2
          },
          {
            "cell": "agent-ask-btn",
            "parent": "agent-demo",
            "slot": "children",
            "order": 3
          },
          {
            "cell": "agent-request-error",
            "parent": "agent-demo",
            "slot": "children",
            "order": 4
          },
          {
            "cell": "agent-asked-panel",
            "parent": "agent-demo",
            "slot": "children",
            "order": 5
          },
          {
            "cell": "agent-asked-value",
            "parent": "agent-asked-panel",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "agent-reply-panel",
            "parent": "agent-demo",
            "slot": "children",
            "order": 6
          },
          {
            "cell": "agent-reply-empty",
            "parent": "agent-reply-panel",
            "slot": "children",
            "order": 0
          },
          {
            "cell": "agent-reply-value",
            "parent": "agent-reply-panel",
            "slot": "children",
            "order": 1
          },
          {
            "cell": "agent-signout-btn",
            "parent": "agent-demo",
            "slot": "children",
            "order": 7
          }
        ]
      }
    }
  }
}
