{
  "name": "gik-samples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite apps/host",
    "build": "vite build apps/host",
    "test": "vitest run",
    "typecheck": "tsc -p apps/host/tsconfig.json --noEmit && tsc -p backend-host/tsconfig.json --noEmit && tsc -p agent-host/tsconfig.json --noEmit && tsc -p control-host/tsconfig.json --noEmit && tsc -p gik-meta/tsconfig.json --noEmit",
    "start:backend": "tsx backend-host/order-service.ts",
    "start:agent": "tsx agent-host/mcp-service.ts",
    "start:control": "tsx control-host/service.ts",
    "start:continuity": "tsx control-host/continuity-worker.ts",
    "start:gik": "tsx gik-meta/quickstart.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.312",
    "@gik/agentface": "0.1.0",
    "@gik/component-infinite-canvas": "0.1.0",
    "@gik/controlface": "0.1.2",
    "@gik/evaluators": "0.1.0",
    "@gik/kernel": "0.1.0",
    "@gik/profile": "0.1.1",
    "@gik/provider-consequence-graph": "0.1.0",
    "@gik/provider-exploratory-graph": "0.1.0",
    "@gik/provider-profile-authoring": "0.1.0",
    "@gik/provider-step-orchestrator": "0.1.0",
    "@gik/react": "0.1.0",
    "@gik/transport-http-sse": "0.1.0",
    "@gik/transport-mcp-http": "0.1.0",
    "@xyflow/react": "^12.8.5",
    "gik": "0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
