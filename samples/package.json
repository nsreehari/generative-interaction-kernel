{
  "name": "@gik/samples",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "blueprints:bundle": "node catalog/build-blueprint-catalog.mjs",
    "dev": "npm run blueprints:bundle && npm run build:storybook && vite apps/browser-host",
    "dev:local": "npm run blueprints:bundle && npm run build:storybook && vite apps/browser-host --mode gik-local",
    "build": "npm run blueprints:bundle && npm run build:storybook && vite build apps/browser-host",
    "build:local": "npm run blueprints:bundle && npm run build:storybook && vite build apps/browser-host --mode gik-local",
    "storybook": "npm run dev",
    "build:storybook": "storybook build -c storybook/.storybook -o storybook-static",
    "test": "vitest run",
    "typecheck": "tsc -p apps/browser-host/tsconfig.json --noEmit && tsc -p apps/node-host/tsconfig.json --noEmit && tsc -p storybook/tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "start:node": "tsx apps/node-host/service.ts",
    "start:agent": "tsx examples/stateless-agent-mcp-host/mcp-service.ts",
    "start:control": "tsx apps/node-host/service.ts --profile portfolio-tracker-new",
    "start:continuity": "tsx apps/node-host/continuity-worker.ts",
    "start:gik": "tsx examples/gik-quickstart/quickstart.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.3",
    "@fluentui/react-icons": "^2.0.312",
    "@gik/agentface": "0.1.1",
    "@gik/agent-lifecycle-exp": "0.1.0",
    "@gik/blueprint-agent-host": "0.1.0",
    "@gik/blueprint": "0.2.0",
    "@gik/components": "0.2.0",
    "@gik/controlface": "0.1.4",
    "@gik/demo-runner-host": "0.1.5",
    "@gik/durable-runtime": "0.8.0",
    "@gik/evaluators": "0.1.1",
    "@gik/kernel": "0.1.1",
    "@gik/provider-blueprint-authoring": "0.1.0",
    "@gik/provider-step-orchestrator": "0.1.0",
    "@gik/react": "0.3.0",
    "@gik/transport-http-sse": "0.1.0",
    "@gik/transport-mcp-http": "0.1.0",
    "@xyflow/react": "^12.8.5",
    "mermaid": "^11.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/react-vite": "10.5.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sirv": "^3.0.2",
    "storybook": "10.5.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  }
}
