{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@gik/kernel": [
        "../../../packages/kernel/src/index.ts"
      ],
      "@gik/controlface": [
        "../../../packages/controlface/src/index.ts"
      ],
      "@gik/agentface": [
        "../../../packages/agentface/src/index.ts"
      ],
      "@gik/react": [
        "../../../packages/react/src/index.ts"
      ],
      "@gik/profile": [
        "../../../packages/profile/src/index.ts"
      ],
      "@gik/profile-genui": [
        "../../../packages/profile-genui/src/index.ts"
      ],
      "@gik/provider-reactive-state-model": [
        "../../../packages/provider-reactive-state-model/src/index.ts"
      ],
      "@gik/provider-consequence-graph": [
        "../../../packages/provider-consequence-graph/src/index.ts"
      ],
      "@gik/provider-exploratory-graph": [
        "../../../packages/provider-exploratory-graph/src/index.ts"
      ],
      "@gik/provider-step-orchestrator": [
        "../../../packages/provider-step-orchestrator/src/index.ts"
      ],
      "@gik/provider-profile-authoring": [
        "../../../packages/provider-profile-authoring/src/index.ts"
      ],
      "@gik/reactive-state-model": [
        "../../../packages/reactive-state-model/src/index.ts"
      ],
      "@gik/transport-http-sse": [
        "../../../packages/transport-http-sse/src/index.ts"
      ],
      "@gik/transport-http-sse/server": [
        "../../../packages/transport-http-sse/src/server.ts"
      ],
      "@gik/transport-http-sse/client": [
        "../../../packages/transport-http-sse/src/client.ts"
      ],
      "@gik/transport-http-sse/codec": [
        "../../../packages/transport-http-sse/src/codec.ts"
      ],
      "@gik/transport-mcp-http": [
        "../../../packages/transport-mcp-http/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../../bundles"
  ],
  "exclude": [
    "../../bundles/workbench/bundles/chrome",
    "../../bundles/workbench/bundles/inspect"
  ]
}
