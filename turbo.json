{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "kernel/**",
    "blueprint/**",
    "face/**",
    "adapters/**",
    "transports/**",
    "providers/**",
    "schemas/**",
    "packages/evaluators/schemas/**",
    "scripts/sync-package-license.mjs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "globalEnv": ["NODE_ENV", "GIK_BUILD_TOOLCHAIN"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "gik-blueprint#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/blueprint/**"],
      "outputs": ["dist/**"]
    },
    "gik-kernel#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/kernel/**"],
      "outputs": ["dist/**"]
    },
    "gik-controlface#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/face/**"],
      "outputs": ["dist/**"]
    },
    "gik-provider-blueprint-authoring#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/provider-blueprint-authoring/**"],
      "outputs": ["dist/**"]
    }
  }
}