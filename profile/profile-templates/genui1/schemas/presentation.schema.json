{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/presentation.schema.json",
  "title": "GenUI Presentation DSL",
  "description": "The renderer-agnostic Presentation Model (Layer 4): a named layout plus ordered, enriched regions produced by a presentation planner and consumed by the presentation compiler.",
  "type": "object",
  "required": ["layout", "arrangement", "regions", "source"],
  "additionalProperties": false,
  "properties": {
    "layout": { "type": "string", "minLength": 1 },
    "arrangement": {
      "enum": ["stack", "narrative", "split", "grid", "dashboard", "wizard"]
    },
    "frame": { "type": "string", "minLength": 1 },
    "regions": {
      "type": "array",
      "items": { "$ref": "#/definitions/region" }
    },
    "source": {
      "type": "object",
      "required": ["interaction", "subject"],
      "properties": {
        "interaction": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "region": {
      "type": "object",
      "required": ["name", "role", "priority", "disclosure"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "concern": { "type": "string", "minLength": 1 },
        "role": {
          "enum": [
            "summary",
            "collection",
            "detail",
            "timeline",
            "graph",
            "narrative",
            "metrics",
            "status",
            "form",
            "actions",
            "comparison",
            "recommendation"
          ]
        },
        "group": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["primary", "secondary", "tertiary"] },
        "disclosure": { "enum": ["always", "collapsed", "on-demand"] },
        "presentation": { "type": "string", "minLength": 1 },
        "materialize": { "type": "boolean" },
        "capability": { "type": "string", "minLength": 1 },
        "props": {
          "type": "object",
          "description": "Static per-capability presentation config (the 'spec' channel): columns, chartType, thresholds, etc. Merged into the node's props and validated by the capability's propsSchema."
        },
        "read": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "readExpr": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "on": {
          "type": "object",
          "additionalProperties": true
        },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  }
}
