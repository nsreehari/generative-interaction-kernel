{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/workflow.schema.json",
  "title": "GenUI Workflow Spec",
  "type": "object",
  "required": ["workflow", "subject"],
  "additionalProperties": false,
  "properties": {
    "workflow": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "interaction": { "type": "string", "minLength": 1 },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "intent": { "type": "object" },
    "data": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "facetViews": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/facetView"
      }
    }
  },
  "definitions": {
    "facetView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "read": { "type": "object", "additionalProperties": { "type": "string" } },
        "readExpr": { "type": "object", "additionalProperties": { "type": "string" } },
        "on": { "type": "object", "additionalProperties": true },
        "presentation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
