{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "representation-lowering",
    "kind": "intent-blueprint",
    "version": "1",
    "structureMode": "fixed",
    "serviceTiers": [
      {
        "id": "intent",
        "kind": "interaction-intent"
      },
      {
        "id": "runtime",
        "kind": "runtime-document"
      }
    ],
    "serviceRecipes": [
      {
        "id": "intent-to-runtime",
        "from": "intent",
        "to": "runtime",
        "implementationPrograms": [
          {
            "id": "default",
            "cells": {
              "query-input": {
                "behavior": {
                  "on": {
                    "submit": [
                      {
                        "do": "assign",
                        "target": "search.submitted",
                        "args": {
                          "value": true
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ],
        "implementationFallback": "default"
      }
    ],
    "projectionTiers": [
      {
        "id": "intent",
        "kind": "interaction-intent",
        "capabilities": [
          "sample:query-intent",
          "sample:results-intent",
          "sample:summary-intent"
        ]
      },
      {
        "id": "runtime",
        "kind": "runtime-document",
        "capabilities": []
      }
    ],
    "projectionRecipes": [
      {
        "id": "intent-to-runtime",
        "from": "intent",
        "to": "runtime",
        "representations": [
          {
            "id": "default",
            "views": {
              "query-input": {
                "primary": {
                  "capability": "sample:query-input",
                  "region": "query-input"
                }
              },
              "results": {
                "primary": {
                  "capability": "sample:results",
                  "region": "children",
                  "bindings": {
                    "items": {
                      "from": "search.results"
                    }
                  }
                }
              },
              "summary": {
                "primary": {
                  "capability": "sample:summary",
                  "region": "children",
                  "bindings": {
                    "count": {
                      "expression": "$count(search.results)"
                    }
                  }
                }
              }
            },
            "presentation": {
              "slots": [
                "query-input",
                {
                  "id": "children",
                  "region": "query-input"
                }
              ],
              "root": "query-input"
            }
          }
        ],
        "fallback": "default"
      }
    ],
    "cells": {
      "query-input": {
        "id": "query-input",
        "metadata": {
          "role": "collect-query"
        },
        "events": {
          "submit": {
            "payloadSchema": {
              "type": "object"
            }
          }
        },
        "potentialViews": {
          "primary": {
            "capability": "sample:query-intent",
            "region": "query-input"
          }
        }
      },
      "results": {
        "id": "results",
        "metadata": {
          "role": "show-results"
        },
        "potentialViews": {
          "primary": {
            "capability": "sample:results-intent",
            "region": "children"
          }
        }
      },
      "summary": {
        "id": "summary",
        "metadata": {
          "role": "summarize-results"
        },
        "potentialViews": {
          "primary": {
            "capability": "sample:summary-intent",
            "region": "children"
          }
        }
      }
    },
    "runtime": {
      "state": {
        "search": {
          "submitted": false,
          "results": [
            {
              "id": "r1",
              "title": "First result"
            },
            {
              "id": "r2",
              "title": "Second result"
            }
          ]
        }
      }
    },
    "presentation": {
      "slots": [
        "query-input",
        {
          "id": "children",
          "region": "query-input"
        }
      ],
      "root": "query-input",
      "allowedCapabilities": [
        {
          "tier": "intent"
        },
        "sample:query-input",
        "sample:results",
        "sample:summary"
      ]
    }
  }
}
