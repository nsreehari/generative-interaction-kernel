{
  "gik": "0.1",
  "type": "blueprint",
  "payload": {
    "id": "vocabulary-lowering",
    "kind": "intent-blueprint",
    "version": "1",
    "structureMode": "fixed",
    "tiers": [
      {
        "id": "intent",
        "kind": "interaction-intent"
      },
      {
        "id": "runtime",
        "kind": "runtime-document"
      }
    ],
    "recipes": [
      {
        "id": "intent-to-runtime",
        "from": "intent",
        "to": "runtime",
        "patch": [
          {
            "op": "replaceCell",
            "cellId": "query-input",
            "cell": {
              "id": "query-input",
              "potentialViews": {
                "primary": {
                  "capability": "sample:query-input",
                  "region": "query-input"
                }
              },
              "events": {
                "submit": {
                  "payloadSchema": {
                    "type": "object"
                  }
                }
              },
              "behavior": {
                "on": {
                  "submit": [
                    {
                      "do": "assign",
                      "target": "search.submitted",
                      "args": {
                        "value": true
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "op": "replaceCell",
            "cellId": "results",
            "cell": {
              "id": "results",
              "potentialViews": {
                "primary": {
                  "capability": "sample:results",
                  "region": "children",
                  "bindings": {
                    "items": {
                      "from": "search.results"
                    }
                  }
                }
              }
            }
          },
          {
            "op": "replaceCell",
            "cellId": "summary",
            "cell": {
              "id": "summary",
              "potentialViews": {
                "primary": {
                  "capability": "sample:summary",
                  "region": "children",
                  "bindings": {
                    "count": {
                      "expression": "$count(search.results)"
                    }
                  }
                }
              }
            }
          },
          {
            "op": "setPresentation",
            "presentation": {
              "slots": [
                "query-input",
                {
                  "id": "children",
                  "region": "query-input"
                }
              ],
              "root": "query-input"
            }
          }
        ]
      }
    ],
    "cells": {
      "query-input": {
        "id": "query-input",
        "metadata": {
          "role": "collect-query"
        }
      },
      "results": {
        "id": "results",
        "metadata": {
          "role": "show-results"
        }
      },
      "summary": {
        "id": "summary",
        "metadata": {
          "role": "summarize-results"
        }
      }
    },
    "runtime": {
      "state": {
        "search": {
          "submitted": false,
          "results": [
            {
              "id": "r1",
              "title": "First result"
            },
            {
              "id": "r2",
              "title": "Second result"
            }
          ]
        }
      }
    }
  }
}
