{
  "name": "@gik/profile",
  "version": "0.1.0",
  "description": "Profile and lowering base types for GIK (Task -> Domain -> Interaction -> UI).",
  "license": "MIT",
  "author": "nsreehari",
  "keywords": [
    "gik",
    "generative-ui",
    "declarative-ui",
    "profile",
    "lowering",
    "dsl"
  ],
  "homepage": "https://github.com/nsreehari/generative-interaction-kernel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsreehari/generative-interaction-kernel.git",
    "directory": "packages/profile"
  },
  "bugs": {
    "url": "https://github.com/nsreehari/generative-interaction-kernel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@gik/evaluators": "0.1.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --minify --clean --tsconfig tsconfig.json",
    "prepack": "node ../../scripts/sync-public-docs.mjs packages/profile"
  }
}
