{
  "name": "@gik/blueprint",
  "version": "0.2.0",
  "description": "Canonical Blueprint artifact, Cell, tier, lowering recipe, and Kernel lowering contracts for GIK.",
  "license": "MIT",
  "author": "nsreehari",
  "keywords": [
    "gik",
    "blueprint",
    "cells",
    "lowering",
    "declarative"
  ],
  "homepage": "https://github.com/nsreehari/generative-interaction-kernel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsreehari/generative-interaction-kernel.git",
    "directory": "packages/blueprint"
  },
  "bugs": {
    "url": "https://github.com/nsreehari/generative-interaction-kernel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./worker/in-memory": {
      "types": "./dist/worker/in-memory.d.ts",
      "import": "./dist/worker/in-memory.js"
    },
    "./worker/indexed-db": {
      "types": "./dist/worker/indexed-db.d.ts",
      "import": "./dist/worker/indexed-db.js"
    },
    "./worker/filesystem-mcp": {
      "types": "./dist/worker/filesystem-mcp.d.ts",
      "import": "./dist/worker/filesystem-mcp.js"
    },
    "./worker/azure": {
      "types": "./dist/worker/azure.d.ts",
      "import": "./dist/worker/azure.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@gik/durable-runtime": "0.8.0",
    "@gik/evaluators": "0.1.1",
    "@gik/kernel": "0.1.1"
  },
  "scripts": {
    "build": "tsup src/index.ts src/worker.ts src/worker/in-memory.ts src/worker/indexed-db.ts src/worker/filesystem-mcp.ts src/worker/azure.ts --format esm --dts --sourcemap --minify --clean --external @gik/kernel --external @gik/evaluators --external @gik/durable-runtime --tsconfig tsconfig.json",
    "prepack": "node ../../scripts/sync-public-docs.mjs packages/blueprint"
  }
}