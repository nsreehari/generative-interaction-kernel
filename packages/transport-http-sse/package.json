{
  "name": "@gik/transport-http-sse",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/codec.ts src/server.ts --format esm --dts --sourcemap --clean --tsconfig tsconfig.json",
    "prepack": "node ../../scripts/sync-public-docs.mjs packages/transport-http-sse"
  }
}
