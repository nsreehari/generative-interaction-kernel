{
  "name": "gik-transport-http-sse",
  "version": "0.1.2",
  "description": "HTTP + Server-Sent Events transport for GIK projections.",
  "license": "MIT",
  "author": "nsreehari",
  "keywords": [
    "gik",
    "generative-ui",
    "declarative-ui",
    "transport",
    "http",
    "sse",
    "server"
  ],
  "homepage": "https://github.com/nsreehari/generative-interaction-kernel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsreehari/generative-interaction-kernel.git",
    "directory": "packages/transport-http-sse"
  },
  "bugs": {
    "url": "https://github.com/nsreehari/generative-interaction-kernel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "gik-kernel": "0.2.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/codec.ts src/server.ts --format esm --dts --sourcemap --minify --clean --tsconfig tsconfig.json",
    "prepack": "node ../../scripts/sync-package-license.mjs packages/transport-http-sse"
  }
}
