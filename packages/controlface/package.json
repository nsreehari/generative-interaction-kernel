{
  "name": "@gik/controlface",
  "version": "0.1.4",
  "description": "Control-plane projection surface (full capability catalog) for the Generative Interaction Kernel.",
  "license": "MIT",
  "author": "nsreehari",
  "keywords": [
    "gik",
    "generative-ui",
    "declarative-ui",
    "reactive",
    "control-plane",
    "projection",
    "face"
  ],
  "homepage": "https://github.com/nsreehari/generative-interaction-kernel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsreehari/generative-interaction-kernel.git",
    "directory": "packages/controlface"
  },
  "bugs": {
    "url": "https://github.com/nsreehari/generative-interaction-kernel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blueprint": {
      "types": "./dist/blueprint.d.ts",
      "import": "./dist/blueprint.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@gik/blueprint": "0.1.2",
    "@gik/evaluators": "0.1.1",
    "@gik/kernel": "0.1.1"
  },
  "scripts": {
    "build": "tsup src/index.ts src/blueprint.ts --format esm --dts --sourcemap --minify --clean --tsconfig tsconfig.json",
    "prepack": "node ../../scripts/sync-public-docs.mjs packages/controlface"
  }
}
