{
  "name": "@gik/react",
  "version": "0.3.1-next.0",
  "description": "React renderer and in-memory Blueprint host for the Generative Interaction Kernel.",
  "license": "MIT",
  "author": "nsreehari",
  "keywords": [
    "gik",
    "generative-ui",
    "declarative-ui",
    "reactive",
    "react",
    "renderer",
    "adapter"
  ],
  "homepage": "https://github.com/nsreehari/generative-interaction-kernel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsreehari/generative-interaction-kernel.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/nsreehari/generative-interaction-kernel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable": {
      "types": "./dist/durable.d.ts",
      "import": "./dist/durable.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@gik/blueprint": "0.2.1-next.0",
    "@gik/durable-runtime": "0.8.1-next.0",
    "@gik/kernel": "0.1.2-next.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/durable.ts --format esm --dts --sourcemap --minify --clean --tsconfig tsconfig.json",
    "prepack": "node ../../scripts/sync-package-license.mjs packages/react"
  }
}
