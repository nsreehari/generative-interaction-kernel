{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/blueprint.schema.json",
  "title": "GIK Blueprint",
  "description": "A self-contained authored organism definition with Cells, presentation, services, and runtime contract.",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "blueprint" },
    "payload": {
      "type": "object",
      "required": ["id", "kind", "version", "serviceTiers", "serviceRecipes", "projectionTiers", "projectionRecipes", "runtime"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "structureMode": {
          "type": "string",
          "enum": ["fixed", "reconfigurable", "adaptive"],
          "default": "fixed",
          "description": "Blueprint semantic policy governing whether authored structure may change."
        },
        "structurePolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedBlueprintOperations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["addCell", "replaceCell", "removeCell", "setPresentation"]
              }
            },
            "allowedProgramOperations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["mutateGraph", "setGraph", "removeGraph", "setRoot", "removeRoot", "upsertHandler", "removeHandler", "upsertMachine", "removeMachine", "upsertDerivation", "removeDerivation"]
              }
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/interfacePort" }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/interfacePort" }
            },
            "events": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "serviceTiers": {
          "description": "The service (implementation) axis' authored tiers, resolved independently of the projection axis.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/tier.schema.json" }
        },
        "serviceRecipes": {
          "description": "The service axis' tier transitions. Empty means the axis declares exactly one terminal tier.",
          "type": "array",
          "items": { "$ref": "https://genui.dev/schemas/lowering-recipe.schema.json#/definitions/serviceRecipe" }
        },
        "projectionTiers": {
          "description": "The projection (presentation) axis' authored tiers, resolved independently of the service axis.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/tier.schema.json" }
        },
        "projectionRecipes": {
          "description": "The projection axis' tier transitions. Empty means the axis declares exactly one terminal tier.",
          "type": "array",
          "items": { "$ref": "https://genui.dev/schemas/lowering-recipe.schema.json#/definitions/projectionRecipe" }
        },
        "cells": {
          "type": "object",
          "additionalProperties": { "$ref": "https://genui.dev/schemas/cell.schema.json" }
        },
        "presentation": {
          "type": "object",
          "required": ["slots", "root"],
          "additionalProperties": false,
          "description": "A closed set of named slots plus a root. Presentation has no knowledge of Cells — attachment is self-declared by whatever attaches (a slot's own `region`, or a Cell view's own `region`).",
          "properties": {
            "slots": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/presentationSlot" }
            },
            "root": { "type": "string", "minLength": 1 },
            "allowedCapabilities": {
              "description": "A closed vocabulary of capability names any view/decoration in this Blueprint may use. Absent means open; present makes it an enforced closed set.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "layout": {
              "description": "Optional arrangement for named slots' own children, keyed by slot id. A slot absent from this map renders as a plain Fragment (no DOM wrapper, no arrangement).",
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/presentationSlotLayout" }
            }
          }
        },
        "contextFormSpec": {
          "$ref": "https://gik.dev/schemas/ui-form.schema.json#/definitions/formSpec"
        },
        "services": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/serviceDeclaration" }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "externals": { "type": "object" },
            "state": { "type": "object" }
          }
        },
        "metadata": { "type": "object" }
      }
    }
  },
  "definitions": {
    "presentationSlot": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "region": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "presentationSlotLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "enum": ["row", "row-reverse", "column", "column-reverse"] },
        "gap": { "enum": ["none", "xs", "s", "m", "l", "xl"] },
        "align": { "enum": ["stretch", "start", "center", "end", "baseline"] },
        "justify": { "enum": ["start", "center", "end", "space-between", "space-around", "space-evenly"] },
        "wrap": { "type": "boolean" }
      }
    },
    "interfacePort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "object" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "from": { "type": "string", "minLength": 1 }
      }
    },
    "serviceDeclaration": {
      "description": "One entry in `services`: a provider/kind (or nested-Blueprint) binding plus the named operations it exposes. Kind-specific settings (`config`) and per-operation request/response/settlement/validator content are deliberately left open here -- they vary per service kind and are not part of the cross-package structural contract.",
      "type": "object",
      "required": ["version", "operations"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "operations": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/serviceOperationDeclaration" }
        },
        "scope": { "enum": ["per-invocation", "per-cell", "per-blueprint", "per-session"] },
        "kind": { "type": "string", "minLength": 1 },
        "config": { "type": "object" },
        "blueprint": {
          "type": "object",
          "required": ["$ref"],
          "additionalProperties": false,
          "properties": { "$ref": { "type": "string", "minLength": 1 } }
        }
      },
      "oneOf": [
        { "required": ["kind"], "not": { "required": ["blueprint"] } },
        { "required": ["blueprint"], "not": { "required": ["kind"] } }
      ]
    },
    "serviceOperationDeclaration": {
      "description": "One named operation inside a service's `operations` map. Only the provider-native `operation` name and `contract` id are structurally required; request/response/settlement/subject/onViolation are otherwise left open (provider-specific transforms and policy content) except each stage's own `validators`, which is always the shared GuardrailRule vocabulary and is structurally validated here regardless of provider.",
      "type": "object",
      "required": ["operation", "contract"],
      "additionalProperties": false,
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["immediate", "queued"] },
        "subject": { "type": "object" },
        "request": { "$ref": "#/definitions/serviceDataStage" },
        "response": { "$ref": "#/definitions/serviceDataStage" },
        "settlement": { "type": "object" },
        "failureSettlement": { "type": "object" },
        "onViolation": { "type": "object" }
      }
    },
    "serviceDataStage": {
      "type": "object",
      "properties": {
        "validators": {
          "type": "array",
          "items": { "$ref": "https://gik.dev/schemas/ui-form.schema.json#/definitions/validator" }
        }
      }
    }
  }
}