{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/blueprint.schema.json",
  "title": "GIK Blueprint",
  "description": "A self-contained authored organism definition with Cells, relationships, projections, services, and runtime contract.",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "blueprint" },
    "payload": {
      "type": "object",
      "required": ["id", "kind", "version", "tiers", "recipes", "runtime"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "structureMode": {
          "type": "string",
          "enum": ["fixed", "reconfigurable", "adaptive"],
          "default": "fixed",
          "description": "Blueprint semantic policy governing whether authored structure may change."
        },
        "structurePolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedBlueprintOperations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["addCell", "replaceCell", "removeCell", "setRelationship", "removeRelationship", "setProjection", "removeProjection"]
              }
            },
            "allowedProgramOperations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["mutateGraph", "setGraph", "removeGraph", "setRoot", "removeRoot", "upsertHandler", "removeHandler", "upsertMachine", "removeMachine", "upsertDerivation", "removeDerivation"]
              }
            }
          }
        },
        "agentLifecycle": {
          "type": "object",
          "required": ["profiles"],
          "additionalProperties": false,
          "properties": {
            "profiles": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "use": { "$ref": "#/definitions/agentLifecycleProfile" },
                "customize": { "$ref": "#/definitions/agentLifecycleProfile" },
                "author": { "$ref": "#/definitions/agentLifecycleProfile" }
              }
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/interfacePort" }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/interfacePort" }
            },
            "events": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/tier.schema.json" }
        },
        "recipes": {
          "type": "array",
          "items": { "$ref": "https://genui.dev/schemas/lowering-recipe.schema.json#/definitions/loweringRecipe" }
        },
        "cells": {
          "type": "object",
          "additionalProperties": { "$ref": "https://genui.dev/schemas/cell.schema.json" }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["kind", "participants"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "participants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "configuration": {},
              "metadata": { "type": "object" }
            }
          }
        },
        "projections": {
          "type": "object",
          "properties": {
            "presentation": {
              "type": "object",
              "required": ["roots"],
              "additionalProperties": false,
              "properties": {
                "roots": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "placements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["cell"],
                    "additionalProperties": false,
                    "properties": {
                      "cell": { "type": "string", "minLength": 1 },
                      "parent": { "type": "string", "minLength": 1 },
                      "slot": { "type": "string", "minLength": 1 },
                      "order": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "additionalProperties": { "type": "object" }
        },
        "context": { "type": "object" },
        "contextFormSpec": {
          "$ref": "https://gik.dev/schemas/ui-form.schema.json#/definitions/formSpec"
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "object", "required": ["inline"], "additionalProperties": false, "properties": { "inline": {} } },
              { "type": "object", "required": ["$ref"], "additionalProperties": false, "properties": { "$ref": { "type": "string", "minLength": 1 } } }
            ]
          }
        },
        "services": { "type": "object" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "expression": { "type": "string" },
            "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "contexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "capabilities": { "type": "object" },
            "externals": { "type": "object" },
            "state": { "type": "object" }
          }
        },
        "metadata": { "type": "object" }
      }
    }
  },
  "definitions": {
    "interfacePort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "object" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "from": { "type": "string", "minLength": 1 }
      }
    },
    "agentLifecycleProfile": {
      "type": "object",
      "required": ["id", "version", "description", "targetKinds", "intentKinds"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "targetKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "intentKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "goals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "operationPreset": {
          "enum": ["standard", "static-authoring"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["discover", "describe", "inspect", "validate", "simulate", "preflight", "read_in_progress_proposal", "set_in_progress_proposal"]
          }
        }
      },
      "oneOf": [
        { "required": ["operationPreset"] },
        { "required": ["operations"] }
      ]
    }
  }
}