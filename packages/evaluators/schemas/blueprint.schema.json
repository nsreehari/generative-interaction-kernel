{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/blueprint.schema.json",
  "title": "GIK Blueprint",
  "description": "A self-contained authored organism definition with Cells, presentation, services, and runtime contract.",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "blueprint" },
    "payload": {
      "type": "object",
      "required": ["id", "kind", "version", "tiers", "recipes", "runtime"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "structureMode": {
          "type": "string",
          "enum": ["fixed", "reconfigurable", "adaptive"],
          "default": "fixed",
          "description": "Blueprint semantic policy governing whether authored structure may change."
        },
        "structurePolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedBlueprintOperations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["addCell", "replaceCell", "removeCell", "setPresentation"]
              }
            },
            "allowedProgramOperations": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": ["mutateGraph", "setGraph", "removeGraph", "setRoot", "removeRoot", "upsertHandler", "removeHandler", "upsertMachine", "removeMachine", "upsertDerivation", "removeDerivation"]
              }
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inputs": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/interfacePort" }
            },
            "outputs": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/interfacePort" }
            },
            "events": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/tier.schema.json" }
        },
        "recipes": {
          "type": "array",
          "items": { "$ref": "https://genui.dev/schemas/lowering-recipe.schema.json#/definitions/loweringRecipe" }
        },
        "cells": {
          "type": "object",
          "additionalProperties": { "$ref": "https://genui.dev/schemas/cell.schema.json" }
        },
        "presentation": {
          "type": "object",
          "required": ["slots", "root"],
          "additionalProperties": false,
          "description": "A closed set of named slots plus a root. Presentation has no knowledge of Cells — attachment is self-declared by whatever attaches (a slot's own `region`, or a Cell view's own `region`).",
          "properties": {
            "slots": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  {
                    "type": "object",
                    "required": ["id"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "region": { "type": "string", "minLength": 1 }
                    }
                  }
                ]
              }
            },
            "root": { "type": "string", "minLength": 1 }
          }
        },
        "contextFormSpec": {
          "$ref": "https://gik.dev/schemas/ui-form.schema.json#/definitions/formSpec"
        },
        "services": { "type": "object" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "expression": { "type": "string" },
            "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "contexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "capabilities": { "type": "object" },
            "externals": { "type": "object" },
            "state": { "type": "object" }
          }
        },
        "metadata": { "type": "object" }
      }
    }
  },
  "definitions": {
    "interfacePort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "object" },
        "required": { "type": "boolean" },
        "description": { "type": "string" },
        "from": { "type": "string", "minLength": 1 }
      }
    }
  }
}