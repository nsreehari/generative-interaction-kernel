{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/gik/0.1/program.schema.json",
  "title": "GIK program message",
  "description": "An executable program definition with optional projection, event handlers, machines, and derivations. Valid only against a declared vocabulary version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gik", "type", "payload"],
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "program" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["graph"] },
        { "required": ["root"] },
        { "required": ["handlers"] },
        { "required": ["machines"] },
        { "required": ["derivations"] }
      ],
      "properties": {
        "vocabulary": {
          "type": "string",
          "description": "Vocabulary version this program targets."
        },
        "graph": { "$ref": "#/definitions/programGraph" },
        "root": { "$ref": "#/definitions/node" },
        "handlers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/runtimeHandler" }
        },
        "machines": {
          "type": "array",
          "items": { "$ref": "#/definitions/machine" }
        },
        "derivations": {
          "type": "array",
          "items": { "$ref": "#/definitions/derivation" }
        }
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "capabilityRef": {
      "type": "string",
      "description": "A capability reference: a bare name, or a namespaced `alias:name` resolved through the vocabulary's externals.projectionViews.",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(:[A-Za-z_][A-Za-z0-9_-]*)?$"
    },
    "nsPath": {
      "type": "string",
      "description": "A dotted namespace path, e.g. card_data.selected.",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
    },
    "expr": {
      "type": "string",
      "description": "An opaque expression in the vocabulary-declared dialect."
    },
    "portToken": {
      "type": "string",
      "description": "A program-level dataflow token. Tokens may be dormant or participate in feedback cycles.",
      "minLength": 1
    },
    "portDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["value", "signal", "stream"] },
        "producers": { "enum": ["single", "many"] }
      }
    },
    "inputPort": {
      "oneOf": [
        { "$ref": "#/definitions/portToken" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["token"],
          "properties": {
            "token": { "$ref": "#/definitions/portToken" },
            "optional": { "type": "boolean" }
          }
        }
      ]
    },
    "outputPort": {
      "oneOf": [
        { "$ref": "#/definitions/portToken" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["token"],
          "properties": {
            "token": { "$ref": "#/definitions/portToken" },
            "mode": { "enum": ["value", "signal", "stream"] }
          }
        }
      ]
    },
    "nodeTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["startup"],
          "properties": { "startup": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event"],
          "properties": {
            "event": { "$ref": "#/definitions/identifier" },
            "node": { "$ref": "#/definitions/identifier" }
          }
        }
      ]
    },
    "computeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "expression"],
      "properties": {
        "kind": { "const": "compute" },
        "expression": { "$ref": "#/definitions/expr" }
      }
    },
    "actionsOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "actions"],
      "properties": {
        "kind": { "const": "actions" },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } }
      }
    },
    "invokeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "tool"],
      "properties": {
        "kind": { "const": "invoke" },
        "tool": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/expr" }
        }
      }
    },
    "decisionCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when"],
      "properties": {
        "when": { "$ref": "#/definitions/expr" },
        "outputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/expr" }
        }
      }
    },
    "decisionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cases"],
      "properties": {
        "kind": { "const": "decision" },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/decisionCase" }
        }
      }
    },
    "extensionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": { "const": "extension" },
        "name": { "type": "string", "minLength": 1 },
        "config": {}
      }
    },
    "programNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/inputPort" }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/outputPort" }
        },
        "trigger": { "$ref": "#/definitions/nodeTrigger" },
        "when": { "$ref": "#/definitions/expr" },
        "operation": {
          "oneOf": [
            { "$ref": "#/definitions/computeOperation" },
            { "$ref": "#/definitions/actionsOperation" },
            { "$ref": "#/definitions/invokeOperation" },
            { "$ref": "#/definitions/decisionOperation" },
            { "$ref": "#/definitions/extensionOperation" }
          ]
        }
      }
    },
    "programGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes"],
      "properties": {
        "inputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/portToken" } },
        "outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/portToken" } },
        "ports": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/portDefinition" }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/programNode" }
        }
      }
    },
    "action": {
      "oneOf": [
        { "$ref": "#/definitions/assignAction" },
        { "$ref": "#/definitions/emitAction" },
        { "$ref": "#/definitions/invokeAction" },
        { "$ref": "#/definitions/routeAction" },
        { "$ref": "#/definitions/requestAction" }
      ]
    },
    "assignAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "target", "args"],
      "properties": {
        "do": { "const": "assign" },
        "target": { "$ref": "#/definitions/nsPath" },
        "args": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": { "value": {} }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from"],
              "properties": { "from": { "$ref": "#/definitions/expr" } }
            }
          ]
        },
        "guard": { "$ref": "#/definitions/expr" }
      }
    },
    "emitAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "event"],
      "properties": {
        "do": { "const": "emit" },
        "event": { "$ref": "#/definitions/identifier" },
        "data": { "type": "object" },
        "guard": { "$ref": "#/definitions/expr" }
      }
    },
    "invokeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "control"],
      "properties": {
        "do": { "const": "invoke" },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "serviceRef": { "type": "string", "minLength": 1 },
            "responseSchema": { "type": "object" },
            "sourceId": { "type": "string", "minLength": 1 },
            "sourceCellId": { "type": "string", "minLength": 1 },
            "sourceRequestToken": { "type": "string", "minLength": 1 },
            "sourceInputs": { "type": "object" },
            "sourceInputTransform": { "type": "object" },
            "sourceOutputTransform": { "type": "object" }
          }
        },
        "data": { "type": "object" },
        "guard": { "$ref": "#/definitions/expr" }
      }
    },
    "routeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "control"],
      "properties": {
        "do": { "const": "route" },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["to"],
          "properties": { "to": {} }
        },
        "data": { "type": "object" },
        "guard": { "$ref": "#/definitions/expr" }
      }
    },
    "requestAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do", "control", "data"],
      "properties": {
        "do": { "const": "request" },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "responseSchema"],
          "properties": {
            "kind": { "enum": ["decision", "clarification", "data"] },
            "responseSchema": { "type": "object" },
            "policy": { "type": "string", "minLength": 1 },
            "timeoutMs": { "type": "number", "minimum": 0 }
          }
        },
        "data": { "type": "object" },
        "guard": { "$ref": "#/definitions/expr" }
      }
    },
    "runtimeHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "on"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "on": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/action" }
          }
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "expression", "dependencies"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "target": { "$ref": "#/definitions/nsPath" },
        "expression": { "$ref": "#/definitions/expr" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nsPath" }
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "object",
          "description": "prop -> namespace path (data in).",
          "additionalProperties": { "$ref": "#/definitions/nsPath" }
        },
        "readExpr": {
          "type": "object",
          "description": "prop -> expression evaluated against state (data in, shaped).",
          "additionalProperties": { "$ref": "#/definitions/expr" }
        },
        "gate": { "$ref": "#/definitions/expr" },
        "write": {
          "type": "object",
          "description": "event -> { to: namespace path } (data out).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to"],
            "properties": { "to": { "$ref": "#/definitions/nsPath" } }
          }
        },
        "on": {
          "type": "object",
          "description": "event -> ordered list of actions (behavior).",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/action" }
          }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "id"],
      "properties": {
        "capability": { "$ref": "#/definitions/capabilityRef" },
        "id": { "$ref": "#/definitions/identifier" },
        "props": { "type": "object" },
        "edges": { "$ref": "#/definitions/edges" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/definitions/identifier" },
        "guard": { "$ref": "#/definitions/expr" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "object",
          "description": "event -> target state name (shorthand) or a full transition.",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/definitions/identifier" },
              { "$ref": "#/definitions/transition" }
            ]
          }
        },
        "entry": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "exit": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "type": { "enum": ["final"] }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "context", "initial", "states"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "context": {
          "$ref": "#/definitions/nsPath",
          "description": "Namespace path where the machine's current state is stored."
        },
        "initial": { "$ref": "#/definitions/identifier" },
        "states": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/state" }
        }
      }
    }
  }
}
