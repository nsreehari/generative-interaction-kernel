{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/gik/0.1/trace.schema.json",
  "title": "GIK trace message",
  "description": "An observability event emitted by the kernel to an ObservabilitySink.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gik", "type", "payload"],
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "trace" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": {
          "enum": ["resolve", "fallback", "action", "transition", "validate"]
        },
        "node": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
        },
        "detail": { "type": "object" },
        "ts": {
          "type": "number",
          "description": "Epoch milliseconds."
        }
      }
    }
  }
}
