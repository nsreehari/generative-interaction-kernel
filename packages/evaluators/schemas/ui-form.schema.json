{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gik.dev/schemas/ui-form.schema.json",
  "title": "primitive:form props",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "fields": { "$ref": "#/definitions/formSchema" },
    "schema": { "$ref": "#/definitions/formSchema" },
    "value": { "type": "object" },
    "data": { "type": "object" },
    "saveLabel": { "type": "string" },
    "discardLabel": { "type": "string" }
  },
  "definitions": {
    "formSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields"],
      "properties": {
        "fields": { "$ref": "#/definitions/formSchema" },
        "initialValue": { "type": "object" },
        "saveLabel": { "type": "string" },
        "discardLabel": { "type": "string" }
      }
    },
    "formSchema": {
      "type": "object",
      "additionalProperties": true,
      "required": ["properties"],
      "properties": {
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/definitions/field" }
        },
        "required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "validators": {
          "type": "array",
          "items": { "$ref": "#/definitions/validator" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "type": { "enum": ["string", "number", "integer", "boolean", "array", "json"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "hint": { "type": "string" },
        "format": { "type": "string" },
        "placeholder": { "type": "string" },
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true },
        "enumNames": { "type": "array", "items": { "type": "string" } },
        "oneOf": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["const"],
            "properties": {
              "const": {},
              "title": { "type": "string" }
            }
          }
        },
        "options": { "type": "array", "minItems": 1 },
        "items": { "type": "object" },
        "readOnly": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "multiline": { "type": "boolean" },
        "rows": { "type": ["number", "string"] },
        "colSpan": { "type": "number", "minimum": 1, "maximum": 12 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minLength": { "type": "number", "minimum": 0 },
        "maxLength": { "type": "number", "minimum": 0 },
        "pattern": { "type": "string" },
        "default": {},
        "secret": { "type": "boolean" },
        "span": { "type": "number", "minimum": 1, "maximum": 12 }
      }
    },
    "validator": {
      "description": "The canonical structural schema for @gik/kernel's `GuardrailRule` vocabulary -- shared verbatim (by cross-file $ref) with cell.schema.json's `sources[*].acceptanceCriteria` and blueprint.schema.json's `request`/`response` operation validators, so a malformed rule is rejected at authoring-time everywhere this vocabulary is used, not just here.",
      "oneOf": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": [{ "type": "string", "minLength": 1 }, { "type": "string" }]
        },
        {
          "type": "object",
          "required": ["expr"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "jsonata" },
            "expr": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "level": { "enum": ["error", "warning"] },
            "code": { "type": "string" },
            "node": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "schema"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "ajv-schema" },
            "schema": { "type": "object" },
            "refs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["schema"],
                "additionalProperties": false,
                "properties": {
                  "schema": { "type": "object" },
                  "key": { "type": "string" }
                }
              }
            },
            "message": { "type": "string" },
            "level": { "enum": ["error", "warning"] },
            "code": { "type": "string" },
            "node": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "jsonata-expression" },
            "mode": { "enum": ["full", "safe"] },
            "message": { "type": "string" },
            "level": { "enum": ["error", "warning"] },
            "code": { "type": "string" },
            "node": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "type"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "typedef" },
            "type": {
              "oneOf": [
                { "$ref": "#/definitions/declarativeType" },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "$ref": "#/definitions/declarativeType" }
                }
              ]
            },
            "message": { "type": "string" },
            "level": { "enum": ["error", "warning"] },
            "code": { "type": "string" },
            "node": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": ["blueprint-cell", "blueprint-tier", "blueprint-service-recipe", "blueprint-projection-recipe", "blueprint"]
            },
            "message": { "type": "string" },
            "level": { "enum": ["error", "warning"] },
            "code": { "type": "string" },
            "node": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "blueprint-capability-acceptance" },
            "acceptedField": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "level": { "enum": ["error", "warning"] },
            "code": { "type": "string" },
            "node": { "type": "string" }
          }
        }
      ]
    },
    "declarativeType": {
      "enum": ["json", "object", "array", "string", "number", "integer", "boolean", "null"]
    }
  }
}
