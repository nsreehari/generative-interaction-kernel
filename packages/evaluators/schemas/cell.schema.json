{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/cell.schema.json",
  "title": "GIK Cell",
  "description": "An independently addressable participant in a Blueprint.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "minLength": 1 },
          "as": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "cardinality": { "enum": ["one", "many"] },
          "schema": { "type": "object" }
        }
      }
    },
    "systemInputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/systemInputToken" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "service", "operation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": { "type": "array" },
          "when": { "type": "string", "minLength": 1 },
          "input": { "$ref": "#/definitions/transform" },
          "output": { "$ref": "#/definitions/transform" }
        }
      }
    },
    "compute": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expression", "assign"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expression": { "type": "string", "minLength": 1 },
          "assign": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "schema": { "type": "object" }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["payloadSchema"],
        "additionalProperties": false,
        "properties": {
          "payloadSchema": { "type": "object" },
          "description": { "type": "string" }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "https://genui.dev/gik/0.1/program.schema.json#/definitions/action" }
          }
        }
      }
    },
    "potentialViews": {
      "description": "Zero, one, or many named external manifestations this Cell carries. Each one is dormant unless its own declared region is reachable from the presentation active for the current materialization.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/view" }
    },
    "blueprint": {
      "description": "A child Blueprint whose live instance is represented by this Cell.",
      "oneOf": [
        {
          "type": "object",
          "required": ["$ref"],
          "additionalProperties": false,
          "properties": {
            "$ref": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "string", "minLength": 1 },
                    "expression": { "type": "string", "minLength": 1 }
                  },
                  "oneOf": [
                    { "required": ["from"] },
                    { "required": ["expression"] }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["inline"],
          "additionalProperties": false,
          "properties": { "inline": { "$ref": "https://genui.dev/schemas/blueprint.schema.json" } }
        }
      ]
    }
  },
  "definitions": {
    "systemInputToken": {
      "enum": ["numSourcesRunning"]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "expression": { "type": "string", "minLength": 1 }
            },
            "oneOf": [
              { "required": ["from"] },
              { "required": ["expression"] }
            ]
          }
        },
        "visibility": { "type": "string", "minLength": 1 },
        "before": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/viewDecoration" }
        },
        "after": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/viewDecoration" }
        },
        "region": {
          "description": "Which presentation slot(s) this view attaches to. An array renders one independent instance per slot, all through this same Cell.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        }
      }
    },
    "viewDecoration": {
      "type": "object",
      "required": ["capability"],
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "expression": { "type": "string", "minLength": 1 }
            },
            "oneOf": [
              { "required": ["from"] },
              { "required": ["expression"] }
            ]
          }
        },
        "visibility": { "type": "string", "minLength": 1 }
      }
    },
    "transform": {
      "type": "object",
      "required": ["kind", "expr"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "jsonata" },
        "expr": { "type": "string", "minLength": 1 }
      }
    }
  }
}
