{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/cell.schema.json",
  "title": "GIK Cell",
  "description": "An independently addressable participant in a Blueprint.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "dpp": {
      "type": "object",
      "required": ["manifest", "context"],
      "additionalProperties": false,
      "properties": {
        "manifest": { "$ref": "#/definitions/dppManifest" },
        "context": {
          "type": "object",
          "required": ["sources"],
          "additionalProperties": false,
          "properties": {
            "sources": {
              "allOf": [
                { "$ref": "#/properties/sources" },
                { "minItems": 2 }
              ]
            },
            "senses": { "$ref": "#/properties/senses" }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "minLength": 1 },
          "as": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "cardinality": { "enum": ["one", "many"] },
          "schema": { "type": "object" }
        }
      }
    },
    "systemInputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/systemInputToken" }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "service", "operation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "acceptanceCriteria": {
            "type": "array",
            "items": { "$ref": "https://gik.dev/schemas/ui-form.schema.json#/definitions/validator" }
          },
          "when": { "type": "string", "minLength": 1 },
          "input": { "$ref": "#/definitions/transform" },
          "output": { "$ref": "#/definitions/transform" }
        }
      }
    },
    "senses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "service", "operation", "on"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "input": { "$ref": "#/definitions/transform" },
          "output": { "$ref": "#/definitions/transform" },
          "on": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "compute": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expression", "assign"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expression": { "type": "string", "minLength": 1 },
          "assign": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "schema": { "type": "object" }
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["payloadSchema"],
        "additionalProperties": false,
        "properties": {
          "payloadSchema": { "type": "object" },
          "description": { "type": "string" }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "https://genui.dev/gik/0.1/program.schema.json#/definitions/action" }
          }
        }
      }
    },
    "potentialViews": {
      "description": "Zero, one, or many named external manifestations this Cell carries. Each one is dormant unless its own declared region is reachable from the presentation active for the current materialization.",
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/view" }
    },
    "blueprint": {
      "description": "A child Blueprint whose live instance is represented by this Cell.",
      "oneOf": [
        {
          "type": "object",
          "required": ["$ref"],
          "additionalProperties": false,
          "properties": {
            "$ref": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "string", "minLength": 1 },
                    "expression": { "type": "string", "minLength": 1 }
                  },
                  "oneOf": [
                    { "required": ["from"] },
                    { "required": ["expression"] }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["inline"],
          "additionalProperties": false,
          "properties": { "inline": { "$ref": "https://genui.dev/schemas/blueprint.schema.json" } }
        }
      ]
    }
  },
  "definitions": {
    "dppManifest": {
      "type": "object",
      "required": ["manifest-version", "participant", "durable-charter", "evolving-working-model", "context-store"],
      "properties": {
        "manifest-version": { "type": "string", "minLength": 1 },
        "participant": {
          "type": "object",
          "required": ["stable-id", "human-readable-name"],
          "properties": {
            "stable-id": { "type": "string", "minLength": 1 },
            "human-readable-name": { "type": "string", "minLength": 1 }
          }
        },
        "durable-charter": {
          "type": "object",
          "required": ["identity-and-viability", "value-creation", "participation", "authority-and-boundaries", "steward"],
          "properties": {
            "identity-and-viability": {
              "type": "object",
              "required": ["why-this-participant-exists", "what-must-remain-true-for-it-to-remain-this-participant"],
              "properties": {
                "why-this-participant-exists": { "type": "string", "minLength": 1 },
                "what-must-remain-true-for-it-to-remain-this-participant": { "type": "string", "minLength": 1 }
              }
            },
            "value-creation": {
              "type": "object",
              "required": ["beneficial-change-it-exists-to-create", "who-benefits-from-that-change"],
              "properties": {
                "beneficial-change-it-exists-to-create": { "type": "string", "minLength": 1 },
                "who-benefits-from-that-change": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              }
            },
            "participation": {
              "type": "object",
              "required": ["relationships"],
              "properties": { "relationships": { "type": "array", "items": { "type": "object" } } }
            },
            "authority-and-boundaries": {
              "type": "object",
              "required": ["what-it-may-adapt-within-this-charter", "what-it-may-do-without-asking", "what-requires-human-decision", "what-it-must-never-do"],
              "additionalProperties": { "type": "array", "items": { "type": "string" } }
            },
            "steward": {
              "type": "object",
              "required": ["responsibility", "permitted-services-and-tools", "evidence-and-decision-recording"],
              "properties": {
                "responsibility": { "type": "string", "minLength": 1 },
                "permitted-services-and-tools": { "type": "array", "items": { "type": "string" } },
                "evidence-and-decision-recording": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "evolving-working-model": {
          "type": "object",
          "required": ["currency-hypotheses", "viability-tensions", "current-strategy-and-priorities", "operating-rhythm", "learned-context-references"],
          "properties": {
            "currency-hypotheses": { "type": "object" },
            "viability-tensions": { "type": "array", "items": { "type": "string" } },
            "current-strategy-and-priorities": { "type": "object" },
            "operating-rhythm": { "type": "object" },
            "learned-context-references": { "type": "array", "items": { "type": "string" } }
          }
        },
        "context-store": {
          "type": "object",
          "required": ["query", "ingest"],
          "properties": {
            "query": { "type": "string", "minLength": 1 },
            "ingest": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "systemInputToken": {
      "enum": ["numSourcesRunning", "sourceErrors"]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "expression": { "type": "string", "minLength": 1 }
            },
            "oneOf": [
              { "required": ["from"] },
              { "required": ["expression"] }
            ]
          }
        },
        "visibility": { "type": "string", "minLength": 1 },
        "before": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/viewDecoration" }
        },
        "after": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/viewDecoration" }
        },
        "wrap": {
          "description": "Layers this view's primary capability nests inside, outermost first (the primary is always innermost) -- a genuine child in the rendered tree, unlike the flat before/after siblings.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/viewDecoration" }
        },
        "region": {
          "description": "Which presentation slot(s) this view attaches to. An array renders one independent instance per slot, all through this same Cell.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        }
      }
    },
    "viewDecoration": {
      "type": "object",
      "required": ["capability"],
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "expression": { "type": "string", "minLength": 1 }
            },
            "oneOf": [
              { "required": ["from"] },
              { "required": ["expression"] }
            ]
          }
        },
        "visibility": { "type": "string", "minLength": 1 }
      }
    },
    "transform": {
      "type": "object",
      "required": ["kind", "expr"],
      "additionalProperties": false,
      "properties": {
        "kind": { "const": "jsonata" },
        "expr": { "type": "string", "minLength": 1 }
      }
    }
  }
}
