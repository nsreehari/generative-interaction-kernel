{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/lowering-recipe.schema.json",
  "title": "GIK Lowering Recipe",
  "description": "The two independent lowering-recipe dialects. A projection recipe owns representations + fallback; a service recipe owns implementationPrograms + fallback. There is no combined recipe.",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "lowering-recipe" },
    "payload": {
      "oneOf": [
        { "$ref": "#/definitions/serviceRecipe" },
        { "$ref": "#/definitions/projectionRecipe" }
      ]
    }
  },
  "definitions": {
    "projectionRecipe": {
      "description": "One projection-axis tier transition: selects named potential views and the presentation skeleton.",
      "type": "object",
      "required": ["id", "from", "to", "representations", "fallback"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "representations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/representation" }
        },
        "fallback": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      }
    },
    "serviceRecipe": {
      "description": "One service-axis tier transition: selects the contract-compatible Cell implementation seam (sources, compute, behavior, and service declarations).",
      "type": "object",
      "required": ["id", "from", "to", "implementationPrograms", "fallback"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "implementationPrograms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/implementationProgram" }
        },
        "fallback": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      }
    },
    "representation": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "extends": { "type": "string", "minLength": 1 },
        "views": {
          "description": "Per Cell, upserts one or more named potential views by name. A present entry replaces or introduces that one named view; every other view already declared on that Cell is left untouched.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "$ref": "https://genui.dev/schemas/cell.schema.json#/definitions/view" }
          }
        },
        "removeViews": {
          "description": "Per Cell, removes named potential views before this representation's view upserts are applied.",
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "decorators": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/representationDecorator" }
        },
        "presentation": { "$ref": "#/definitions/presentationDefinition" },
        "presentationAppend": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/presentationSlot" }
        }
      }
    },
    "representationDecorator": {
      "type": "object",
      "required": ["select"],
      "additionalProperties": false,
      "properties": {
        "select": { "type": "string", "minLength": 1 },
        "before": { "$ref": "https://genui.dev/schemas/cell.schema.json#/definitions/viewDecoration" },
        "after": { "$ref": "https://genui.dev/schemas/cell.schema.json#/definitions/viewDecoration" }
      },
      "anyOf": [
        { "required": ["before"] },
        { "required": ["after"] }
      ]
    },
    "implementationProgram": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "when": { "type": "string", "minLength": 1 },
        "cells": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/cellImplementationOverride" }
        },
        "services": {
          "type": "object",
          "additionalProperties": { "$ref": "https://genui.dev/schemas/blueprint.schema.json#/definitions/serviceDeclaration" }
        }
      }
    },
    "cellImplementationOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": { "$ref": "https://genui.dev/schemas/cell.schema.json#/properties/sources" },
        "compute": { "$ref": "https://genui.dev/schemas/cell.schema.json#/properties/compute" },
        "behavior": { "$ref": "https://genui.dev/schemas/cell.schema.json#/properties/behavior" }
      }
    },
    "presentationDefinition": {
      "type": "object",
      "required": ["slots", "root"],
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/presentationSlot" }
        },
        "root": { "type": "string", "minLength": 1 },
        "exportedRegions": {
          "description": "Host-addressable named regions this representation's presentation exports.",
          "type": "array",
          "items": {
            "$ref": "https://genui.dev/schemas/blueprint.schema.json#/definitions/presentationRegionExport"
          }
        },
        "layout": {
          "description": "Optional arrangement for named slots' own children, keyed by slot id.",
          "type": "object",
          "additionalProperties": {
            "$ref": "https://genui.dev/schemas/blueprint.schema.json#/definitions/presentationSlotLayout"
          }
        }
      }
    },
    "presentationSlot": {
      "$ref": "https://genui.dev/schemas/blueprint.schema.json#/definitions/presentationSlot"
    }
  }
}