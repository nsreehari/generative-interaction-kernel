{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/cell.schema.json",
  "title": "GIK Cell",
  "description": "An independently addressable participant in a Blueprint.",
  "type": "object",
  "required": ["id"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial": { "type": "object" },
        "schema": { "type": "object" },
        "persistence": { "enum": ["ephemeral", "checkpointed", "durable"] }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "minLength": 1 },
          "as": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "cardinality": { "enum": ["one", "many"] },
          "schema": { "type": "object" }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operation", "contract"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "service": { "type": "string", "minLength": 1 },
          "inline": { "type": "object" },
          "operation": { "type": "string", "minLength": 1 },
          "contract": { "type": "string", "minLength": 1 },
          "policyOverride": { "type": "object" },
          "when": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["service"], "not": { "required": ["inline"] } },
          { "required": ["inline"], "not": { "required": ["service"] } }
        ]
      }
    },
    "compute": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "expression", "assign", "dependencies"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expression": { "type": "string", "minLength": 1 },
          "assign": { "type": "string", "minLength": 1 },
          "dependencies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "when": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["token"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "schema": { "type": "object" }
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object", "required": ["do"] }
          }
        },
        "reactions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["when", "run"],
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string", "minLength": 1 },
              "runInitially": { "type": "boolean" },
              "run": { "type": "array", "items": { "type": "object", "required": ["do"] } }
            }
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "bindings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "from": { "type": "string", "minLength": 1 },
              "expression": { "type": "string", "minLength": 1 }
            },
            "oneOf": [
              { "required": ["from"] },
              { "required": ["expression"] }
            ]
          }
        },
        "visibility": { "type": "string", "minLength": 1 }
      }
    },
    "blueprint": {
      "description": "A child Blueprint whose live instance is represented by this Cell.",
      "oneOf": [
        {
          "type": "object",
          "required": ["$ref"],
          "additionalProperties": false,
          "properties": {
            "$ref": {
              "oneOf": [
                { "type": "string", "minLength": 1 },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "from": { "type": "string", "minLength": 1 },
                    "expression": { "type": "string", "minLength": 1 }
                  },
                  "oneOf": [
                    { "required": ["from"] },
                    { "required": ["expression"] }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["inline"],
          "additionalProperties": false,
          "properties": { "inline": { "$ref": "https://genui.dev/schemas/blueprint.schema.json" } }
        }
      ]
    }
  }
}
