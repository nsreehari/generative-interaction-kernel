{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/gik/0.1/vocabulary.schema.json",
  "title": "GIK vocabulary message",
  "description": "Publishes the capability vocabulary a domain speaks. Every other party (validator, renderer, orchestrator) validates against it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gik", "type", "payload"],
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "vocabulary" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "description": "The vocabulary version programs are validated against."
        },
        "expression": {
          "type": "string",
          "description": "Identifier of the expression dialect used by gate/derive/read (e.g. 'jsonata')."
        },
        "namespaces": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Declared namespace roots available in the Store."
        },
        "contexts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Namespace roots that are shared context rather than local state (ADR-0034): a host binds each to a shared StateModel, and read/assign/derive whose path targets one route to that shared store instead of local kernel state."
        },
        "actions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available action families: the six built-ins plus any declared custom actions.",
          "default": ["assign", "derive", "invoke", "emit", "route", "confirm"]
        },
        "capabilities": {
          "type": "object",
          "description": "Map of capability type -> descriptor.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "propsSchema": {
                "type": "object",
                "description": "JSON Schema for this capability's props."
              },
              "emits": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Event names this capability can emit."
              },
              "slots": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Structural slots (child regions) this capability accepts."
              },
              "dataProp": {
                "type": "string",
                "description": "Which prop receives bound data from a read edge (e.g. metric -> \"value\", table -> \"rows\"). Defaults to \"value\"."
              }
            }
          }
        },
        "externals": {
          "type": "object",
          "additionalProperties": false,
          "description": "The bundle's outward dependency contract: imported projection-view providers and required external effect handlers, grouped so a reader/agent can answer 'what does this bundle need from the host?' from one object.",
          "properties": {
            "projectionViews": {
              "type": "object",
              "description": "Alias -> projection-view provider binding. A capability is referenced as `alias:name` and resolved through this map; nothing (not even the floor) is ambient.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from"],
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "Provider name: 'floor', 'self', or another bundle's name."
                  },
                  "use": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Optional whitelist of capability names borrowed under this alias; omitted means the whole provider."
                  }
                }
              }
            },
            "effectHandlers": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Names of effect handlers the host must supply for this bundle's `invoke` actions."
            },
            "services": {
              "type": "object",
              "description": "Blueprint-owned service declarations. The operation-only shape remains accepted during migration.",
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["version", "operations"],
                    "properties": {
                      "version": { "type": "string", "minLength": 1 },
                      "operations": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["kind", "version", "operations"],
                    "properties": {
                      "kind": { "type": "string", "minLength": 1 },
                      "version": { "type": "string", "minLength": 1 },
                      "operations": {
                        "type": "array",
                        "minItems": 1,
                        "uniqueItems": true,
                        "items": { "type": "string", "minLength": 1 }
                      },
                      "config": {},
                      "scope": { "enum": ["per-invocation", "per-cell", "per-blueprint", "per-session"] }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["blueprint", "version", "operations"],
                    "properties": {
                      "blueprint": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["$ref"],
                        "properties": {
                          "$ref": { "type": "string", "pattern": "^blueprint:[A-Za-z0-9][A-Za-z0-9._/-]*(?:@[A-Za-z0-9][A-Za-z0-9.+-]*)?$" }
                        }
                      },
                      "version": { "type": "string", "minLength": 1 },
                      "operations": { "type": "object", "minProperties": 1 },
                      "scope": { "enum": ["per-invocation", "per-cell", "per-blueprint", "per-session"] }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
