{
  "gik": "0.1",
  "type": "lowering-recipe",
  "payload": {
    "id": "live-cards.presentation-to-runtime",
    "from": "presentation",
    "to": "runtime-document",
    "metadata": { "executor": "lower-document" },
    "program": [
      {
        "slot": "container",
        "match": {},
        "emit": {
          "capability": "ui:board",
          "props": {
            "title": "{{source.subject}}",
            "layout": "{{presentation.layout}}",
            "arrangement": "{{presentation.arrangement}}"
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "tasks" },
        "emit": { "capability": "ui:todo", "read": { "items": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "region": "relationships" },
        "emit": { "capability": "primitive:chart", "props": { "spec": { "kind": "bar", "fields": { "label": "label", "value": "value" } } }, "read": { "points": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "region": "context" },
        "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "region": "explanation" },
        "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "region": "content" },
        "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } }
      },
      {
        "slot": "region",
        "match": { "region": "detail" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "left" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "right" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "results" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "options" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "alerts" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      {
        "slot": "region",
        "match": { "region": "thread" },
        "emit": {
          "capability": "ui:table",
          "read": { "rows": "{{region.dataPath}}" },
          "on": {
            "rowSelect": [
              { "do": "assign", "target": "{{source.subject}}.selected", "args": { "from": "$event.id" } }
            ]
          }
        }
      },
      { "slot": "region", "match": { "role": "summary" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "metrics" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "status" }, "emit": { "capability": "ui:metric", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "narrative" }, "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "recommendation" }, "emit": { "capability": "ui:markdown", "read": { "value": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "collection" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "detail" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "timeline" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "comparison" }, "emit": { "capability": "ui:table", "read": { "rows": "{{region.dataPath}}" } } },
      { "slot": "region", "match": { "role": "actions" }, "emit": { "capability": "ui:actions" } },
      { "slot": "region", "match": { "role": "graph" }, "emit": { "capability": "primitive:chart", "props": { "spec": { "kind": "bar", "fields": { "label": "label", "value": "value" } } }, "read": { "points": "{{region.dataPath}}" } } },
      {
        "slot": "region",
        "match": {},
        "emit": {
          "props": {
            "label": "{{region.name}}",
            "priority": "{{region.priority}}",
            "disclosure": "{{region.disclosure}}",
            "presentation": "{{region.presentation}}"
          }
        }
      }
    ]
  }
}
