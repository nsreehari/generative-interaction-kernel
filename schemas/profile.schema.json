{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/profile.schema.json",
  "title": "GenUI Profile",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "profile" },
    "payload": {
      "type": "object",
      "required": ["id", "kind", "version", "layers", "recipes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile-template": { "type": "string", "minLength": 1 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/layer.schema.json" }
        },
        "recipes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 }
            }
          }
        },
        "context": {
          "type": "object"
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": ["inline"],
                "additionalProperties": false,
                "properties": { "inline": {} }
              },
              {
                "type": "object",
                "required": ["$ref"],
                "additionalProperties": false,
                "properties": { "$ref": { "type": "string", "minLength": 1 } }
              }
            ]
          }
        },
        "services": {
          "type": "object",
          "description": "Blueprint-owned service declarations. The operation-only shape remains accepted during migration.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "operations"],
                "properties": {
                  "version": { "type": "string", "minLength": 1 },
                  "operations": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "version", "operations"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "operations": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "config": {},
                  "scope": { "enum": ["per-invocation", "per-cell", "per-blueprint", "per-session"] },
                  "operationPolicies": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["guardrails"],
                      "properties": {
                        "guardrails": { "type": "array" },
                        "onViolation": { "type": "object" }
                      },
                      "additionalProperties": false
                    }
                  }
                }
              }
            ]
          }
        },
        "runtime": {
          "type": "object",
          "required": ["capabilities"],
          "additionalProperties": false,
          "properties": {
            "expression": { "type": "string" },
            "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "contexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "capabilities": { "type": "object" },
            "externals": {
              "type": "object",
              "properties": {
                "serviceBindings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["invoke", "use"],
                    "additionalProperties": false,
                    "properties": {
                      "invoke": { "type": "string", "minLength": 1 },
                      "use": {
                        "type": "object",
                        "required": ["service", "operation", "contract"],
                        "additionalProperties": false,
                        "properties": {
                          "service": { "type": "string", "minLength": 1 },
                          "operation": { "type": "string", "minLength": 1 },
                          "contract": { "type": "string", "minLength": 1 },
                          "policyOverride": { "type": "object" }
                        }
                      },
                      "mode": { "enum": ["immediate", "queued"] },
                      "request": { "type": "string", "minLength": 1 },
                      "result": { "type": "string", "minLength": 1 },
                      "subject": { "type": "object" }
                    }
                  }
                }
              },
              "additionalProperties": true
            },
            "state": { "type": "object" }
          }
        },
        "authoring": {
          "type": "object",
          "required": ["tools"],
          "additionalProperties": false,
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "op"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "op": { "enum": ["validate", "describe", "project"] },
                  "layer": { "type": "string" },
                  "description": { "type": "string" },
                  "inputSchema": { "type": "object" },
                  "checks": { "type": "array", "items": { "type": "string" } },
                  "projector": { "type": "string" },
                  "projectExpression": { "type": "string" },
                  "describe": { "type": "string" },
                  "agentSafe": { "type": "boolean" }
                }
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}