{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/profile.schema.json",
  "title": "GenUI Profile",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "profile" },
    "payload": {
      "type": "object",
      "required": ["id", "kind", "version", "layers", "recipes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "profile-template": { "type": "string", "minLength": 1 },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/layer.schema.json" }
        },
        "recipes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "from", "to"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "from": { "type": "string", "minLength": 1 },
              "to": { "type": "string", "minLength": 1 }
            }
          }
        },
        "context": {
          "type": "object"
        },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": ["inline"],
                "additionalProperties": false,
                "properties": { "inline": {} }
              },
              {
                "type": "object",
                "required": ["$ref"],
                "additionalProperties": false,
                "properties": { "$ref": { "type": "string", "minLength": 1 } }
              }
            ]
          }
        },
        "services": {
          "type": "object",
          "description": "Blueprint-owned service declarations. The operation-only shape remains accepted during migration.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["version", "operations"],
                "properties": {
                  "version": { "type": "string", "minLength": 1 },
                  "operations": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "version", "operations"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 },
                  "operations": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "config": {},
                  "scope": { "enum": ["per-invocation", "per-cell", "per-blueprint", "per-session"] }
                }
              }
            ]
          }
        },
        "authoring": {
          "type": "object",
          "required": ["tools"],
          "additionalProperties": false,
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "op"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "op": { "enum": ["validate", "describe", "project"] },
                  "layer": { "type": "string" },
                  "description": { "type": "string" },
                  "inputSchema": { "type": "object" },
                  "checks": { "type": "array", "items": { "type": "string" } },
                  "projector": { "type": "string" },
                  "projectExpression": { "type": "string" },
                  "describe": { "type": "string" },
                  "agentSafe": { "type": "boolean" }
                }
              }
            }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}