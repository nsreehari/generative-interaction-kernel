{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/lowering-recipe.schema.json",
  "title": "GenUI Lowering Recipe",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "lowering-recipe" },
    "payload": {
      "$ref": "#/definitions/layerRecipe"
    }
  },
  "definitions": {
    "layerRecipe": {
      "type": "object",
      "required": ["id", "from", "to", "metadata"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "metadata": {
          "type": "object",
          "required": ["executor"],
          "additionalProperties": true,
          "properties": {
            "executor": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}