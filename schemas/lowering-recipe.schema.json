{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/lowering-recipe.schema.json",
  "title": "GenUI Lowering Recipe",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "lowering-recipe" },
    "payload": {
      "oneOf": [
        { "$ref": "#/definitions/interactionToPresentation" },
        { "$ref": "#/definitions/presentationToRuntime" }
      ]
    }
  },
  "definitions": {
    "contextMatch": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "interaction": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "space": { "type": "string", "minLength": 1 },
        "attention": { "type": "string", "minLength": 1 },
        "expertise": { "type": "string", "minLength": 1 },
        "constrained": { "type": "boolean" },
        "region": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "priority": { "type": "string", "minLength": 1 },
        "disclosure": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "presentation": { "type": "string", "minLength": 1 }
      }
    },
    "templateString": {
      "type": "string",
      "minLength": 1
    },
    "runtimeNodeFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "read": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "readExpr": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "on": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "interactionToPresentation": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "templates",
        "program",
        "cap"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "const": "interaction" },
        "to": { "const": "presentation" },
        "constrainedWhen": {
          "type": "array",
          "items": { "$ref": "#/definitions/contextMatch" }
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "arrangement"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "arrangement": { "type": "string", "minLength": 1 },
              "maxRegions": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "program": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["slot", "match", "emit"],
            "additionalProperties": false,
            "properties": {
              "slot": {
                "enum": ["template", "rank", "priority", "disclosure", "presentation", "rationale"]
              },
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "cap": {
          "type": "object",
          "required": ["preserveRequired"],
          "additionalProperties": false,
          "properties": {
            "preserveRequired": { "type": "boolean" }
          }
        }
      }
    },
    "presentationToRuntime": {
      "type": "object",
      "required": ["id", "from", "to", "program"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "const": "presentation" },
        "to": { "const": "runtime-document" },
        "program": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["slot", "match", "emit"],
                "additionalProperties": false,
                "properties": {
                  "slot": { "const": "container" },
                  "match": { "$ref": "#/definitions/contextMatch" },
                  "emit": {
                    "allOf": [
                      { "$ref": "#/definitions/runtimeNodeFields" },
                      { "required": ["capability"] }
                    ]
                  }
                }
              },
              {
                "type": "object",
                "required": ["slot", "match", "emit"],
                "additionalProperties": false,
                "properties": {
                  "slot": { "const": "region" },
                  "match": { "$ref": "#/definitions/contextMatch" },
                  "emit": { "$ref": "#/definitions/runtimeNodeFields" }
                }
              }
            ]
          }
        }
      }
    }
  }
}