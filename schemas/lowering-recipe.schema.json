{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/lowering-recipe.schema.json",
  "title": "GIK Lowering Recipe",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "lowering-recipe" },
    "payload": {
      "$ref": "#/definitions/loweringRecipe"
    }
  },
  "definitions": {
    "loweringRecipe": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object" }
      }
    }
  }
}