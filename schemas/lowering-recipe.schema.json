{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/lowering-recipe.schema.json",
  "title": "GenUI Lowering Recipe",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "lowering-recipe" },
    "payload": {
      "oneOf": [
        { "$ref": "#/definitions/interactionToPresentation" },
        { "$ref": "#/definitions/presentationToRuntime" }
      ]
    }
  },
  "definitions": {
    "contextMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interaction": { "type": "string", "minLength": 1 },
        "surface": { "type": "string", "minLength": 1 },
        "device": { "type": "string", "minLength": 1 },
        "space": { "type": "string", "minLength": 1 },
        "attention": { "type": "string", "minLength": 1 },
        "expertise": { "type": "string", "minLength": 1 },
        "constrained": { "type": "boolean" },
        "region": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "priority": { "type": "string", "minLength": 1 },
        "disclosure": { "type": "string", "minLength": 1 },
        "index": { "type": "integer", "minimum": 0 },
        "presentation": { "type": "string", "minLength": 1 }
      }
    },
    "templateString": {
      "type": "string",
      "minLength": 1
    },
    "runtimeNodeFields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "read": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "readExpr": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "on": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "interactionToPresentation": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "templates",
        "templateRules",
        "orderRules",
        "priorityRules",
        "disclosureRules",
        "cap"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "const": "interaction" },
        "to": { "const": "presentation" },
        "constrainedWhen": {
          "type": "array",
          "items": { "$ref": "#/definitions/contextMatch" }
        },
        "templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "arrangement"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "arrangement": { "type": "string", "minLength": 1 },
              "maxRegions": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "templateRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["match", "emit"],
            "additionalProperties": false,
            "properties": {
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": {
                "type": "object",
                "required": ["template", "layout"],
                "additionalProperties": false,
                "properties": {
                  "template": { "type": "string", "minLength": 1 },
                  "layout": { "$ref": "#/definitions/templateString" }
                }
              }
            }
          }
        },
        "orderRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["match", "emit"],
            "additionalProperties": false,
            "properties": {
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": {
                "type": "object",
                "required": ["rank"],
                "additionalProperties": false,
                "properties": {
                  "rank": { "type": "integer" }
                }
              }
            }
          }
        },
        "priorityRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["match", "emit"],
            "additionalProperties": false,
            "properties": {
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": {
                "type": "object",
                "required": ["priority"],
                "additionalProperties": false,
                "properties": {
                  "priority": { "enum": ["primary", "secondary", "tertiary"] }
                }
              }
            }
          }
        },
        "disclosureRules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["match", "emit"],
            "additionalProperties": false,
            "properties": {
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": {
                "type": "object",
                "required": ["disclosure"],
                "additionalProperties": false,
                "properties": {
                  "disclosure": { "enum": ["always", "collapsed", "on-demand"] }
                }
              }
            }
          }
        },
        "regionRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["match", "emit"],
            "additionalProperties": false,
            "properties": {
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "presentation": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "rationaleRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["match", "emit"],
            "additionalProperties": false,
            "properties": {
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": {
                "type": "object",
                "required": ["template"],
                "additionalProperties": false,
                "properties": {
                  "template": { "$ref": "#/definitions/templateString" }
                }
              }
            }
          }
        },
        "cap": {
          "type": "object",
          "required": ["preserveRequired"],
          "additionalProperties": false,
          "properties": {
            "preserveRequired": { "type": "boolean" }
          }
        }
      }
    },
    "presentationToRuntime": {
      "type": "object",
      "required": ["id", "from", "to", "container", "rules"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "const": "presentation" },
        "to": { "const": "runtime-document" },
        "container": {
          "allOf": [
            { "$ref": "#/definitions/runtimeNodeFields" },
            { "required": ["capability"] }
          ]
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["match", "emit"],
            "additionalProperties": false,
            "properties": {
              "match": { "$ref": "#/definitions/contextMatch" },
              "emit": { "$ref": "#/definitions/runtimeNodeFields" }
            }
          }
        },
        "fallback": { "$ref": "#/definitions/runtimeNodeFields" }
      }
    }
  }
}