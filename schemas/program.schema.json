{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/gik/0.1/program.schema.json",
  "title": "GIK program message",
  "description": "An executable program definition with optional projection, event handlers, reactions, machines, and derivations. Valid only against a declared vocabulary version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gik", "type", "payload"],
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "program" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["root"] },
        { "required": ["handlers"] },
        { "required": ["reactions"] },
        { "required": ["machines"] },
        { "required": ["derivations"] }
      ],
      "properties": {
        "vocabulary": {
          "type": "string",
          "description": "Vocabulary version this program targets."
        },
        "root": { "$ref": "#/definitions/node" },
        "handlers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/runtimeHandler" }
        },
        "reactions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/runtimeReaction" }
        },
        "machines": {
          "type": "array",
          "items": { "$ref": "#/definitions/machine" }
        },
        "derivations": {
          "type": "array",
          "items": { "$ref": "#/definitions/derivation" }
        }
      }
    }
  },
  "definitions": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "capabilityRef": {
      "type": "string",
      "description": "A capability reference: a bare name, or a namespaced `alias:name` resolved through the vocabulary's externals.projectionViews.",
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*(:[A-Za-z_][A-Za-z0-9_-]*)?$"
    },
    "nsPath": {
      "type": "string",
      "description": "A dotted namespace path, e.g. card_data.selected.",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
    },
    "expr": {
      "type": "string",
      "description": "An opaque expression in the vocabulary-declared dialect."
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do"],
      "properties": {
        "do": {
          "type": "string",
          "description": "A built-in family (assign|derive|invoke|emit|route|confirm) or a vocabulary-declared custom action."
        },
        "target": { "$ref": "#/definitions/nsPath" },
        "args": { "type": "object" },
        "guard": { "$ref": "#/definitions/expr" },
        "event": { "$ref": "#/definitions/identifier" }
      }
    },
    "reaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "run"],
      "description": "A declarative reaction: when the `when` expression's value changes, run the closed-grammar `run` actions (a state-triggered effect; the standing analogue of an event handler).",
      "properties": {
        "when": { "$ref": "#/definitions/expr" },
        "runInitially": { "type": "boolean", "default": false, "description": "Run once when the initially observed value is non-null." },
        "run": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "runtimeHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "on"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "on": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/action" }
          }
        }
      }
    },
    "runtimeReaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "run"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "when": { "$ref": "#/definitions/expr" },
        "runInitially": { "type": "boolean", "default": false },
        "run": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "expression", "dependencies"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "target": { "$ref": "#/definitions/nsPath" },
        "expression": { "$ref": "#/definitions/expr" },
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nsPath" }
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "object",
          "description": "prop -> namespace path (data in).",
          "additionalProperties": { "$ref": "#/definitions/nsPath" }
        },
        "readExpr": {
          "type": "object",
          "description": "prop -> expression evaluated against state (data in, shaped).",
          "additionalProperties": { "$ref": "#/definitions/expr" }
        },
        "gate": { "$ref": "#/definitions/expr" },
        "write": {
          "type": "object",
          "description": "event -> { to: namespace path } (data out).",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to"],
            "properties": { "to": { "$ref": "#/definitions/nsPath" } }
          }
        },
        "on": {
          "type": "object",
          "description": "event -> ordered list of actions (behavior).",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/definitions/action" }
          }
        },
        "react": {
          "type": "array",
          "description": "Standing reactions: state-triggered effects that run when their `when` value changes.",
          "items": { "$ref": "#/definitions/reaction" }
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "id"],
      "properties": {
        "capability": { "$ref": "#/definitions/capabilityRef" },
        "id": { "$ref": "#/definitions/identifier" },
        "props": { "type": "object" },
        "edges": { "$ref": "#/definitions/edges" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/definitions/identifier" },
        "guard": { "$ref": "#/definitions/expr" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/definitions/action" }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "object",
          "description": "event -> target state name (shorthand) or a full transition.",
          "additionalProperties": {
            "oneOf": [
              { "$ref": "#/definitions/identifier" },
              { "$ref": "#/definitions/transition" }
            ]
          }
        },
        "entry": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "exit": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "type": { "enum": ["final"] }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "context", "initial", "states"],
      "properties": {
        "id": { "$ref": "#/definitions/identifier" },
        "context": {
          "$ref": "#/definitions/nsPath",
          "description": "Namespace path where the machine's current state is stored."
        },
        "initial": { "$ref": "#/definitions/identifier" },
        "states": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/state" }
        }
      }
    }
  }
}
