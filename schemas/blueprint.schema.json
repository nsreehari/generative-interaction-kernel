{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/blueprint.schema.json",
  "title": "GIK Blueprint",
  "description": "A self-contained authored organism definition with Cells, relationships, projections, services, and runtime contract.",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "blueprint" },
    "payload": {
      "type": "object",
      "required": ["id", "kind", "version", "tiers", "recipes", "runtime"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "structureMode": {
          "type": "string",
          "enum": ["fixed", "reconfigurable", "adaptive"],
          "default": "fixed",
          "description": "Blueprint semantic policy governing whether authored structure may change."
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/tier.schema.json" }
        },
        "recipes": {
          "type": "array",
          "items": { "$ref": "https://genui.dev/schemas/lowering-recipe.schema.json#/definitions/loweringRecipe" }
        },
        "cells": {
          "type": "object",
          "additionalProperties": { "$ref": "https://genui.dev/schemas/cell.schema.json" }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["kind", "participants"],
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "participants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "configuration": {},
              "metadata": { "type": "object" }
            }
          }
        },
        "projections": {
          "type": "object",
          "properties": {
            "presentation": {
              "type": "object",
              "required": ["roots"],
              "additionalProperties": false,
              "properties": {
                "roots": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "placements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["cell"],
                    "additionalProperties": false,
                    "properties": {
                      "cell": { "type": "string", "minLength": 1 },
                      "parent": { "type": "string", "minLength": 1 },
                      "slot": { "type": "string", "minLength": 1 },
                      "order": { "type": "number" }
                    }
                  }
                }
              }
            }
          },
          "additionalProperties": { "type": "object" }
        },
        "context": { "type": "object" },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "object", "required": ["inline"], "additionalProperties": false, "properties": { "inline": {} } },
              { "type": "object", "required": ["$ref"], "additionalProperties": false, "properties": { "$ref": { "type": "string", "minLength": 1 } } }
            ]
          }
        },
        "services": { "type": "object" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "expression": { "type": "string" },
            "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "contexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "capabilities": { "type": "object" },
            "externals": { "type": "object" },
            "state": { "type": "object" }
          }
        },
        "metadata": { "type": "object" }
      }
    }
  }
}