{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://genui.dev/schemas/blueprint.schema.json",
  "title": "GIK Blueprint",
  "description": "A self-contained authored application with its tier chain, lowering recipes, organism, resources, and runtime contract.",
  "type": "object",
  "required": ["gik", "type", "payload"],
  "additionalProperties": false,
  "properties": {
    "gik": { "const": "0.1" },
    "type": { "const": "blueprint" },
    "payload": {
      "type": "object",
      "required": ["id", "kind", "version", "tiers", "recipes", "runtime"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "blueprint-template": { "type": "string", "minLength": 1 },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "https://genui.dev/schemas/layer.schema.json" }
        },
        "recipes": {
          "type": "array",
          "items": { "$ref": "https://genui.dev/schemas/lowering-recipe.schema.json#/definitions/layerRecipe" }
        },
        "organism": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "root": { "$ref": "#/$defs/cell" },
            "cells": { "type": "array", "items": { "$ref": "#/$defs/cell" } }
          }
        },
        "context": { "type": "object" },
        "resources": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "object", "required": ["inline"], "additionalProperties": false, "properties": { "inline": {} } },
              { "type": "object", "required": ["$ref"], "additionalProperties": false, "properties": { "$ref": { "type": "string", "minLength": 1 } } }
            ]
          }
        },
        "services": { "type": "object" },
        "runtime": {
          "type": "object",
          "required": ["capabilities"],
          "additionalProperties": false,
          "properties": {
            "expression": { "type": "string" },
            "namespaces": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "contexts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "actions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "capabilities": { "type": "object" },
            "externals": { "type": "object" },
            "state": { "type": "object" }
          }
        },
        "authoring": { "type": "object" },
        "metadata": { "type": "object" }
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "edges": { "type": "object" },
        "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "provides": { "type": "array" },
        "service": { "type": "object" }
      }
    }
  }
}